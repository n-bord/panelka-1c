---
// Вариант содержимого для одного интерфейса внутри <InterfaceTabs>.
// Всё, что попадает внутрь (текст, шаги, изображения, видео, примечания,
// заголовки), переключается вместе с режимом — общий текст статьи
// дублировать не нужно.
interface Props {
  mode: '1c' | 'web';
}

const { mode } = Astro.props;
---

<div class="interface-pane" data-interface-pane={mode}>
  <slot />
</div>
