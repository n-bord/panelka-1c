---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import type { ResolvedNavEntry } from '../../components/SidebarNav.astro';
import { docsNav, flattenNav, parentGroupOf, type NavEntry } from '../../lib/docs-nav';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Подписи страниц берём из title статей; label в конфиге может их переопределять.
const all = await getCollection('docs', ({ data }) => !data.draft);
const titleBySlug = new Map(all.map((e) => [e.id, e.data.title]));

function resolve(entries: NavEntry[]): ResolvedNavEntry[] {
  return entries.map((e) => ({
    slug: e.slug,
    label: e.label ?? (e.slug ? titleBySlug.get(e.slug) ?? e.slug : ''),
    children: e.children ? resolve(e.children) : undefined,
  }));
}

const navItems = resolve(docsNav);
const order = flattenNav();
const index = order.indexOf(entry.id);
const prevSlug = index > 0 ? order[index - 1] : null;
const nextSlug = index >= 0 && index < order.length - 1 ? order[index + 1] : null;
const prev = prevSlug ? { slug: prevSlug, title: titleBySlug.get(prevSlug) ?? prevSlug } : null;
const next = nextSlug ? { slug: nextSlug, title: titleBySlug.get(nextSlug) ?? nextSlug } : null;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  navItems={navItems}
  currentSlug={entry.id}
  category={parentGroupOf(entry.id)}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
