#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область РегистрацияВнешнейОбработки

// Формирует сведения регистрации внешней обработки для конфигурации с БСП.
//
// Возвращаемое значение:
//  Структура - регистрационные сведения внешней обработки и таблица команд.
Функция СведенияОВнешнейОбработке() Экспорт
	Если Метаданные.ОбщиеМодули.Найти("ДополнительныеОтчетыИОбработки") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найден общий модуль ""ДополнительныеОтчетыИОбработки"". Обработка требует Библиотеку стандартных подсистем.'");
	КонецЕсли;
	Если Метаданные.ОбщиеМодули.Найти("ДополнительныеОтчетыИОбработкиКлиентСервер") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найден общий модуль ""ДополнительныеОтчетыИОбработкиКлиентСервер"". Обработка требует Библиотеку стандартных подсистем.'");
	КонецЕсли;
	//@skip-check undefined-variable
	МодульБСП = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
	МодульБСП_КС = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработкиКлиентСервер");
	ВерсияБСП = "3.1.2.1";
	МодульСтандартныеПодсистемыСервер = Неопределено;
	Если Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыСервер") <> Неопределено Тогда
		Попытка
			МодульСтандартныеПодсистемыСервер = ОбщегоНазначения.ОбщийМодуль("СтандартныеПодсистемыСервер");
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если МодульСтандартныеПодсистемыСервер <> Неопределено Тогда
		Попытка
			ВерсияБСП = МодульСтандартныеПодсистемыСервер.ВерсияБиблиотеки();
		Исключение
		КонецПопытки;
	КонецЕсли;
	ПараметрыРегистрации = МодульБСП.СведенияОВнешнейОбработке(ВерсияБСП);
	// БЕРЕМ ИМЯ ИЗ СИНОНИМА ОБРАБОТКИ
	ПараметрыРегистрации.Наименование = Метаданные().Синоним;
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Вид = МодульБСП_КС.ВидОбработкиДополнительнаяОбработка();
	БазоваяИнфо = "Универсальный навигатор (Панелька): запуск обработок, отчетов, веб-ссылок и локальных файлов";
	Если Метаданные.ОбщиеМодули.Найти("ДополнительныеОтчетыИОбработкиАптека") <> Неопределено Тогда
		ТекстДопИнфо = Символы.ПС
			+ "Ссылка на задачу: Нет"
			+ Символы.ПС
			+ "Дата добавления: " + Формат(ТекущаяДатаСеанса(), "ДФ=""dd.MM.yyyy HH:mm:ss""")
			+ Символы.ПС
			+ "Заказчик: БордачевНД";
		ПараметрыРегистрации.Информация = БазоваяИнфо + ТекстДопИнфо;
	Иначе
		ПараметрыРегистрации.Информация = БазоваяИнфо;
	КонецЕсли;
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Идентификатор = "ОткрытьГлавнуюФормуДашборда";
	НоваяКоманда.Использование = МодульБСП_КС.ТипКомандыОткрытиеФормы();
	// НАЗВАНИЕ КНОПКИ ТОЖЕ БЕРЕМ ИЗ СИНОНИМА
	СинонимОбработки = Метаданные().Синоним;
	НоваяКоманда.Представление = ?(СинонимОбработки = "Панелька", НСтр("ru = 'Открыть Панельку'"),
		СтрШаблон(НСтр("ru = 'Открыть %1'"), СинонимОбработки));
	Возврат ПараметрыРегистрации;
КонецФункции

#КонецОбласти

#Область КартинкиДляВыбора

// Возвращает системные и общие картинки для обоих редакторов.
// Параметры:
//  ВключатьКартинки - Булево - загружать изображения вместе с именами.
// Возвращаемое значение:
//  СписокЗначений из Строка - имена, представления и, при необходимости, картинки.
Функция ПанелькаКартинкиДляВыбора(ВключатьКартинки = Истина) Экспорт
	СписокКартинок = Новый СписокЗначений;
	СписокКартинок.Добавить("Папка",НСтр("ru = 'Папка'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Папка, Неопределено));
	СписокКартинок.Добавить("Избранное",НСтр("ru = 'Звезда'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Избранное, Неопределено));
	СписокКартинок.Добавить("Настройка",НСтр("ru = 'Настройки'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Настройка, Неопределено));
	СписокКартинок.Добавить("Справочник",НСтр("ru = 'Справочник'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Справочник, Неопределено));
	СписокКартинок.Добавить("Документ",НСтр("ru = 'Документ'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Документ, Неопределено));
	СписокКартинок.Добавить("Отчет",НСтр("ru = 'Отчет'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Отчет, Неопределено));
	СписокКартинок.Добавить("Обработка",НСтр("ru = 'Обработка'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Обработка, Неопределено));
	СписокКартинок.Добавить("Скрепка",НСтр("ru = 'Скрепка'"), , ?(ВключатьКартинки, БиблиотекаКартинок.Скрепка, Неопределено));
	Для каждого ОбщКартинка Из Метаданные.ОбщиеКартинки Цикл
		Попытка
			Синоним = ОбщКартинка.Синоним;
			Если ПустаяСтрока(Синоним) Тогда
				Синоним = ОбщКартинка.Имя;
			КонецЕсли;
			СписокКартинок.Добавить(ОбщКартинка.Имя, Синоним, , ?(ВключатьКартинки, БиблиотекаКартинок[ОбщКартинка.Имя], Неопределено));
		Исключение
			ПанелькаЗарегистрироватьОшибку("КаталогКартинок", ИнформацияОбОшибке(), ОбщКартинка.Имя);
		КонецПопытки;
	КонецЦикла;
	Возврат СписокКартинок;
КонецФункции

#КонецОбласти

#Область СистемныеИнструменты

// Читает каталог платформы без выполнения содержащегося в нем кода.
//
// Возвращаемое значение:
//  Структура - результат чтения:
//  * Инструменты - Массив из Структура - найденные стандартные инструменты:
//  ** Наименование - Строка - локализованное название.
//  ** Ссылка - Строка - адрес sys_cmd системной обработки.
//  * НеполныйСписок - Булево - часть записей не удалось прочитать.
//  * ОчисткаВыполнена - Булево - временный файл закрыт и удален.
Функция ПанелькаПрочитатьСистемныеИнструменты() Экспорт
	Результат = Новый Структура("Инструменты,НеполныйСписок,ОчисткаВыполнена", Новый Массив, Ложь, Истина);
	ИмяФайла = "";
	Чтение = Неопределено;
	Попытка
		ИмяФайла = ПолучитьИмяВременногоФайла("lf");
		КопироватьФайл("v8res://mngbase/AllFunctions.lf", ИмяФайла);
		Чтение = Новый ЧтениеТекста(ИмяФайла);
		ПанелькаПрочитатьКаталогСистемныхФункций(Чтение, Результат);
	Исключение
		Результат.НеполныйСписок = Истина;
		ПанелькаЗарегистрироватьОшибку("ЧтениеСистемныхФункций", ИнформацияОбОшибке());
	КонецПопытки;
	// Закрытие предшествует удалению и не подменяет исходную ошибку.
	Если Чтение <> Неопределено Тогда
		Попытка
			Чтение.Закрыть();
		Исключение
			Результат.ОчисткаВыполнена = Ложь;
			ПанелькаЗарегистрироватьОшибку("ЗакрытиеКаталогаСистемныхФункций", ИнформацияОбОшибке());
		КонецПопытки;
		Чтение = Неопределено;
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяФайла) Тогда
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
			Результат.ОчисткаВыполнена = Ложь;
			ПанелькаЗарегистрироватьОшибку("УдалениеКаталогаСистемныхФункций", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ДоступКДополнительнымИнструментам

// Проверяет платформенное право администрирования для общего редактора и скрытия адресов.
//
// Возвращаемое значение:
//  Булево - наличие права Администрирование.
Функция ПанелькаАдминистраторДополнительныхИнструментов() Экспорт
	Возврат ПравоДоступа("Администрирование", Метаданные);
КонецФункции

// Получает доступные инструменты WMS и БСП без повышения прав. Отказ источника возвращается в Сообщения.
//
// Параметры:
//  ПерсональнаяПанель - Булево - применять ограничения личного режима; общий редактор использует Ложь.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
//
// Возвращаемое значение:
//  Структура - результат отбора, без повышения прав:
//  * Источники - Массив из Структура - доступные инструменты:
//  ** Name - Строка - наименование инструмента.
//  ** Url - Строка - навигационная ссылка.
//  ** Tooltip - Строка - описание.
//  ** Type - Строка - вид инструмента для отображения.
//  ** Source - Строка - технический источник extra.
//  ** Folder - Строка - представление папки.
//  ** Catalog - Строка - имя справочника регистрации.
//  ** Disabled - Булево - признак отключенной публикации.
//  * Сообщения - Массив из Строка - пояснения отказов отдельных источников.
Функция ПанелькаДоступныеДополнительныеИнструменты(ПерсональнаяПанель = Ложь, Контекст = Неопределено) Экспорт
	Результат = Новый Структура("Источники,Сообщения", Новый Массив, Новый Массив);
	Администратор = ПанелькаАдминистраторДополнительныхИнструментов();
	Если ПерсональнаяПанель Тогда
		Если Контекст = Неопределено Тогда
			Контекст = ПанелькаКонтекстДоступаЛичнойПанели();
		КонецЕсли;
		Администратор = Контекст.ИгнорироватьОграничения;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("ДополнительныеОтчетыИОбработки,ВнешниеОбработки", ",") Цикл
		МД = Метаданные.Справочники.Найти(Имя);
		Если МД = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПравоДоступа("Чтение", МД) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ИсточникиКаталога = Новый Массив;
			Выборка = ПанелькаВыборкаДополнительныхИнструментов(МД, Администратор);
			Пока Выборка.Следующий() Цикл
				Вид = НРег(СтрЗаменить(Строка(Выборка.Вид), "ё", "е"));
				ТипИнструмента = "Тип не определён";
				Если СтрНайти(Вид, "отчет") > 0 Тогда
					ТипИнструмента = "Дополнительные отчеты";
				ИначеЕсли Не ПустаяСтрока(Вид) Тогда
					ТипИнструмента = "Дополнительные обработки";
				КонецЕсли;
				Адрес = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
				ОписаниеИнструмента = Новый Структура;
				ОписаниеИнструмента.Вставить("Name", Выборка.Наименование);
				ОписаниеИнструмента.Вставить("Url", Адрес);
				ОписаниеИнструмента.Вставить("Tooltip", Строка(Выборка.Описание));
				ОписаниеИнструмента.Вставить("Type", ТипИнструмента);
				ОписаниеИнструмента.Вставить("Source", "extra");
				ОписаниеИнструмента.Вставить("Folder", Строка(Выборка.Папка));
				ОписаниеИнструмента.Вставить("Catalog", МД.Имя);
				ОписаниеИнструмента.Вставить("Disabled", Строка(Выборка.Публикация) = "Отключена");
				ИсточникиКаталога.Добавить(ОписаниеИнструмента);
			КонецЦикла;
			Для Каждого Инструмент Из ИсточникиКаталога Цикл
				Результат.Источники.Добавить(Инструмент);
			КонецЦикла;
		Исключение
			ПанелькаЗарегистрироватьОшибку("ОтборДополнительныхИнструментов", ИнформацияОбОшибке(), МД.Имя);
			Результат.Сообщения.Добавить(СтрШаблон(
				НСтр("ru = 'Не удалось определить доступные инструменты «%1». Список этого источника не показан. Обратитесь к администратору.'"),
				Строка(МД.Синоним)));
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Нормализует адрес одного из поддерживаемых каталогов в ключ catalog/ref.
//
// Параметры:
//  Адрес - Строка - адрес ссылки; источник определяется также по содержимому адреса.
//
// Возвращаемое значение:
//  Строка - канонический catalog/ref либо пустая строка для некорректного адреса.
Функция ПанелькаКлючДополнительнойСсылки(Знач Адрес) Экспорт
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Адрес = НРег(СокрЛП(Адрес));
	Если Лев(Адрес, 9) = "web_link:" Тогда
		Возврат ПанелькаКлючДополнительнойСсылки(Сред(Адрес, 10));
	КонецЕсли;
	Префикс = "e1cib/data/справочник.";
	Если Лев(Адрес, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Адрес, "?");
	Если Позиция <= СтрДлина(Префикс) Тогда
		Возврат "";
	КонецЕсли;
	Имя = Сред(Адрес, СтрДлина(Префикс) + 1, Позиция - СтрДлина(Префикс) - 1);
	Если Имя <> НРег("ДополнительныеОтчетыИОбработки") И Имя <> НРег("ВнешниеОбработки") Тогда
		Возврат "";
	КонецЕсли;
	Идентификатор = "";
	Найден = Ложь;
	Для Каждого Пара Из СтрРазделить(Сред(Адрес, Позиция + 1), "&") Цикл
		Если Лев(Пара, 4) <> "ref=" Тогда
			Продолжить;
		КонецЕсли;
		Если Найден Тогда
			Возврат "";
		КонецЕсли;
		Найден = Истина;
		Идентификатор = Сред(Пара, 5);
	КонецЦикла;
	Позиция = СтрНайти(Идентификатор, ":");
	Если Позиция > 0 Тогда
		Идентификатор = Сред(Идентификатор, Позиция + 1);
	КонецЕсли;
	Если СтрДлина(Идентификатор) <> 32 Тогда
		Возврат "";
	КонецЕсли;
	Для Индекс = 1 По 32 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Идентификатор, Индекс, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат Имя + "|" + Идентификатор;
КонецФункции

// Строит индекс разрешенных инструментов. Переданный контекст повторно использует индекс в пределах операции.
//
// Параметры:
//  ПерсональнаяПанель - Булево - применять ограничения личного режима; общий редактор использует Ложь.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - разрешенные инструменты по каноническим ключам catalog/ref:
//  * Ключ - Строка - каноническая пара имени справочника и идентификатора ссылки.
//  * Значение - Булево - Истина для доступного инструмента.
Функция ПанелькаИндексДоступныхДополнительныхИнструментов(ПерсональнаяПанель = Истина, Контекст = Неопределено) Экспорт
	Индекс = Новый Соответствие;
	Если ПанелькаАдминистраторДополнительныхИнструментов() Тогда
		Если Не ПерсональнаяПанель Тогда
			Возврат Индекс;
		КонецЕсли;
		Если Контекст = Неопределено Тогда
			Контекст = ПанелькаКонтекстДоступаЛичнойПанели();
		КонецЕсли;
		Если Контекст.ИгнорироватьОграничения Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЕсли;
	Список = ПанелькаДоступныеДополнительныеИнструменты(ПерсональнаяПанель, Контекст);
	Для Каждого Инструмент Из Список.Источники Цикл
		Ключ = ПанелькаКлючДополнительнойСсылки(Инструмент.Url);
		Если Не ПустаяСтрока(Ключ) Тогда
			Индекс.Вставить(Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Индекс;
КонецФункции

// Проверяет наличие инструмента в доступном индексе; неизвестный адрес не дает разрешения.
//
// Параметры:
//  Адрес - Строка - адрес ссылки; источник определяется также по содержимому адреса.
//  Индекс - Неопределено, Соответствие из КлючИЗначение - индекс разрешенных инструментов текущей операции:
//   * Ключ - Строка - каноническая пара справочника и идентификатора.
//   * Значение - Булево - признак разрешения инструмента.
//  ПерсональнаяПанель - Булево - применять ограничения личного режима; общий редактор использует Ложь.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
//
// Возвращаемое значение:
//  Булево - инструмент разрешен текущему пользователю.
Функция ПанелькаДополнительнаяСсылкаДоступна(Адрес, Индекс = Неопределено, ПерсональнаяПанель = Истина,
	Контекст = Неопределено) Экспорт
	Если ПанелькаАдминистраторДополнительныхИнструментов() Тогда
		Если Не ПерсональнаяПанель Тогда
			Возврат Истина;
		КонецЕсли;
		Если Контекст = Неопределено Тогда
			Контекст = ПанелькаКонтекстДоступаЛичнойПанели();
		КонецЕсли;
		Если Контекст.ИгнорироватьОграничения Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Ключ = ПанелькаКлючДополнительнойСсылки(Адрес);
	Если ПустаяСтрока(Ключ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Индекс = Неопределено И Контекст <> Неопределено Тогда
		Индекс = Контекст.ДоступныеДополнительные;
	КонецЕсли;
	Если Индекс = Неопределено Тогда
		Индекс = ПанелькаИндексДоступныхДополнительныхИнструментов(ПерсональнаяПанель, Контекст);
		Если Контекст <> Неопределено Тогда
			Контекст.ДоступныеДополнительные = Индекс;
		КонецЕсли;
	КонецЕсли;
	Возврат Индекс[Ключ] = Истина;
КонецФункции

// Распознает дополнительный инструмент по адресу или техническому источнику.
//
// Параметры:
//  Адрес - Строка - адрес ссылки; источник определяется также по содержимому адреса.
//  Источник - Строка - технический ключ источника objects, extra, web или files.
//
// Возвращаемое значение:
//  Булево - адрес или источник относится к дополнительным инструментам.
Функция ПанелькаЭтоДополнительнаяСсылка(Адрес, Источник = "") Экспорт
	Возврат Источник = "extra" Или ПанелькаКатегорияЛичнойСсылки(Адрес, Источник) = "ДополнительныеОбработки";
КонецФункции

#КонецОбласти

#Область МодельНастроекПанелька_v3

// Создает типизированную таблицу указанной части текущей модели.
//
// Параметры:
//  Имя - Строка - имя таблицы или свойства модели.
//
// Возвращаемое значение:
//  ТаблицаЗначений - типизированная таблица указанной части текущей модели.
Функция ПанелькаНоваяТаблица(Имя) Экспорт
	НоваяТаблица = Новый ТаблицаЗначений;
	Если Имя = "Страницы" Тогда
		Поля = "ИД,ИмяСтраницы,ИмяКартинки,РолиДоступа";
	ИначеЕсли Имя = "Колонки" Тогда
		Поля = "ИД,ИДСтраницы,ИмяКолонки,ИмяКартинки";
	ИначеЕсли Имя = "КаталогСсылок" Тогда
		Поля = "ИД,Источник,Ссылка,Наименование,Подсказка";
	ИначеЕсли Имя = "Размещения" Тогда
		Поля = "ИД,ИДСсылки,ИДКолонки,Наименование,Подсказка";
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестная таблица модели Панелька: %1'"), Имя);
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить(Поля, ",") Цикл
		НоваяТаблица.Колонки.Добавить(Поле, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Если Имя <> "КаталогСсылок" Тогда
		НоваяТаблица.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	КонецЕсли;
	Если Имя = "Размещения" Тогда
		НоваяТаблица.Колонки.Добавить("СвоеНаименование", Новый ОписаниеТипов("Булево"));
		НоваяТаблица.Колонки.Добавить("СвояПодсказка", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Возврат НоваяТаблица;
КонецФункции

// Создает текущая модель с системными страницами, колонками и значениями настроек по умолчанию.
//
// Возвращаемое значение:
//  Структура - текущая модель с системным каркасом:
//  * ВерсияСхемы - Число - версия формата 3.
//  * Страницы - ТаблицаЗначений - таблица модели:
//  ** ИД - Строка - значение поля модели.
//  ** ИмяСтраницы - Строка - значение поля модели.
//  ** ИмяКартинки - Строка - значение поля модели.
//  ** РолиДоступа - Строка - значение поля модели.
//  ** Порядок - Число - порядок строки.
//  * Колонки - ТаблицаЗначений - таблица модели:
//  ** ИД - Строка - значение поля модели.
//  ** ИДСтраницы - Строка - значение поля модели.
//  ** ИмяКолонки - Строка - значение поля модели.
//  ** ИмяКартинки - Строка - значение поля модели.
//  ** Порядок - Число - порядок строки.
//  * КаталогСсылок - ТаблицаЗначений - таблица модели:
//  ** ИД - Строка - значение поля модели.
//  ** Источник - Строка - значение поля модели.
//  ** Ссылка - Строка - значение поля модели.
//  ** Наименование - Строка - значение поля модели.
//  ** Подсказка - Строка - значение поля модели.
//  * Размещения - ТаблицаЗначений - таблица модели:
//  ** ИД - Строка - значение поля модели.
//  ** ИДСсылки - Строка - значение поля модели.
//  ** ИДКолонки - Строка - значение поля модели.
//  ** Наименование - Строка - значение поля модели.
//  ** Подсказка - Строка - значение поля модели.
//  ** Порядок - Число - порядок строки.
//  ** СвоеНаименование - Булево - использовать индивидуальное название.
//  ** СвояПодсказка - Булево - использовать индивидуальную подсказку.
//  * Группировать - Булево - группировать ссылки по типу объекта.
//  * РазрешитьПерсональнуюПанельПанелька - Булево - общее разрешение персональных панелей.
//  * РазрешитьИмпортЛичнойПанелиПанелька - Булево - разрешён импорт настроек персональной панели.
//  * РазрешитьЭкспортЛичнойПанелиПанелька - Булево - разрешён экспорт настроек персональной панели.
//  * НеПрименятьОграниченияИсточниковКАдминистраторамПанелька - Булево - исключение администратора из ограничений источников.
//  * ИсточникиПерсональныхПанелейПанелька - См. ПанелькаНоваяПолитикаИсточниковЛичныхПанелей
//  * НеРаспределенныеНаОтдельнойВкладке - Булево - отдельная вкладка нераспределенных ссылок.
//  * СтандартныеНаОтдельнойВкладке - Булево - отдельная вкладка стандартных инструментов.
//  * ЗаполнятьКомментарийИзМетаданных - Булево - заполнять комментарий только при добавлении новой ссылки.
//  * РежимОтображенияПодсказок - Строка - вариант отображения подсказки.
//  * ШрифтКолонки - Шрифт - оформление заголовка колонки.
//  * ЦветКолонки - Цвет - цвет заголовка колонки.
//  * ШрифтГруппировки - Шрифт - оформление группировки.
//  * ЦветГруппировки - Цвет - цвет группировки.
Функция ПанелькаПустаяМодель() Экспорт
	МодельПанели = Новый Структура("ВерсияСхемы", 3);
	МодельПанели.Вставить("Страницы", ПанелькаНоваяТаблица("Страницы"));
	МодельПанели.Вставить("Колонки", ПанелькаНоваяТаблица("Колонки"));
	МодельПанели.Вставить("КаталогСсылок", ПанелькаНоваяТаблица("КаталогСсылок"));
	МодельПанели.Вставить("Размещения", ПанелькаНоваяТаблица("Размещения"));
	МодельПанели.Вставить("Группировать", Истина);
	МодельПанели.Вставить("РазрешитьПерсональнуюПанельПанелька", Истина);
	МодельПанели.Вставить("РазрешитьИмпортЛичнойПанелиПанелька", Истина);
	МодельПанели.Вставить("РазрешитьЭкспортЛичнойПанелиПанелька", Истина);
	МодельПанели.Вставить("НеПрименятьОграниченияИсточниковКАдминистраторамПанелька", Ложь);
	МодельПанели.Вставить("ИсточникиПерсональныхПанелейПанелька", ПанелькаНоваяПолитикаИсточниковЛичныхПанелей());
	МодельПанели.Вставить("НеРаспределенныеНаОтдельнойВкладке", Ложь);
	МодельПанели.Вставить("СтандартныеНаОтдельнойВкладке", Ложь);
	МодельПанели.Вставить("ЗаполнятьКомментарийИзМетаданных", Ложь);
	МодельПанели.Вставить("РежимОтображенияПодсказок", "Снизу");
	МодельПанели.Вставить("ШрифтКолонки", Новый Шрифт(, 13, Истина));
	МодельПанели.Вставить("ЦветКолонки", Новый Цвет());
	МодельПанели.Вставить("ШрифтГруппировки", Новый Шрифт(, 9));
	МодельПанели.Вставить("ЦветГруппировки", WebЦвета.ТемноСерый);
	Стр = МодельПанели.Страницы.Добавить();
	Стр.ИД = "page-main";
	Стр.ИмяСтраницы = "Главная";
	Стр.ИмяКартинки = "Избранное";
	Стр = МодельПанели.Страницы.Добавить();
	Стр.ИД = "page-unassigned";
	Стр.ИмяСтраницы = "Не распределено";
	Стр.ИмяКартинки = "Папка";
	Стр.Порядок = 100000;
	Стр = МодельПанели.Страницы.Добавить();
	Стр.ИД = "page-standard";
	Стр.ИмяСтраницы = "Стандартные инструменты";
	Стр.ИмяКартинки = "Настройка";
	Стр.Порядок = 100010;
	Стр = МодельПанели.Колонки.Добавить();
	Стр.ИД = "column-unassigned";
	Стр.ИДСтраницы = "page-unassigned";
	Стр.ИмяКолонки = "Не распределено";
	Стр.ИмяКартинки = "Папка";
	Стр.Порядок = 100000;
	Стр = МодельПанели.Колонки.Добавить();
	Стр.ИД = "column-standard";
	Стр.ИДСтраницы = "page-standard";
	Стр.ИмяКолонки = "Стандартные инструменты";
	Стр.ИмяКартинки = "Настройка";
	Стр.Порядок = 100010;
	Возврат МодельПанели;
КонецФункции

// Читает свойство структуры. Отсутствующее свойство и явное Неопределено различаются.
//
// Параметры:
//  Данные - Структура, Неопределено - текущая модель настроек или отсутствие записи.
//  Имя - Строка - имя таблицы или свойства модели.
//  ПоУмолчанию - Произвольный - значение при отсутствии свойства.
//
// Возвращаемое значение:
//  Произвольный - значение свойства либо ПоУмолчанию.
Функция ПанелькаЗначение(Данные, Имя, ПоУмолчанию = Неопределено) Экспорт
	Результат = ПоУмолчанию;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

// Читает общий флаг личных панелей. При первом запуске панели разрешены по умолчанию.
//
// Параметры:
//  Данные - Структура, Неопределено - текущая модель настроек или отсутствие записи.
//
// Возвращаемое значение:
//  Булево - значение разрешения с начальным значением по умолчанию.
Функция ПанелькаРазрешениеПерсональнойПанелиИзНастроек(Данные) Экспорт
	Значение = ПанелькаЗначение(Данные, "РазрешитьПерсональнуюПанельПанелька");
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Некорректное свойство настроек: РазрешитьПерсональнуюПанельПанелька. Ожидался тип Булево, получен тип %1.'"), Строка(ТипЗнч(Значение)));
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Читает флаг административного исключения. По умолчанию исключение выключено.
//
// Параметры:
//  Данные - Структура, Неопределено - текущая модель настроек или отсутствие записи.
//
// Возвращаемое значение:
//  Булево - настроенное административное исключение.
Функция ПанелькаНеПрименятьОграниченияКАдминистраторамИзНастроек(Данные) Экспорт
	Значение = ПанелькаЗначение(Данные, "НеПрименятьОграниченияИсточниковКАдминистраторамПанелька");
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректное свойство настроек: НеПрименятьОграниченияИсточниковКАдминистраторамПанелька. Ожидался тип Булево.'");
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Личная модель не хранит общие разрешения; отсутствие общей записи использует начальные значения.
// Параметры:
//  Настройки - Структура, Неопределено - общие настройки.
//  Операция - Строка - import или export.
// Возвращаемое значение:
//  Булево - разрешение операции.
Функция ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(Настройки, Операция) Экспорт
	Если Операция = "import" Тогда
		ИмяРазрешения = "РазрешитьИмпортЛичнойПанелиПанелька";
	ИначеЕсли Операция = "export" Тогда
		ИмяРазрешения = "РазрешитьЭкспортЛичнойПанелиПанелька";
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестная операция обмена настройками панели.'");
	КонецЕсли;
	Значение = ПанелькаЗначение(Настройки, ИмяРазрешения);
	Если Значение = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Некорректное разрешение обмена настройками: %1. Ожидался тип Булево.'"), ИмяРазрешения);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Решение принимает актуальная общая настройка, а не личная модель или импорт.
// Параметры:
//  Операция - Строка - import или export.
// Возвращаемое значение:
//  Булево - разрешение операции без исключения для администраторов источников.
Функция ПанелькаОбменЛичнойПанелиРазрешен(Операция) Экспорт
	Возврат ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(ПанелькаОбщиеНастройкиПолитикиИсточников(), Операция);
КонецФункции

// Читает опцию автоматического комментария; по умолчанию она выключена.
// Параметры:
//  Данные - Структура, Неопределено - текущая модель либо отсутствие записи.
// Возвращаемое значение:
//  Булево - разрешено заполнение комментария новой ссылки.
Функция ПанелькаЗаполнятьКомментарийИзНастроек(Данные) Экспорт
	Значение = ПанелькаЗначение(Данные, "ЗаполнятьКомментарийИзМетаданных");
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректная настройка «Заполнять комментарий из метаданных». Ожидался тип Булево.'");
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Возвращает исходный комментарий только для добавляемой ссылки. Сохранённые модели не изменяет.
// Параметры:
//  Адрес - Строка - адрес списка/приложения либо конкретного зарегистрированного инструмента БСП/WMS.
//  ПерсональнаяПанель - Булево - применять ограничения персональных источников к дополнительным инструментам.
//  Кэш - Структура, Неопределено - кеш описаний дополнительных инструментов текущей пакетной операции.
//  КонтекстДоступа - Структура, Неопределено - актуальный контекст доступа одной операции.
// Возвращаемое значение:
//  Строка - комментарий метаданных либо описание доступного инструмента; при отсутствии пустая строка.
Функция ПанелькаКомментарийНовойСсылки(Адрес, ПерсональнаяПанель = Ложь, Кэш = Неопределено, КонтекстДоступа = Неопределено) Экспорт
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Адрес = СокрЛП(Адрес);
	Если СтрНайти(Адрес, "#") > 0 Тогда
		Возврат "";
	КонецЕсли;
	КлючДополнительной = ПанелькаКлючДополнительнойСсылки(Адрес);
	Если Не ПустаяСтрока(КлючДополнительной) Тогда
		Если Кэш = Неопределено Тогда
			Кэш = Новый Структура;
		КонецЕсли;
		Описания = ПанелькаЗначение(Кэш, "Дополнительные");
		Если Описания = Неопределено Тогда
			Описания = Новый Соответствие;
			Доступные = ПанелькаДоступныеДополнительныеИнструменты(ПерсональнаяПанель, КонтекстДоступа);
			Для Каждого Инструмент Из Доступные.Источники Цикл
				КлючИнструмента = ПанелькаКлючДополнительнойСсылки(Инструмент.Url);
				Если Не ПустаяСтрока(КлючИнструмента) Тогда
					Описания.Вставить(КлючИнструмента, Инструмент.Tooltip);
				КонецЕсли;
			КонецЦикла;
			Кэш.Вставить("Дополнительные", Описания);
		КонецЕсли;
		Комментарий = Описания[КлючДополнительной];
		Возврат ?(Комментарий = Неопределено, "", Комментарий);
	КонецЕсли;
	// Ссылки на конкретные данные и параметры формы не получают комментарий класса метаданных.
	Если СтрНайти(Адрес, "?") > 0 Тогда
		Возврат "";
	КонецЕсли;
	ЭтоКонстанта = Лев(Адрес, СтрДлина("e1cib/data/Константа.")) = "e1cib/data/Константа.";
	Если Лев(Адрес, 11) <> "e1cib/list/" И Лев(Адрес, 10) <> "e1cib/app/" И Не ЭтоКонстанта Тогда
		Возврат "";
	КонецЕсли;
	Части = СтрРазделить(Адрес, "/");
	Если Части.Количество() <> 3 Или ПустаяСтрока(Части[2]) Тогда
		Возврат "";
	КонецЕсли;
	Если ЭтоКонстанта И СтрРазделить(Части[2], ".").Количество() <> 2 Тогда
		Возврат "";
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[2]);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Не ПанелькаМетаданныеДоступны(ОбъектМетаданных) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ОбъектМетаданных.Комментарий;
КонецФункции

// Вычисляет название и подсказку с учетом индивидуальных значений; пустая личная подсказка осознанна.
//
// Параметры:
//  Ссылка - СтрокаТаблицыЗначений - запись каталога ссылок текущей модели.
//  Размещение - СтрокаТаблицыЗначений - запись размещения с индивидуальным названием и подсказкой.
//
// Возвращаемое значение:
//  Структура - эффективные свойства размещения:
//  * Наименование - Строка - индивидуальное или общее название.
//  * Подсказка - Строка - индивидуальная либо общая подсказка; пустое индивидуальное значение сохраняется.
Функция ПанелькаСвойстваРазмещения(Ссылка, Размещение) Экспорт
	Название = Ссылка.Наименование;
	Подсказка = Ссылка.Подсказка;
	Если Размещение.СвоеНаименование Тогда
		Название = Размещение.Наименование;
	КонецЕсли;
	Если Размещение.СвояПодсказка Тогда
		Подсказка = Размещение.Подсказка;
	КонецЕсли;
	Возврат Новый Структура("Наименование,Подсказка", Название, Подсказка);
КонецФункции

// Проверяет типы и связи текущей модели до импорта в форму или записи; исходные данные не исправляет.
//
// Параметры:
//  МодельПанели - Структура - полная текущая модель из ПанелькаПустаяМодель.
Процедура ПанелькаПроверитьМодель(МодельПанели) Экспорт
	Если ТипЗнч(МодельПанели) <> Тип("Структура") Или ПанелькаЗначение(МодельПанели, "ВерсияСхемы", 0) <> 3 Тогда
		ВызватьИсключение НСтр("ru = 'Неподдерживаемая версия настроек Панелька.'");
	КонецЕсли;
	ИндексыМодели = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("Страницы,Колонки,КаталогСсылок,Размещения", ",") Цикл
		ТаблицаМодели = ПанелькаЗначение(МодельПанели, Имя);
		Если ТипЗнч(ТаблицаМодели) <> Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Отсутствует таблица %1'"), Имя);
		КонецЕсли;
		Для Каждого КолонкаТаблицы Из ПанелькаНоваяТаблица(Имя).Колонки Цикл
			Если ТаблицаМодели.Колонки.Найти(КолонкаТаблицы.Имя) = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Нет поля %1.%2'"), Имя, КолонкаТаблицы.Имя);
			КонецЕсли;
		КонецЦикла;
		Ключи = Новый Соответствие;
		Для Каждого Стр Из ТаблицаМодели Цикл
			Если ПустаяСтрока(Стр.ИД) Или Ключи[Стр.ИД] <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Пустой или повторяющийся идентификатор: %1'"), Имя);
			КонецЕсли;
			Ключи.Вставить(Стр.ИД, Стр);
		КонецЦикла;
		ИндексыМодели.Вставить(Имя, Ключи);
	КонецЦикла;
	СтраницыПоИД = ИндексыМодели["Страницы"];
	КолонкиПоИД = ИндексыМодели["Колонки"];
	СсылкиПоИД = ИндексыМодели["КаталогСсылок"];
	Системные = ПанелькаПустаяМодель();
	Для Каждого Свойство Из Системные Цикл
		Если ТипЗнч(Свойство.Значение) = Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		// Личная модель не хранит общие разрешения. Их значения определяются общей политикой.
		Если Свойство.Ключ = "РазрешитьПерсональнуюПанельПанелька" Тогда
			Значение = ПанелькаРазрешениеПерсональнойПанелиИзНастроек(МодельПанели);
		ИначеЕсли Свойство.Ключ = "РазрешитьИмпортЛичнойПанелиПанелька" Тогда
			Значение = ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(МодельПанели, "import");
		ИначеЕсли Свойство.Ключ = "РазрешитьЭкспортЛичнойПанелиПанелька" Тогда
			Значение = ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(МодельПанели, "export");
		ИначеЕсли Свойство.Ключ = "НеПрименятьОграниченияИсточниковКАдминистраторамПанелька" Тогда
			Значение = ПанелькаНеПрименятьОграниченияКАдминистраторамИзНастроек(МодельПанели);
		ИначеЕсли Свойство.Ключ = "ЗаполнятьКомментарийИзМетаданных" Тогда
			Значение = ПанелькаЗаполнятьКомментарийИзНастроек(МодельПанели);
		ИначеЕсли Свойство.Ключ = "ИсточникиПерсональныхПанелейПанелька" Тогда
			Значение = ПанелькаПолитикаИсточниковИзНастроек(МодельПанели);
		Иначе
			Значение = ПанелькаЗначение(МодельПанели, Свойство.Ключ);
		КонецЕсли;
		Если ТипЗнч(Значение) <> ТипЗнч(Свойство.Значение) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Некорректное свойство настроек: %1'"), Свойство.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Страницы,Колонки", ",") Цикл
		ПолеИмени = ?(Имя = "Страницы", "ИмяСтраницы", "ИмяКолонки");
		Для Каждого Эталон Из Системные[Имя] Цикл
			ИндексТаблицы = ИндексыМодели[Имя];
			Стр = ИндексТаблицы[Эталон.ИД];
			Если Стр = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Отсутствует системный элемент: %1'"), Эталон.ИД);
			КонецЕсли;
			Если Стр[ПолеИмени] <> Эталон[ПолеИмени] Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Изменено системное имя: %1'"), Эталон.ИД);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Страницы,Колонки", ",") Цикл
		ПолеИмени = ?(Имя = "Страницы", "ИмяСтраницы", "ИмяКолонки");
		Имена = Новый Соответствие;
		Для Каждого Стр Из МодельПанели[Имя] Цикл
			Название = НРег(СокрЛП(Стр[ПолеИмени]));
			КлючНазвания = ?(Имя = "Колонки", Стр.ИДСтраницы + "|", "") + Название;
			Если ПустаяСтрока(Название) Или Имена[КлючНазвания] <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Пустое или повторяющееся имя: %1'"), Имя);
			КонецЕсли;
			Имена.Вставить(КлючНазвания, Истина);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Колонка Из МодельПанели.Колонки Цикл
		Если СтраницыПоИД[Колонка.ИДСтраницы] = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Колонка ссылается на отсутствующую страницу.'");
		КонецЕсли;
	КонецЦикла;
	Адреса = Новый Соответствие;
	Для Каждого Ссылка Из МодельПанели.КаталогСсылок Цикл
		Если СтрРазделить("objects,files,web,extra", ",").Найти(Ссылка.Источник) = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Неизвестный источник ссылки.'");
		КонецЕсли;
		Если ПустаяСтрока(Ссылка.Ссылка) Или ПустаяСтрока(Ссылка.Наименование) Тогда
			ВызватьИсключение НСтр("ru = 'Заполните адрес и общее название ссылки.'");
		КонецЕсли;
		Ключ = Ссылка.Источник + Символы.ПС + Ссылка.Ссылка;
		Если Адреса[Ключ] <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Адрес уже существует в каталоге: %1'"), Ссылка.Ссылка);
		КонецЕсли;
		Адреса.Вставить(Ключ, Истина);
	КонецЦикла;
	Пары = Новый Соответствие;
	Для Каждого РазмещениеСсылки Из МодельПанели.Размещения Цикл
		Если СсылкиПоИД[РазмещениеСсылки.ИДСсылки] = Неопределено Или КолонкиПоИД[РазмещениеСсылки.ИДКолонки] = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Размещение ссылается на отсутствующую ссылку или колонку.'");
		КонецЕсли;
		Ключ = РазмещениеСсылки.ИДСсылки + ":" + РазмещениеСсылки.ИДКолонки;
		Если Пары[Ключ] <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Повторное размещение одной ссылки в колонке.'");
		КонецЕсли;
		Пары.Вставить(Ключ, Истина);
		Если РазмещениеСсылки.СвоеНаименование И ПустаяСтрока(РазмещениеСсылки.Наименование) Тогда
			ВызватьИсключение НСтр("ru = 'Индивидуальное название не может быть пустым.'");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Возвращает проверенную текущую модель; отсутствие записи означает первый запуск.
//
// Параметры:
//  Данные - Структура, Неопределено - текущая модель настроек или отсутствие записи.
//
// Возвращаемое значение:
//  См. ПанелькаПустаяМодель
Функция ПанелькаПолучитьМодель(Данные) Экспорт
	Если Данные = Неопределено Тогда
		Возврат ПанелькаПустаяМодель();
	КонецЕсли;
	ПанелькаПроверитьМодель(Данные);
	Возврат Данные;
КонецФункции

// Адаптирует модель для двух интерфейсов. Рабочие таблицы представления не записываются в хранилище.
// Отсутствие записи означает первый запуск; неподдерживаемые форматы отклоняются.
//
// Параметры:
//  Данные - Структура, Неопределено - текущая модель настроек или отсутствие записи.
//
// Возвращаемое значение:
//  Произвольный - структура текущего представления, описанная в ПанелькаНовоеПредставлениеМоделиДляДашборда;
//   Неопределено при отсутствии сохранённых настроек. Дополнительные свойства модели сохраняются.
Функция ПанелькаПредставлениеДляДашборда(Данные) Экспорт
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПанелькаПроверитьМодель(Данные);
	Возврат ПанелькаПредставлениеМоделиДляДашборда(Данные);
КонецФункции


#КонецОбласти

#Область ПроверкаРедактируемыхНастроек

// Подготавливает рабочую модель редактора с обязательным системным каркасом.
//
// Параметры:
//  Данные - Структура, Неопределено - текущая модель настроек или отсутствие записи.
//
// Возвращаемое значение:
//  См. ПанелькаПустаяМодель
Функция ПанелькаПодготовитьМодельРедактора(Данные) Экспорт
	Модель = ПанелькаПолучитьМодель(Данные);
	// Единственная явная нормализация осиротевших записей каталога при загрузке.
	РазмещенныеСсылки = Новый Соответствие;
	Для Каждого Размещение Из Модель.Размещения Цикл
		РазмещенныеСсылки.Вставить(Размещение.ИДСсылки, Истина);
	КонецЦикла;
	Для Каждого Ссылка Из Модель.КаталогСсылок Цикл
		Если РазмещенныеСсылки[Ссылка.ИД] = Неопределено Тогда
			Размещение = Модель.Размещения.Добавить();
			Размещение.ИД = Строка(Новый УникальныйИдентификатор);
			Размещение.ИДСсылки = Ссылка.ИД;
			Размещение.ИДКолонки = "column-unassigned";
			Размещение.Порядок = Модель.Размещения.Количество() * 10;
			РазмещенныеСсылки.Вставить(Ссылка.ИД, Истина);
		КонецЕсли;
	КонецЦикла;
	ПанелькаПроверитьМодельРедактора(Модель);
	Возврат Модель;
КонецФункции

// Проверяет дополнительные инварианты редактора до загрузки реквизитов и сохранения.
//
// Параметры:
//  Модель - Структура - текущая модель с таблицами страниц, колонок, каталога и размещений.
Процедура ПанелькаПроверитьМодельРедактора(Модель) Экспорт
	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидалась структура настроек.'");
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Страницы,Колонки,КаталогСсылок,Размещения", ",") Цикл
		Таблица = ПанелькаЗначение(Модель, Имя);
		Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Отсутствует таблица %1'"), Имя);
		КонецЕсли;
		Эталон = ПанелькаНоваяТаблица(Имя);
		Для Каждого Поле Из Эталон.Колонки Цикл
			Колонка = Таблица.Колонки.Найти(Поле.Имя);
			Если Колонка = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Отсутствует поле %1.%2'"), Имя, Поле.Имя);
			КонецЕсли;
			Если Колонка.ТипЗначения.Типы().Количество() <> 1
				Или Не Колонка.ТипЗначения.СодержитТип(Поле.ТипЗначения.Типы()[0]) Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Некорректный тип поля %1.%2'"), Имя, Поле.Имя);
			КонецЕсли;
			Для Каждого СтрокаДанных Из Таблица Цикл
				Если Не Поле.ТипЗначения.СодержитТип(ТипЗнч(СтрокаДанных[Поле.Имя])) Тогда
					ВызватьИсключение СтрШаблон(НСтр("ru = 'Некорректное значение %1.%2'"), Имя, Поле.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Для Каждого СтрокаДанных Из Таблица Цикл
			Если СтрНайти(СтрокаДанных.ИД, ":") > 0 Или СтрНайти(СтрокаДанных.ИД, ";") > 0
				Или СтрНайти(СтрокаДанных.ИД, Символы.ПС) > 0 Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Недопустимый идентификатор в таблице %1'"), Имя);
			КонецЕсли;
			Если Имя <> "КаталогСсылок" Тогда
				Если СтрокаДанных.Порядок < 0 Или Цел(СтрокаДанных.Порядок) <> СтрокаДанных.Порядок Тогда
					ВызватьИсключение СтрШаблон(НСтр("ru = 'Порядок должен быть целым неотрицательным числом: %1'"), Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ПанелькаПроверитьМодель(Модель);
	Если СтрРазделить("Снизу,Всплывающая,Кнопка,Нет", ",").Найти(Модель.РежимОтображенияПодсказок) = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестный режим отображения подсказок.'");
	КонецЕсли;
	Для Каждого Колонка Из Модель.Колонки Цикл
		Если Колонка.ИД = "column-unassigned" И Колонка.ИДСтраницы <> "page-unassigned"
			Или Колонка.ИД = "column-standard" И Колонка.ИДСтраницы <> "page-standard" Тогда
			ВызватьИсключение НСтр("ru = 'Нарушена связь системной колонки со страницей.'");
		КонецЕсли;
		Если Колонка.ИД <> "column-unassigned" И Колонка.ИД <> "column-standard"
			И (Колонка.ИДСтраницы = "page-unassigned" Или Колонка.ИДСтраницы = "page-standard") Тогда
			ВызватьИсключение НСтр("ru = 'Пользовательская колонка не может находиться на системной странице.'");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ПерсональнаяПанель

// Загружает профиль текущего пользователя; при его отсутствии возвращает новый неактивный профиль. Поля Создана и Изменена могут отсутствовать;
// при наличии они содержат даты создания и изменения. Читайте их через ПанелькаЗначение.
//
// Возвращаемое значение:
//  Структура - профиль текущего пользователя:
//  * Версия - Число - версия профиля 1.
//  * Активна - Булево - используется ли персональная панель.
//  * Данные - Неопределено, Структура - сохраненная модель; Неопределено при отсутствии панели.
//  * Ревизия - Строка - ревизия профиля для проверки конкурентной записи.
//  * ИсточникСоздания - Строка - служебное происхождение панели.
//  * РевизияОбщей - Строка - ревизия исходной общей панели.
Функция ПанелькаПрочитатьЛичныйПрофиль() Экспорт
	Профиль = ХранилищеОбщихНастроек.Загрузить("Панелька.ЛичнаяПанель", "Профиль");
	Если Профиль = Неопределено Тогда
		Возврат ПанелькаНовыйЛичныйПрофиль();
	КонецЕсли;
	Если ТипЗнч(Профиль) <> Тип("Структура") Или ПанелькаЗначение(Профиль, "Версия", 0) <> 1 Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось прочитать формат персональной панели. Сохранённые данные не изменены.'");
	КонецЕсли;
	Возврат Профиль;
КонецФункции

// Проверяет общее разрешение личных панелей и право сохранения пользовательских данных.
// КонтекстДоступа - Структура, Неопределено - серверный снимок текущей операции.
Процедура ПанелькаПроверитьПравоЛичнойПанели(КонтекстДоступа = Неопределено) Экспорт
	Если КонтекстДоступа = Неопределено Тогда
		ЛичнаяПанельРазрешена = ПанелькаРазрешенаПерсональнаяПанель();
	Иначе
		ЛичнаяПанельРазрешена = ПанелькаРазрешениеПерсональнойПанелиИзНастроек(КонтекстДоступа.Настройки);
	КонецЕсли;
	Если Не ЛичнаяПанельРазрешена Тогда
		ВызватьИсключение НСтр("ru = 'Персональные панели отключены администратором. Используйте общую панель.'");
	КонецЕсли;
	Если Не ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Для персональной панели требуется право «Сохранение данных пользователя». Обратитесь к администратору.'");
	КонецЕсли;
КонецПроцедуры

// Сохраняет, заменяет или удаляет личную панель текущего пользователя.
// Проверяет ревизию, текущие права и источники; при обычном редактировании сохраняет скрытые строки.
//
// Параметры:
//  Данные - Структура, Неопределено - текущая модель; Неопределено удаляет собственную панель.
//  ОжидаемаяРевизия - Строка - ревизия профиля на момент открытия редактора.
//  ПараметрыСохранения - Структура, Неопределено - контекст редактирования:
//  * СнимокВидимости - Строка - снимок при открытии; обязателен при изменении существующей панели.
//  * Заменить - Булево - явно подтвержденная замена всей панели, по умолчанию Ложь.
//  * ИсточникСоздания - Строка - происхождение новой или замененной панели.
//  * РевизияОбщей - Строка - ревизия исходной общей панели.
//  * Активна - Булево - использовать сохраненную панель, по умолчанию Истина.
//
// Возвращаемое значение:
//  Структура - результат успешной записи:
//  * Профиль - См. ПанелькаПрочитатьЛичныйПрофиль
//  * СнимокВидимости - Строка - основание для следующего сохранения из этого редактора.
Функция ПанелькаСохранитьЛичнуюПанель(Знач Данные, ОжидаемаяРевизия, ПараметрыСохранения = Неопределено) Экспорт
	Профиль = ПанелькаЛичныйПрофильДляЗаписи(ОжидаемаяРевизия);
	Параметры = ПанелькаПараметрыСохраненияЛичнойПанели(ПараметрыСохранения);
	СнимокВидимости = "";
	Если Данные <> Неопределено Тогда
		// Проверка структуры предшествует обходам модели и не меняет черновик вызывающего кода.
		ПанелькаПроверитьМодельРедактора(Данные);
		КонтекстДоступа = ПанелькаКонтекстДоступаЛичнойПанели();
		Данные = ПанелькаПодготовитьЛичнуюМодельКЗаписи(Данные, Профиль, Параметры, КонтекстДоступа);
		// Снимок вычисляется до записи: ошибка его построения не должна скрыть успешное сохранение.
		СнимокВидимости = ПанелькаСнимокВидимостиЛичнойМодели(Данные, КонтекстДоступа);
		Если Профиль.Данные = Неопределено Или Параметры.Заменить Тогда
			Профиль.ИсточникСоздания = Параметры.ИсточникСоздания;
			Профиль.РевизияОбщей = Параметры.РевизияОбщей;
		КонецЕсли;
	КонецЕсли;
	Профиль.Данные = Данные;
	Профиль.Активна = Данные <> Неопределено И Параметры.Активна;
	ПанелькаЗаписатьПроверенныйЛичныйПрофиль(Профиль, ОжидаемаяРевизия);
	Результат = Новый Структура;
	Результат.Вставить("Профиль", Профиль);
	Результат.Вставить("СнимокВидимости", СнимокВидимости);
	Возврат Результат;
КонецФункции

// Переключает использование текущего профиля без изменения модели, ее ревизии и дат.
// Отсутствующая личная панель остается неактивной.
Процедура ПанелькаПереключитьЛичныйРежим() Экспорт
	ПанелькаПроверитьПравоЛичнойПанели();
	Профиль = ПанелькаПрочитатьЛичныйПрофиль();
	Профиль.Активна = Не Профиль.Активна И Профиль.Данные <> Неопределено;
	ПанелькаЗаписатьПроверенныйЛичныйПрофиль(Профиль, Профиль.Ревизия);
КонецПроцедуры



// Сериализует проверенную модель в XML без изменения хранилища.
//
// Параметры:
//  Модель - Структура - текущая модель с таблицами страниц, колонок, каталога и размещений.
//
// Возвращаемое значение:
//  Строка - XML-представление модели без записи в хранилище.
Функция ПанелькаМодельВXML(Модель) Экспорт
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(Запись, Модель, "Значение", НазначениеТипаXML.Явное);
	Возврат Запись.Закрыть();
КонецФункции

// Проверяет права администрирования и сохранения пользовательских данных перед работой с чужими профилями.
Процедура ПанелькаПроверитьАдминистрированиеПанелей() Экспорт
	Если Не ПравоДоступа("Администрирование", Метаданные)
		Или Не ПравоДоступа("АдминистрированиеДанных", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Для работы с персональными панелями пользователей требуются права «Администрирование» и «Администрирование данных».'");
	КонецЕсли;
КонецПроцедуры

// Возвращает только существующие личные панели. Поврежденные профили учитываются и регистрируются.
//
// Возвращаемое значение:
//  Структура - административный список и счетчик отказов:
//  * Панели - ТаблицаЗначений - только профили с сохраненной панелью:
//  ** ИмяПользователя - Строка - ключ пользователя в хранилище.
//  ** Пользователь - Строка - отображаемое имя пользователя.
//  ** Ревизия - Строка - ревизия профиля.
//  ** Создана - Дата - дата создания или пустая дата.
//  ** Изменена - Дата - дата изменения или пустая дата.
//  ** Страниц - Число - число отображаемых страниц.
//  ** Ссылок - Число - число ссылок каталога.
//  * Пропущено - Число - количество профилей с ошибкой чтения или проверки.
Функция ПанелькаСписокПерсональныхПанелей() Экспорт
	ПанелькаПроверитьАдминистрированиеПанелей();
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("ИмяПользователя,Пользователь,Ревизия", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Таблица.Колонки.Добавить("Создана", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Изменена", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Страниц", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Ссылок", Новый ОписаниеТипов("Число"));
	Отбор = Новый Структура("КлючОбъекта,КлючНастроек", "Панелька.ЛичнаяПанель", "Профиль");
	Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
	Пропущено = 0;
	Пока Выборка.Следующий() Цикл
		Профиль = Выборка.Настройки;
		Попытка
			ПанелькаПроверитьФорматАдминПрофиля(Профиль);
			Если Профиль.Данные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Модель = ПанелькаПолучитьМодель(Профиль.Данные);
			ПанелькаПроверитьМодельРедактора(Модель);
		Исключение
			Пропущено = Пропущено + 1;
			ПанелькаЗарегистрироватьОшибку("ЧтениеАдминистративногоПрофиля", ИнформацияОбОшибке(), Выборка.Пользователь);
			Продолжить;
		КонецПопытки;
		Стр = Таблица.Добавить();
		Стр.ИмяПользователя = Выборка.Пользователь;
		Стр.Пользователь = ?(ПустаяСтрока(Стр.ИмяПользователя), "<Без имени пользователя>", Стр.ИмяПользователя);
		Стр.Ревизия = Профиль.Ревизия;
		Стр.Создана = ПанелькаДатаПрофиля(Профиль, "Создана");
		Стр.Изменена = ПанелькаДатаПрофиля(Профиль, "Изменена");
		Стр.Страниц = 0;
		Для Каждого Страница Из Модель.Страницы Цикл
			Если Страница.ИД = "page-unassigned" И Не Модель.НеРаспределенныеНаОтдельнойВкладке Тогда
				Продолжить;
			КонецЕсли;
			Если Страница.ИД = "page-standard" И Не Модель.СтандартныеНаОтдельнойВкладке Тогда
				Продолжить;
			КонецЕсли;
			Стр.Страниц = Стр.Страниц + 1;
		КонецЦикла;
		Стр.Ссылок = Модель.КаталогСсылок.Количество();
	КонецЦикла;
	Таблица.Сортировать("Пользователь");
	Возврат Новый Структура("Панели,Пропущено", Таблица, Пропущено);
КонецФункции

// Экспортирует модель выбранного пользователя после проверки административного права и ревизии.
//
// Параметры:
//  ИмяПользователя - Строка - точный ключ владельца в стандартном хранилище пользовательских настроек.
//  ОжидаемаяРевизия - Строка - ревизия профиля, полученная до редактирования или выбора команды.
//
// Возвращаемое значение:
//  Строка - XML-модель выбранного профиля без служебных данных владельца.
Функция ПанелькаАдминЭкспортПанели(ИмяПользователя, ОжидаемаяРевизия) Экспорт
	// Только модель: без имени пользователя, режима и служебных полей профиля.
	Возврат ПанелькаМодельВXML(ПанелькаАдминМодельПанели(ИмяПользователя, ОжидаемаяРевизия));
КонецФункции

// Удаляет содержимое выбранного профиля и меняет ревизию для защиты уже открытых редакторов.
//
// Параметры:
//  ИмяПользователя - Строка - точный ключ владельца в стандартном хранилище пользовательских настроек.
//  ОжидаемаяРевизия - Строка - ревизия профиля, полученная до редактирования или выбора команды.
Процедура ПанелькаАдминУдалитьПанель(ИмяПользователя, ОжидаемаяРевизия) Экспорт
	ПанелькаАдминПрочитатьПрофиль(ИмяПользователя, ОжидаемаяРевизия);
	Если Не ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Для удаления требуется право «Сохранение данных пользователя».'");
	КонецЕсли;
	// Содержимое удаляется; новая ревизия блокирует сохранение из старого редактора.
	Удаленный = ПанелькаНовыйЛичныйПрофиль(Строка(Новый УникальныйИдентификатор));
	Попытка
		ХранилищеОбщихНастроек.Сохранить("Панелька.ЛичнаяПанель", "Профиль", Удаленный, , ИмяПользователя);
	Исключение
		ПанелькаЗарегистрироватьОшибку("УдалениеЛичногоПрофиля", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Строит дерево содержимого выбранной панели без изменения ее данных.
//
// Параметры:
//  ИмяПользователя - Строка - точный ключ владельца в стандартном хранилище пользовательских настроек.
//  ОжидаемаяРевизия - Строка - ревизия профиля, полученная до редактирования или выбора команды.
//
// Возвращаемое значение:
//  ДеревоЗначений - упорядоченное представление страниц, колонок и ссылок выбранного профиля.
Функция ПанелькаАдминСоставПанели(ИмяПользователя, ОжидаемаяРевизия) Экспорт
	Модель = ПанелькаАдминМодельПанели(ИмяПользователя, ОжидаемаяРевизия);
	Дерево = Новый ДеревоЗначений;
	Для Каждого Имя Из СтрРазделить("Название,Вид,Ссылка,Подсказка", ",") Цикл
		Дерево.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Страницы = Модель.Страницы.Скопировать();
	Колонки = Модель.Колонки.Скопировать();
	Размещения = Модель.Размещения.Скопировать();
	Страницы.Сортировать("Порядок");
	Колонки.Сортировать("Порядок");
	Размещения.Сортировать("Порядок");
	Для Каждого Страница Из Страницы Цикл
		УзелСтраницы = Дерево.Строки.Добавить();
		УзелСтраницы.Название = Страница.ИмяСтраницы;
		УзелСтраницы.Вид = "Страница";
		Для Каждого Колонка Из Колонки.НайтиСтроки(Новый Структура("ИДСтраницы", Страница.ИД)) Цикл
			УзелКолонки = УзелСтраницы.Строки.Добавить();
			УзелКолонки.Название = Колонка.ИмяКолонки;
			УзелКолонки.Вид = "Колонка";
			Для Каждого Размещение Из Размещения.НайтиСтроки(Новый Структура("ИДКолонки", Колонка.ИД)) Цикл
				Ссылка = Модель.КаталогСсылок.Найти(Размещение.ИДСсылки, "ИД");
				Свойства = ПанелькаСвойстваРазмещения(Ссылка, Размещение);
				Узел = УзелКолонки.Строки.Добавить();
				Узел.Название = Свойства.Наименование;
				Узел.Вид = "Ссылка";
				Узел.Ссылка = Ссылка.Ссылка;
				Узел.Подсказка = Свойства.Подсказка;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	БезРазмещения = Неопределено;
	Для Каждого Ссылка Из Модель.КаталогСсылок Цикл
		Если Размещения.Найти(Ссылка.ИД, "ИДСсылки") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если БезРазмещения = Неопределено Тогда
			БезРазмещения = Дерево.Строки.Добавить();
			БезРазмещения.Название = "Без размещения";
			БезРазмещения.Вид = "Каталог";
		КонецЕсли;
		Узел = БезРазмещения.Строки.Добавить();
		Узел.Название = Ссылка.Наименование;
		Узел.Вид = "Ссылка";
		Узел.Ссылка = Ссылка.Ссылка;
		Узел.Подсказка = Ссылка.Подсказка;
	КонецЦикла;
	Возврат Дерево;
КонецФункции

// Проверяет права платформы на объект метаданных; отсутствие объекта означает отказ.
//
// Параметры:
//  ОбъектМД - ОбъектМетаданных - проверяемый объект конфигурации.
//
// Возвращаемое значение:
//  Булево - объект существует и доступен по проверяемым правам.
Функция ПанелькаМетаданныеДоступны(ОбъектМД) Экспорт
	Если ОбъектМД = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Класс = СтрРазделить(ОбъектМД.ПолноеИмя(), ".")[0];
	Если Класс = "ОбщаяФорма" Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Если Класс = "Отчет" Или Класс = "Обработка" Тогда
			Возврат ПравоДоступа("Использование", ОбъектМД);
		КонецЕсли;
		Возврат ПравоДоступа("Просмотр", ОбъектМД);
	Исключение
		Попытка
			Возврат ПравоДоступа("Чтение", ОбъектМД);
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецПопытки;
КонецФункции

// Совместно проверяет категорию источника, доступ к дополнительному инструменту и права метаданных.
//
// Параметры:
//  Адрес - Строка - адрес ссылки; источник определяется также по содержимому адреса.
//  Источник - Строка - технический ключ источника objects, extra, web или files.
//  Политика - Структура, Неопределено - эффективные булевы разрешения категорий из общей настройки.
//  ДоступныеДополнительные - Неопределено, Соответствие из КлючИЗначение - индекс разрешенных инструментов текущей операции:
//   * Ключ - Строка - каноническая пара справочника и идентификатора.
//   * Значение - Булево - признак разрешения инструмента.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
//
// Возвращаемое значение:
//  Булево - источник и объект доступны текущему пользователю.
Функция ПанелькаСсылкаДоступнаЛично(Знач Адрес, Источник = "", Политика = Неопределено,
	ДоступныеДополнительные = Неопределено, Контекст = Неопределено) Экспорт
	Если Контекст = Неопределено Тогда
		Контекст = ПанелькаКонтекстДоступаЛичнойПанели();
	КонецЕсли;
	Если Политика = Неопределено Тогда
		Политика = Контекст.Политика;
	КонецЕсли;
	Если Не ПанелькаИсточникРазрешенЛично(Адрес, Источник, Политика) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПанелькаЭтоДополнительнаяСсылка(Адрес, Источник) Тогда
		Если Не ПанелькаДополнительнаяСсылкаДоступна(Адрес, ДоступныеДополнительные, Истина, Контекст) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Адрес = СокрЛП(Адрес);
	Если Лев(НРег(Адрес), 9) = "web_link:" Тогда
		Возврат ПанелькаСсылкаДоступнаЛично(Сред(Адрес, 10), Источник, Политика, ДоступныеДополнительные, Контекст);
	КонецЕсли;
	Если Лев(НРег(Адрес), 6) <> "e1cib/" Тогда
		Возврат Истина;
	КонецЕсли;
	Части = СтрРазделить(СтрРазделить(Адрес, "?")[0], "/");
	Если Части.Количество() < 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяМД = Части[2];
	Для Каждого Маркер Из СтрРазделить(".Форма.,.Команда.", ",") Цикл
		Позиция = СтрНайти(ИмяМД, Маркер);
		Если Позиция > 0 Тогда
			ИмяМД = Лев(ИмяМД, Позиция - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат ПанелькаМетаданныеДоступны(Метаданные.НайтиПоПолномуИмени(ИмяМД));
КонецФункции

// Фильтрует рабочую копию по текущим правам. Исходная сохраненная модель не изменяется.
//
// Параметры:
//  Исходная - Структура - полная исходная текущая модель, которая не изменяется при фильтрации.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
//
// Возвращаемое значение:
//  См. ПанелькаПустаяМодель
Функция ПанелькаЛичнаяВидимаяМодель(Исходная, Контекст = Неопределено) Экспорт
	Если Контекст = Неопределено Тогда
		Контекст = ПанелькаКонтекстДоступаЛичнойПанели();
	КонецЕсли;
	Политика = Контекст.Политика;
	ВидимаяМодель = ПанелькаПустаяМодель();
	Для Каждого Свойство Из Исходная Цикл
		Если ТипЗнч(Свойство.Значение) = Тип("ТаблицаЗначений") Тогда
			ВидимаяМодель.Вставить(Свойство.Ключ, Свойство.Значение.Скопировать());
		Иначе
			ВидимаяМодель.Вставить(Свойство.Ключ, Свойство.Значение);
		КонецЕсли;
	КонецЦикла;
	Удаляемые = Новый Массив;
	НедоступныеСтраницы = Новый Соответствие;
	Для Каждого Стр Из ВидимаяМодель.Страницы Цикл
		Если Не ПанелькаСтраницаДоступнаЛично(Стр) Тогда
			НедоступныеСтраницы.Вставить(Стр.ИД, Истина);
			// Системный каркас обязателен для редактора и текущего формата хранения.
			// Скрывается содержимое, а не обязательные page-standard/column-standard.
			Если Стр.ИД <> "page-main" И Стр.ИД <> "page-unassigned" И Стр.ИД <> "page-standard" Тогда
				Удаляемые.Добавить(Стр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Удаляемые Цикл
		ВидимаяМодель.Страницы.Удалить(Стр);
	КонецЦикла;
	СтраницыПоИД = Новый Соответствие;
	Для Каждого Стр Из ВидимаяМодель.Страницы Цикл
		СтраницыПоИД.Вставить(Стр.ИД, Истина);
	КонецЦикла;
	КолонкиПоИД = Новый Соответствие;
	Удаляемые = Новый Массив;
	Для Каждого Стр Из ВидимаяМодель.Колонки Цикл
		Если СтраницыПоИД[Стр.ИДСтраницы] = Неопределено Тогда
			Удаляемые.Добавить(Стр);
		Иначе
			КолонкиПоИД.Вставить(Стр.ИД, Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Удаляемые Цикл
		ВидимаяМодель.Колонки.Удалить(Стр);
	КонецЦикла;
	Удаляемые = Новый Массив;
	ДоступныеДополнительные = Неопределено;
	Для Каждого Стр Из ВидимаяМодель.КаталогСсылок Цикл
		Если Не ПанелькаСсылкаДоступнаЛично(Стр.Ссылка, Стр.Источник, Политика, ДоступныеДополнительные, Контекст) Тогда
			Удаляемые.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Удаляемые Цикл
		ВидимаяМодель.КаталогСсылок.Удалить(Стр);
	КонецЦикла;
	СсылкиПоИД = Новый Соответствие;
	Для Каждого Стр Из ВидимаяМодель.КаталогСсылок Цикл
		СсылкиПоИД.Вставить(Стр.ИД, Истина);
	КонецЦикла;
	ИсходныеРазмещенныеСсылки = Новый Соответствие;
	Для Каждого Стр Из Исходная.Размещения Цикл
		ИсходныеРазмещенныеСсылки.Вставить(Стр.ИДСсылки, Истина);
	КонецЦикла;
	ВидимыеРазмещенныеСсылки = Новый Соответствие;
	Удаляемые = Новый Массив;
	Для Каждого Стр Из ВидимаяМодель.Размещения Цикл
		Колонка = КолонкиПоИД[Стр.ИДКолонки];
		Если Колонка = Неопределено Или СсылкиПоИД[Стр.ИДСсылки] = Неопределено Тогда
			Удаляемые.Добавить(Стр);
		ИначеЕсли НедоступныеСтраницы[Колонка.ИДСтраницы] = Истина Тогда
			Удаляемые.Добавить(Стр);
		Иначе
			ВидимыеРазмещенныеСсылки.Вставить(Стр.ИДСсылки, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Удаляемые Цикл
		ВидимаяМодель.Размещения.Удалить(Стр);
	КонецЦикла;
	Удаляемые = Новый Массив;
	Для Каждого Стр Из ВидимаяМодель.КаталогСсылок Цикл
		Если ИсходныеРазмещенныеСсылки[Стр.ИД] <> Неопределено
			И ВидимыеРазмещенныеСсылки[Стр.ИД] = Неопределено Тогда
			Удаляемые.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Удаляемые Цикл
		ВидимаяМодель.КаталогСсылок.Удалить(Стр);
	КонецЦикла;
	Возврат ВидимаяМодель;
КонецФункции

// Фиксирует видимые идентификаторы для обнаружения смены доступа в уже открытом редакторе.
//
// Параметры:
//  Модель - Структура - текущая модель с таблицами страниц, колонок, каталога и размещений.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
//
// Возвращаемое значение:
//  Строка - отпечаток видимости; не разрешение доступа и не ревизия профиля.
Функция ПанелькаСнимокВидимостиЛичнойМодели(Модель, Контекст = Неопределено) Экспорт
	Видимая = ПанелькаЛичнаяВидимаяМодель(Модель, Контекст);
	Части = Новый Массив;
	Для Каждого ИмяТаблицы Из СтрРазделить("Страницы,Колонки,КаталогСсылок,Размещения", ",") Цикл
		Для Каждого СтрокаМодели Из Видимая[ИмяТаблицы] Цикл
			Части.Добавить(ИмяТаблицы + ":" + СтрокаМодели.ИД + ";");
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Части, "");
КонецФункции

// Возвращает скрытые из-за прав строки при обычном сохранении; сознательный сброс их не сохраняет.
//
// Параметры:
//  Новая - Структура - редактируемая текущая модель; изменяется при восстановлении скрытых строк.
//  Прежняя - Структура - полная ранее сохраненная текущая модель.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
Процедура ПанелькаСохранитьСкрытыеЛичныеСтроки(Новая, Прежняя, Контекст = Неопределено) Экспорт
	Видимая = ПанелькаЛичнаяВидимаяМодель(Прежняя, Контекст);
	ИменаТаблиц = СтрРазделить("Страницы,Колонки,КаталогСсылок,Размещения", ",");
	ИДНовыхСтрок = Новый Структура;
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		Индекс = Новый Соответствие;
		Для Каждого СтрокаМодели Из Новая[ИмяТаблицы] Цикл
			Индекс.Вставить(СтрокаМодели.ИД, Истина);
		КонецЦикла;
		ИДНовыхСтрок.Вставить(ИмяТаблицы, Индекс);
	КонецЦикла;

	НераспределенныеСсылки = Новый Соответствие;
	Для Каждого Размещение Из Новая.Размещения Цикл
		Если Размещение.ИДКолонки = "column-unassigned" Тогда
			НераспределенныеСсылки.Вставить(Размещение.ИДСсылки, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		ИДВидимыхСтрок = Новый Соответствие;
		Для Каждого СтрокаМодели Из Видимая[ИмяТаблицы] Цикл
			ИДВидимыхСтрок.Вставить(СтрокаМодели.ИД, Истина);
		КонецЦикла;
		ИДТекущейТаблицы = ИДНовыхСтрок[ИмяТаблицы];
		Для Каждого Стр Из Прежняя[ИмяТаблицы] Цикл
			Если ИДВидимыхСтрок[Стр.ИД] <> Неопределено Или ИДТекущейТаблицы[Стр.ИД] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяТаблицы = "Колонки" И ИДНовыхСтрок.Страницы[Стр.ИДСтраницы] = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ИмяТаблицы = "Размещения" Тогда
				Если ИДНовыхСтрок.КаталогСсылок[Стр.ИДСсылки] = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ИДНовыхСтрок.Колонки[Стр.ИДКолонки] = Неопределено Тогда
					// Если колонку удалили, скрытая ссылка остаётся в «Не распределено».
					Если ИДНовыхСтрок.Колонки["column-unassigned"] = Неопределено
						Или НераспределенныеСсылки[Стр.ИДСсылки] <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					Восстановленная = Новая.Размещения.Добавить();
					ЗаполнитьЗначенияСвойств(Восстановленная, Стр);
					Восстановленная.ИДКолонки = "column-unassigned";
					НераспределенныеСсылки.Вставить(Стр.ИДСсылки, Истина);
					ИДТекущейТаблицы.Вставить(Стр.ИД, Истина);
					Продолжить;
				КонецЕсли;
				Если Стр.ИДКолонки = "column-unassigned" Тогда
					НераспределенныеСсылки.Вставить(Стр.ИДСсылки, Истина);
				КонецЕсли;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Новая[ИмяТаблицы].Добавить(), Стр);
			ИДТекущейТаблицы.Вставить(Стр.ИД, Истина);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область Диагностика

// Регистрирует технический отказ без зависимости от БСП; ошибка журнала не подменяет исходный отказ.
//
// Параметры:
//  Операция - Строка - постоянное имя события журнала регистрации.
//  Ошибка - ИнформацияОбОшибке - исходное исключение без замены его текстовым сообщением.
//  Контекст - Строка - каталог или владелец поврежденного профиля для диагностики.
Процедура ПанелькаЗарегистрироватьОшибку(Операция, Ошибка, Контекст = "") Экспорт
	Попытка
		ЗаписьЖурналаРегистрации("Панелька." + Операция, УровеньЖурналаРегистрации.Ошибка, , ,
			Лев(Контекст + Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(Ошибка), 10000));
	Исключение
		// Отказ журнала не должен скрывать исходную причину неуспешной операции.
	КонецПопытки;
КонецПроцедуры

// Возвращает стандартный модуль БСП для чтения и записи общих настроек.
Функция ПанелькаПолучитьМодульХранилища() Экспорт
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		МодульХранилища = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначения");
		Если МодульХранилища = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Общий модуль указан в метаданных, но не получен.'");
		КонецЕсли;
	Исключение
		ОшибкаПолучения = ИнформацияОбОшибке();
		ПричинаОтказа = ОписаниеОшибки();
		ПанелькаЗарегистрироватьОшибку("ПолучениеМодуляХранилища", ОшибкаПолучения);
		ВызватьИсключение НСтр("ru = 'Не удалось открыть хранилище настроек Панелька. Обратитесь к администратору.'")
			+ Символы.ПС + "ОбщегоНазначения: " + ПричинаОтказа;
	КонецПопытки;
	Возврат МодульХранилища;
КонецФункции

// Читает общие настройки панели по фиксированному ключу БСП.
//
// Возвращаемое значение:
//  Произвольный - общие настройки или Неопределено при их отсутствии.
Функция ПанелькаПрочитатьОбщиеНастройки() Экспорт
	МодульХранилища = ПанелькаПолучитьМодульХранилища();
	Если МодульХранилища = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Настройки = МодульХранилища.ПрочитатьДанныеИзБезопасногоХранилища("Панелька_БНД");
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Настройки;
КонецФункции

// Читает общее разрешение личных панелей независимо от содержимого личного профиля.
//
// Возвращаемое значение:
//  Булево - общее разрешение личных панелей.
Функция ПанелькаРазрешенаПерсональнаяПанель() Экспорт
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбщиеНастройки = ПанелькаПрочитатьОбщиеНастройки();
	Если ОбщиеНастройки <> Неопределено Тогда
		ПанелькаПроверитьМодель(ОбщиеНастройки);
	КонецЕсли;
	Возврат ПанелькаРазрешениеПерсональнойПанелиИзНастроек(ОбщиеНастройки);
КонецФункции

#КонецОбласти

#Область ПолитикаИсточниковПерсональныхПанелей

// Перечисляет категории метаданных. Технические ключи стабильны и не зависят от подписей.
//
// Возвращаемое значение:
//  Структура - технический ключ категории сопоставлен ее представлению:
//  * Справочники - Строка - представление категории Справочники.
//  * Документы - Строка - представление категории Документы.
//  * ЖурналыДокументов - Строка - представление категории Журналы документов.
//  * Отчеты - Строка - представление категории Отчеты.
//  * Обработки - Строка - представление категории Обработки.
//  * ПланыВидовХарактеристик - Строка - представление категории Планы видов характеристик.
//  * ПланыСчетов - Строка - представление категории Планы счетов.
//  * ПланыВидовРасчета - Строка - представление категории Планы видов расчета.
//  * ПланыОбмена - Строка - представление категории Планы обмена.
//  * РегистрыСведений - Строка - представление категории Регистры сведений.
//  * РегистрыНакопления - Строка - представление категории Регистры накопления.
//  * РегистрыБухгалтерии - Строка - представление категории Регистры бухгалтерии.
//  * РегистрыРасчета - Строка - представление категории Регистры расчета.
//  * БизнесПроцессы - Строка - представление категории Бизнес-процессы.
//  * Задачи - Строка - представление категории Задачи.
//  * ОбщиеФормы - Строка - представление категории Общие формы.
//  * Константы - Строка - представление категории Константы.
//  * ВнешниеИсточникиДанных - Строка - представление категории Внешние источники данных.
Функция ПанелькаКатегорииМетаданныхЛичныхПанелей() Экспорт
	Категории = Новый Структура;
	Категории.Вставить("Справочники", "Справочники");
	Категории.Вставить("Документы", "Документы");
	Категории.Вставить("ЖурналыДокументов", "Журналы документов");
	Категории.Вставить("Отчеты", "Отчеты");
	Категории.Вставить("Обработки", "Обработки");
	Категории.Вставить("ПланыВидовХарактеристик", "Планы видов характеристик");
	Категории.Вставить("ПланыСчетов", "Планы счетов");
	Категории.Вставить("ПланыВидовРасчета", "Планы видов расчета");
	Категории.Вставить("ПланыОбмена", "Планы обмена");
	Категории.Вставить("РегистрыСведений", "Регистры сведений");
	Категории.Вставить("РегистрыНакопления", "Регистры накопления");
	Категории.Вставить("РегистрыБухгалтерии", "Регистры бухгалтерии");
	Категории.Вставить("РегистрыРасчета", "Регистры расчета");
	Категории.Вставить("БизнесПроцессы", "Бизнес-процессы");
	Категории.Вставить("Задачи", "Задачи");
	Категории.Вставить("ОбщиеФормы", "Общие формы");
	Категории.Вставить("Константы", "Константы");
	Категории.Вставить("ВнешниеИсточникиДанных", "Внешние источники данных");
	Возврат Категории;
КонецФункции

// Создает разрешающую политику всех поддерживаемых источников.
//
// Возвращаемое значение:
//  Структура - разрешения поддерживаемых источников; все значения Истина:
//  * Справочники - Булево - источник разрешен.
//  * Документы - Булево - источник разрешен.
//  * ЖурналыДокументов - Булево - источник разрешен.
//  * Отчеты - Булево - источник разрешен.
//  * Обработки - Булево - источник разрешен.
//  * ПланыВидовХарактеристик - Булево - источник разрешен.
//  * ПланыСчетов - Булево - источник разрешен.
//  * ПланыВидовРасчета - Булево - источник разрешен.
//  * ПланыОбмена - Булево - источник разрешен.
//  * РегистрыСведений - Булево - источник разрешен.
//  * РегистрыНакопления - Булево - источник разрешен.
//  * РегистрыБухгалтерии - Булево - источник разрешен.
//  * РегистрыРасчета - Булево - источник разрешен.
//  * БизнесПроцессы - Булево - источник разрешен.
//  * Задачи - Булево - источник разрешен.
//  * ОбщиеФормы - Булево - источник разрешен.
//  * Константы - Булево - источник разрешен.
//  * ВнешниеИсточникиДанных - Булево - источник разрешен.
//  * СтандартныеИнструменты - Булево - источник разрешен.
//  * ДополнительныеОбработки - Булево - источник разрешен.
//  * ВебСсылки - Булево - источник разрешен.
//  * ЛокальныеФайлы - Булево - источник разрешен.
Функция ПанелькаНоваяПолитикаИсточниковЛичныхПанелей() Экспорт
	Политика = Новый Структура;
	Политика.Вставить("Справочники", Истина);
	Политика.Вставить("Документы", Истина);
	Политика.Вставить("ЖурналыДокументов", Истина);
	Политика.Вставить("Отчеты", Истина);
	Политика.Вставить("Обработки", Истина);
	Политика.Вставить("ПланыВидовХарактеристик", Истина);
	Политика.Вставить("ПланыСчетов", Истина);
	Политика.Вставить("ПланыВидовРасчета", Истина);
	Политика.Вставить("ПланыОбмена", Истина);
	Политика.Вставить("РегистрыСведений", Истина);
	Политика.Вставить("РегистрыНакопления", Истина);
	Политика.Вставить("РегистрыБухгалтерии", Истина);
	Политика.Вставить("РегистрыРасчета", Истина);
	Политика.Вставить("БизнесПроцессы", Истина);
	Политика.Вставить("Задачи", Истина);
	Политика.Вставить("ОбщиеФормы", Истина);
	Политика.Вставить("Константы", Истина);
	Политика.Вставить("ВнешниеИсточникиДанных", Истина);
	Политика.Вставить("СтандартныеИнструменты", Истина);
	Политика.Вставить("ДополнительныеОбработки", Истина);
	Политика.Вставить("ВебСсылки", Истина);
	Политика.Вставить("ЛокальныеФайлы", Истина);
	Возврат Политика;
КонецФункции

// Проверяет политику из общих настроек; отсутствующие новые ключи сохраняют совместимость.
//
// Параметры:
//  Настройки - Структура, Неопределено - общие настройки; отсутствие новых ключей сохраняет совместимость.
//
// Возвращаемое значение:
//  См. ПанелькаНоваяПолитикаИсточниковЛичныхПанелей
Функция ПанелькаПолитикаИсточниковИзНастроек(Настройки) Экспорт
	Политика = ПанелькаНоваяПолитикаИсточниковЛичныхПанелей();
	Сохраненная = ПанелькаЗначение(Настройки, "ИсточникиПерсональныхПанелейПанелька");
	Если Сохраненная = Неопределено Тогда
		Возврат Политика;
	КонецЕсли;
	Если ТипЗнч(Сохраненная) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный формат разрешённых источников персональных панелей.'");
	КонецЕсли;
	Для Каждого Пара Из Политика Цикл
		Значение = ПанелькаЗначение(Сохраненная, Пара.Ключ);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Значение) <> Тип("Булево") Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Некорректное разрешение источника персональной панели: %1'"),
				Пара.Ключ);
		КонецЕсли;
		Политика[Пара.Ключ] = Значение;
	КонецЦикла;
	Возврат Политика;
КонецФункции

// Проверяет административное право и соответствующее исключение только в общей настройке.
//
// Возвращаемое значение:
//  Булево - разрешено исключение; права метаданных и RLS не повышаются.
Функция ПанелькаИгнорироватьОграниченияИсточниковАдминистратору() Экспорт
	Если Не ПанелькаАдминистраторДополнительныхИнструментов() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПанелькаНеПрименятьОграниченияКАдминистраторамИзНастроек(ПанелькаОбщиеНастройкиПолитикиИсточников());
КонецФункции

// Получает эффективную общую политику. Личная модель и импорт не участвуют в решении.
//
// Возвращаемое значение:
//  См. ПанелькаНоваяПолитикаИсточниковЛичныхПанелей
Функция ПанелькаТекущаяПолитикаИсточников() Экспорт
	Возврат ПанелькаКонтекстДоступаЛичнойПанели().Политика;
КонецФункции

// Читает общую политику один раз для пакета проверок. Контекст нельзя сохранять между серверными вызовами.
//
// Возвращаемое значение:
//  Структура - актуальный контекст одной операции:
//  * Настройки - Структура, Неопределено - общий снимок БСП, из которого получена политика.
//  * Политика - См. ПанелькаНоваяПолитикаИсточниковЛичныхПанелей
//  * ИгнорироватьОграничения - Булево - административное исключение включено общей настройкой.
//  * ДоступныеДополнительные - Неопределено, Соответствие из КлючИЗначение - лениво заполняемый индекс инструментов:
//  ** Ключ - Строка - каноническая пара справочника и идентификатора.
//  ** Значение - Булево - признак разрешения.
Функция ПанелькаКонтекстДоступаЛичнойПанели() Экспорт
	Настройки = ПанелькаОбщиеНастройкиПолитикиИсточников();
	Политика = ПанелькаПолитикаИсточниковИзНастроек(Настройки);
	ИгнорироватьОграничения = Ложь;
	Если ПанелькаАдминистраторДополнительныхИнструментов() Тогда
		Если ПанелькаНеПрименятьОграниченияКАдминистраторамИзНастроек(Настройки) Тогда
			ИгнорироватьОграничения = Истина;
		КонецЕсли;
	КонецЕсли;
	Если ИгнорироватьОграничения Тогда
		Политика = ПанелькаНоваяПолитикаИсточниковЛичныхПанелей();
	КонецЕсли;
	Возврат Новый Структура("Политика,ИгнорироватьОграничения,ДоступныеДополнительные,Настройки",
		Политика, ИгнорироватьОграничения, Неопределено, Настройки);
КонецФункции

// Определяет техническую категорию по имени класса метаданных.
//
// Параметры:
//  ИмяКласса - Строка - техническое имя класса метаданных в единственном числе.
//
// Возвращаемое значение:
//  Строка - технический ключ категории либо пустая строка.
Функция ПанелькаКлючКатегорииМетаданных(ИмяКласса) Экспорт
	Классы = Новый Структура;
	Классы.Вставить("Справочник", "Справочники");
	Классы.Вставить("Документ", "Документы");
	Классы.Вставить("ЖурналДокументов", "ЖурналыДокументов");
	Классы.Вставить("Отчет", "Отчеты");
	Классы.Вставить("Обработка", "Обработки");
	Классы.Вставить("ПланВидовХарактеристик", "ПланыВидовХарактеристик");
	Классы.Вставить("ПланСчетов", "ПланыСчетов");
	Классы.Вставить("ПланВидовРасчета", "ПланыВидовРасчета");
	Классы.Вставить("ПланОбмена", "ПланыОбмена");
	Классы.Вставить("РегистрСведений", "РегистрыСведений");
	Классы.Вставить("РегистрНакопления", "РегистрыНакопления");
	Классы.Вставить("РегистрБухгалтерии", "РегистрыБухгалтерии");
	Классы.Вставить("РегистрРасчета", "РегистрыРасчета");
	Классы.Вставить("БизнесПроцесс", "БизнесПроцессы");
	Классы.Вставить("Задача", "Задачи");
	Классы.Вставить("ОбщаяФорма", "ОбщиеФормы");
	Классы.Вставить("Константа", "Константы");
	Классы.Вставить("ВнешнийИсточникДанных", "ВнешниеИсточникиДанных");
	Возврат ПанелькаЗначение(Классы, ИмяКласса, "");
КонецФункции

// Определяет категорию по самому адресу. Метка источника не позволяет замаскировать объект.
//
// Параметры:
//  Адрес - Строка - адрес ссылки; источник определяется также по содержимому адреса.
//  Источник - Строка - технический ключ источника objects, extra, web или files.
//
// Возвращаемое значение:
//  Строка - технический ключ категории по самому адресу; пустая строка означает неизвестный источник.
Функция ПанелькаКатегорияЛичнойСсылки(Знач Адрес, Источник = "") Экспорт
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Адрес = СокрЛП(Адрес);
	Нижний = НРег(Адрес);
	Если Лев(Нижний, 9) = "web_link:" Тогда
		Возврат ПанелькаКатегорияЛичнойСсылки(Сред(Адрес, 10), "web");
	КонецЕсли;
	Если Лев(Нижний, 9) = "ext_file:" Тогда
		Возврат "ЛокальныеФайлы";
	КонецЕсли;
	Если Лев(Нижний, 8) = "sys_cmd:" Или Лев(Нижний, 8) = "v8res://" Тогда
		Возврат "СтандартныеИнструменты";
	КонецЕсли;
	Если Лев(Нижний, 6) = "e1cib/" Тогда
		Части = СтрРазделить(СтрРазделить(Адрес, "?")[0], "/");
		Если Части.Количество() < 3 Тогда
			Возврат "";
		КонецЕсли;
		ИмяМД = Части[2];
		// Дополнительные инструменты — самостоятельный источник, не категория справочников.
		ИмяОбъекта = СтрРазделить(ИмяМД, ".");
		Если ИмяОбъекта.Количество() >= 2 Тогда
			Если ИмяОбъекта[0] = "Справочник" И (НРег(ИмяОбъекта[1]) = НРег("ДополнительныеОтчетыИОбработки")
				Или НРег(ИмяОбъекта[1]) = НРег("ВнешниеОбработки")) Тогда
				Возврат "ДополнительныеОбработки";
			КонецЕсли;
		КонецЕсли;
		Возврат ПанелькаКлючКатегорииМетаданных(СтрРазделить(ИмяМД, ".")[0]);
	КонецЕсли;
	Если Лев(Нижний, 7) = "http://" Или Лев(Нижний, 8) = "https://"
		Или Лев(Нижний, 6) = "ftp://" Или Лев(Нижний, 7) = "mailto:" Тогда
		Возврат "ВебСсылки";
	КонецЕсли;
	Если Лев(Нижний, 5) = "file:" Или Лев(Адрес, 1) = "/" Или Лев(Адрес, 1) = "\"
		Или Сред(Адрес, 2, 1) = ":" Тогда
		Возврат "ЛокальныеФайлы";
	КонецЕсли;
	Если Источник = "files" Тогда
		Возврат "ЛокальныеФайлы";
	КонецЕсли;
	Возврат "";
КонецФункции

// Проверяет разрешения источника, включая обе категории адреса с веб-оберткой.
//
// Параметры:
//  Адрес - Строка - адрес ссылки; источник определяется также по содержимому адреса.
//  Источник - Строка - технический ключ источника objects, extra, web или files.
//  Политика - Структура, Неопределено - эффективные булевы разрешения категорий из общей настройки.
//
// Возвращаемое значение:
//  Булево - все категории адреса разрешены политикой.
Функция ПанелькаИсточникРазрешенЛично(Адрес, Источник = "", Политика = Неопределено) Экспорт
	Если Политика = Неопределено Тогда
		Политика = ПанелькаТекущаяПолитикаИсточников();
	КонецЕсли;
	Категория = ПанелькаКатегорияЛичнойСсылки(Адрес, Источник);
	Если ПустаяСтрока(Категория) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Политика[Категория] <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Источник = "extra" И Не Политика.ДополнительныеОбработки Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Источник = "web" И Не Политика.ВебСсылки Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Источник = "files" И Не Политика.ЛокальныеФайлы Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Отклоняет новые запрещенные ссылки до замены модели. Прежние скрытые строки допустимы без изменений.
//
// Параметры:
//  Модель - Структура - текущая модель с таблицами страниц, колонок, каталога и размещений.
//  Прежняя - Структура, Неопределено - предыдущая сохраненная модель для проверки неизмененных скрытых строк.
//  Контекст - Структура, Неопределено - контекст ПанелькаКонтекстДоступаЛичнойПанели одной серверной операции.
Процедура ПанелькаПроверитьИсточникиЛичнойМодели(Модель, Прежняя = Неопределено, Контекст = Неопределено) Экспорт
	Если Контекст = Неопределено Тогда
		Контекст = ПанелькаКонтекстДоступаЛичнойПанели();
	КонецЕсли;
	Политика = Контекст.Политика;
	ДоступныеДополнительные = Неопределено;
	Для Каждого Ссылка Из Модель.КаталогСсылок Цикл
		Разрешена = ПанелькаИсточникРазрешенЛично(Ссылка.Ссылка, Ссылка.Источник, Политика);
		Если Разрешена И ПанелькаЭтоДополнительнаяСсылка(Ссылка.Ссылка, Ссылка.Источник) Тогда
			Разрешена = ПанелькаДополнительнаяСсылкаДоступна(Ссылка.Ссылка, ДоступныеДополнительные, Истина, Контекст);
		КонецЕсли;
		Если Разрешена Тогда
			Продолжить;
		КонецЕсли;
		Старая = Неопределено;
		Если Прежняя <> Неопределено Тогда
			Старая = Прежняя.КаталогСсылок.Найти(Ссылка.ИД, "ИД");
		КонецЕсли;
		Если Старая <> Неопределено Тогда
			Если Старая.Ссылка = Ссылка.Ссылка И Старая.Источник = Ссылка.Источник Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Источник ссылки «%1» недоступен пользователю или запрещён администратором. Изменения не применены.'"), Ссылка.Наименование);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область РазборИПредставлениеНавигационныхСсылок

// Преобразует техническое имя метаданных в читаемую подпись без обращения к данным.
//
// Параметры:
//  Текст - Строка - техническое имя.
//
// Возвращаемое значение:
//  Строка - имя с пробелами между словами.
Функция ПанелькаРазбитьКэмелКейс(Знач Текст) Экспорт
	Части = Новый Массив;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Симв = Сред(Текст, Индекс, 1);
		Если Индекс > 1 Тогда
			ПредСимв = Сред(Текст, Индекс - 1, 1);
			Если Симв = Врег(Симв) И Симв <> Нрег(Симв) И ПредСимв = Нрег(ПредСимв) И ПредСимв <> Врег(ПредСимв) Тогда
				Части.Добавить(" ");
			КонецЕсли;
		КонецЕсли;
		Части.Добавить(Симв);
	КонецЦикла;
	Возврат СтрСоединить(Части, "");
КонецФункции

// Возвращает подпись навигационной ссылки для источников редактора.
//
// Параметры:
//  СсылкаТекст - Строка - навигационная ссылка списка, формы или объекта данных.
//
// Возвращаемое значение:
//  Строка - представление объекта либо техническое имя с пробелами; исходный адрес, если имя не извлечено.
Функция ПанелькаИмяНавигационнойСсылки(Знач СсылкаТекст) Экспорт
	РезервноеИмя = ПанелькаРезервноеИмяНавигационнойСсылки(СсылкаТекст);
	Если СтрНайти(СсылкаТекст, ".") = 0 Тогда
		Возврат РезервноеИмя;
	КонецЕсли;
	ПозицияДата = СтрНайти(СсылкаТекст, "e1cib/data/");
	Если ПозицияДата = 0 Тогда
		Возврат РезервноеИмя;
	КонецЕсли;
	Возврат ПанелькаПредставлениеОбъектаДанных(СсылкаТекст, ПозицияДата, Истина);
КонецФункции

// Получает представления уникальных объектов одним запросом на тип метаданных.
//
// Параметры:
//  СсылкиОбъектов - Массив из Строка - исходные навигационные ссылки.
//  ИспользоватьИмяМетаданных - Булево - запасное читаемое имя редактора и регистрация ошибок;
//   Ложь сохраняет контракт формы выбора: исходный адрес при отказе чтения отдельного типа.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - представление или запасная подпись для каждого адреса:
//  * Ключ - Строка - исходная навигационная ссылка.
//  * Значение - Строка - представление либо подпись, не требующая дополнительного запроса.
Функция ПанелькаПредставленияНавигационныхСсылок(СсылкиОбъектов, ИспользоватьИмяМетаданных = Ложь) Экспорт
	Результат = Новый Соответствие;
	ДанныеСсылок = Новый Соответствие;
	СсылкиПоТипам = Новый Соответствие;
	Для Каждого СсылкаТекст Из СсылкиОбъектов Цикл
		Если Результат[СсылкаТекст] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(СсылкаТекст, СсылкаТекст);
		Если ИспользоватьИмяМетаданных Тогда
			Если СтрНайти(СсылкаТекст, "e1cib/data/") = 0 Тогда
				Результат.Вставить(СсылкаТекст, ПанелькаРезервноеИмяНавигационнойСсылки(СсылкаТекст));
				Продолжить;
			КонецЕсли;
			ОписаниеСсылки = ПанелькаРазобратьНавигационнуюСсылкуДанных(СсылкаТекст);
			Если ОписаниеСсылки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(СсылкаТекст, ПанелькаРазбитьКэмелКейс(ОписаниеСсылки.ИмяОбъекта));
			Менеджер = ПанелькаМенеджерОбъектаНавигационнойСсылки(ОписаниеСсылки.Класс,
				ОписаниеСсылки.ИмяОбъекта, Ложь, Истина);
			Если Менеджер = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				УИД = Новый УникальныйИдентификатор(ОписаниеСсылки.Идентификатор);
				СсылкаНаОбъект = Менеджер.ПолучитьСсылку(УИД);
				ДанныеСсылки = Новый Структура("Таблица,Ссылка", СсылкаНаОбъект.Метаданные().ПолноеИмя(), СсылкаНаОбъект);
			Исключение
				ПанелькаЗарегистрироватьОшибку("ПолучениеПредставленияСсылки", ИнформацияОбОшибке());
				Продолжить;
			КонецПопытки;
		Иначе
			ДанныеСсылки = ПанелькаОбъектДанныхДляПредставления(СсылкаТекст);
			Если ДанныеСсылки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ДанныеСсылок.Вставить(СсылкаТекст, ДанныеСсылки.Ссылка);
		СсылкиТипа = СсылкиПоТипам[ДанныеСсылки.Таблица];
		Если СсылкиТипа = Неопределено Тогда
			СсылкиТипа = Новый Соответствие;
			СсылкиПоТипам.Вставить(ДанныеСсылки.Таблица, СсылкиТипа);
		КонецЕсли;
		СсылкиТипа.Вставить(ДанныеСсылки.Ссылка, Истина);
	КонецЦикла;
	ПредставленияПоСсылкам = Новый Соответствие;
	Для Каждого ТипИСсылки Из СсылкиПоТипам Цикл
		МассивСсылок = Новый Массив;
		Для Каждого СсылкаТипа Из ТипИСсылки.Значение Цикл
			МассивСсылок.Добавить(СсылкаТипа.Ключ);
		КонецЦикла;
		Попытка
			Запрос = Новый Запрос;
			// Имя таблицы — из метаданных типизированной ссылки; значения передаются параметром.
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Объект.Ссылка КАК Ссылка,
				|ПРЕДСТАВЛЕНИЕ(Объект.Ссылка) КАК Представление
				|ИЗ " + ТипИСсылки.Ключ + " КАК Объект
				|ГДЕ Объект.Ссылка В (&Ссылки)";
			Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Представление) Тогда
					ПредставленияПоСсылкам.Вставить(Выборка.Ссылка, Выборка.Представление);
				КонецЕсли;
			КонецЦикла;
		Исключение
			Если ИспользоватьИмяМетаданных Тогда
				ПанелькаЗарегистрироватьОшибку("ПолучениеПредставленияСсылки", ИнформацияОбОшибке());
			КонецЕсли;
			// Отказ одного типа не затрагивает остальные; поштучных повторов нет.
		КонецПопытки;
	КонецЦикла;
	Для Каждого СсылкаИДанные Из ДанныеСсылок Цикл
		ПредставлениеОбъекта = ПредставленияПоСсылкам[СсылкаИДанные.Значение];
		Если ПредставлениеОбъекта <> Неопределено Тогда
			Результат.Вставить(СсылкаИДанные.Ключ, ПредставлениеОбъекта);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Получает представление конкретного объекта под правами текущего пользователя.
// Ошибки менеджера и запроса регистрируются; запасная подпись определяется вызывающим сценарием.
//
// Параметры:
//  СсылкаТекст - Строка - навигационная ссылка объекта данных.
//  ПозицияДанных - Число - начало фрагмента e1cib/data/ в адресе.
//  ИспользоватьИмяМетаданных - Булево - вернуть читаемое имя вместо пустой строки при недоступности объекта.
//
// Возвращаемое значение:
//  Строка - представление или выбранная запасная подпись.
Функция ПанелькаПредставлениеОбъектаДанных(Знач СсылкаТекст, Знач ПозицияДанных,
	ИспользоватьИмяМетаданных = Ложь) Экспорт
	ОписаниеСсылки = ПанелькаРазобратьНавигационнуюСсылкуДанных(СсылкаТекст, ПозицияДанных);
	Если ОписаниеСсылки = Неопределено Тогда
		Возврат ?(ИспользоватьИмяМетаданных, СсылкаТекст, "");
	КонецЕсли;
	ЗапаснаяПодпись = ?(ИспользоватьИмяМетаданных, ПанелькаРазбитьКэмелКейс(ОписаниеСсылки.ИмяОбъекта), "");
	Менеджер = ПанелькаМенеджерОбъектаНавигационнойСсылки(ОписаниеСсылки.Класс, ОписаниеСсылки.ИмяОбъекта,
		Ложь, Истина);
	Если Менеджер = Неопределено Тогда
		Возврат ЗапаснаяПодпись;
	КонецЕсли;
	Попытка
		УИД = Новый УникальныйИдентификатор(ОписаниеСсылки.Идентификатор);
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПРЕДСТАВЛЕНИЕ(Ссылка) КАК Представление
			|ИЗ " + ОписаниеСсылки.ТипМетаданных + " КАК Объект
			|ГДЕ Объект.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Менеджер.ПолучитьСсылку(УИД));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Представление) Тогда
			Возврат Выборка.Представление;
		КонецЕсли;
	Исключение
		ПанелькаЗарегистрироватьОшибку("ПолучениеПредставленияСсылки", ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ЗапаснаяПодпись;
КонецФункции

// Разбирает объект данных без запроса представления; используется пакетным чтением источников.
//
// Параметры:
//  СсылкаТекст - Строка - навигационная ссылка объекта данных.
//
// Возвращаемое значение:
//  Неопределено, Структура - описание корректной типизированной ссылки:
//   * Таблица - Строка - полное имя метаданных созданной ссылки.
//   * Ссылка - ЛюбаяСсылка, ПланСчетовСсылка - типизированная ссылка для параметра запроса.
Функция ПанелькаОбъектДанныхДляПредставления(Знач СсылкаТекст) Экспорт
	Попытка
		ОписаниеСсылки = ПанелькаРазобратьНавигационнуюСсылкуДанных(СсылкаТекст);
		Если ОписаниеСсылки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Менеджер = ПанелькаМенеджерОбъектаНавигационнойСсылки(ОписаниеСсылки.Класс, ОписаниеСсылки.ИмяОбъекта,
			Истина, Ложь);
		Если Менеджер = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		УИД = Новый УникальныйИдентификатор(ОписаниеСсылки.Идентификатор);
		СсылкаНаОбъект = Менеджер.ПолучитьСсылку(УИД);
		Возврат Новый Структура("Таблица,Ссылка", СсылкаНаОбъект.Метаданные().ПолноеИмя(), СсылкаНаОбъект);
	Исключение
		// Ошибка адреса, отсутствующий менеджер или недоступный тип не прерывают пакет избранного.
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ПланИзмененияПорядкаРедактора

// Рассчитывает перестановку соседних страниц, колонок или размещений без изменения таблиц формы.
// Системные элементы и чужие родительские группы исключаются. Повторяющиеся порядки нормализуются
// только при существующем соседнем элементе, как при непосредственном перемещении в редакторе.
//
// Параметры:
//  Вид - Строка - page, column или link.
//  Таблица - ТаблицаЗначений, ДанныеФормыКоллекция - элементы соответствующего вида.
//  ИдентификаторЭлемента - Строка - идентификатор перемещаемой строки.
//  Направление - Строка - prev перемещает назад, остальные значения вперёд.
//  ТипыСсылок - Неопределено, Соответствие из КлючИЗначение - классификация ссылок для группировки:
//  * Ключ - Строка - идентификатор ссылки.
//  * Значение - Строка - тип ссылки; Неопределено вместо соответствия отключает группировку.
//
// Возвращаемое значение:
//  Неопределено, Соответствие из КлючИЗначение - новые порядки; Неопределено при отсутствии перемещения:
//  * Ключ - Строка - идентификатор изменяемой строки.
//  * Значение - Число - новый порядок строки.
Функция ПанелькаПланПеремещенияЭлемента(Вид, Таблица, ИдентификаторЭлемента, Направление,
	ТипыСсылок = Неопределено) Экспорт
	ИндексСтрок = Новый Соответствие;
	СтрокаЭлемента = Неопределено;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ИндексСтрок.Вставить(СтрокаТаблицы.ИД, СтрокаТаблицы);
		Если СтрокаТаблицы.ИД = ИдентификаторЭлемента И СтрокаЭлемента = Неопределено Тогда
			СтрокаЭлемента = СтрокаТаблицы;
		КонецЕсли;
	КонецЦикла;
	СистемныеИД = СтрРазделить("page-main,page-standard,page-unassigned,column-standard,column-unassigned", ",");
	Если СтрокаЭлемента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Вид <> "link" И СистемныеИД.Найти(ИдентификаторЭлемента) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Соседи = Новый ТаблицаЗначений;
	Соседи.Колонки.Добавить("ИД");
	Соседи.Колонки.Добавить("Порядок");
	Для Каждого Другая Из Таблица Цикл
		Если Вид = "page" И СистемныеИД.Найти(Другая.ИД) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Вид = "column" И (Другая.ИДСтраницы <> СтрокаЭлемента.ИДСтраницы
			Или СистемныеИД.Найти(Другая.ИД) <> Неопределено) Тогда
			Продолжить;
		КонецЕсли;
		Если Вид = "link" И Другая.ИДКолонки <> СтрокаЭлемента.ИДКолонки Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Соседи.Добавить(), Другая, "ИД,Порядок");
	КонецЦикла;
	Соседи.Сортировать("Порядок, ИД");
	Кандидаты = Новый Массив;
	ПредыдущийПорядок = Неопределено;
	ЕстьПовторы = Ложь;
	Для Каждого Сосед Из Соседи Цикл
		Если ПредыдущийПорядок = Сосед.Порядок Тогда
			ЕстьПовторы = Истина;
		КонецЕсли;
		ПредыдущийПорядок = Сосед.Порядок;
		Другая = ИндексСтрок[Сосед.ИД];
		Если Вид = "link" И ТипыСсылок <> Неопределено Тогда
			Если ТипыСсылок[СтрокаЭлемента.ИДСсылки] <> ТипыСсылок[Другая.ИДСсылки] Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Кандидаты.Добавить(Другая.ИД);
	КонецЦикла;
	Индекс = Кандидаты.Найти(ИдентификаторЭлемента);
	Если Индекс = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СоседнийИндекс = Индекс + ?(Направление = "prev", -1, 1);
	Если СоседнийИндекс < 0 Или СоседнийИндекс >= Кандидаты.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Порядки = Новый Соответствие;
	Если ЕстьПовторы Тогда
		Номер = 0;
		Для Каждого Сосед Из Соседи Цикл
			Номер = Номер + 10;
			Порядки.Вставить(Сосед.ИД, Номер);
		КонецЦикла;
	Иначе
		Порядки.Вставить(СтрокаЭлемента.ИД, СтрокаЭлемента.Порядок);
		Другая = ИндексСтрок[Кандидаты[СоседнийИндекс]];
		Порядки.Вставить(Другая.ИД, Другая.Порядок);
	КонецЕсли;
	ДругойИД = Кандидаты[СоседнийИндекс];
	Порядок = Порядки[СтрокаЭлемента.ИД];
	Порядки.Вставить(СтрокаЭлемента.ИД, Порядки[ДругойИД]);
	Порядки.Вставить(ДругойИД, Порядок);
	Возврат Порядки;
КонецФункции

#КонецОбласти


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СистемныеИнструменты

// Ошибка одной записи не прекращает чтение следующих инструментов.
Процедура ПанелькаПрочитатьКаталогСистемныхФункций(Чтение, Результат)
	Путь = "";
	НомерСтроки = 0;
	Текст = Чтение.ПрочитатьСтроку();
	Пока Текст <> Неопределено Цикл
		НомерСтроки = НомерСтроки + 1;
		ТекстНРег = НРег(Текст);
		НовыйПуть = ПанелькаПутьСистемнойОбработки(Текст);
		Если СтрНайти(ТекстНРег, "v8res://mngbase/") > 0 Тогда
			Если Не ПустаяСтрока(Путь) Или ПустаяСтрока(НовыйПуть) Тогда
				Результат.НеполныйСписок = Истина;
				Попытка
					ВызватьИсключение НСтр("ru = 'Незавершенная запись или некорректный адрес системного инструмента.'");
				Исключение
					ПанелькаЗарегистрироватьОшибку("РазборСистемнойФункции", ИнформацияОбОшибке(), Строка(НомерСтроки));
				КонецПопытки;
			КонецЕсли;
			// Новый ресурс начинает новую запись, в том числе при поврежденном адресе.
			Путь = НовыйПуть;
		КонецЕсли;
		Если Не ПустаяСтрока(Путь) И СтрНайти(ТекстНРег, "substring.name") > 0
			И СтрНайти(ТекстНРег, "nstr") > 0 Тогда
			Попытка
				Имя = ПанелькаИмяСистемнойФункции(Текст);
				Если ПустаяСтрока(Имя) Тогда
					ВызватьИсключение НСтр("ru = 'Не найдено название системного инструмента.'");
				КонецЕсли;
				Результат.Инструменты.Добавить(Новый Структура("Наименование,Ссылка", Имя, "sys_cmd:" + Путь));
			Исключение
				Результат.НеполныйСписок = Истина;
				ПанелькаЗарегистрироватьОшибку("РазборСистемнойФункции", ИнформацияОбОшибке(), Строка(НомерСтроки));
			КонецПопытки;
			Путь = "";
		КонецЕсли;
		Текст = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Если Не ПустаяСтрока(Путь) Тогда
		ВызватьИсключение НСтр("ru = 'Каталог системных инструментов содержит незавершенную запись.'");
	КонецЕсли;
КонецПроцедуры

Функция ПанелькаПутьСистемнойОбработки(Текст)
	Начало = СтрНайти(НРег(Текст), "v8res://mngbase/");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Текст, Начало);
	Конец = СтрНайти(НРег(Остаток), ".epf");
	Если Конец = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Остаток, Конец + 3);
КонецФункции

// В LF кавычки BSL-литералов удвоены внешней сериализацией.
// Сначала снимается один слой, затем читается строковый литерал NStr.
Функция ПанелькаИмяСистемнойФункции(Текст)
	СтрокаBSL = СтрЗаменить(Текст, """""", """");
	Начало = СтрНайти(НРег(СтрокаBSL), "nstr");
	Остаток = СокрЛП(Сред(СтрокаBSL, Начало + 4));
	Если Начало = 0 Или Лев(Остаток, 1) <> "(" Тогда
		ВызватьИсключение НСтр("ru = 'Некорректная запись названия системного инструмента.'");
	КонецЕсли;
	Литерал = ПанелькаПрочитатьЛитералКаталога(Сред(Остаток, 2), """");
	Если Литерал = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не завершена строка названия системного инструмента.'");
	КонецЕсли;
	Язык = "";
	Остаток = СокрЛП(Литерал.Остаток);
	Если Лев(Остаток, 1) = "," Тогда
		КодЯзыка = ПанелькаПрочитатьЛитералКаталога(Сред(Остаток, 2), """");
		Если КодЯзыка = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Некорректный язык названия системного инструмента.'");
		КонецЕсли;
		Язык = НРег(КодЯзыка.Значение);
		Остаток = СокрЛП(КодЯзыка.Остаток);
	КонецЕсли;
	Если Лев(Остаток, 1) <> ")" Тогда
		ВызватьИсключение НСтр("ru = 'Не завершена запись названия системного инструмента.'");
	КонецЕсли;
	Возврат ПанелькаЛокализованноеИмяКаталога(Литерал.Значение, Язык);
КонецФункции

// Читает кавычки и удвоенные кавычки без Выполнить и динамической НСтр.
Функция ПанелькаПрочитатьЛитералКаталога(Текст, Кавычка)
	Текст = СокрЛП(Текст);
	Если Лев(Текст, 1) <> Кавычка Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = "";
	Позиция = 2;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = Кавычка Тогда
			Если Сред(Текст, Позиция + 1, 1) = Кавычка Тогда
				Значение = Значение + Кавычка;
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			Возврат Новый Структура("Значение,Остаток", Значение, Сред(Текст, Позиция + 1));
		КонецЕсли;
		Значение = Значение + Символ;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПанелькаЛокализованноеИмяКаталога(Текст, Язык)
	ЗапасноеИмя = "";
	Остаток = СокрЛП(Текст);
	Пока Не ПустаяСтрока(Остаток) Цикл
		Равно = СтрНайти(Остаток, "=");
		Если Равно = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Некорректная локализация системного инструмента.'");
		КонецЕсли;
		КодЯзыка = НРег(СокрЛП(Лев(Остаток, Равно - 1)));
		Литерал = ПанелькаПрочитатьЛитералКаталога(Сред(Остаток, Равно + 1), "'");
		Если Литерал = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Не завершена локализация системного инструмента.'");
		КонецЕсли;
		Если КодЯзыка <> "sys" Тогда
			Если КодЯзыка = Язык Тогда
				Возврат Литерал.Значение;
			КонецЕсли;
			Если ПустаяСтрока(ЗапасноеИмя) Тогда
				ЗапасноеИмя = Литерал.Значение;
			КонецЕсли;
		КонецЕсли;
		Остаток = СокрЛП(Литерал.Остаток);
		Если Не ПустаяСтрока(Остаток) Тогда
			Если Лев(Остаток, 1) <> ";" Тогда
				ВызватьИсключение НСтр("ru = 'Некорректный разделитель локализации системного инструмента.'");
			КонецЕсли;
			Остаток = СокрЛП(Сред(Остаток, 2));
		КонецЕсли;
	КонецЦикла;
	Возврат ЗапасноеИмя;
КонецФункции

#КонецОбласти

#Область ДоступКДополнительнымИнструментам

Функция ПанелькаВыборкаДополнительныхИнструментов(МетаданныеСправочника, Администратор)
	ПолеВида = "";
	Для Каждого Имя Из СтрРазделить("Вид,ТипОбработки", ",") Цикл
		Если МетаданныеСправочника.Реквизиты.Найти(Имя) <> Неопределено Тогда
			ПолеВида = "Доп." + Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ПолеВида) Тогда
		ПолеВида = """""";
	КонецЕсли;
	ПолеОписания = """""";
	ИмяПоляОписания = ?(МетаданныеСправочника.Имя = "ВнешниеОбработки", "Описание", "Информация");
	Если МетаданныеСправочника.Реквизиты.Найти(ИмяПоляОписания) <> Неопределено Тогда
		ПолеОписания = "Доп." + ИмяПоляОписания;
	КонецЕсли;
	ПолеПапки = ?(МетаданныеСправочника.Иерархический, "ПРЕДСТАВЛЕНИЕ(Доп.Родитель)", """""");
	ПолеПубликации = ?(МетаданныеСправочника.Реквизиты.Найти("Публикация") = Неопределено, """""", "Доп.Публикация");
	// Имена полей выбраны выше по метаданным; пользовательские значения передаются параметрами.
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|   Доп.Ссылка КАК Ссылка,
	|   Доп.Наименование КАК Наименование,
	|   &ПолеВида КАК Вид,
	|   &ПолеОписания КАК Описание,
	|   &ПолеПапки КАК Папка,
	|   &ПолеПубликации КАК Публикация
	|ИЗ
	|   Справочник.&ИмяСправочника КАК Доп
	|ГДЕ
	|   НЕ Доп.ПометкаУдаления";
	Текст = СтрЗаменить(Текст, "&ПолеВида", ПолеВида);
	Текст = СтрЗаменить(Текст, "&ПолеОписания", ПолеОписания);
	Текст = СтрЗаменить(Текст, "&ПолеПапки", ПолеПапки);
	Текст = СтрЗаменить(Текст, "&ПолеПубликации", ПолеПубликации);
	Текст = СтрЗаменить(Текст, "&ИмяСправочника", МетаданныеСправочника.Имя);
	Если МетаданныеСправочника.Иерархический Тогда
		Текст = Текст + " И НЕ Доп.ЭтоГруппа";
	КонецЕсли;
	Запрос = Новый Запрос;
	Если Не Администратор Тогда
		Если МетаданныеСправочника.Имя = "ВнешниеОбработки" Тогда
			Текст = Текст + ПанелькаУсловиеДоступаWMS(МетаданныеСправочника, Запрос);
		Иначе
			Текст = Текст + ПанелькаУсловиеДоступаБСП(МетаданныеСправочника, Запрос);
		КонецЕсли;
	КонецЕсли;
	Запрос.Текст = Текст + " УПОРЯДОЧИТЬ ПО Наименование";
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

Функция ПанелькаКонтекстДоступаWMS()
	ИмяМодуля = "";
	Если Метаданные.ОбщиеМодули.Найти("ПользователиЕАП") <> Неопределено Тогда
		ИмяМодуля = "ПользователиЕАП";
	ИначеЕсли Метаданные.ОбщиеМодули.Найти("Пользователи") <> Неопределено Тогда
		ИмяМодуля = "Пользователи";
	КонецЕсли;
	Если ПустаяСтрока(ИмяМодуля) Тогда
		ВызватьИсключение НСтр("ru = 'Не найден модуль определения пользователя WMS.'");
	КонецЕсли;
	МодульПользователей = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	Пользователь = МодульПользователей.ТекущийПользовательСсылка();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Не определён текущий пользователь WMS.'");
	КонецЕсли;
	Роли = МодульПользователей.РолиТекущегоПользователя();
	Если ТипЗнч(Роли) = Тип("СписокЗначений") Тогда
		Роли = Роли.ВыгрузитьЗначения();
	КонецЕсли;
	Если ТипЗнч(Роли) <> Тип("Массив") И ТипЗнч(Роли) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось определить роли текущего пользователя WMS.'");
	КонецЕсли;
	Сотрудник = Неопределено;
	Если Метаданные.ПараметрыСеанса.Найти("ТекСотрудник") <> Неопределено Тогда
		Сотрудник = ПараметрыСеанса["ТекСотрудник"];
	КонецЕсли;
	Возврат Новый Структура("Пользователь,Роли,Сотрудник", Пользователь, Роли, Сотрудник);
КонецФункции

// Панелька не является формой-владельцем WMS: применяем доступ субъекта,
// не переносим ограничения ОбъектыВладельцы/ФормаГруппыВнешниеКоманды из контекстного меню формы.
Функция ПанелькаУсловиеДоступаWMS(МетаданныеСправочника, Запрос)
	Доступ = МетаданныеСправочника.ТабличныеЧасти.Найти("Доступ");
	Если Доступ = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найдена таблица доступа инструментов WMS.'");
	КонецЕсли;
	Если Доступ.Реквизиты.Найти("СубъектДоступа") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найден субъект доступа инструментов WMS.'");
	КонецЕсли;
	Контекст = ПанелькаКонтекстДоступаWMS();
	Условие = "Доступ.СубъектДоступа = &ПанелькаТекущийПользователь";
	Запрос.УстановитьПараметр("ПанелькаТекущийПользователь", Контекст.Пользователь);
	Если ЗначениеЗаполнено(Контекст.Сотрудник) Тогда
		Условие = Условие + " ИЛИ Доступ.СубъектДоступа = &ПанелькаТекущийСотрудник";
		Запрос.УстановитьПараметр("ПанелькаТекущийСотрудник", Контекст.Сотрудник);
	КонецЕсли;
	Если Контекст.Роли.Количество() > 0 Тогда
		Условие = Условие + " ИЛИ Доступ.СубъектДоступа В (&ПанелькаРолиПользователя)";
		Запрос.УстановитьПараметр("ПанелькаРолиПользователя", Контекст.Роли);
	КонецЕсли;
	Возврат " И Доп.Ссылка В (ВЫБРАТЬ Доступ.Ссылка ИЗ Справочник.ВнешниеОбработки.Доступ КАК Доступ ГДЕ (" +
		Условие + "))";
КонецФункции

// Базовая схема БСП: опубликованные самостоятельные инструменты с нескрытыми командами.
// Вызовы общих модулей намеренно отсутствуют: в старых и частично перенесённых БСП
// наличие модуля не гарантирует наличие экспортного метода ДополнительныеКоманды.
// РАЗРЕШЕННЫЕ указывается только у внешнего SELECT; права текущего сеанса сохраняются.
// Регистр настройки
// быстрого доступа не является правом на запуск инструмента.
Функция ПанелькаУсловиеДоступаБСП(МетаданныеСправочника, Запрос)
	Если Метаданные.ФункциональныеОпции.Найти("ИспользоватьДополнительныеОтчетыИОбработки") <> Неопределено Тогда
		Используются = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительныеОтчетыИОбработки");
		Если ТипЗнч(Используются) <> Тип("Булево") Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось определить состояние функциональной опции дополнительных отчётов и обработок.'");
		КонецЕсли;
		Если Не Используются Тогда
			Возврат " И ЛОЖЬ";
		КонецЕсли;
	КонецЕсли;
	// Отдельные правила поставляемых инструментов в модели сервиса этим адаптером
	// не интерпретируются: обычный отбор по публикации их не заменяет.
	Если Метаданные.ФункциональныеОпции.Найти("СтандартныеПодсистемыВМоделиСервиса") <> Неопределено Тогда
		ВМоделиСервиса = ПолучитьФункциональнуюОпцию("СтандартныеПодсистемыВМоделиСервиса");
		Если ТипЗнч(ВМоделиСервиса) <> Тип("Булево") Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось определить режим модели сервиса для дополнительных инструментов.'");
		КонецЕсли;
		Если ВМоделиСервиса Тогда
			ВызватьИсключение НСтр("ru = 'Для дополнительных инструментов в модели сервиса требуется отдельный адаптер доступности.'");
		КонецЕсли;
	КонецЕсли;
	Если МетаданныеСправочника.Реквизиты.Найти("Публикация") = Неопределено Или МетаданныеСправочника.Реквизиты.Найти("Вид") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не поддерживается схема дополнительных инструментов: нужны реквизиты Публикация и Вид.'");
	КонецЕсли;
	Команды = МетаданныеСправочника.ТабличныеЧасти.Найти("Команды");
	Если Команды = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не поддерживается схема дополнительных инструментов: не найдена таблица Команды.'");
	КонецЕсли;
	Если Команды.Реквизиты.Найти("Скрыть") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не поддерживается схема дополнительных инструментов: не найден признак Команды.Скрыть.'");
	КонецЕсли;
	МДВида = Метаданные.Перечисления.Найти("ВидыДополнительныхОтчетовИОбработок");
	Если МДВида = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найден вид дополнительного инструмента БСП.'");
	КонецЕсли;
	Виды = Новый Массив;
	Для Каждого ИмяВида Из СтрРазделить("ДополнительнаяОбработка,ДополнительныйОтчет", ",") Цикл
		Если МДВида.ЗначенияПеречисления.Найти(ИмяВида) = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Не поддерживается вид дополнительного инструмента БСП.'");
		КонецЕсли;
		Виды.Добавить(Перечисления["ВидыДополнительныхОтчетовИОбработок"][ИмяВида]);
	КонецЦикла;
	МДПубликации = Метаданные.Перечисления.Найти("ВариантыПубликацииДополнительныхОтчетовИОбработок");
	Если МДПубликации = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найдено перечисление вариантов публикации дополнительных инструментов.'");
	КонецЕсли;
	Если МДПубликации.ЗначенияПеречисления.Найти("Используется") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не найден вариант публикации Используется для дополнительных инструментов.'");
	КонецЕсли;
	Запрос.УстановитьПараметр("ПанелькаВидыБСП", Виды);
	Запрос.УстановитьПараметр("ПанелькаПубликацияБСП",
		Перечисления["ВариантыПубликацииДополнительныхОтчетовИОбработок"]["Используется"]);
	Возврат " И Доп.Публикация = &ПанелькаПубликацияБСП И Доп.Вид В (&ПанелькаВидыБСП)"
		+ " И Доп.Ссылка В (ВЫБРАТЬ Команды.Ссылка"
		+ " ИЗ Справочник.ДополнительныеОтчетыИОбработки.Команды КАК Команды ГДЕ НЕ Команды.Скрыть)";
КонецФункции

#КонецОбласти

#Область МодельНастроекПанелька_v3

// Создает представление проверенной текущей модели, сохраняя нетабличные свойства расширений.
//
// Параметры:
//  Данные - См. ПанелькаПустаяМодель
//
// Возвращаемое значение:
//  См. ПанелькаНовоеПредставлениеМоделиДляДашборда
Функция ПанелькаПредставлениеМоделиДляДашборда(Данные)
	ПанелькаПроверитьМодель(Данные);
	ИндексСсылок = Новый Соответствие;
	ИндексКолонок = Новый Соответствие;
	ИндексСтраниц = Новый Соответствие;
	Для Каждого СтрокаКаталогаСсылок Из Данные.КаталогСсылок Цикл
		ИндексСсылок.Вставить(СтрокаКаталогаСсылок.ИД, СтрокаКаталогаСсылок);
	КонецЦикла;
	Для Каждого КолонкаПанели Из Данные.Колонки Цикл
		ИндексКолонок.Вставить(КолонкаПанели.ИД, КолонкаПанели);
	КонецЦикла;
	Для Каждого СтрСтраницы Из Данные.Страницы Цикл
		ИндексСтраниц.Вставить(СтрСтраницы.ИД, СтрСтраницы);
	КонецЦикла;
	ПараметрыПредставления = Новый Структура;
	Для Каждого Свойство Из Данные Цикл
		Если ТипЗнч(Свойство.Значение) <> Тип("ТаблицаЗначений") Тогда
			ПараметрыПредставления.Вставить(Свойство.Ключ, Свойство.Значение);
		КонецЕсли;
	КонецЦикла;
	Результат = ПанелькаНовоеПредставлениеМоделиДляДашборда(Данные, ПараметрыПредставления);
	Страницы = Результат.Страницы;
	Страницы.Сортировать("Порядок");
	Колонки = Результат.Колонки;
	Колонки.Сортировать("Порядок");
	Колонки.Колонки.Добавить("Страница", Новый ОписаниеТипов("Строка"));
	Колонки.Колонки.Добавить("ЗаголовокКолонки", Новый ОписаниеТипов("Строка"));
	Для Каждого КолонкаПанели Из Колонки Цикл
		КолонкаПанели.Страница = ИндексСтраниц[КолонкаПанели.ИДСтраницы].ИмяСтраницы;
		КолонкаПанели.ЗаголовокКолонки = КолонкаПанели.ИмяКолонки;
		КолонкаПанели.ИмяКолонки = КолонкаПанели.ИД;
	КонецЦикла;
	// Системные колонки строятся отрисовщиком автоматически.
	Для Каждого ИД Из СтрРазделить("column-unassigned,column-standard", ",") Цикл
		КолонкаПанели = Колонки.Найти(ИД, "ИД");
		Если КолонкаПанели <> Неопределено Тогда
			Колонки.Удалить(КолонкаПанели);
		КонецЕсли;
	КонецЦикла;
	Если Не Данные.НеРаспределенныеНаОтдельнойВкладке Тогда
		Страницы.Удалить(Страницы.Найти("page-unassigned", "ИД"));
	КонецЕсли;
	Если Не Данные.СтандартныеНаОтдельнойВкладке Тогда
		Страницы.Удалить(Страницы.Найти("page-standard", "ИД"));
	КонецЕсли;
	УчтенныеСтандартные = Новый Соответствие;
	Для Каждого РазмещениеСсылки Из Данные.Размещения Цикл
		СтрокаКаталогаСсылок = ИндексСсылок[РазмещениеСсылки.ИДСсылки];
		КолонкаПанели = ИндексКолонок[РазмещениеСсылки.ИДКолонки];
		Если Данные.СтандартныеНаОтдельнойВкладке И СтрокаКаталогаСсылок.Источник = "objects" И Лев(СтрокаКаталогаСсылок.Ссылка, 8) = "sys_cmd:" Тогда
			Если УчтенныеСтандартные[СтрокаКаталогаСсылок.ИД] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УчтенныеСтандартные.Вставить(СтрокаКаталогаСсылок.ИД, Истина);
		КонецЕсли;
		Имя = ?(СтрокаКаталогаСсылок.Источник = "objects", "Ссылки", ?(СтрокаКаталогаСсылок.Источник = "files", "ВнешниеФайлы", ?(СтрокаКаталогаСсылок.Источник = "web",
			"ВебСсылки", "ДопОбработки")));
		Стр = Результат[Имя].Добавить();
		Стр.Ссылка = СтрокаКаталогаСсылок.Ссылка;
		Стр.Путь = СтрокаКаталогаСсылок.Ссылка;
		Свойства = ПанелькаСвойстваРазмещения(СтрокаКаталогаСсылок, РазмещениеСсылки);
		Стр.Наименование = Свойства.Наименование;
		Стр.Подсказка = Свойства.Подсказка;
		Стр.Колонка = ?(КолонкаПанели.ИД = "column-unassigned" Или КолонкаПанели.ИД = "column-standard", "", КолонкаПанели.ИД);
		Стр.Порядок = РазмещениеСсылки.Порядок;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Создает рабочие таблицы и обязательные свойства представления текущей модели.
// Нетабличные свойства переносятся из входной модели, включая дополнительные свойства расширений.
// Поля РазрешитьПерсональнуюПанельПанелька, НеПрименятьОграниченияИсточниковКАдминистраторамПанелька
// и ИсточникиПерсональныхПанелейПанелька сохраняются при наличии; личная модель не хранит общую политику.
// Порядок перенесенных свойств сохраняется перед таблицами представления.
//
// Параметры:
//  Данные - См. ПанелькаПустаяМодель
//  ПараметрыПредставления - Структура - новая структура нетабличных свойств входной модели.
//
// Возвращаемое значение:
//  Структура - представление текущей модели с обязательным каркасом и перенесенными свойствами:
//  * ВерсияСхемы - Число - версия формата 3.
//  * Группировать - Булево - группировать ссылки по типу объекта.
//  * НеРаспределенныеНаОтдельнойВкладке - Булево - отдельная вкладка нераспределенных ссылок.
//  * СтандартныеНаОтдельнойВкладке - Булево - отдельная вкладка стандартных инструментов.
//  * РежимОтображенияПодсказок - Строка - вариант отображения подсказки.
//  * ШрифтКолонки - Шрифт - оформление заголовка колонки.
//  * ЦветКолонки - Цвет - цвет заголовка колонки.
//  * ШрифтГруппировки - Шрифт - оформление группировки.
//  * ЦветГруппировки - Цвет - цвет группировки.
//  * Страницы - ТаблицаЗначений - рабочая копия страниц модели для отбора отображаемых вкладок.
//  * Колонки - ТаблицаЗначений - рабочая копия колонок модели для подготовки полей представления.
//  * Ссылки - См. ПанелькаНоваяТаблицаПредставленияДашборда
//  * ВнешниеФайлы - См. ПанелькаНоваяТаблицаПредставленияДашборда
//  * ВебСсылки - См. ПанелькаНоваяТаблицаПредставленияДашборда
//  * ДопОбработки - См. ПанелькаНоваяТаблицаПредставленияДашборда
Функция ПанелькаНовоеПредставлениеМоделиДляДашборда(Данные, ПараметрыПредставления)
	Результат = ПараметрыПредставления;
	Результат.Вставить("ВерсияСхемы", Данные.ВерсияСхемы);
	Результат.Вставить("Группировать", Данные.Группировать);
	Результат.Вставить("НеРаспределенныеНаОтдельнойВкладке", Данные.НеРаспределенныеНаОтдельнойВкладке);
	Результат.Вставить("СтандартныеНаОтдельнойВкладке", Данные.СтандартныеНаОтдельнойВкладке);
	Результат.Вставить("РежимОтображенияПодсказок", Данные.РежимОтображенияПодсказок);
	Результат.Вставить("ШрифтКолонки", Данные.ШрифтКолонки);
	Результат.Вставить("ЦветКолонки", Данные.ЦветКолонки);
	Результат.Вставить("ШрифтГруппировки", Данные.ШрифтГруппировки);
	Результат.Вставить("ЦветГруппировки", Данные.ЦветГруппировки);
	Результат.Вставить("Страницы", Данные.Страницы.Скопировать());
	Результат.Вставить("Колонки", Данные.Колонки.Скопировать());
	Результат.Вставить("Ссылки", ПанелькаНоваяТаблицаПредставленияДашборда());
	Результат.Вставить("ВнешниеФайлы", ПанелькаНоваяТаблицаПредставленияДашборда());
	Результат.Вставить("ВебСсылки", ПанелькаНоваяТаблицаПредставленияДашборда());
	Результат.Вставить("ДопОбработки", ПанелькаНоваяТаблицаПредставленияДашборда());
	Возврат Результат;
КонецФункции

// Создает таблицу размещений одного источника для представления дашборда.
//
// Возвращаемое значение:
//  ТаблицаЗначений - размещения источника:
//  * Ссылка - Строка - адрес ссылки.
//  * Путь - Строка - тот же адрес для файлового источника.
//  * Наименование - Строка - эффективное название.
//  * Подсказка - Строка - эффективная подсказка.
//  * Колонка - Строка - идентификатор пользовательской колонки либо пустая строка.
//  * Порядок - Число - порядок размещения.
Функция ПанелькаНоваяТаблицаПредставленияДашборда()
	ТаблицаИсточника = Новый ТаблицаЗначений;
	ТаблицаИсточника.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка"));
	ТаблицаИсточника.Колонки.Добавить("Путь", Новый ОписаниеТипов("Строка"));
	ТаблицаИсточника.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ТаблицаИсточника.Колонки.Добавить("Подсказка", Новый ОписаниеТипов("Строка"));
	ТаблицаИсточника.Колонки.Добавить("Колонка", Новый ОписаниеТипов("Строка"));
	ТаблицаИсточника.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Возврат ТаблицаИсточника;
КонецФункции





#КонецОбласти

#Область ПерсональнаяПанель

// Проверяет право и ревизию перед записью текущего профиля.
//
// Возвращаемое значение:
//  Структура - независимая структура текущего профиля.
Функция ПанелькаЛичныйПрофильДляЗаписи(ОжидаемаяРевизия)
	ПанелькаПроверитьПравоЛичнойПанели();
	Если ТипЗнч(ОжидаемаяРевизия) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректная ревизия персональной панели.'");
	КонецЕсли;
	Сохраненный = ПанелькаПрочитатьЛичныйПрофиль();
	Если Сохраненный.Ревизия <> ОжидаемаяРевизия Тогда
		ВызватьИсключение НСтр("ru = 'Персональная панель изменена или удалена. Откройте настройки заново; несохранённые изменения можно экспортировать.'");
	КонецЕсли;
	Профиль = Новый Структура;
	Для Каждого ПолеПрофиля Из Сохраненный Цикл
		Профиль.Вставить(ПолеПрофиля.Ключ, ПолеПрофиля.Значение);
	КонецЦикла;
	Возврат Профиль;
КонецФункции

Функция ПанелькаПараметрыСохраненияЛичнойПанели(Исходные)
	Если Исходные <> Неопределено И ТипЗнч(Исходные) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный контекст сохранения персональной панели.'");
	КонецЕсли;
	Параметры = Новый Структура;
	Параметры.Вставить("СнимокВидимости", ПанелькаЗначение(Исходные, "СнимокВидимости", ""));
	Параметры.Вставить("Заменить", ПанелькаЗначение(Исходные, "Заменить", Ложь));
	Параметры.Вставить("ИсточникСоздания", ПанелькаЗначение(Исходные, "ИсточникСоздания", ""));
	Параметры.Вставить("РевизияОбщей", ПанелькаЗначение(Исходные, "РевизияОбщей", ""));
	Параметры.Вставить("Активна", ПанелькаЗначение(Исходные, "Активна", Истина));
	Для Каждого Имя Из СтрРазделить("СнимокВидимости,ИсточникСоздания,РевизияОбщей", ",") Цикл
		Если ТипЗнч(Параметры[Имя]) <> Тип("Строка") Тогда
			ВызватьИсключение НСтр("ru = 'Некорректный контекст сохранения персональной панели.'");
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Параметры.Заменить) <> Тип("Булево") Или ТипЗнч(Параметры.Активна) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный контекст сохранения персональной панели.'");
	КонецЕсли;
	Возврат Параметры;
КонецФункции

Функция ПанелькаПодготовитьЛичнуюМодельКЗаписи(Данные, Профиль, Параметры, КонтекстДоступа)
	Если Профиль.Данные <> Неопределено И Не Параметры.Заменить Тогда
		Если ПустаяСтрока(Параметры.СнимокВидимости) Тогда
			ВызватьИсключение НСтр("ru = 'Для изменения существующей персональной панели передайте снимок видимости при открытии редактора в ПанелькаСохранитьЛичнуюПанель.'");
		КонецЕсли;
		ТекущаяВидимость = ПанелькаСнимокВидимостиЛичнойМодели(Профиль.Данные, КонтекстДоступа);
		Если ТекущаяВидимость <> Параметры.СнимокВидимости Тогда
			ВызватьИсключение НСтр("ru = 'Доступные источники или права изменились после открытия редактора. Чтобы сохранить скрытые ссылки, экспортируйте правки и откройте персональные настройки заново.'");
		КонецЕсли;
	КонецЕсли;
	ПанелькаПроверитьИсточникиЛичнойМодели(Данные, ?(Параметры.Заменить, Неопределено, Профиль.Данные), КонтекстДоступа);
	Видимая = ПанелькаЛичнаяВидимаяМодель(Данные, КонтекстДоступа);
	Если Профиль.Данные <> Неопределено И Не Параметры.Заменить Тогда
		ПанелькаСохранитьСкрытыеЛичныеСтроки(Видимая, Профиль.Данные, КонтекстДоступа);
	КонецЕсли;
	ПанелькаПроверитьМодельРедактора(Видимая);
	Возврат Видимая;
КонецФункции

// Закрытая запись: публичные операции до вызова проверяют модель и назначение действия.
// Повторная проверка ревизии обнаруживает изменения, произошедшие во время подготовки модели.
Процедура ПанелькаЗаписатьПроверенныйЛичныйПрофиль(Профиль, ОжидаемаяРевизия)
	Сохраненный = ПанелькаЛичныйПрофильДляЗаписи(ОжидаемаяРевизия);
	ПанелькаПодготовитьДатыПрофиля(Профиль, Сохраненный);
	Попытка
		ХранилищеОбщихНастроек.Сохранить("Панелька.ЛичнаяПанель", "Профиль", Профиль);
	Исключение
		ПанелькаЗарегистрироватьОшибку("ЗаписьЛичногоПрофиля", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры


// Создаёт независимый неактивный профиль без содержимого и служебных дат.
//
// Параметры:
//  Ревизия - Строка - пустая для нового профиля; новая ревизия для отметки удаления.
//
// Возвращаемое значение:
//  См. ПанелькаПрочитатьЛичныйПрофиль
Функция ПанелькаНовыйЛичныйПрофиль(Ревизия = "")
	Профиль = Новый Структура;
	Профиль.Вставить("Версия", 1);
	Профиль.Вставить("Активна", Ложь);
	Профиль.Вставить("Данные", Неопределено);
	Профиль.Вставить("Ревизия", Ревизия);
	Профиль.Вставить("ИсточникСоздания", "");
	Профиль.Вставить("РевизияОбщей", "");
	Возврат Профиль;
КонецФункции

// Режим общей/личной панели не является изменением содержимого.
Процедура ПанелькаПодготовитьДатыПрофиля(Профиль, Сохраненный)
	Профиль.Вставить("Создана", ПанелькаДатаПрофиля(Сохраненный, "Создана"));
	Профиль.Вставить("Изменена", ПанелькаДатаПрофиля(Сохраненный, "Изменена"));
	Профиль.Ревизия = Сохраненный.Ревизия;
	Если Профиль.Данные = Неопределено Тогда
		Профиль.Активна = Ложь;
		Профиль.Ревизия = Строка(Новый УникальныйИдентификатор);
		Профиль.Создана = Дата(1, 1, 1);
		Профиль.Изменена = Дата(1, 1, 1);
	ИначеЕсли Сохраненный.Данные = Неопределено Тогда
		Профиль.Создана = ТекущаяДатаСеанса();
		Профиль.Изменена = Профиль.Создана;
		Профиль.Ревизия = Строка(Новый УникальныйИдентификатор);
	ИначеЕсли ПанелькаМодельВXML(Профиль.Данные) <> ПанелькаМодельВXML(Сохраненный.Данные) Тогда
		Профиль.Изменена = ТекущаяДатаСеанса();
		Профиль.Ревизия = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
КонецПроцедуры

Функция ПанелькаДатаПрофиля(Профиль, Имя)
	Значение = ПанелькаЗначение(Профиль, Имя);
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Дата(1, 1, 1);
КонецФункции

Процедура ПанелькаПроверитьФорматАдминПрофиля(Профиль)
	Если ТипЗнч(Профиль) <> Тип("Структура") Или ПанелькаЗначение(Профиль, "Версия", 0) <> 1
		Или Не Профиль.Свойство("Данные") Или ТипЗнч(ПанелькаЗначение(Профиль, "Ревизия")) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестный формат персональной панели. Данные не изменены.'");
	КонецЕсли;
КонецПроцедуры

// Имя — точный ключ пользователя стандартного хранилища, не представление в списке.
Функция ПанелькаАдминПрочитатьПрофиль(ИмяПользователя, ОжидаемаяРевизия)
	ПанелькаПроверитьАдминистрированиеПанелей();
	Если ТипЗнч(ИмяПользователя) <> Тип("Строка") Или ТипЗнч(ОжидаемаяРевизия) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный пользователь или ревизия персональной панели.'");
	КонецЕсли;
	Профиль = ХранилищеОбщихНастроек.Загрузить("Панелька.ЛичнаяПанель", "Профиль", , ИмяПользователя);
	Если Профиль = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Персональная панель уже удалена. Обновите список.'");
	КонецЕсли;
	ПанелькаПроверитьФорматАдминПрофиля(Профиль);
	Если Профиль.Данные = Неопределено Или Профиль.Ревизия <> ОжидаемаяРевизия Тогда
		ВызватьИсключение НСтр("ru = 'Персональная панель изменена или удалена. Обновите список и повторите команду.'");
	КонецЕсли;
	Возврат Профиль;
КонецФункции

Функция ПанелькаАдминМодельПанели(ИмяПользователя, ОжидаемаяРевизия)
	Профиль = ПанелькаАдминПрочитатьПрофиль(ИмяПользователя, ОжидаемаяРевизия);
	Модель = ПанелькаПолучитьМодель(Профиль.Данные);
	ПанелькаПроверитьМодельРедактора(Модель);
	Возврат Модель;
КонецФункции

Функция ПанелькаСтраницаДоступнаЛично(Страница)
	Если ПустаяСтрока(Страница.РолиДоступа) Или Страница.ИД = "page-main" Тогда
		Возврат Истина;
	КонецЕсли;
	Если ПравоДоступа("Администрирование", Метаданные) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого ИмяРоли Из СтрРазделить(Страница.РолиДоступа, ",") Цикл
		Если РольДоступна(СокрЛП(ИмяРоли)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#Область ПолитикаИсточниковПерсональныхПанелей

// Чтение только из общей настройки: личная модель и импорт не меняют разрешения.
Функция ПанелькаОбщиеНастройкиПолитикиИсточников()
	Если Метаданные.ОбщиеМодули.Найти("ОбщегоНазначения") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось прочитать общую политику источников персональных панелей.'");
	КонецЕсли;
	Данные = ПанелькаПрочитатьОбщиеНастройки();
	Если Данные <> Неопределено Тогда
		ПанелькаПроверитьМодель(Данные);
	КонецЕсли;
	Возврат Данные;
КонецФункции

#КонецОбласти

#Область РазборНавигационныхСсылок

// Получает запасную подпись только разбором текста, без менеджера объекта и запросов.
//
// Параметры:
//  СсылкаТекст - Строка - навигационная ссылка списка, формы или объекта данных.
//
// Возвращаемое значение:
//  Строка - техническое имя с пробелами; исходный адрес, если имя не извлечено.
Функция ПанелькаРезервноеИмяНавигационнойСсылки(Знач СсылкаТекст)
	ПозицияТочки = СтрНайти(СсылкаТекст, ".");
	Если ПозицияТочки = 0 Тогда
		Возврат СсылкаТекст;
	КонецЕсли;
	ПозицияВопроса = СтрНайти(СсылкаТекст, "?");
	Если ПозицияВопроса = 0 Тогда
		ПозицияВопроса = СтрДлина(СсылкаТекст) + 1;
	КонецЕсли;
	ИмяОбъекта = Сред(СсылкаТекст, ПозицияТочки + 1, ПозицияВопроса - ПозицияТочки - 1);
	Возврат ПанелькаРазбитьКэмелКейс(ИмяОбъекта);
КонецФункции

// Только синтаксический разбор: не создаёт ссылок и не читает базу.
Функция ПанелькаРазобратьНавигационнуюСсылкуДанных(СсылкаТекст, ПозицияДанных = 0)
	Если ПозицияДанных = 0 Тогда
		ПозицияДанных = СтрНайти(СсылкаТекст, "e1cib/data/");
	КонецЕсли;
	Если ПозицияДанных = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Остаток = Сред(СсылкаТекст, ПозицияДанных + 11);
	ПозицияВопроса = СтрНайти(Остаток, "?ref=");
	Если ПозицияВопроса = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипОбъектаСтрокой = Лев(Остаток, ПозицияВопроса - 1);
	СтрокаRef = Сред(Остаток, ПозицияВопроса + 5);
	ПозАмп = СтрНайти(СтрокаRef, "&");
	Если ПозАмп > 0 Тогда
		СтрокаRef = Лев(СтрокаRef, ПозАмп - 1);
	КонецЕсли;
	ПозДвоеточия = СтрНайти(СтрокаRef, ":");
	ГидСтрока = ?(ПозДвоеточия > 0, Сред(СтрокаRef, ПозДвоеточия + 1), СтрокаRef);
	Если СтрДлина(ГидСтрока) <> 32 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПозицияТочки = СтрНайти(ТипОбъектаСтрокой, ".");
	Если ПозицияТочки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("ТипМетаданных", ТипОбъектаСтрокой);
	Результат.Вставить("Класс", Лев(ТипОбъектаСтрокой, ПозицияТочки - 1));
	Результат.Вставить("ИмяОбъекта", Сред(ТипОбъектаСтрокой, ПозицияТочки + 1));
	// ref хранит UUID в ином порядке байтов, чем строковое представление идентификатора.
	Результат.Вставить("Идентификатор", Сред(ГидСтрока, 25, 8) + "-" + Сред(ГидСтрока, 21, 4) + "-"
		+ Сред(ГидСтрока, 17, 4) + "-" + Сред(ГидСтрока, 1, 4) + "-" + Сред(ГидСтрока, 5, 12));
	Возврат Результат;
КонецФункции

Функция ПанелькаМенеджерОбъектаНавигационнойСсылки(Класс, ИмяОбъекта, РазрешитьРегистры, РегистрироватьОшибки)
	Попытка
		Если Класс = "Справочник" Тогда
			Возврат Справочники[ИмяОбъекта];
		ИначеЕсли Класс = "Документ" Тогда
			Возврат Документы[ИмяОбъекта];
		ИначеЕсли Класс = "БизнесПроцесс" Тогда
			Возврат БизнесПроцессы[ИмяОбъекта];
		ИначеЕсли Класс = "Задача" Тогда
			Возврат Задачи[ИмяОбъекта];
		ИначеЕсли Класс = "ПланВидовХарактеристик" Тогда
			Возврат ПланыВидовХарактеристик[ИмяОбъекта];
		ИначеЕсли Класс = "ПланСчетов" Тогда
			Возврат ПланыСчетов[ИмяОбъекта];
		ИначеЕсли Класс = "ПланВидовРасчета" Тогда
			Возврат ПланыВидовРасчета[ИмяОбъекта];
		ИначеЕсли РазрешитьРегистры И Класс = "РегистрСведений" Тогда
			Возврат РегистрыСведений[ИмяОбъекта];
		ИначеЕсли РазрешитьРегистры И Класс = "РегистрНакопления" Тогда
			Возврат РегистрыНакопления[ИмяОбъекта];
		ИначеЕсли РазрешитьРегистры И Класс = "РегистрБухгалтерии" Тогда
			Возврат РегистрыБухгалтерии[ИмяОбъекта];
		ИначеЕсли РазрешитьРегистры И Класс = "РегистрРасчета" Тогда
			Возврат РегистрыРасчета[ИмяОбъекта];
		КонецЕсли;
	Исключение
		Если РегистрироватьОшибки Тогда
			ПанелькаЗарегистрироватьОшибку("ПолучениеМенеджераСсылки", ИнформацияОбОшибке());
		КонецЕсли;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#КонецОбласти

