// Проверяет адрес и добавляет введённую вручную ссылку.
&НаКлиенте
Процедура ДобавитьВставленнуюСсылкуКоманда(Команда)
	Если ПустаяСтрока(ВставленнаяСсылка) Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Вставьте ссылку.'"));
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(НазваниеВставленнойСсылки) Или НазваниеВставленнойСсылки = "Не удалось найти ссылку в базе" Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Укажите название ссылки перед добавлением.'"));
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(HTMLНастройкиАктивнаяКолонка) Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Выберите колонку в дереве.'"));
		Возврат;
	КонецЕсли;
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Адрес = СокрЛП(ВставленнаяСсылка);
	Если Лев(Адрес, 6) <> "e1cib/" И Лев(НРег(Адрес), 7) <> "http://" И Лев(НРег(Адрес), 8) <> "https://" Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Укажите навигационную ссылку 1С или адрес http / https.'"));
		Возврат;
	КонецЕсли;
	ДобавитьСсылку(?(Лев(Адрес, 6) = "e1cib/", "objects", "web"), Адрес, НазваниеВставленнойСсылки, "",
		HTMLНастройкиАктивнаяКолонка);
	ВставленнаяСсылка = "";
	НазваниеВставленнойСсылки = "";
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Показывает полный список выделенных элементов без изменения выделения.
&НаКлиенте
Процедура ПолныйСписокВыделенияКоманда(Команда)
	Узлы = Новый Массив;
	СобратьВыделенныеУзлы(ДеревоПанели.ПолучитьЭлементы(), Узлы);
	Список = Новый СписокЗначений;
	Для Каждого ДанныеВыбранногоУзла Из Узлы Цикл
		Если ДанныеВыбранногоУзла.Вид <> "Link" Тогда
			Продолжить;
		КонецЕсли;
		РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ДанныеВыбранногоУзла.ИД);
		Если РазмещениеСсылки <> Неопределено Тогда
			Список.Добавить(РазмещениеСсылки.ИД, РазмещениеСсылки.ИтоговоеНаименование + " — " + РазмещениеСсылки.ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	Если Список.Количество() > 0 Тогда
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеПросмотраВыделенныхПанелька", ЭтотОбъект), Список);
	КонецЕсли;
КонецПроцедуры

