// Редактор общих и персональных настроек «Панельки».
// Обычный и Web-интерфейсы используют единую модель настроек.
// Версия формата хранения — 3 (v3).
// Общая запись требует Администрирование; личная — СохранениеДанныхПользователя.
// Состояние выделения рассчитывается на клиенте, без серверного обновления дерева.

#Область ОписаниеПеременных
&НаСервере
Перем ГлубинаПакетаОбновленияПанелька;

// Только текущий серверный вызов: один каталог дополнительных описаний на пакет.
&НаСервере
Перем КэшКомментариевДобавленияПанелька;

// Только текущий серверный вызов; не хранит данные формы.
&НаКлиенте
Перем HTMLНастройкиПоследняяКомандаМоста;

// Идентификатор обработанной команды текущего HTML-документа.
&НаКлиенте
Перем HTMLНастройкиМостПодключен;

// Защита от повторного подключения обработчика ожидания.
&НаКлиенте
Перем HTMLНастройкиКонтекстКартинки;

// Контекст открытого выбора картинки.
&НаКлиенте
Перем HTMLНастройкиВыполняетсяКомандаМоста;

// Защита от повторного выполнения принятой команды.
&НаКлиенте
Перем HTMLНастройкиОшибкаКомандыМоста;

// Результат последнего выполнения без повторного запуска.
&НаКлиенте
Перем HTMLНастройкиКомандаСинхронизирована;

// Текущий черновик уже применён принятой HTML-командой.

&НаКлиенте
Перем ОбычныйИнтерфейсОбновляется;

// Защита от повторной обработки событий программного обновления.

&НаКлиенте
Перем МножественныйВыборПанелька;

// Режим панели свойств; состав пакета читается из выделения.
&НаКлиенте
Перем БыстраяПодписьВыделенияПанелька;

// Идентификаторы текущей строки и выделения последнего обновления.
&НаКлиенте
Перем ПодписьВыделенияПанелька;

// Последнее отображённое состояние выделения.

&НаКлиенте
Перем ЗакрытиеПодтвержденоПанелька;

// Закрытие после сохранения или явного отказа от изменений.
&НаКлиенте
Перем ВопросЗакрытияПанелька;

// Защита от повторного диалога закрытия.

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Проверяет доступ, загружает сохранённую модель и подготавливает реквизиты формы.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПерсональнаяНастройкаПанелька = Ложь;
	Параметры.Свойство("ПерсональнаяНастройкаПанелька", ПерсональнаяНастройкаПанелька);
	ПроверитьПравоНастройкиПанелька();
	МожноРедактироватьОбщуюПанельПанелька = ПравоДоступа("Администрирование", Метаданные);
	Элементы.ВзятьОбщуюПанельПанелька.Видимость = ПерсональнаяНастройкаПанелька;
	Элементы.ПараметрыПерсональнойПанелиПанелька.Видимость = Не ПерсональнаяНастройкаПанелька;
	СостояниеСпискаПерсональныхПанелейПанелька = НСтр("ru = 'Нажмите «Обновить», чтобы получить список сохранённых персональных панелей.'");
	Элементы.ГруппаПросмотраПерсональнойПанелиПанелька.Видимость = Ложь;
	Элементы.АдминПанелиПросмотреть.Доступность = Ложь;
	Элементы.АдминПанелиЭкспортировать.Доступность = Ложь;
	Элементы.АдминПанелиУдалить.Доступность = Ложь;
	ОбычныйИсточник = "Метаданные";
	ОбычнаяКатегория = "Документы";
	Обработка = РеквизитФормыВЗначение("Объект");
	ИсходныеНастройки = ПанелькаНастройкиПрочитать();
	Если Не ПерсональнаяНастройкаПанелька Тогда
		СнимокХранилищаПанелька = ПолучитьЗначениеОформленияВXML(ИсходныеНастройки);
	КонецЕсли;
	МодельРедактора = Обработка.ПанелькаПодготовитьМодельРедактора(ИсходныеНастройки);
	Если ПерсональнаяНастройкаПанелька Тогда
		Заголовок = НСтр("ru = 'Персональная настройка панели — только для вас'");
		Команды.УдалитьНастройки.Заголовок = НСтр("ru = 'Удалить мою панель'");
		Если ИсходныеНастройки = Неопределено Тогда
			НачатьСПустой = Ложь;
			Параметры.Свойство("НачатьСПустой", НачатьСПустой);
			Если НачатьСПустой Тогда
				МодельРедактора = Обработка.ПанелькаПустаяМодель();
				ИсточникЛичнойПанелиПанелька = "empty";
			Иначе
				ОбщиеНастройки = ПанелькаОбщиеНастройкиПрочитать();
				МодельРедактора = Обработка.ПанелькаПодготовитьМодельРедактора(ОбщиеНастройки);
				ИсточникЛичнойПанелиПанелька = "common";
				Если ТипЗнч(ОбщиеНастройки) = Тип("Структура") Тогда
					ОбщиеНастройки.Свойство("РевизияПанелька", РевизияОбщейПанелиПанелька);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		КонтекстДоступа = Обработка.ПанелькаКонтекстДоступаЛичнойПанели();
		Если ИсходныеНастройки <> Неопределено Тогда
			СнимокВидимостиЛичнойПанелиПанелька = Обработка.ПанелькаСнимокВидимостиЛичнойМодели(МодельРедактора, КонтекстДоступа);
		КонецЕсли;
		МодельРедактора = Обработка.ПанелькаЛичнаяВидимаяМодель(МодельРедактора, КонтекстДоступа);
	Иначе
		КонтекстДоступа = Неопределено;
	КонецЕсли;
	ЗагрузитьМодельВФорму(МодельРедактора, КонтекстДоступа);
	РежимHTMLНастроек = ПолучитьПользовательскуюНастройкуHTMLПанелька("РежимHTMLНастроек", Истина);
	HTMLНастройкиАктивнаяСтраница = "Главная";
	HTMLНастройкиАктивнаяКолонка = "";
	HTMLНастройкиТипИсточника = "metadata";
	HTMLНастройкиКатегорияМетаданных = "Документы";
	ВыбранныйТип = "Page";
	НастройкиИзменены = ПерсональнаяНастройкаПанелька И ИсходныеНастройки = Неопределено;
КонецПроцедуры

// Инициализирует клиентский интерфейс и подключает наблюдатели выделения и HTML-команд.
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	МножественныйВыборПанелька = Ложь;
	ПодписьВыделенияПанелька = "";
	ПодключитьОбработчикОжидания("ПроверитьВыделениеПанелька", 1);
	ОбычныйИнтерфейсОбновляется = Ложь;
	HTMLНастройкиПоследняяКомандаМоста = "";
	HTMLНастройкиМостПодключен = Ложь;
	ПрименитьРежимHTMLНастроек();
	ОбновитьHTMLНастроекЕслиНужно();
	ПодключитьМостHTMLНастроек();
КонецПроцедуры

// Отключает обработчики ожидания при закрытии формы.
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОтключитьОбработчикОжидания("ПроверитьВыделениеПанелька");
	ОтключитьМостHTMLНастроек();
КонецПроцедуры

// Проверяет незаписанные изменения перед закрытием и запрашивает решение пользователя.
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗакрытиеПодтвержденоПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Если РежимHTMLНастроек Тогда
		Если Не СинхронизироватьКомандыHTMLПанелька() Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Попытка
			НастройкиИзменены = НастройкиИзменены Или Не ПустаяСтрока(ПрочитатьЧерновикHTMLПанелька());
		Исключение
			Отказ = Истина;
			СообщитьПользователюПанелька(НСтр("ru = 'Не удалось проверить изменения Web-интерфейса. Дождитесь загрузки формы и повторите закрытие.'"));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	Если ЕстьЧерновикНовойВебСсылкиHTMLПанелька() Тогда
		Отказ = Истина;
		СообщитьПользователюПанелька(НСтр("ru = 'Завершите добавление веб-ссылки или отмените ввод перед закрытием.'"));
		Возврат;
	КонецЕсли;
	Если Не НастройкиИзменены Тогда
		Возврат;
	КонецЕсли;
	Текст = НСтр("ru = 'Сохранить изменения в настройках панели? Если не сохранять, изменения будут потеряны.'");
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = Текст;
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ВопросЗакрытияПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	ВопросЗакрытияПанелька = Истина;
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("save",НСтр("ru = 'Сохранить'"));
	Кнопки.Добавить("discard",НСтр("ru = 'Не сохранять'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияЗакрытияПанелька", ЭтотОбъект), Текст,
		Кнопки, 0, КодВозвратаДиалога.Отмена);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Применяет правки прежнего режима и переключает интерфейс настроек.
&НаКлиенте
Процедура РежимHTMLНастроекПриИзменении(Элемент)
	НовыйРежим = РежимHTMLНастроек;
	// Apply the editor in the previous mode; on validation failure keep that mode.
	РежимHTMLНастроек = Не НовыйРежим;
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	РежимHTMLНастроек = НовыйРежим;
	ДопНастройкиОткрытыПанелька = Ложь;
	СохранитьПользовательскуюНастройкуHTMLПанелька("РежимHTMLНастроек", РежимHTMLНастроек);
	ПрименитьРежимHTMLНастроек();
	Если РежимHTMLНастроек Тогда
		ОбновитьHTMLНастроекЕслиНужно();
	КонецЕсли;
КонецПроцедуры

// Применяет изменённые текстовые свойства ссылки.
&НаКлиенте
Процедура РедакторТекстПриИзменении(Элемент)
	ПрименитьИзмененияТекстовогоРедактораПанелька();
КонецПроцедуры

// Применяет изменённые свойства страницы или колонки.
&НаКлиенте
Процедура СтруктураТекстПриИзменении(Элемент)
	ПрименитьИзмененияТекстовогоРедактораПанелька();
КонецПроцедуры

// Открывает выбор родительской страницы для колонки.
&НаКлиенте
Процедура ВыборСтраницыКолонкиНачало(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыбратьСтраницуКолонкиПанелька(Элемент);
КонецПроцедуры

// Отмечает изменение общего параметра и обновляет доступное представление.
&НаКлиенте
Процедура ОформлениеПриИзменении(Элемент)
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ЖурналИзмененийПанелька = "";
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Открывает выбор значения по нажатию на поле.
&НаКлиенте
Процедура ВыборПоНажатию(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Неопределено;
	Если Элемент.Имя = "ОбычныйИсточник" Тогда
		ИсточникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	ИначеЕсли Элемент.Имя = "ОбычнаяКатегория" Тогда
		КатегорияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	Иначе
		ОбластьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

// Запускает подбор названия после изменения вставленного адреса.
&НаКлиенте
Процедура ВставленнаяСсылкаПриИзменении(Элемент)
	ВставленнаяСсылка = СокрЛП(ВставленнаяСсылка);
	НазваниеВставленнойСсылки = ПодобратьНазваниеВставленнойСсылки(ВставленнаяСсылка);
КонецПроцедуры

// Перехватывает нажатие HTML-команды и передаёт его диспетчеру.
&НаКлиенте
Процедура ПолеHTMLНастроекПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	URL = ДанныеСобытия.Href;
	Если ТипЗнч(URL) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	Если СтрНайти(URL, "panelkasettings://") = 0
		И СтрНайти(URL, "#panelkasettings/") = 0 Тогда
		Возврат;
	КонецЕсли;
	// Основной транспорт HTML -> 1С выполняется только через DOM-мост
	// и обработчик ожидания. Событие ПриНажатии используется исключительно
	// для отмены стандартной навигации. Выполнять команду здесь нельзя:
	// иначе одна и та же команда может выполниться дважды (ПриНажатии + DOM),
	// что особенно критично для файловых диалогов импорта/экспорта.
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ЛичныеИсточникиПриИзмененииПанелька(Элемент)
	НастройкиИзменены = Истина;
КонецПроцедуры

// Разрешение применяется после сохранения общих настроек.
&НаКлиенте
Процедура РазрешитьПерсональнуюПанельПриИзмененииПанелька(Элемент)
	НастройкиИзменены = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИсточникиСписок

// Обрабатывает выбор строки каталога источников.
&НаКлиенте
Процедура ИсточникВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДобавитьИсточникКоманда(Неопределено);
КонецПроцедуры

// Формирует пакет источников для перетаскивания.
&НаКлиенте
Процедура ИсточникиНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Если Не Выполнение Тогда
		Возврат;
	КонецЕсли;
	Пакет = ВыбранныеИсточникиДляДобавления();
	Если Пакет.Количество() = 0 Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	ПараметрыПеретаскивания.Значение = Новый Структура("Формат,Ссылки", "ПанелькаИсточникиV3", Пакет);
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Копирование;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоПанели

// Отмечает активацию строки; окончательное выделение обрабатывается в режиме ожидания.
&НаКлиенте
Процедура ДеревоПанелиПриВыборе(Элемент)
	ОтметитьВыборУзлаДереваПанелька();
КонецПроцедуры

// Проверяет допустимость перетаскивания на узел дерева.
&НаКлиенте
Процедура ДеревоПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	Если ПриемникВнутреннегоПереноса(ПараметрыПеретаскивания.Значение, Строка) <> Неопределено Тогда
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
		Возврат;
	КонецЕсли;
	КолонкаИД = КолонкаПриемникПеретаскивания(ПараметрыПеретаскивания.Значение, Строка);
	ПараметрыПеретаскивания.Действие = ?(ПустаяСтрока(КолонкаИД), ДействиеПеретаскивания.Отмена,
		ДействиеПеретаскивания.Копирование);
КонецПроцедуры

// Обрабатывает перенос источников или узлов в дерево панели.
&НаКлиенте
Процедура ДеревоПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	Если ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена Тогда
		Возврат;
	КонецЕсли;
	Цель = ПриемникВнутреннегоПереноса(ПараметрыПеретаскивания.Значение, Строка);
	Если Цель <> Неопределено Тогда
		Если Не ПрименитьОбычныйРедактор() Тогда
			Возврат;
		КонецЕсли;
		Попытка
			ПредупреждениеПереноса = ПеренестиУзлыДерева(ПараметрыПеретаскивания.Значение, Цель);
			ОбновитьОбычнуюФорму();
			Если Не ПустаяСтрока(ПредупреждениеПереноса) Тогда
				ПоказатьПредупреждение(Неопределено, ПредупреждениеПереноса);
			КонецЕсли;
		Исключение
			СообщитьПользователюПанелька(ОписаниеОшибки());
		КонецПопытки;
		Возврат;
	КонецЕсли;
	КолонкаИД = КолонкаПриемникПеретаскивания(ПараметрыПеретаскивания.Значение, Строка);
	Если ПустаяСтрока(КолонкаИД) Тогда
		Возврат;
	КонецЕсли;
	ДобавитьПакетИсточниковКлиент(ПараметрыПеретаскивания.Значение.Ссылки, КолонкаИД);
КонецПроцедуры

// Проверяет состав выделения и формирует пакет внутреннего перетаскивания.
&НаКлиенте
Процедура ДеревоНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Если Не Выполнение Тогда
		Возврат;
	КонецЕсли;
	Пакет = Новый Массив;
	СобратьВыделенныеУзлы(ДеревоПанели.ПолучитьЭлементы(), Пакет);
	Если Пакет.Количество() = 0 Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	Вид = Пакет[0].Вид;
	Если Вид <> "Link" И Вид <> "Column" И Вид <> "Group" Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	Если Вид = "Group" И Пакет.Количество() <> 1 Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	Для Каждого ДанныеВыбранногоУзла Из Пакет Цикл
		Если ДанныеВыбранногоУзла.Вид <> Вид Или ЭтоСистемныйИД(ДанныеВыбранногоУзла.ИД) Тогда
			Выполнение = Ложь;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ПараметрыПеретаскивания.Значение = Новый Структура("Формат,Вид,Узлы", "ПанелькаДеревоV3", Вид, Пакет);
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
КонецПроцедуры

// Обрабатывает активацию ячейки без перестроения панели свойств внутри события.
&НаКлиенте
Процедура ДеревоПанелиПриАктивизацииЯчейки(Элемент)
	Если ОбычныйИнтерфейсОбновляется Тогда
		Возврат;
	КонецЕсли;
	// Не меняем компоновку посреди события активации строки.
	// Постоянный обработчик ожидания прочитает окончательное выделение.
	ПоказатьВсеВыбранныеПанелька = Ложь;
	// Изменение состава выделения обнаруживает наблюдатель.
	// Повторная активация той же строки не требует заполнения свойств.
КонецПроцедуры

