	Если Панель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗапроситьУдалениеПерсональнойПанелиПанелька(Панель);
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение пользователю через платформенный объект без зависимости от БСП.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения, включая переводы строк и локализованные подписи.
&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователюПанелька(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
КонецПроцедуры

#Область МодельИЗапись

// Применяет редактор и сохраняет настройки без закрытия формы.
&НаКлиенте
Процедура СохранитьНастройкиКлиентПанелька()
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СохранитьНастройкиВХранилище();
		Оповестить("Панелька_ОбновитьДашборд");
		СообщитьПользователюПанелька(НСтр("ru = 'Настройки сохранены.'"));
		Если РежимHTMLНастроек Тогда
			ОбновитьHTMLНастроекЕслиНужно();
		КонецЕсли;
	Исключение
		HTMLНастройкиОшибкаКомандыМоста = Истина;
		СообщитьПользователюПанелька(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Применяет редактор и закрывает форму только после успешного сохранения.
&НаКлиенте
Процедура СохранитьНастройкиИЗакрытьПанелька()
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьЧерновикНовойВебСсылкиHTMLПанелька() Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Завершите добавление веб-ссылки или отмените ввод перед закрытием.'"));
		Возврат;
	КонецЕсли;
	Попытка
		СохранитьНастройкиВХранилище();
	Исключение
		HTMLНастройкиОшибкаКомандыМоста = Истина;
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Оповестить("Панелька_ОбновитьДашборд");
	ЗакрытиеПодтвержденоПанелька = Истина;
	Закрыть();
КонецПроцедуры

// Контракт обновления хранится в форме между изменением данных и обновлением интерфейса.
// Пустой журнал означает неизвестный состав изменений: используем полный безопасный путь.
&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьПланОбновленияПанелька(Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Структура("Full,Columns,Links", Истина, Новый Массив, Новый Массив);
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

// Регистрирует затронутые объекты до их изменения, сохраняя прежние колонки при переносе.
&НаСервере
Процедура ОтметитьИзменениеПанелька(Вид, Идентификатор = "")
	План = ПрочитатьПланОбновленияПанелька(ЖурналИзмененийПанелька);
	Если ПустаяСтрока(ЖурналИзмененийПанелька) Тогда
		План.Full = Ложь;
	КонецЕсли;
	Если Вид = "full" Тогда
		План.Full = Истина;
	ИначеЕсли Вид = "column" Тогда
		Если План.Columns.Найти(Идентификатор) = Неопределено Тогда
			План.Columns.Добавить(Идентификатор);
		КонецЕсли;
		Для Каждого РазмещениеСсылки Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДКолонки", Идентификатор)) Цикл
			Если План.Links.Найти(РазмещениеСсылки.ИДСсылки) = Неопределено Тогда
				План.Links.Добавить(РазмещениеСсылки.ИДСсылки);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Вид = "link" Тогда
		Если План.Links.Найти(Идентификатор) = Неопределено Тогда
			План.Links.Добавить(Идентификатор);
		КонецЕсли;
		Для Каждого РазмещениеСсылки Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", Идентификатор)) Цикл
			Если План.Columns.Найти(РазмещениеСсылки.ИДКолонки) = Неопределено Тогда
				План.Columns.Добавить(РазмещениеСсылки.ИДКолонки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Встроенные колонки могут отображаться на другой странице или сливаться.
	Если План.Columns.Найти("column-standard") <> Неопределено Или
		План.Columns.Найти("column-unassigned") <> Неопределено Тогда
		План.Full = Истина;
	КонецЕсли;
	Для Каждого СсылкаИД Из План.Links Цикл
		СсылкаМодели = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", СсылкаИД);
		Если СсылкаМодели <> Неопределено И СсылкаМодели.Источник = "objects" И Лев(СсылкаМодели.Ссылка,
			8) = "sys_cmd:" Тогда
			План.Full = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, План);
	ЖурналИзмененийПанелька = Запись.Закрыть();
КонецПроцедуры

// Вложенные операции откладывают пересчёт до выхода из внешней команды.
&НаСервере
Процедура НачатьПакетОбновленияПанелька()
	Если ГлубинаПакетаОбновленияПанелька = Неопределено Тогда
		ГлубинаПакетаОбновленияПанелька = 0;
	КонецЕсли;
	ГлубинаПакетаОбновленияПанелька = ГлубинаПакетаОбновленияПанелька + 1;
КонецПроцедуры

&НаСервере
Процедура ЗавершитьПакетОбновленияПанелька()
	ГлубинаПакетаОбновленияПанелька = ГлубинаПакетаОбновленияПанелька - 1;
	Если ГлубинаПакетаОбновленияПанелька = 0 Тогда
		ОбновитьПредставления();
	КонецЕсли;
КонецПроцедуры

// Не маскирует исключение и не оставляет последующие команды в режиме отложенного пересчёта.
&НаСервере
Процедура ПрерватьПакетОбновленияПанелька()
	ГлубинаПакетаОбновленияПанелька = 0;
	ПредставленияАктуальныПанелька = Ложь;
	ОтметитьИзменениеПанелька("full");
КонецПроцедуры

// Находит строку по полю; для имён игнорирует регистр и крайние пробелы.
&НаКлиентеНаСервереБезКонтекста
Функция НайтиСтрокуМодели(Таблица, Поле, Значение)
	Если Поле = "ИмяКолонки" Тогда
		Для Каждого СтрокаПоИД Из Таблица Цикл
			Если СтрокаПоИД.ИД = Значение Тогда
				Возврат СтрокаПоИД;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Стр Из Таблица Цикл
		Если Поле = "ИмяКолонки" Или Поле = "ИмяСтраницы" Тогда
			Если НРег(СокрЛП(Стр[Поле])) = НРег(СокрЛП(Значение)) Тогда
				Возврат Стр;
			КонецЕсли;
		ИначеЕсли Стр[Поле] = Значение Тогда
			Возврат Стр;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Освобождает классификацию после импорта или добавления дополнительного объекта.
&НаСервере
Процедура СброситьКэшТиповДопПанелька()
	Если Не ПустаяСтрока(АдресКэшаТиповДопПанелька) Тогда
		УдалитьИзВременногоХранилища(АдресКэшаТиповДопПанелька);
		АдресКэшаТиповДопПанелька = "";
	КонецЕсли;
КонецПроцедуры

// Возвращает классификацию дополнительных ссылок на время жизни формы.
// Полный каталог перечитывается при явном обновлении источника; в контекст входит только адрес кеша.
&НаСервере
Функция ПолучитьТипыДопИсточниковПанелька()
	Если ТаблицаСсылок.НайтиСтроки(Новый Структура("Источник", "extra")).Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Если Не ПустаяСтрока(АдресКэшаТиповДопПанелька) Тогда
		Типы = ПолучитьИзВременногоХранилища(АдресКэшаТиповДопПанелька);
		Если Типы <> Неопределено Тогда
			Возврат Типы;
		КонецЕсли;
	КонецЕсли;
	Источники = ДополнительныеИсточникиОбычнойФормы();
	Типы = Новый Соответствие;
	Для Каждого Источник Из Источники Цикл
		Типы.Вставить(Источник.Url, Источник.Type);
	КонецЦикла;
	Возврат Типы;
КонецФункции

// Собирает сохраняемую модель из четырёх таблиц и общих параметров формы.
&НаСервере
Функция СобратьМодель()
	Обработка = РеквизитФормыВЗначение("Объект");
	МодельПанели = Обработка.ПанелькаПустаяМодель();
	Имена = Новый Структура;
	Имена.Вставить("Страницы", "ТаблицаСтраниц");
	Имена.Вставить("Колонки", "ТаблицаКолонок");
	Имена.Вставить("КаталогСсылок", "ТаблицаСсылок");
	Имена.Вставить("Размещения", "ТаблицаРазмещений");
	Для Каждого Пара Из Имена Цикл
		ТаблицаМодели = Обработка.ПанелькаНоваяТаблица(Пара.Ключ);
		Для Каждого Стр Из ЭтотОбъект[Пара.Значение] Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаМодели.Добавить(), Стр);
		КонецЦикла;
		МодельПанели[Пара.Ключ] = ТаблицаМодели;
	КонецЦикла;
	МодельПанели.Группировать = ГруппироватьПоТипуОбъекта;
	МодельПанели.Вставить("ЗаполнятьКомментарийИзМетаданных", ЗаполнятьКомментарийИзМетаданных);
	Если Не ПерсональнаяНастройкаПанелька Тогда
		МодельПанели.Вставить("РазрешитьПерсональнуюПанельПанелька", РазрешитьПерсональнуюПанельПанелька);
		МодельПанели.Вставить("РазрешитьИмпортЛичнойПанелиПанелька", РазрешитьИмпортЛичнойПанелиПанелька);
		МодельПанели.Вставить("РазрешитьЭкспортЛичнойПанелиПанелька", РазрешитьЭкспортЛичнойПанелиПанелька);
		МодельПанели.Вставить("НеПрименятьОграниченияИсточниковКАдминистраторамПанелька",
			НеПрименятьОграниченияИсточниковКАдминистраторамПанелька);
		Политика = Обработка.ПанелькаНоваяПолитикаИсточниковЛичныхПанелей();
		Для Каждого Пара Из Политика Цикл
			Политика[Пара.Ключ] = ЭтотОбъект["ЛичныеРазрешить" + Пара.Ключ];
		КонецЦикла;
		МодельПанели.Вставить("ИсточникиПерсональныхПанелейПанелька", Политика);
	Иначе
		МодельПанели.Удалить("ИсточникиПерсональныхПанелейПанелька");
		МодельПанели.Удалить("РазрешитьИмпортЛичнойПанелиПанелька");
		МодельПанели.Удалить("РазрешитьЭкспортЛичнойПанелиПанелька");
		МодельПанели.Удалить("НеПрименятьОграниченияИсточниковКАдминистраторамПанелька");
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("НеРаспределенныеНаОтдельнойВкладке,СтандартныеНаОтдельнойВкладке,РежимОтображенияПодсказок,ШрифтКолонки,ЦветКолонки,ШрифтГруппировки,ЦветГруппировки", ",") Цикл
		МодельПанели[Имя] = ЭтотОбъект[Имя];
	КонецЦикла;
	Возврат МодельПанели;
КонецФункции

// Проверяет модель и загружает её таблицы и параметры в реквизиты формы.
&НаСервере
Процедура ЗагрузитьМодельВФорму(МодельПанели, КонтекстДоступа = Неопределено)
	ПредставленияАктуальныПанелька = Ложь;
	ОтметитьИзменениеПанелька("full");
	СброситьКэшТиповДопПанелька();
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПанелькаПроверитьМодельРедактора(МодельПанели);
	Если ПерсональнаяНастройкаПанелька Тогда
		МодельПанели = Обработка.ПанелькаЛичнаяВидимаяМодель(МодельПанели, КонтекстДоступа);
	КонецЕсли;
	МодельПанели.Страницы.Сортировать("Порядок");
	МодельПанели.Колонки.Сортировать("Порядок");
	МодельПанели.Размещения.Сортировать("Порядок");
	ТаблицаСтраниц.Загрузить(МодельПанели.Страницы);
	ТаблицаКолонок.Загрузить(МодельПанели.Колонки);
	ТаблицаСсылок.Загрузить(МодельПанели.КаталогСсылок);
	ТаблицаРазмещений.Загрузить(МодельПанели.Размещения);
	ГруппироватьПоТипуОбъекта = МодельПанели.Группировать;
	ЗаполнятьКомментарийИзМетаданных = Обработка.ПанелькаЗаполнятьКомментарийИзНастроек(МодельПанели);
	РазрешитьПерсональнуюПанельПанелька = Обработка.ПанелькаРазрешениеПерсональнойПанелиИзНастроек(МодельПанели);
	НеПрименятьОграниченияИсточниковКАдминистраторамПанелька = Обработка.ПанелькаНеПрименятьОграниченияКАдминистраторамИзНастроек(МодельПанели);
	РазрешитьИмпортЛичнойПанелиПанелька = Обработка.ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(МодельПанели, "import");
	РазрешитьЭкспортЛичнойПанелиПанелька = Обработка.ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(МодельПанели, "export");
	Политика = Обработка.ПанелькаПолитикаИсточниковИзНастроек(МодельПанели);
	Для Каждого Пара Из Политика Цикл
		ЭтотОбъект["ЛичныеРазрешить" + Пара.Ключ] = Пара.Значение;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("НеРаспределенныеНаОтдельнойВкладке,СтандартныеНаОтдельнойВкладке,РежимОтображенияПодсказок,ШрифтКолонки,ЦветКолонки,ШрифтГруппировки,ЦветГруппировки", ",") Цикл
		ЭтотОбъект[Имя] = МодельПанели[Имя];
	КонецЦикла;
	РазрешенияОбмена = ПолучитьРазрешенияОбменаПанелька();
	Элементы.ИмпортКнопка.Доступность = РазрешенияОбмена.Импорт;
	Элементы.ЭкспортКнопка.Доступность = РазрешенияОбмена.Экспорт;
	ВыбраннаяСсылкаИД = "";
	ВыбранноеРазмещениеИД = "";
	ОбновитьПредставления();
КонецПроцедуры

// Проверяет модель и записывает настройки; снимает признак изменений только после успешной записи.
&НаСервере
Процедура СохранитьНастройкиВХранилище()
	ПроверитьПравоНастройкиПанелька();
	ОбновитьПредставления();
	ПроверитьСтандартныеРазмещенияПанелька();
	МодельПанели = СобратьМодель();
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПанелькаПроверитьМодельРедактора(МодельПанели);
	ПанелькаНастройкиЗаписать(МодельПанели);
	НастройкиИзменены = Ложь;
КонецПроцедуры

#КонецОбласти

#Область КаталогИРазмещения

// Находит размещение по идентификаторам ссылки и колонки.
&НаСервере
Функция НайтиРазмещениеПоСвязи(СсылкаИД, КолонкаИД, ИндексДобавления = Неопределено)
	Если ИндексДобавления <> Неопределено Тогда
		РазмещенияСсылки = ИндексДобавления.РазмещенияПоСсылкам[СсылкаИД];
		Если РазмещенияСсылки = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат РазмещенияСсылки[КолонкаИД];
	КонецЕсли;
	Для Каждого РазмещениеСсылки Из ТаблицаРазмещений Цикл
		Если РазмещениеСсылки.ИДСсылки = СсылкаИД И РазмещениеСсылки.ИДКолонки = КолонкаИД Тогда
			Возврат РазмещениеСсылки;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Возвращает существующее размещение или создаёт новое в конце колонки.
&НаСервере
Функция СоздатьРазмещение(СсылкаИД, КолонкаИД, ИндексДобавления = Неопределено)
	РазмещениеСсылки = НайтиРазмещениеПоСвязи(СсылкаИД, КолонкаИД, ИндексДобавления);
	Если РазмещениеСсылки <> Неопределено Тогда
		Возврат РазмещениеСсылки;
	КонецЕсли;
	Максимум = МаксимальныйПорядокДобавленияПанелька(КолонкаИД, ИндексДобавления);
	РазмещениеСсылки = ТаблицаРазмещений.Добавить();
	РазмещениеСсылки.ИД = Строка(Новый УникальныйИдентификатор);
	РазмещениеСсылки.ИДСсылки = СсылкаИД;
	РазмещениеСсылки.ИДКолонки = КолонкаИД;
	РазмещениеСсылки.Порядок = Максимум + 10;
	ОбновитьИндексРазмещенияДобавленияПанелька(ИндексДобавления, РазмещениеСсылки);
	Возврат РазмещениеСсылки;
КонецФункции

// Индекс принадлежит одному пакетному добавлению и не сохраняется в состоянии формы.
&НаСервере
Функция ИндексПакетногоДобавленияПанелька()
	Индекс = Новый Структура;
	Индекс.Вставить("СсылкиПоИсточникам", Новый Соответствие);
	Индекс.Вставить("РазмещенияПоСсылкам", Новый Соответствие);
	Индекс.Вставить("МаксимумыПорядка", Новый Соответствие);
	Индекс.Вставить("ГрязныеМаксимумы", Новый Соответствие);
	Для Каждого СсылкаКаталога Из ТаблицаСсылок Цикл
		СсылкиИсточника = Индекс.СсылкиПоИсточникам[СсылкаКаталога.Источник];
		Если СсылкиИсточника = Неопределено Тогда
			СсылкиИсточника = Новый Соответствие;
			Индекс.СсылкиПоИсточникам.Вставить(СсылкаКаталога.Источник, СсылкиИсточника);
		КонецЕсли;
		Если СсылкиИсточника[СсылкаКаталога.Ссылка] = Неопределено Тогда
			СсылкиИсточника.Вставить(СсылкаКаталога.Ссылка, СсылкаКаталога);
		КонецЕсли;
	КонецЦикла;
	Для Каждого РазмещениеСсылки Из ТаблицаРазмещений Цикл
		ОбновитьИндексРазмещенияДобавленияПанелька(Индекс, РазмещениеСсылки);
	КонецЦикла;
	Возврат Индекс;
КонецФункции

// Возвращает максимум из индекса; после переноса пересчитывает только по необходимости.
&НаСервере
Функция МаксимальныйПорядокДобавленияПанелька(КолонкаИД, ИндексДобавления)
	Если ИндексДобавления <> Неопределено Тогда
		Максимум = ИндексДобавления.МаксимумыПорядка[КолонкаИД];
		Если Максимум = Неопределено Тогда
			Максимум = 0;
		КонецЕсли;
		Если ИндексДобавления.ГрязныеМаксимумы[КолонкаИД] = Неопределено Тогда
			Возврат Максимум;
		КонецЕсли;
	КонецЕсли;
	Максимум = 0;
	Для Каждого Стр Из ТаблицаРазмещений Цикл
		Если Стр.ИДКолонки = КолонкаИД Тогда
			Максимум = Макс(Максимум, Стр.Порядок);
		КонецЕсли;
	КонецЦикла;
	Если ИндексДобавления <> Неопределено Тогда
		ИндексДобавления.МаксимумыПорядка.Вставить(КолонкаИД, Максимум);
		ИндексДобавления.ГрязныеМаксимумы.Удалить(КолонкаИД);
	КонецЕсли;
	Возврат Максимум;
КонецФункции

// Удаление старой связи выполняется до удаления строки таблицы, перенос — после смены колонки.
&НаСервере
Процедура ОбновитьИндексРазмещенияДобавленияПанелька(Индекс, Размещение, ПрежняяКолонка = Неопределено, Удалено = Ложь)
	Если Индекс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РазмещенияСсылки = Индекс.РазмещенияПоСсылкам[Размещение.ИДСсылки];
	Если РазмещенияСсылки = Неопределено Тогда
		РазмещенияСсылки = Новый Соответствие;
		Индекс.РазмещенияПоСсылкам.Вставить(Размещение.ИДСсылки, РазмещенияСсылки);
	КонецЕсли;
	Если ПрежняяКолонка <> Неопределено Тогда
		РазмещенияСсылки.Удалить(ПрежняяКолонка);
		Индекс.ГрязныеМаксимумы.Вставить(ПрежняяКолонка, Истина);
	КонецЕсли;
	Если Удалено Тогда
		Возврат;
	КонецЕсли;
	Если РазмещенияСсылки[Размещение.ИДКолонки] = Неопределено Тогда
		РазмещенияСсылки.Вставить(Размещение.ИДКолонки, Размещение);
	КонецЕсли;
	Максимум = Индекс.МаксимумыПорядка[Размещение.ИДКолонки];
	Если Максимум = Неопределено Тогда
		Максимум = 0;
	КонецЕсли;
	Индекс.МаксимумыПорядка.Вставить(Размещение.ИДКолонки, Макс(Максимум, Размещение.Порядок));
КонецПроцедуры

// Создаёт индекс строк по ИД на время одного расчёта; не хранит устаревающие ссылки на строки.
&НаСервереБезКонтекста
Функция ИндексСтрокПоИДПанелька(Таблица)
	Индекс = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Индекс.Вставить(СтрокаТаблицы.ИД, СтрокаТаблицы);
	КонецЦикла;
	Возврат Индекс;
КонецФункции

// Группирует размещения за один проход вместо повторного поиска по всей таблице.
&НаСервере
Функция ИндексРазмещенийПанелька()
	Индекс = Новый Соответствие;
	Для Каждого СсылкаКаталога Из ТаблицаСсылок Цикл
		Индекс.Вставить(СсылкаКаталога.ИД, Новый Массив);
	КонецЦикла;
	Для Каждого Размещение Из ТаблицаРазмещений Цикл
		Строки = Индекс[Размещение.ИДСсылки];
		Если Строки <> Неопределено Тогда
			Строки.Добавить(Размещение);
		КонецЕсли;
	КонецЦикла;
	Возврат Индекс;
КонецФункции

// Пересчитывает производные представления таблиц по текущей модели.
&НаСервере
Процедура ОбновитьПредставления(ТолькоСсылкаИД = "")
	Если ГлубинаПакетаОбновленияПанелька <> Неопределено И ГлубинаПакетаОбновленияПанелька > 0 Тогда
		Возврат;
	КонецЕсли;
	Если ПредставленияАктуальныПанелька Тогда
		Возврат;
	КонецЕсли;
	План = ПрочитатьПланОбновленияПанелька(ЖурналИзмененийПанелька);
	Если ПустаяСтрока(ТолькоСсылкаИД) И Не План.Full И План.Links.Количество() > 0
		И План.Links.Количество() < ТаблицаСсылок.Количество() Тогда
		Для Каждого ИДСсылки Из План.Links Цикл
			ОбновитьПредставленияСсылкиПанелька(ИДСсылки);
		КонецЦикла;
		ПредставленияАктуальныПанелька = Истина;
		ВерсияОбновленияПанелька = ВерсияОбновленияПанелька + 1;
		ЗаполнитьРедактор();
		Возврат;
	КонецЕсли;
	Если Не ПустаяСтрока(ТолькоСсылкаИД) Тогда
		ОбновитьПредставленияСсылкиПанелька(ТолькоСсылкаИД);
		ПредставленияАктуальныПанелька = Истина;
		ВерсияОбновленияПанелька = ВерсияОбновленияПанелька + 1;
		ЗаполнитьРедактор();
		Возврат;
	КонецЕсли;
	СтраницыПоИД = ИндексСтрокПоИДПанелька(ТаблицаСтраниц);
	КолонкиПоИД = ИндексСтрокПоИДПанелька(ТаблицаКолонок);
	РазмещенияПоСсылке = ИндексРазмещенийПанелька();
	Обработка = РеквизитФормыВЗначение("Объект");
	Для Каждого КолонкаПанели Из ТаблицаКолонок Цикл
		Страница = СтраницыПоИД[КолонкаПанели.ИДСтраницы];
		КолонкаПанели.Страница = ?(Страница = Неопределено, "", Страница.ИмяСтраницы);
	КонецЦикла;
	Для Каждого СсылкаКаталога Из ТаблицаСсылок Цикл
		Если Не ПустаяСтрока(ТолькоСсылкаИД) И СсылкаКаталога.ИД <> ТолькоСсылкаИД Тогда
			Продолжить;
		КонецЕсли;
		СсылкаКаталога.ВидИсточника = ПредставлениеИсточника(СсылкаКаталога.Источник);
		Колонки = Новый Массив;
		Для Каждого РазмещениеСсылки Из РазмещенияПоСсылке[СсылкаКаталога.ИД] Цикл
			КолонкаПанели = КолонкиПоИД[РазмещениеСсылки.ИДКолонки];
			Если КолонкаПанели = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			РазмещениеСсылки.ИмяКолонки = КолонкаПанели.ИмяКолонки;
			Свойства = Обработка.ПанелькаСвойстваРазмещения(СсылкаКаталога, РазмещениеСсылки);
			РазмещениеСсылки.ИтоговоеНаименование = Свойства.Наименование;
			РазмещениеСсылки.ИтоговаяПодсказка = Свойства.Подсказка;
			РазмещениеСсылки.РежимПодсказки = ?(РазмещениеСсылки.СвояПодсказка, "Только эта колонка", "Общая подсказка");
			Колонки.Добавить(КолонкаПанели.ИмяКолонки);
		КонецЦикла;
		СсылкаКаталога.КолонкиПредставление = СтрСоединить(Колонки, ", ");
	КонецЦикла;
	ПредставленияАктуальныПанелька = Истина;
	ВерсияОбновленияПанелька = ВерсияОбновленияПанелька + 1;
	ЗаполнитьРедактор();
КонецПроцедуры

// Пересчитывает только размещения изменённой ссылки; структура колонок не меняется.
&НаСервере
Процедура ОбновитьПредставленияСсылкиПанелька(СсылкаИД)
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", СсылкаИД);
	Если СсылкаКаталога = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СсылкаКаталога.ВидИсточника = ПредставлениеИсточника(СсылкаКаталога.Источник);
	Обработка = РеквизитФормыВЗначение("Объект");
	Колонки = Новый Массив;
	Для Каждого РазмещениеСсылки Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", СсылкаИД)) Цикл
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", РазмещениеСсылки.ИДКолонки);
		Если КолонкаПанели = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РазмещениеСсылки.ИмяКолонки = КолонкаПанели.ИмяКолонки;
		Свойства = Обработка.ПанелькаСвойстваРазмещения(СсылкаКаталога, РазмещениеСсылки);
		РазмещениеСсылки.ИтоговоеНаименование = Свойства.Наименование;
		РазмещениеСсылки.ИтоговаяПодсказка = Свойства.Подсказка;
		РазмещениеСсылки.РежимПодсказки = ?(РазмещениеСсылки.СвояПодсказка, "Только эта колонка", "Общая подсказка");
		Колонки.Добавить(КолонкаПанели.ИмяКолонки);
	КонецЦикла;
	СсылкаКаталога.КолонкиПредставление = СтрСоединить(Колонки, ", ");
КонецПроцедуры

// Возвращает пользовательское название источника ссылки.
&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеИсточника(Источник)
	Возврат ?(Источник = "objects", "Объект 1С", ?(Источник = "files", "Файл", ?(Источник = "web", "Веб-ссылка",
		"Доп. обработка")));
КонецФункции

// Устанавливает выбранную ссылку и заполняет её редактор.
&НаСервере
Процедура ВыбратьСсылку(ИдентификаторСсылки, КолонкаИмя = "")
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ИдентификаторСсылки);
	Если СсылкаКаталога = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыбраннаяСсылкаИД = ИдентификаторСсылки;
	ВыбранныйТип = "Link";
	Размещения = ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", ИдентификаторСсылки));
	Если Размещения.Количество() = 0 Тогда
		СоздатьРазмещение(ИдентификаторСсылки, "column-unassigned");
		Размещения = ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", ИдентификаторСсылки));
	КонецЕсли;
	ВыбранноеРазмещениеИД = Размещения[0].ИД;
	Для Каждого РазмещениеСсылки Из Размещения Цикл
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", РазмещениеСсылки.ИДКолонки);
		Если КолонкаПанели <> Неопределено И КолонкаПанели.ИД = КолонкаИмя Тогда
			ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьРедактор();
КонецПроцедуры

// Заполняет серверное представление редактора общими или индивидуальными свойствами.
&НаСервере
Процедура ЗаполнитьРедактор()
	СсылкаИД = ЗаполнитьРедакторСсылкиПанелька(ЭтотОбъект);
	Если СсылкаИД <> Неопределено Тогда
		Элементы.Размещения.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИДСсылки", СсылкаИД));
	КонецЕсли;
КонецПроцедуры

// Общее представление полей ссылки, наследования и видимости пути для обоих контекстов.
// Форма — УправляемаяФорма. Возврат — ИД ссылки (Строка), либо Неопределено при отсутствии размещения.
&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнитьРедакторСсылкиПанелька(Форма)
	СсылкаКаталога = НайтиСтрокуМодели(Форма.ТаблицаСсылок, "ИД", Форма.ВыбраннаяСсылкаИД);
	РазмещениеСсылки = НайтиСтрокуМодели(Форма.ТаблицаРазмещений, "ИД", Форма.ВыбранноеРазмещениеИД);
	УстановитьСвойствоЭлементаПанелька(Форма.Элементы.РедакторСсылки, "Доступность", СсылкаКаталога <> Неопределено);
	Если СсылкаКаталога = Неопределено Тогда
		Форма.РедакторАдрес = "";
		Форма.РедакторНазвание = "";
		Форма.РедакторПодсказка = "";
		Форма.РедакторКолонка = "";
		Форма.РедакторСвоеНазвание = Ложь;
		Форма.РедакторСвояПодсказка = Ложь;
		Форма.РедакторПорядок = 0;
		Возврат "";
	КонецЕсли;
	Если РазмещениеСсылки = Неопределено Или РазмещениеСсылки.ИДСсылки <> СсылкаКаталога.ИД Тогда
		Строки = Форма.ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", СсылкаКаталога.ИД));
		Если Строки.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		РазмещениеСсылки = Строки[0];
		Форма.ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД;
	КонецЕсли;
	Форма.РедакторАдрес = СсылкаКаталога.Ссылка;
	Форма.Элементы.РедакторАдрес.Видимость = Не СкрыватьПутьДополнительногоИнструментаПанелька(СсылкаКаталога.Ссылка, СсылкаКаталога.Источник,
		Форма.МожноРедактироватьОбщуюПанельПанелька);
	Форма.РедакторСвоеНазвание = РазмещениеСсылки.СвоеНаименование;
	Форма.РедакторСвояПодсказка = РазмещениеСсылки.СвояПодсказка;
	Форма.РедакторНазвание = ?(РазмещениеСсылки.СвоеНаименование, РазмещениеСсылки.Наименование, СсылкаКаталога.Наименование);
	Форма.РедакторПодсказка = ?(РазмещениеСсылки.СвояПодсказка, РазмещениеСсылки.Подсказка, СсылкаКаталога.Подсказка);
	КолонкаПанели = НайтиСтрокуМодели(Форма.ТаблицаКолонок, "ИД", РазмещениеСсылки.ИДКолонки);
	Форма.РедакторКолонка = ?(КолонкаПанели = Неопределено, "", КолонкаПанели.ИмяКолонки);
	Форма.РедакторПорядок = РазмещениеСсылки.Порядок;
	Возврат СсылкаКаталога.ИД;
КонецФункции

// Единое правило показа пути для обоих редакторов; проверка права при записи — на сервере.
&НаКлиентеНаСервереБезКонтекста
Функция СкрыватьПутьДополнительногоИнструментаПанелька(Адрес, Источник, Администратор)
	Если Администратор Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Источник = "extra" Тогда
		Возврат Истина;
	КонецЕсли;
	Нижний = НРег(СокрЛП(Адрес));
	Если Лев(Нижний, 9) = "web_link:" Тогда
		Возврат СкрыватьПутьДополнительногоИнструментаПанелька(Сред(Нижний, 10), Источник, Администратор);
	КонецЕсли;
	Путь = СтрРазделить(Нижний, "?")[0];
	Возврат Путь = "e1cib/data/справочник.внешниеобработки"
		Или Путь = "e1cib/data/справочник.дополнительныеотчетыиобработки";
КонецФункции

// Записывает общие и индивидуальные свойства ссылки с учётом области применения.
// Оба интерфейса вызывают одну операцию. Флажок определяет область записи,
// но не доступность поля. При общем режиме меняется именно каталог.
&НаСервере
Процедура ЗаписатьСвойстваСсылки(СсылкаИД, РазмещениеИД, Название, Подсказка, СвоеНазвание, СвояПодсказка, Адрес)
	ОтметитьИзменениеПанелька("link", СсылкаИД);
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", СсылкаИД);
	РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", РазмещениеИД);
	Если СсылкаКаталога = Неопределено Или РазмещениеСсылки = Неопределено Или РазмещениеСсылки.ИДСсылки <> СсылкаКаталога.ИД Тогда
		ВызватьИсключение НСтр("ru = 'Выберите существующее размещение ссылки.'");
	КонецЕсли;
	// Адрес дополнительного инструмента не редактируется обычным пользователем.
	// HTML без поля пути не отправляет url; сохраняем исходный адрес на сервере.
	Если СкрыватьПутьДополнительногоИнструментаПанелька(СсылкаКаталога.Ссылка, СсылкаКаталога.Источник, ПравоДоступа("Администрирование",
		Метаданные)) Тогда
		Если Не ПустаяСтрока(Адрес) И СокрЛП(Адрес) <> СсылкаКаталога.Ссылка Тогда
			ВызватьИсключение НСтр("ru = 'Изменять адрес дополнительного отчёта или обработки может только администратор.'");
		КонецЕсли;
		Адрес = СсылкаКаталога.Ссылка;
	КонецЕсли;
	Если ПустаяСтрока(Название) Или ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение НСтр("ru = 'Заполните название и адрес ссылки.'");
	КонецЕсли;
	Если СсылкаКаталога.Ссылка <> СокрЛП(Адрес) Тогда
		ПроверитьФорматАдресаПанелька(СсылкаКаталога.Источник, Адрес);
	КонецЕсли;
	Если ПерсональнаяНастройкаПанелька И СсылкаКаталога.Ссылка <> СокрЛП(Адрес) Тогда
		Если Не РеквизитФормыВЗначение("Объект").ПанелькаСсылкаДоступнаЛично(Адрес, СсылкаКаталога.Источник) Тогда
			ВызватьИсключение НСтр("ru = 'Источник нового адреса запрещён администратором или объект недоступен.'");
		КонецЕсли;
	КонецЕсли;
	Для Каждого Другая Из ТаблицаСсылок Цикл
		Если Другая.ИД <> СсылкаКаталога.ИД И Другая.Источник = СсылкаКаталога.Источник И Другая.Ссылка = СокрЛП(Адрес) Тогда
			ВызватьИсключение НСтр("ru = 'Этот адрес уже есть в каталоге. Добавьте для существующей ссылки размещение.'");
		КонецЕсли;
	КонецЦикла;
	Если СсылкаКаталога.Ссылка = СокрЛП(Адрес) И РазмещениеСсылки.СвоеНаименование = СвоеНазвание И РазмещениеСсылки.СвояПодсказка = СвояПодсказка
		И Название = ?(СвоеНазвание, РазмещениеСсылки.Наименование, СсылкаКаталога.Наименование)
		И Подсказка = ?(СвояПодсказка, РазмещениеСсылки.Подсказка, СсылкаКаталога.Подсказка) Тогда
		Возврат;
	КонецЕсли;
	СсылкаКаталога.Ссылка = СокрЛП(Адрес);
	РазмещениеСсылки.СвоеНаименование = СвоеНазвание;
	РазмещениеСсылки.СвояПодсказка = СвояПодсказка;
	Если СвоеНазвание Тогда
		РазмещениеСсылки.Наименование = Название;
	Иначе
		СсылкаКаталога.Наименование = Название;
		РазмещениеСсылки.Наименование = "";
	КонецЕсли;
	Если СвояПодсказка Тогда
		РазмещениеСсылки.Подсказка = Подсказка;
	Иначе
		СсылкаКаталога.Подсказка = Подсказка;
		РазмещениеСсылки.Подсказка = "";
	КонецЕсли;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления(СсылкаИД);
КонецПроцедуры

// Переключает наследование свойств выбранного размещения.
&НаСервере
Процедура ИзменитьРежимРедактора()
	ОтметитьИзменениеПанелька("link", ВыбраннаяСсылкаИД);
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ВыбраннаяСсылкаИД);
	РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
	Если СсылкаКаталога = Неопределено Или РазмещениеСсылки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если РедакторСвоеНазвание И Не РазмещениеСсылки.СвоеНаименование Тогда
		РазмещениеСсылки.Наименование = СсылкаКаталога.Наименование;
	КонецЕсли;
	Если РедакторСвояПодсказка И Не РазмещениеСсылки.СвояПодсказка Тогда
		РазмещениеСсылки.Подсказка = СсылкаКаталога.Подсказка;
	КонецЕсли;
	РазмещениеСсылки.СвоеНаименование = РедакторСвоеНазвание;
	РазмещениеСсылки.СвояПодсказка = РедакторСвояПодсказка;
	Если Не РазмещениеСсылки.СвоеНаименование Тогда
		РазмещениеСсылки.Наименование = "";
	КонецЕсли;
	Если Не РазмещениеСсылки.СвояПодсказка Тогда
		РазмещениеСсылки.Подсказка = "";
	КонецЕсли;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления(ВыбраннаяСсылкаИД);
КонецПроцедуры

// Распространяет общую подсказку на все размещения ссылки.
&НаСервере
Процедура ПрименитьПодсказкуВсем(ИдентификаторСсылки, Текст)
	ОтметитьИзменениеПанелька("link", ИдентификаторСсылки);
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ИдентификаторСсылки);
	Если СсылкаКаталога = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СсылкаКаталога.Подсказка = Текст;
	Для Каждого РазмещениеСсылки Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", ИдентификаторСсылки)) Цикл
		РазмещениеСсылки.СвояПодсказка = Ложь;
		РазмещениеСсылки.Подсказка = "";
	КонецЦикла;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления(ИдентификаторСсылки);
КонецПроцедуры

// Возвращает размещению общие название и подсказку.
&НаСервере
Процедура СброситьСвойстваРазмещения(ИдентификаторРазмещения)
	РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ИдентификаторРазмещения);
	Если РазмещениеСсылки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтметитьИзменениеПанелька("link", РазмещениеСсылки.ИДСсылки);
	РазмещениеСсылки.СвоеНаименование = Ложь;
	РазмещениеСсылки.СвояПодсказка = Ложь;
	РазмещениеСсылки.Наименование = "";
	РазмещениеСсылки.Подсказка = "";
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления(РазмещениеСсылки.ИДСсылки);
КонецПроцедуры

// Добавляет ссылку в каталог и размещает её в целевой колонке без дублирования каталога.
&НаСервере
Функция ДобавитьСсылку(Источник, Адрес, Название, Подсказка, КолонкаИмя = "",
	ОбновлятьПредставление = Истина, КонтекстДоступа = Неопределено)
	Описание = ОписаниеДобавляемойСсылкиПанелька(Источник, Адрес, Название, Подсказка, КолонкаИмя);
	Возврат ДобавитьСсылкуПоОписаниюПанелька(Описание, ОбновлятьПредставление, КонтекстДоступа);
КонецФункции

// Собирает описание для общего механизма одиночного и пакетного добавления.
&НаСервереБезКонтекста
Функция ОписаниеДобавляемойСсылкиПанелька(Источник, Адрес, Название, Подсказка, Колонка)
	Описание = Новый Структура;
	Описание.Вставить("Источник", Источник);
	Описание.Вставить("Адрес", Адрес);
	Описание.Вставить("Название", Название);
	Описание.Вставить("Подсказка", Подсказка);
	Описание.Вставить("Колонка", Колонка);
	Возврат Описание;
КонецФункции

// Проверяет право платформы для источников, которые подключаются как внешние файлы.
&НаСервереБезКонтекста
Функция ЕстьПравоДобавленияИнструментаПанелька(Источник, НижнийАдрес)
	Если Источник = "files" Или Лев(НижнийАдрес, 9) = "ext_file:" Тогда
		Расширение = Прав(НижнийАдрес, 4);
		Если Расширение = ".erf" Тогда
			Возврат ПравоДоступа("ИнтерактивноеОткрытиеВнешнихОтчетов", Метаданные);
		КонецЕсли;
		Возврат Расширение = ".epf" И ПравоДоступа("ИнтерактивноеОткрытиеВнешнихОбработок", Метаданные);
	КонецЕсли;
	Если Лев(НижнийАдрес, 8) = "sys_cmd:" Или Лев(НижнийАдрес, 8) = "v8res://" Тогда
		Возврат ПравоДоступа("ИнтерактивноеОткрытиеВнешнихОбработок", Метаданные);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Проверяет тип файловой ссылки и исключает передачу пути как веб-адреса.
&НаСервереБезКонтекста
Процедура ПроверитьФорматАдресаПанелька(Источник, Знач Адрес)
	Адрес = СокрЛП(Адрес);
	НижнийАдрес = НРег(Адрес);
	Если Источник = "files" Тогда
		Расширение = Прав(НижнийАдрес, 4);
		Если Расширение <> ".epf" И Расширение <> ".erf" Тогда
			ВызватьИсключение НСтр("ru = 'Поддерживаются только внешние обработки EPF и отчёты ERF.'");
		КонецЕсли;
		Если Не ЕстьПравоДобавленияИнструментаПанелька(Источник, НижнийАдрес) Тогда
			ВызватьИсключение НСтр("ru = 'Недостаточно прав для добавления этого внешнего отчёта или обработки.'");
		КонецЕсли;
	ИначеЕсли Источник <> "web" И (Лев(НижнийАдрес, 8) = "sys_cmd:" Или Лев(НижнийАдрес, 8) = "v8res://") Тогда
		Если Не ЕстьПравоДобавленияИнструментаПанелька(Источник, НижнийАдрес) Тогда
			ВызватьИсключение НСтр("ru = 'Недостаточно прав для добавления стандартного инструмента.'");
		КонецЕсли;
	ИначеЕсли Источник = "web" Тогда
		Если Лев(НижнийАдрес, 7) <> "http://" И Лев(НижнийАдрес, 8) <> "https://"
			И Лев(НижнийАдрес, 6) <> "ftp://" И Лев(НижнийАдрес, 7) <> "mailto:" Тогда
			ВызватьИсключение НСтр("ru = 'Недопустимый адрес веб-ссылки.'");
		КонецЕсли;
	ИначеЕсли Лев(НижнийАдрес, 9) = "ext_file:" Или Лев(НижнийАдрес, 5) = "file:"
		Или Лев(Адрес, 1) = "/" Или Лев(Адрес, 1) = "\" Или Сред(Адрес, 2, 1) = ":" Тогда
		ВызватьИсключение НСтр("ru = 'Добавляйте файлы EPF и ERF через источник внешних файлов.'");
	КонецЕсли;
КонецПроцедуры

// Выполняет общее добавление; пакет передаёт индексы текущей операции.
&НаСервере
Функция ДобавитьСсылкуПоОписаниюПанелька(Описание, ОбновлятьПредставление = Истина,
	КонтекстДоступа = Неопределено, ИндексДобавления = Неопределено, ЧастичныйHTML = Ложь)
	Источник = Описание.Источник;
	Адрес = Описание.Адрес;
	Название = Описание.Название;
	Подсказка = Описание.Подсказка;
	КолонкаИмя = Описание.Колонка;
	Если Не ПустаяСтрока(Адрес) Тогда
		ПроверитьФорматАдресаПанелька(Источник, Адрес);
	КонецЕсли;
	Если ПерсональнаяНастройкаПанелька Тогда
		ОбработкаДоступа = РеквизитФормыВЗначение("Объект");
		Если Не ОбработкаДоступа.ПанелькаСсылкаДоступнаЛично(Адрес, Источник, Неопределено, Неопределено,
			КонтекстДоступа) Тогда
			ВызватьИсключение НСтр("ru = 'Источник запрещён администратором или нет доступа к объекту этой ссылки. Добавление отменено.'");
		КонецЕсли;
	КонецЕсли;
	Если Не ЧастичныйHTML Тогда
		ОтметитьИзменениеПанелька("full");
	КонецЕсли;
	Если Источник = "extra" Тогда
		СброситьКэшТиповДопПанелька();
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Тогда
		Возврат "";
	КонецЕсли;
	СсылкаКаталога = Неопределено;
	Если ИндексДобавления = Неопределено Тогда
		Для Каждого Стр Из ТаблицаСсылок Цикл
			Если Стр.Источник = Источник И Стр.Ссылка = СокрЛП(Адрес) Тогда
				СсылкаКаталога = Стр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		СсылкиИсточника = ИндексДобавления.СсылкиПоИсточникам[Источник];
		Если СсылкиИсточника <> Неопределено Тогда
			СсылкаКаталога = СсылкиИсточника[СокрЛП(Адрес)];
		КонецЕсли;
	КонецЕсли;
	Если СсылкаКаталога = Неопределено Тогда
		ПодсказкаНовойСсылки = Подсказка;
		ОбработкаКомментария = РеквизитФормыВЗначение("Объект");
		Если ОбработкаКомментария.ПанелькаЭтоДополнительнаяСсылка(Адрес, Источник) Тогда
			ПодсказкаНовойСсылки = "";
		КонецЕсли;
		Если ЗаполнятьКомментарийИзМетаданных И ПустаяСтрока(ПодсказкаНовойСсылки) Тогда
			Если КэшКомментариевДобавленияПанелька = Неопределено Тогда
				КэшКомментариевДобавленияПанелька = Новый Структура;
			КонецЕсли;
			ПодсказкаНовойСсылки = ОбработкаКомментария.ПанелькаКомментарийНовойСсылки(Адрес,
				ПерсональнаяНастройкаПанелька, КэшКомментариевДобавленияПанелька, КонтекстДоступа);
		КонецЕсли;
		СсылкаКаталога = ТаблицаСсылок.Добавить();
		СсылкаКаталога.ИД = Строка(Новый УникальныйИдентификатор);
		СсылкаКаталога.Источник = Источник;
		СсылкаКаталога.Ссылка = СокрЛП(Адрес);
		СсылкаКаталога.Наименование = ?(ПустаяСтрока(Название), Адрес, Название);
		СсылкаКаталога.Подсказка = ПодсказкаНовойСсылки;
		Если ИндексДобавления <> Неопределено Тогда
			СсылкиИсточника = ИндексДобавления.СсылкиПоИсточникам[Источник];
			Если СсылкиИсточника = Неопределено Тогда
				СсылкиИсточника = Новый Соответствие;
				ИндексДобавления.СсылкиПоИсточникам.Вставить(Источник, СсылкиИсточника);
			КонецЕсли;
			СсылкиИсточника.Вставить(СсылкаКаталога.Ссылка, СсылкаКаталога);
		КонецЕсли;
	КонецЕсли;
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", КолонкаИмя);
	ИДКолонки = ?(КолонкаПанели = Неопределено, "column-unassigned", КолонкаПанели.ИД);
	Если ЧастичныйHTML Тогда
		// Прежнее размещение нужно включить в ответ до его переноса или удаления.
		ОтметитьИзменениеПанелька("link", СсылкаКаталога.ИД);
	КонецЕсли;
	Если ИДКолонки <> "column-unassigned" Тогда
		Нераспр = НайтиРазмещениеПоСвязи(СсылкаКаталога.ИД, "column-unassigned", ИндексДобавления);
		Если Нераспр <> Неопределено Тогда
			// Первое назначение сохраняет свойства размещения из нераспределённых.
			Если НайтиРазмещениеПоСвязи(СсылкаКаталога.ИД, ИДКолонки, ИндексДобавления) = Неопределено Тогда
				Нераспр.ИДКолонки = ИДКолонки;
				ОбновитьИндексРазмещенияДобавленияПанелька(ИндексДобавления, Нераспр, "column-unassigned");
			Иначе
				ОбновитьИндексРазмещенияДобавленияПанелька(ИндексДобавления, Нераспр, "column-unassigned", Истина);
				ТаблицаРазмещений.Удалить(Нераспр);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	РазмещениеСсылки = СоздатьРазмещение(СсылкаКаталога.ИД, ИДКолонки, ИндексДобавления);
	Если ЧастичныйHTML Тогда
		ОтметитьИзменениеПанелька("link", СсылкаКаталога.ИД);
	КонецЕсли;
	ВыбраннаяСсылкаИД = СсылкаКаталога.ИД;
	ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД;
	ВыбранныйТип = "Link";
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	Если ОбновлятьПредставление Тогда
		ОбновитьПредставления();
	КонецЕсли;
	Возврат СсылкаКаталога.ИД;
КонецФункции

// Удаляет размещение через общую пакетную операцию удаления.
&НаСервере
Процедура СнятьРазмещение(СсылкаИД, КолонкаИмя)
	Колонка = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", КолонкаИмя);
	Если Колонка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Размещение = НайтиРазмещениеПоСвязи(СсылкаИД, Колонка.ИД);
	Если Размещение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Пакет = Новый Массив;
	Пакет.Добавить(Новый Структура("Вид,ИД", "Link", Размещение.ИД));
	ВыполнитьПакетСерверПанелька("delete", Пакет, "");
КонецПроцедуры

// Удаляет ссылку из каталога вместе со всеми её размещениями.
&НаСервере
Процедура УдалитьСсылку(ИдентификаторСсылки)
	ОтметитьИзменениеПанелька("full");
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ИдентификаторСсылки);
	Если СсылкаКаталога = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого РазмещениеСсылки Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", ИдентификаторСсылки)) Цикл
		ТаблицаРазмещений.Удалить(РазмещениеСсылки);
	КонецЦикла;
	ТаблицаСсылок.Удалить(СсылкаКаталога);
	ВыбраннаяСсылкаИД = "";
	ВыбранноеРазмещениеИД = "";
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления();
КонецПроцедуры

#КонецОбласти

#Область ЗакрытиеФормы

// Обрабатывает сохранение, отказ от записи или отмену закрытия.
//
// Параметры:
//  Результат - Строка, КодВозвратаДиалога - save, discard или отмена.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеПодтвержденияЗакрытияПанелька(Результат, Контекст) Экспорт
	ВопросЗакрытияПанелька = Ложь;
	Если Результат = "save" Тогда
		СохранитьНастройкиИЗакрытьПанелька();
	ИначеЕсли Результат = "discard" Тогда
		ЗакрытиеПодтвержденоПанелька = Истина;
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СтраницыКолонкиИПорядок

// Подбирает свободное имя элемента структуры.
&НаСервере
Функция НовоеИмя(Таблица, Поле, Основа)
	Имя = Основа;
	Номер = 1;
	Пока НайтиСтрокуМодели(Таблица, Поле, Имя) <> Неопределено Цикл
		Номер = Номер + 1;
		Имя = Основа + " " + Строка(Номер);
	КонецЦикла;
	Возврат Имя;
КонецФункции

// Добавляет страницу в модель с уникальным именем.
&НаСервере
Процедура ДобавитьСтраницуМодели(Имя)
	ОтметитьИзменениеПанелька("full");
	Имя = СокрЛП(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Имя = НовоеИмя(ТаблицаСтраниц, "ИмяСтраницы", "Новая страница");
	КонецЕсли;
	Если НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", Имя) <> Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Страница с таким именем уже есть.'");
	КонецЕсли;
	Стр = ТаблицаСтраниц.Добавить();
	Стр.ИД = Строка(Новый УникальныйИдентификатор);
	Стр.ИмяСтраницы = Имя;
	Стр.ИмяКартинки = "Папка";
	Стр.Порядок = ТаблицаСтраниц.Количество() * 10;
	HTMLНастройкиАктивнаяСтраница = Имя;
	ВыбранныйТип = "Page";
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
КонецПроцедуры

// Добавляет колонку на выбранную страницу.
&НаСервере
Процедура ДобавитьКолонкуМодели(Имя, СтраницаИмя)
	ОтметитьИзменениеПанелька("full");
	Имя = СокрЛП(Имя);
	Страница = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", СтраницаИмя);
	Если Страница = Неопределено Тогда
		Страница = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", "page-main");
	КонецЕсли;
	Если Страница.ИД = "page-standard" Или Страница.ИД = "page-unassigned" Тогда
		ВызватьИсключение НСтр("ru = 'Выберите пользовательскую страницу.'");
	КонецЕсли;
	Если ПустаяСтрока(Имя) Тогда
		Имя = "Новая колонка";
		НомерКолонки = 1;
		Пока НайтиКолонкуНаСтраницеПанелька(ТаблицаКолонок, Страница.ИД, Имя) <> Неопределено Цикл
			НомерКолонки = НомерКолонки + 1;
			Имя = "Новая колонка " + Строка(НомерКолонки);
		КонецЦикла;
	КонецЕсли;
	Если НайтиКолонкуНаСтраницеПанелька(ТаблицаКолонок, Страница.ИД, Имя) <> Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'На выбранной странице уже есть колонка с таким названием.'");
	КонецЕсли;
	КолонкаПанели = ТаблицаКолонок.Добавить();
	КолонкаПанели.ИД = Строка(Новый УникальныйИдентификатор);
	КолонкаПанели.ИДСтраницы = Страница.ИД;
	КолонкаПанели.ИмяКолонки = Имя;
	КолонкаПанели.ИмяКартинки = "Папка";
	КолонкаПанели.Порядок = ТаблицаКолонок.Количество() * 10;
	HTMLНастройкиАктивнаяСтраница = Страница.ИмяСтраницы;
	HTMLНастройкиАктивнаяКолонка = КолонкаПанели.ИД;
	ВыбранныйТип = "Column";
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления();
КонецПроцедуры

// Переименовывает страницу или колонку и согласует связанные представления.
&НаСервере
Процедура ИзменитьСтруктуруМодели(Вид, СтароеИмя, НовоеИмя, СтраницаИмя = "")
	ТаблицаСтруктуры = ?(Вид = "page", ТаблицаСтраниц, ТаблицаКолонок);
	Поле = ?(Вид = "page", "ИмяСтраницы", "ИмяКолонки");
	Стр = НайтиСтрокуМодели(ТаблицаСтруктуры, Поле, СтароеИмя);
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоСистемныйИД(Стр.ИД) Тогда
		ВызватьИсключение НСтр("ru = 'Системное имя изменять нельзя.'");
	КонецЕсли;
	НовоеИмя = СокрЛП(НовоеИмя);
	Если ПустаяСтрока(НовоеИмя) Тогда
		ВосстановитьНазваниеСтруктурыПанелька(Вид, Стр);
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Название не может быть пустым. Восстановлено прежнее название: «%1».'"),
			Стр[Поле]));
		Возврат;
	КонецЕсли;
	ЦелеваяСтраницаИД = "";
	Если Вид = "column" Тогда
		ЦелеваяСтраницаИД = Стр.ИДСтраницы;
		СтраницаНазначения = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", СтраницаИмя);
		Если СтраницаНазначения <> Неопределено Тогда
			ЦелеваяСтраницаИД = СтраницаНазначения.ИД;
		КонецЕсли;
	КонецЕсли;
	Для Каждого Другая Из ТаблицаСтруктуры Цикл
		Если Вид = "column" И Другая.ИДСтраницы <> ЦелеваяСтраницаИД Тогда
			Продолжить;
		КонецЕсли;
		Если Другая.ИД <> Стр.ИД И НРег(Другая[Поле]) = НРег(НовоеИмя) Тогда
			ВосстановитьНазваниеСтруктурыПанелька(Вид, Стр);
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = '%1 Восстановлено прежнее название: «%2».'"), ?(Вид = "page",
				"Страница с таким названием уже существует.",
				"На выбранной странице уже есть колонка с таким названием."), Стр[Поле]));
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ОтметитьИзменениеПанелька("headers");
	Если Вид = "page" Тогда
		Для Каждого КолонкаСтраницы Из ТаблицаКолонок.НайтиСтроки(Новый Структура("ИДСтраницы", Стр.ИД)) Цикл
			ОтметитьИзменениеПанелька("column", КолонкаСтраницы.ИД);
			КолонкаСтраницы.Страница = НовоеИмя;
		КонецЦикла;
	Иначе
		ОтметитьИзменениеПанелька("column", Стр.ИД);
	КонецЕсли;
	Если Вид = "column" Тогда
		Страница = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", СтраницаИмя);
		Если Страница <> Неопределено Тогда
			Если Страница.ИД = "page-standard" Или Страница.ИД = "page-unassigned" Тогда
				ВызватьИсключение НСтр("ru = 'Нельзя перенести колонку на системную страницу.'");
			КонецЕсли;
			Если Стр.ИДСтраницы <> Страница.ИД Тогда
				ОтметитьИзменениеПанелька("full");
			КонецЕсли;
			Стр.ИДСтраницы = Страница.ИД;
		КонецЕсли;
	КонецЕсли;
	Стр[Поле] = НовоеИмя;
	Если Вид = "page" Тогда
		HTMLНастройкиАктивнаяСтраница = НовоеИмя;
	Иначе
		HTMLНастройкиАктивнаяКолонка = Стр.ИД;
	КонецЕсли;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления();
КонецПроцедуры

// Отменяет невалидный ввод без изменения модели и признака несохранённых правок.
// Web-редактор получает прежние значения из модели в штатном ответе команды.
&НаСервере
Процедура ВосстановитьНазваниеСтруктурыПанелька(Вид, СтрокаСтруктуры)
	Если Вид = "page" Тогда
		СтруктураНазвание = СтрокаСтруктуры.ИмяСтраницы;
	Иначе
		СтруктураНазвание = СтрокаСтруктуры.ИмяКолонки;
		СтраницаКолонки = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", СтрокаСтруктуры.ИДСтраницы);
		Если СтраницаКолонки <> Неопределено Тогда
			СтруктураСтраница = СтраницаКолонки.ИмяСтраницы;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Определяет, относится ли идентификатор к встроенному элементу структуры.
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСистемныйИД(Идентификатор)
	Возврат СтрРазделить("page-main,page-standard,page-unassigned,column-standard,column-unassigned",
		",").Найти(Идентификатор) <> Неопределено;
КонецФункции

// Удаляет колонку, обрабатывая её размещения.
&НаСервере
Процедура УдалитьКолонкуМодели(Имя, Режим = "unassign")
	НачатьПакетОбновленияПанелька();
	Попытка
		УдалитьКолонкуМоделиБезОбновления(Имя, Режим);
	Исключение
		ПрерватьПакетОбновленияПанелька();
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьПакетОбновленияПанелька();
КонецПроцедуры

// Внутренняя часть пакетной операции; вызывается через внешний обработчик.
&НаСервере
Процедура УдалитьКолонкуМоделиБезОбновления(Имя, Режим = "unassign")
		Если Режим <> "unassign" И Режим <> "delete_links" Тогда
			ВызватьИсключение НСтр("ru = 'Неизвестный способ удаления колонки.'");
		КонецЕсли;
	ОтметитьИзменениеПанелька("full");
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", Имя);
	Если КолонкаПанели = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоСистемныйИД(КолонкаПанели.ИД) Тогда
		ВызватьИсключение НСтр("ru = 'Системная колонка не удаляется.'");
	КонецЕсли;
	Строки = ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДКолонки", КолонкаПанели.ИД));
	Для Каждого РазмещениеСсылки Из Строки Цикл
		Если Режим = "delete_links" Тогда
				СсылкаИД = РазмещениеСсылки.ИДСсылки;
				ТаблицаРазмещений.Удалить(РазмещениеСсылки);
				// Удаление структуры затрагивает только её размещения.
				Если ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", СсылкаИД)).Количество() = 0 Тогда
					СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", СсылкаИД);
					Если СсылкаКаталога <> Неопределено Тогда
						ТаблицаСсылок.Удалить(СсылкаКаталога);
					КонецЕсли;
				КонецЕсли;
		Иначе
				Нераспределенное = НайтиРазмещениеПоСвязи(РазмещениеСсылки.ИДСсылки, "column-unassigned");
				Если Нераспределенное = Неопределено Тогда
					Максимум = 0;
					Для Каждого СтрокаПорядка Из ТаблицаРазмещений Цикл
						Если СтрокаПорядка.ИДКолонки = "column-unassigned" Тогда
							Максимум = Макс(Максимум, СтрокаПорядка.Порядок);
						КонецЕсли;
					КонецЦикла;
				РазмещениеСсылки.ИДКолонки = "column-unassigned";
					РазмещениеСсылки.Порядок = Максимум + 10;
			Иначе
					// Сохраняем существующее размещение и его индивидуальные свойства.
				ТаблицаРазмещений.Удалить(РазмещениеСсылки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ТаблицаКолонок.Удалить(КолонкаПанели);
	HTMLНастройкиАктивнаяКолонка = "";
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления();
КонецПроцедуры

// Удаляет страницу и обрабатывает находящиеся на ней колонки.
&НаСервере
Процедура УдалитьСтраницуМодели(Имя, Режим = "unassign")
	НачатьПакетОбновленияПанелька();
	Попытка
		УдалитьСтраницуМоделиБезОбновления(Имя, Режим);
	Исключение
		ПрерватьПакетОбновленияПанелька();
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьПакетОбновленияПанелька();
КонецПроцедуры

// Внутренняя часть пакетной операции; вызывается через внешний обработчик.
&НаСервере
Процедура УдалитьСтраницуМоделиБезОбновления(Имя, Режим = "unassign")
	Если Режим <> "unassign" И Режим <> "delete_links" Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестный способ удаления страницы.'");
	КонецЕсли;
	ОтметитьИзменениеПанелька("full");
	СтраницаПанели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", Имя);
	Если СтраницаПанели = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоСистемныйИД(СтраницаПанели.ИД) Тогда
		ВызватьИсключение НСтр("ru = 'Системная страница не удаляется.'");
	КонецЕсли;
	Колонки = ТаблицаКолонок.НайтиСтроки(Новый Структура("ИДСтраницы", СтраницаПанели.ИД));
	Для Каждого КолонкаПанели Из Колонки Цикл
		УдалитьКолонкуМодели(КолонкаПанели.ИД, Режим);
	КонецЦикла;
	ТаблицаСтраниц.Удалить(СтраницаПанели);
	HTMLНастройкиАктивнаяСтраница = "Главная";
	ВыбранныйТип = "Page";
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления();
КонецПроцедуры

// Изменяет порядок элемента внутри родительской структуры.
&НаСервере
Процедура ПереместитьМодель(Вид, ИдентификаторЭлемента, Направление)
	ИмяТаблицы = ?(Вид = "page", "ТаблицаСтраниц", ?(Вид = "column", "ТаблицаКолонок", "ТаблицаРазмещений"));
	Стр = НайтиСтрокуМодели(ЭтотОбъект[ИмяТаблицы], "ИД", ИдентификаторЭлемента);
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Вид <> "link" И ЭтоСистемныйИД(ИдентификаторЭлемента) Тогда
		Возврат;
	КонецЕсли;
	ТипыСсылок = Неопределено;
	Если Вид = "link" И ГруппироватьПоТипуОбъекта Тогда
		ТипыСсылок = Новый Соответствие;
		ТипыДоп = ПолучитьТипыДопИсточниковПанелька();
		СсылкиПоИД = ИндексСтрокПоИДПанелька(ТаблицаСсылок);
		Для Каждого РазмещениеСсылки Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДКолонки", Стр.ИДКолонки)) Цикл
			Если ТипыСсылок[РазмещениеСсылки.ИДСсылки] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СсылкаКаталога = СсылкиПоИД[РазмещениеСсылки.ИДСсылки];
			ТипыСсылок.Вставить(СсылкаКаталога.ИД,
				ОпределитьТипСсылкиHTML(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка, ТипыДоп));
		КонецЦикла;
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Порядки = Обработка.ПанелькаПланПеремещенияЭлемента(Вид, ЭтотОбъект[ИмяТаблицы], ИдентификаторЭлемента,
		Направление, ТипыСсылок);
	Если Порядки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИндексСтрок = ИндексСтрокПоИДПанелька(ЭтотОбъект[ИмяТаблицы]);
	Для Каждого ПараПорядка Из Порядки Цикл
		ИндексСтрок[ПараПорядка.Ключ].Порядок = ПараПорядка.Значение;
	КонецЦикла;
	Если Вид = "link" Тогда
		ОтметитьИзменениеПанелька("column", Стр.ИДКолонки);
	Иначе
		ОтметитьИзменениеПанелька("full");
	КонецЕсли;
	НастройкиИзменены = Истина;
	// Порядок не влияет на производные текстовые поля.
	ВерсияОбновленияПанелька = ВерсияОбновленияПанелька + 1;
	ЗаполнитьРедактор();
КонецПроцедуры

// Перемещает группу объектов внутри колонки.
&НаСервере
Процедура СдвинутьГруппуПанелька(КолонкаИД, ТипГруппы, Шаг, ПередГруппой = "")
	ОтметитьИзменениеПанелька("column", КолонкаИД);
	Если Не ГруппироватьПоТипуОбъекта Тогда
		Возврат;
	КонецЕсли;
	ТипыДоп = ПолучитьТипыДопИсточниковПанелька();
	СсылкиПоИД = ИндексСтрокПоИДПанелька(ТаблицаСсылок);
	РазмещенияПоИД = ИндексСтрокПоИДПанелька(ТаблицаРазмещений);
	Упорядоченные = ТаблицаРазмещений.Выгрузить();
	Упорядоченные.Сортировать("Порядок, ИД");
	Группы = Новый Массив;
	Состав = Новый Соответствие;
	Для Каждого РазмещениеСсылки Из Упорядоченные Цикл
		Если РазмещениеСсылки.ИДКолонки <> КолонкаИД Тогда
			Продолжить;
		КонецЕсли;
		СсылкаКаталога = СсылкиПоИД[РазмещениеСсылки.ИДСсылки];
		Если СсылкаКаталога = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТипОбъекта = ТипОбъектаОбычнойФормы(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка, ТипыДоп);
		Если Состав[ТипОбъекта] = Неопределено Тогда
			Группы.Добавить(ТипОбъекта);
			Состав.Вставить(ТипОбъекта, Новый Массив);
		КонецЕсли;
		Состав[ТипОбъекта].Добавить(РазмещениеСсылки.ИД);
	КонецЦикла;
	Индекс = Группы.Найти(ТипГруппы);
	Если Индекс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Шаг = 0 Тогда
		Если ПередГруппой = ТипГруппы Тогда
			Возврат;
		КонецЕсли;
		Если Не ПустаяСтрока(ПередГруппой) И Группы.Найти(ПередГруппой) = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Группы.Удалить(Индекс);
		Если ПустаяСтрока(ПередГруппой) Тогда
			Группы.Добавить(ТипГруппы);
		Иначе
			Группы.Вставить(Группы.Найти(ПередГруппой), ТипГруппы);
		КонецЕсли;
	Иначе
		Сосед = Индекс + Шаг;
		Если Сосед < 0 Или Сосед >= Группы.Количество() Тогда
			Возврат;
		КонецЕсли;
		ДругаяГруппа = Группы[Сосед];
		Группы[Сосед] = ТипГруппы;
		Группы[Индекс] = ДругаяГруппа;
	КонецЕсли;
	Порядок = 0;
	Для Каждого ТипОбъекта Из Группы Цикл
		Для Каждого ИД Из Состав[ТипОбъекта] Цикл
			Порядок = Порядок + 10;
			РазмещениеСсылки = РазмещенияПоИД[ИД];
			РазмещениеСсылки.Порядок = Порядок;
		КонецЦикла;
	КонецЦикла;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ЗаполнитьРедактор();
КонецПроцедуры

#КонецОбласти

#Область ПредставлениеHTML

// Переключает вкладки дополнительных настроек в текущем режиме редактора.
&НаКлиенте
Процедура ПереключитьДопНастройкиПанелька()
	ДопНастройкиОткрытыПанелька = Не ДопНастройкиОткрытыПанелька;
	ПрименитьРежимHTMLНастроек();
	Если ДопНастройкиОткрытыПанелька И Не ПерсональнаяНастройкаПанелька Тогда
		ОбновитьСписокПерсональныхПанелейПанелька();
	КонецЕсли;
	Если РежимHTMLНастроек И Не ДопНастройкиОткрытыПанелька Тогда
		ОбновитьHTMLНастроекЕслиНужно();
	КонецЕсли;
КонецПроцедуры

// Согласует видимость обычного редактора, HTML и дополнительных настроек.
&НаКлиенте
Процедура ПрименитьРежимHTMLНастроек()
	Элементы.ОформлениеКнопка.Видимость = Не РежимHTMLНастроек Или ДопНастройкиОткрытыПанелька;
	Элементы.ОформлениеКнопка.Пометка = ДопНастройкиОткрытыПанелька;
	Элементы.ГруппаОбычныеНастройки.Видимость = (Не РежимHTMLНастроек) Или ДопНастройкиОткрытыПанелька;
	Элементы.ПанельОформления.Видимость = ДопНастройкиОткрытыПанелька;
	Элементы.РабочаяОбласть.Видимость = (Не РежимHTMLНастроек) И (Не ДопНастройкиОткрытыПанелька);
	Элементы.ПолеHTMLНастроек.Видимость = РежимHTMLНастроек И (Не ДопНастройкиОткрытыПанелька);
	// Отложенное обновление структуры выполняется после показа рабочей области.
	Если Не РежимHTMLНастроек И Не ДопНастройкиОткрытыПанелька Тогда
		ОбновитьОбычнуюФорму();
		ОбновитьИсточникиОбычнойФормы();
	КонецЕсли;
КонецПроцедуры

// Обновляет представление в зависимости от выбранного режима интерфейса.
&НаКлиенте
Процедура ОбновитьHTMLНастроекЕслиНужно(ПрокруткаЦентр = 0, ПрокруткаИсточники = 0, ПрокруткаСвойства = 0)
	Если Не РежимHTMLНастроек Тогда
		ОбновитьОбычнуюФорму();
		Возврат;
	КонецЕсли;
	Если HTMLНастройкиВыполняетсяКомандаМоста <> Истина Тогда
		ПринятьЛокальныеДопНастройкиHTMLПанелька();
		СохранитьСостояниеОткрытогоHTMLПанелька();
	КонецЕсли;
	СформироватьHTMLНастроекНаСервере(ПолучитьОткрытыеОкнаДляHTMLНастроек(), HTMLНастройкиКонтекстКартинки,
		ПрокруткаЦентр, ПрокруткаИсточники, ПрокруткаСвойства);
	HTMLНастройкиПоследняяКомандаМоста = "";
	HTMLНастройкиКомандаСинхронизирована = Ложь;
КонецПроцедуры

// Формирует HTML-документ с моделью, контекстом выбора и положением прокрутки.
&НаСервере
Процедура СформироватьHTMLНастроекНаСервере(Окна, КонтекстКартинки, ПрокруткаЦентр, ПрокруткаИсточники,
	ПрокруткаСвойства)
	ОбновитьПредставления();
	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = СформироватьМодельHTML(Окна, КонтекстКартинки, ПараметрыФормированияМоделиHTMLПанелька());
	Данные.Ui.Вставить("ScrollCenter", ПрокруткаЦентр);
	Данные.Ui.Вставить("ScrollSources", ПрокруткаИсточники);
	Данные.Ui.Вставить("ScrollProperties", ПрокруткаСвойства);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ЖурналИзмененийПанелька = "";
	JSON = СтрЗаменить(Запись.Закрыть(), "</", "<\/");
	HTMLНастроек = СтрЗаменить(Обработка.ПолучитьМакет("МакетНастроекПанелькаHTML").ПолучитьТекст(),
		"/*PANELKA_SETTINGS_DATA*/{}", JSON);
КонецПроцедуры

// Собирает общую структуру страниц, колонок и ссылок для обоих интерфейсов.
// При передаче ИДКолонок заполняются только их ссылки.
&НаСервере
Функция РассчитатьСтруктуруПанелиПанелька(ИДКолонок = Неопределено)
	ОбновитьПредставления();
	СсылкиПоИД = ИндексСтрокПоИДПанелька(ТаблицаСсылок);
	ИндексыСсылок = Новый Соответствие;
	Результат = Новый Структура;
	Pages = Новый Массив;
	AllColumns = Новый Массив;
	КэшСтраниц = Новый Соответствие;
	КэшКолонок = Новый Соответствие;
	СтраницыПоПорядку = ТаблицаСтраниц.Выгрузить();
	СтраницыПоПорядку.Сортировать("Порядок, ИД");
	Для Каждого Стр Из СтраницыПоПорядку Цикл
		Если Стр.ИД = "page-unassigned" И Не НеРаспределенныеНаОтдельнойВкладке Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.ИД = "page-standard" И Не СтандартныеНаОтдельнойВкладке Тогда
			Продолжить;
		КонецЕсли;
		Страница = Новый Структура;
		Страница.Вставить("Name", Стр.ИмяСтраницы);
		Страница.Вставить("Icon", Стр.ИмяКартинки);
		Страница.Вставить("IconData", "");
		Страница.Вставить("Roles", Стр.РолиДоступа);
		Страница.Вставить("System", ЭтоСистемныйИД(Стр.ИД));
		Страница.Вставить("Columns", Новый Массив);
		Страница.Вставить("Id", Стр.ИД);
		Pages.Добавить(Страница);
		КэшСтраниц.Вставить(Стр.ИД, Страница);
	КонецЦикла;
	КолонкиПоПорядку = ТаблицаКолонок.Выгрузить();
	КолонкиПоПорядку.Сортировать("Порядок, ИД");
	Для Каждого КолонкаПанели Из КолонкиПоПорядку Цикл
		Если КолонкаПанели.ИД = "column-standard" И Не СтандартныеНаОтдельнойВкладке Тогда
			Продолжить;
		КонецЕсли;
		СтраницаИД = КолонкаПанели.ИДСтраницы;
		Если КолонкаПанели.ИД = "column-unassigned" И Не НеРаспределенныеНаОтдельнойВкладке Тогда
			СтраницаИД = "page-main";
		КонецЕсли;
		Страница = КэшСтраниц[СтраницаИД];
		Если Страница = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Колонка = Новый Структура;
		Колонка.Вставить("Name", КолонкаПанели.ИмяКолонки);
		Колонка.Вставить("Page", Страница.Name);
		Колонка.Вставить("Icon", КолонкаПанели.ИмяКартинки);
		Колонка.Вставить("IconData", "");
		Колонка.Вставить("System", ЭтоСистемныйИД(КолонкаПанели.ИД));
		Колонка.Вставить("Links", Новый Массив);
		Колонка.Вставить("Id", КолонкаПанели.ИД);
		Страница.Columns.Добавить(Колонка);
		КэшКолонок.Вставить(КолонкаПанели.ИД, Колонка);
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("Name", КолонкаПанели.ИмяКолонки);
		ОписаниеКолонки.Вставить("Page", Страница.Name);
		ОписаниеКолонки.Вставить("System", ЭтоСистемныйИД(КолонкаПанели.ИД));
		ОписаниеКолонки.Вставить("Id", КолонкаПанели.ИД);
		AllColumns.Добавить(ОписаниеКолонки);
	КонецЦикла;
	ИДПоИндексу = Новый Массив;
	Для Каждого СсылкаКаталога Из ТаблицаСсылок Цикл
		ИндексыСсылок.Вставить(СсылкаКаталога.ИД, ИДПоИндексу.Количество());
		ИДПоИндексу.Добавить(СсылкаКаталога.ИД);
	КонецЦикла;
	ТипыДоп = ПолучитьТипыДопИсточниковПанелька();
	Учтенные = Новый Соответствие;
	РазмещенияРасчета = ТаблицаРазмещений;
	Если ИДКолонок <> Неопределено Тогда
		РазмещенияРасчета = Новый Массив;
		Для Каждого ИДКолонки Из ИДКолонок Цикл
			Для Каждого СтрокаРазмещения Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДКолонки", ИДКолонки)) Цикл
				РазмещенияРасчета.Добавить(СтрокаРазмещения);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Для Каждого РазмещениеСсылки Из РазмещенияРасчета Цикл
		СсылкаКаталога = СсылкиПоИД[РазмещениеСсылки.ИДСсылки];
		Если СсылкаКаталога = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КолонкаИД = РазмещениеСсылки.ИДКолонки;
		Если КолонкаИД = "column-standard" И Не СтандартныеНаОтдельнойВкладке Тогда
			КолонкаИД = "column-unassigned";
		КонецЕсли;
		Если СтандартныеНаОтдельнойВкладке И СсылкаКаталога.Источник = "objects" И Лев(СсылкаКаталога.Ссылка, 8) = "sys_cmd:" Тогда
			КолонкаИД = "column-standard";
		КонецЕсли;
		Если ИДКолонок <> Неопределено И ИДКолонок.Найти(КолонкаИД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Колонка = КэшКолонок[КолонкаИД];
		Если Колонка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КолонкаИД + ":" + СсылкаКаталога.ИД;
		Если Учтенные[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Ключ, Истина);
		ДанныеСсылкиHTML = Новый Структура;
		ДанныеСсылкиHTML.Вставить("Source", СсылкаКаталога.Источник);
		ДанныеСсылкиHTML.Вставить("Index", ИндексыСсылок[СсылкаКаталога.ИД]);
		ДанныеСсылкиHTML.Вставить("Id", СсылкаКаталога.ИД);
		ДанныеСсылкиHTML.Вставить("PlacementId", РазмещениеСсылки.ИД);
		ДанныеСсылкиHTML.Вставить("Name", РазмещениеСсылки.ИтоговоеНаименование);
		ДанныеСсылкиHTML.Вставить("Tooltip", РазмещениеСсылки.ИтоговаяПодсказка);
		ДанныеСсылкиHTML.Вставить("Url", СсылкаКаталога.Ссылка);
		ДанныеСсылкиHTML.Вставить("Type",
			ОпределитьТипСсылкиHTML(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка, ТипыДоп));
		ДанныеСсылкиHTML.Вставить("Order", РазмещениеСсылки.Порядок);
		ДанныеСсылкиHTML.Вставить("Selected", ВыбранныйТип = "Link" И ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД);
		ДанныеСсылкиHTML.Вставить("Custom", РазмещениеСсылки.СвоеНаименование Или РазмещениеСсылки.СвояПодсказка);
		ДанныеСсылкиHTML.Вставить("HidePath", СкрыватьПутьДополнительногоИнструментаПанелька(СсылкаКаталога.Ссылка, СсылкаКаталога.Источник,
			ПравоДоступа("Администрирование", Метаданные)));
		ДанныеСсылкиHTML.Вставить("CustomName", РазмещениеСсылки.СвоеНаименование);
		ДанныеСсылкиHTML.Вставить("CustomTooltip", РазмещениеСсылки.СвояПодсказка);
		Колонка.Links.Добавить(ДанныеСсылкиHTML);
	КонецЦикла;
	Результат.Вставить("Pages", Pages);
	Результат.Вставить("AllColumns", AllColumns);
	Результат.Вставить("LinkIds", ИДПоИндексу);
	Возврат Результат;
КонецФункции

// Создаёт независимые параметры полного представления HTML.
//
// Возвращаемое значение:
//  Структура - параметры формирования:
//   * ТолькоСтруктура - Булево - не включать картинки, каталог и источники.
//   * БезИсточников - Булево - не включать источники и выбор картинки.
//   * ИДКолонок - Неопределено, Массив из Строка - фильтр колонок; Неопределено означает все.
//   * ИДСсылок - Неопределено, Массив из Строка - фильтр каталога; Неопределено означает все.
&НаСервере
Функция ПараметрыФормированияМоделиHTMLПанелька()
	ПараметрыМодели = Новый Структура;
	ПараметрыМодели.Вставить("ТолькоСтруктура", Ложь);
	ПараметрыМодели.Вставить("БезИсточников", Ложь);
	ПараметрыМодели.Вставить("ИДКолонок", Неопределено);
	ПараметрыМодели.Вставить("ИДСсылок", Неопределено);
	ПараметрыМодели.Вставить("БезКартинокЗаголовков", Ложь);
	Возврат ПараметрыМодели;
КонецФункции

// Добавляет к общей структуре данные только HTML-интерфейса.
//
// Параметры:
//  Окна - Массив из Структура - открытые окна с навигационной ссылкой и представлением.
//  КонтекстКартинки - Структура, Неопределено - контекст выбора картинки.
//  ПараметрыМодели - см. ПараметрыФормированияМоделиHTMLПанелька.
//
// Возвращаемое значение:
//  Структура - модель представления HTML.
&НаСервере
Функция СформироватьМодельHTML(Окна, КонтекстКартинки, ПараметрыМодели)
	КонтекстДоступа = ПолучитьКонтекстДоступаРедактораПанелька();
	РазмещенияПоСсылке = ИндексРазмещенийПанелька();
	КэшКартинок = Новый Соответствие;
	Результат = РассчитатьСтруктуруПанелиПанелька(ПараметрыМодели.ИДКолонок);
	НастройкиИнтерфейса = Новый Структура;
	НастройкиИнтерфейса.Вставить("ActivePage", HTMLНастройкиАктивнаяСтраница);
	НастройкиИнтерфейса.Вставить("ActiveColumn", ИмяКолонкиПанелька(ТаблицаКолонок, HTMLНастройкиАктивнаяКолонка));
	НастройкиИнтерфейса.Вставить("SourceMode", HTMLНастройкиТипИсточника);
	НастройкиИнтерфейса.Вставить("MetadataGroup", HTMLНастройкиКатегорияМетаданных);
	Если Не ПараметрыМодели.ТолькоСтруктура Тогда
		НастройкиИнтерфейса.Вставить("Theme", ПолучитьПользовательскуюНастройкуHTMLПанелька("ТемаНастроекHTML", "light"));
		НастройкиИнтерфейса.Вставить("FavoriteFilter", ПолучитьПользовательскуюНастройкуHTMLПанелька("ФильтрИзбранногоHTML", "all"));
		НастройкиИнтерфейса.Вставить("HasExtraProcessing", ЕстьДополнительныеОбработкиHTML());
	КонецЕсли;
	НастройкиИнтерфейса.Вставить("Personal", ПерсональнаяНастройкаПанелька);
	РазрешенияОбмена = ПолучитьРазрешенияОбменаПанелька(КонтекстДоступа);
	НастройкиИнтерфейса.Вставить("AllowImport", РазрешенияОбмена.Импорт);
	НастройкиИнтерфейса.Вставить("AllowExport", РазрешенияОбмена.Экспорт);
	НастройкиИнтерфейса.Вставить("AllowedSources", ПолитикаИсточниковРедактораПанелька(КонтекстДоступа));
	НастройкиИнтерфейса.Вставить("State", СостояниеHTMLПанелька);
	Результат.Вставить("Ui", НастройкиИнтерфейса);
	ОбщиеНастройкиHTML = Новый Структура;
	ОбщиеНастройкиHTML.Вставить("GroupByType", ГруппироватьПоТипуОбъекта);
	ОбщиеНастройкиHTML.Вставить("UnassignedTab", НеРаспределенныеНаОтдельнойВкладке);
	ОбщиеНастройкиHTML.Вставить("StandardTab", СтандартныеНаОтдельнойВкладке);
	ОбщиеНастройкиHTML.Вставить("FillMetadataComment", ЗаполнятьКомментарийИзМетаданных);
	ОбщиеНастройкиHTML.Вставить("TooltipMode", РежимОтображенияПодсказок);
	Результат.Вставить("General", ОбщиеНастройкиHTML);
	Если ПараметрыМодели.ТолькоСтруктура Тогда
		Возврат Результат;
	КонецЕсли;
	ТипыДоп = ПолучитьТипыДопИсточниковПанелька();
	Для Каждого Страница Из Результат.Pages Цикл
		Если ПараметрыМодели.БезКартинокЗаголовков Тогда
			Страница.Удалить("IconData");
		Иначе
			Страница.IconData = ПолучитьКартинкуHTMLИзКэшаПанелька(Страница.Icon, КэшКартинок);
		КонецЕсли;
		Для Каждого Колонка Из Страница.Columns Цикл
			Если ПараметрыМодели.БезКартинокЗаголовков Тогда
				Колонка.Удалить("IconData");
			Иначе
				Колонка.IconData = ПолучитьКартинкуHTMLИзКэшаПанелька(Колонка.Icon, КэшКартинок);
			КонецЕсли;
			Если ПараметрыМодели.ИДКолонок <> Неопределено И ПараметрыМодели.ИДКолонок.Найти(Колонка.Id) = Неопределено Тогда
				Колонка.Удалить("Links");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	КаталогHTML = Новый Массив;
	Для Каждого Ссылка Из ТаблицаСсылок Цикл
		Если ПараметрыМодели.ИДСсылок <> Неопределено И ПараметрыМодели.ИДСсылок.Найти(Ссылка.ИД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИменаКолонок = Новый Массив;
		Для Каждого Размещение Из РазмещенияПоСсылке[Ссылка.ИД] Цикл
			ИменаКолонок.Добавить(Размещение.ИДКолонки);
		КонецЦикла;
		СсылкаКаталогаHTML = Новый Структура;
		СсылкаКаталогаHTML.Вставить("Id", Ссылка.ИД);
		СсылкаКаталогаHTML.Вставить("Name", Ссылка.Наименование);
		СсылкаКаталогаHTML.Вставить("Tooltip", Ссылка.Подсказка);
		СсылкаКаталогаHTML.Вставить("Source", Ссылка.Источник);
		СсылкаКаталогаHTML.Вставить("Url", Ссылка.Ссылка);
		СсылкаКаталогаHTML.Вставить("Columns", ИменаКолонок);
		КаталогHTML.Добавить(СсылкаКаталогаHTML);
	КонецЦикла;
	Результат.Вставить("Catalog", КаталогHTML);
	Если Не ПараметрыМодели.БезИсточников Тогда
		Группы = ПолучитьГруппыМетаданныхHTML(КонтекстДоступа);
		НормализоватьГруппуМетаданныхHTML(Группы);
		Результат.Вставить("MetadataGroups", Группы);
		Результат.Ui.MetadataGroup = HTMLНастройкиКатегорияМетаданных;
		Результат.Ui.SourceMode = HTMLНастройкиТипИсточника;
		Результат.Вставить("Sources", ОтфильтроватьЛичныеИсточникиПанелька(
			СформироватьИсточникиHTML(Окна, КонтекстДоступа), КонтекстДоступа));
		Результат.Вставить("IconPicker", СформироватьВыборКартинкиHTML(КонтекстКартинки));
	КонецЕсли;
	Результат.Вставить("Selected", СформироватьВыборHTML(ТипыДоп, КэшКартинок));
	Возврат Результат;
КонецФункции

// Собирает свойства выбранного элемента для HTML-редактора.
&НаСервере
Функция СформироватьВыборHTML(ТипыДоп, КэшКартинок)
	Рез = Новый Структура("Kind", "None");
	Если ВыбранныйТип = "Link" Тогда
		СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ВыбраннаяСсылкаИД);
		РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
		Если СсылкаКаталога = Неопределено Или РазмещениеСсылки = Неопределено Тогда
			Возврат Рез;
		КонецЕсли;
		Колонки = Новый Массив;
		Для Каждого Размещение Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", СсылкаКаталога.ИД)) Цикл
			КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", Размещение.ИДКолонки);
			Если КолонкаПанели <> Неопределено Тогда
				Колонки.Добавить(КолонкаПанели.ИД);
			КонецЕсли;
		КонецЦикла;
		Рез = Новый Структура;
		Рез.Вставить("Kind", "Link");
		Рез.Вставить("Source", СсылкаКаталога.Источник);
		Рез.Вставить("Index", ТаблицаСсылок.Индекс(СсылкаКаталога));
		Рез.Вставить("Id", СсылкаКаталога.ИД);
		Рез.Вставить("Name", СсылкаКаталога.Наименование);
		Рез.Вставить("Caption", ПредставлениеИсточника(СсылкаКаталога.Источник));
		Рез.Вставить("Tooltip", СсылкаКаталога.Подсказка);
		Рез.Вставить("Url", СсылкаКаталога.Ссылка);
		Рез.Вставить("Type", ОпределитьТипСсылкиHTML(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка, ТипыДоп));
		Рез.Вставить("Columns", Колонки);
		Рез.Вставить("LockedColumn",
			СтандартныеНаОтдельнойВкладке И СсылкаКаталога.Источник = "objects"
			И Лев(СсылкаКаталога.Ссылка, 8) = "sys_cmd:");
		Рез.Вставить("HidePath", СкрыватьПутьДополнительногоИнструментаПанелька(СсылкаКаталога.Ссылка, СсылкаКаталога.Источник,
			ПравоДоступа("Администрирование", Метаданные)));
		РазмещениеHTML = Новый Структура;
		РазмещениеHTML.Вставить("Id", РазмещениеСсылки.ИД);
		РазмещениеHTML.Вставить("Column", РазмещениеСсылки.ИмяКолонки);
		РазмещениеHTML.Вставить("Name", РазмещениеСсылки.ИтоговоеНаименование);
		РазмещениеHTML.Вставить("Tooltip", РазмещениеСсылки.ИтоговаяПодсказка);
		РазмещениеHTML.Вставить("CustomName", РазмещениеСсылки.СвоеНаименование);
		РазмещениеHTML.Вставить("CustomTooltip", РазмещениеСсылки.СвояПодсказка);
		РазмещениеHTML.Вставить("Order", РазмещениеСсылки.Порядок);
		Рез.Вставить("Placement", РазмещениеHTML);
	ИначеЕсли ВыбранныйТип = "Page" Тогда
		Стр = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", HTMLНастройкиАктивнаяСтраница);
		Если Стр <> Неопределено Тогда
			Рез = Новый Структура;
			Рез.Вставить("Kind", "Page");
			Рез.Вставить("Name", Стр.ИмяСтраницы);
			Рез.Вставить("Caption", "Страница панели");
			Рез.Вставить("Icon", Стр.ИмяКартинки);
			Рез.Вставить("IconData", ПолучитьКартинкуHTMLИзКэшаПанелька(Стр.ИмяКартинки, КэшКартинок));
			Рез.Вставить("Roles", Стр.РолиДоступа);
			Рез.Вставить("System", ЭтоСистемныйИД(Стр.ИД));
		КонецЕсли;
	ИначеЕсли ВыбранныйТип = "Column" Тогда
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", HTMLНастройкиАктивнаяКолонка);
		Если КолонкаПанели <> Неопределено Тогда
			Рез = Новый Структура;
			Рез.Вставить("Kind", "Column");
			Рез.Вставить("Name", КолонкаПанели.ИмяКолонки);
			Рез.Вставить("Caption", "Колонка панели");
			Рез.Вставить("Page", КолонкаПанели.Страница);
			Рез.Вставить("Icon", КолонкаПанели.ИмяКартинки);
			Рез.Вставить("IconData", ПолучитьКартинкуHTMLИзКэшаПанелька(КолонкаПанели.ИмяКартинки, КэшКартинок));
			Рез.Вставить("System", ЭтоСистемныйИД(КолонкаПанели.ИД));
		КонецЕсли;
	КонецЕсли;
	Если Рез.Kind = "Page" Тогда
		Рез.Вставить("Id", Стр.ИД);
	ИначеЕсли Рез.Kind = "Column" Тогда
		Рез.Вставить("Id", КолонкаПанели.ИД);
	КонецЕсли;
	Возврат Рез;
КонецФункции

#КонецОбласти

#Область ДополнительныеНастройкиHTML

&НаКлиенте
Процедура ЗапроситьКопированиеОбщейПанелиПанелька()
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗаменыЛичнойПанелиПанелька", ЭтотОбъект),
		НСтр("ru = 'Заменить текущую структуру копией общей панели? Изменения запишутся только после нажатия «Сохранить».'"),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьСбросНастроекПанелька()
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеУдаленияВсехНастроек", ЭтотОбъект),
		?(ПерсональнаяНастройкаПанелька,
		"Удалить вашу персональную панель? Будет включена общая панель. Настройки других пользователей не изменятся. Отменить удаление нельзя.",
		"Удалить все сохранённые общие настройки Панелька и их резервную копию из базы? Персональные панели пользователей сохранятся. Несохранённые изменения этой формы также будут потеряны. Отменить удаление нельзя."),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

// Описание полей Web-вкладок одновременно задает допустимые реквизиты для записи.
&НаСервере
Функция ПоляДопНастроекHTMLПанелька()
	Поля = Новый Соответствие;
	Поля.Вставить("ГруппироватьПоТипуОбъекта", Новый Структура("Label,Kind,Group", НСтр("ru = 'Группировать ссылки по типу объекта'"), "bool", "display"));
	Поля.Вставить("СтандартныеНаОтдельнойВкладке", Новый Структура("Label,Kind,Group", НСтр("ru = 'Стандартные инструменты на отдельной вкладке'"), "bool", "display"));
	Поля.Вставить("НеРаспределенныеНаОтдельнойВкладке", Новый Структура("Label,Kind,Group", НСтр("ru = '«Не распределено» на отдельной вкладке'"), "bool", "display"));
	Поля.Вставить("ЗаполнятьКомментарийИзМетаданных", Новый Структура("Label,Kind,Group", НСтр("ru = 'Заполнять комментарий из метаданных'"), "bool", "display"));
	Поля.Вставить("РежимОтображенияПодсказок", Новый Структура("Label,Kind,Group", НСтр("ru = 'Расположение подсказки'"), "tooltip", "display"));
	Поля.Вставить("ШрифтКолонки", Новый Структура("Label,Kind,Group", НСтр("ru = 'Шрифт заголовков колонок'"), "font", "appearance"));
	Поля.Вставить("ЦветКолонки", Новый Структура("Label,Kind,Group", НСтр("ru = 'Цвет заголовков колонок'"), "color", "appearance"));
	Поля.Вставить("ШрифтГруппировки", Новый Структура("Label,Kind,Group", НСтр("ru = 'Шрифт заголовков групп'"), "font", "appearance"));
	Поля.Вставить("ЦветГруппировки", Новый Структура("Label,Kind,Group", НСтр("ru = 'Цвет заголовков групп'"), "color", "appearance"));
	Если ПерсональнаяНастройкаПанелька Тогда
		Возврат Поля;
	КонецЕсли;
	Поля.Вставить("РазрешитьПерсональнуюПанельПанелька", Новый Структура("Label,Kind,Group", НСтр("ru = 'Включить персональную панель'"), "bool", "personal"));
	Поля.Вставить("НеПрименятьОграниченияИсточниковКАдминистраторамПанелька", Новый Структура("Label,Kind,Group", НСтр("ru = 'Не применять ограничения источников к администраторам'"), "bool", "personal"));
	Поля.Вставить("РазрешитьИмпортЛичнойПанелиПанелька", Новый Структура("Label,Kind,Group", НСтр("ru = 'Разрешить импорт настроек персональной панели'"), "bool", "personal"));
	Поля.Вставить("РазрешитьЭкспортЛичнойПанелиПанелька", Новый Структура("Label,Kind,Group", НСтр("ru = 'Разрешить экспорт настроек персональной панели'"), "bool", "personal"));
	Категории = РеквизитФормыВЗначение("Объект").ПанелькаКатегорииМетаданныхЛичныхПанелей();
	Для Каждого Категория Из Категории Цикл
		Поля.Вставить("ЛичныеРазрешить" + Категория.Ключ, Новый Структура("Label,Kind,Group", Категория.Значение, "bool", "categories"));
	КонецЦикла;
	Поля.Вставить("ЛичныеРазрешитьСтандартныеИнструменты", Новый Структура("Label,Kind,Group", НСтр("ru = 'Стандартные инструменты'"), "bool", "sources"));
	Поля.Вставить("ЛичныеРазрешитьДополнительныеОбработки", Новый Структура("Label,Kind,Group", НСтр("ru = 'Дополнительные отчёты и обработки'"), "bool", "sources"));
	Поля.Вставить("ЛичныеРазрешитьВебСсылки", Новый Структура("Label,Kind,Group", НСтр("ru = 'Веб-ссылки'"), "bool", "sources"));
	Поля.Вставить("ЛичныеРазрешитьЛокальныеФайлы", Новый Структура("Label,Kind,Group", НСтр("ru = 'Локальные файлы'"), "bool", "sources"));
	Возврат Поля;
КонецФункции

// Возвращает данные вкладок текущего черновика без чтения чужих профилей.
&НаСервере
Функция ДопНастройкиHTMLНаСервереПанелька(Знач ИзмененияJSON = "")
	ПроверитьПравоНастройкиПанелька();
	Поля = ПоляДопНастроекHTMLПанелька();
	Если Не ПустаяСтрока(ИзмененияJSON) Тогда
		ПрименитьДопНастройкиHTMLПанелька(Поля, ИзмененияJSON);
	КонецЕсли;
	ПорядокСтруктуры = СтрРазделить("ГруппироватьПоТипуОбъекта,СтандартныеНаОтдельнойВкладке,НеРаспределенныеНаОтдельнойВкладке", ",");
	ПорядокПодсказок = СтрРазделить("ЗаполнятьКомментарийИзМетаданных,РежимОтображенияПодсказок", ",");
	ПорядокРазрешений = СтрРазделить("РазрешитьПерсональнуюПанельПанелька,НеПрименятьОграниченияИсточниковКАдминистраторамПанелька,РазрешитьИмпортЛичнойПанелиПанелька,РазрешитьЭкспортЛичнойПанелиПанелька", ",");
	ПорядокКатегорий = СтрРазделить("Справочники,Документы,ЖурналыДокументов,Отчеты,Обработки,ОбщиеФормы,"
		+ "РегистрыСведений,РегистрыНакопления,РегистрыБухгалтерии,РегистрыРасчета,Константы,ВнешниеИсточникиДанных,"
		+ "ПланыВидовХарактеристик,ПланыСчетов,ПланыВидовРасчета,ПланыОбмена,БизнесПроцессы,Задачи", ",");
	ПорядокИсточников = СтрРазделить("СтандартныеИнструменты,ДополнительныеОбработки,ВебСсылки,ЛокальныеФайлы", ",");
	Строки = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		Описание = Поле.Значение;
		ЗначениеПоля = ЭтотОбъект[Поле.Ключ];
		СтрокаПоля = Новый Структура("Key,Label,Kind", Поле.Ключ, Описание.Label, Описание.Kind);
		СтрокаПоля.Вставить("Group", Описание.Group);
		Если Описание.Group = "appearance" Тогда
			СтрокаПоля.Вставить("Section", ?(Поле.Ключ = "ШрифтКолонки" Или Поле.Ключ = "ЦветКолонки", "column", "group"));
			СтрокаПоля.Вставить("Presentation", Строка(ЗначениеПоля));
			ЗначениеПоля = ?(Описание.Kind = "color", ПанелькаЦветВHTML(ЗначениеПоля), "");
		ИначеЕсли Описание.Group = "display" Тогда
			Позиция = ПорядокСтруктуры.Найти(Поле.Ключ);
			Если Позиция <> Неопределено Тогда
				СтрокаПоля.Вставить("Section", "structure");
			Иначе
				Позиция = ПорядокПодсказок.Найти(Поле.Ключ);
				СтрокаПоля.Вставить("Section", "tooltips");
			КонецЕсли;
			СтрокаПоля.Вставить("Order", Позиция + 1);
		Иначе
			Если Описание.Group = "personal" Тогда
				Позиция = ПорядокРазрешений.Найти(Поле.Ключ);
				СтрокВКолонке = 2;
			ИначеЕсли Описание.Group = "categories" Тогда
				Позиция = ПорядокКатегорий.Найти(Сред(Поле.Ключ, СтрДлина("ЛичныеРазрешить") + 1));
				СтрокВКолонке = 6;
			Иначе
				Позиция = ПорядокИсточников.Найти(Сред(Поле.Ключ, СтрДлина("ЛичныеРазрешить") + 1));
				СтрокВКолонке = 2;
			КонецЕсли;
			Если Позиция <> Неопределено Тогда
				СтрокаПоля.Вставить("Column", Цел(Позиция / СтрокВКолонке) + 1);
				СтрокаПоля.Вставить("Order", Позиция + 1);
			КонецЕсли;
		КонецЕсли;
		СтрокаПоля.Вставить("Value", ЗначениеПоля);
		Строки.Добавить(СтрокаПоля);
	КонецЦикла;
	Обмен = ПолучитьРазрешенияОбменаПанелька();
	УправлятьПрофилями = Не ПерсональнаяНастройкаПанелька И ПравоДоступа("АдминистрированиеДанных", Метаданные);
	Общие = Новый Структура("GroupByType,UnassignedTab,StandardTab,FillMetadataComment,TooltipMode",
		ГруппироватьПоТипуОбъекта, НеРаспределенныеНаОтдельнойВкладке, СтандартныеНаОтдельнойВкладке,
		ЗаполнятьКомментарийИзМетаданных, РежимОтображенияПодсказок);
	Возврат Новый Структура("Fields,General,CanAdmin,CanManageProfiles,CanDeleteProfiles,CanImport,CanExport,Personal",
		Строки, Общие, Не ПерсональнаяНастройкаПанелька, УправлятьПрофилями,
		УправлятьПрофилями И ПравоДоступа("СохранениеДанныхПользователя", Метаданные),
		Обмен.Импорт, Обмен.Экспорт, ПерсональнаяНастройкаПанелька);
КонецФункции

// Проверяет пакет целиком до изменения реквизитов формы.
&НаСервере
Процедура ПрименитьДопНастройкиHTMLПанелька(Поля, Знач ИзмененияJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ИзмененияJSON);
	Изменения = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если ТипЗнч(Изменения) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный набор дополнительных настроек.'");
	КонецЕсли;
	НовыеЗначения = Новый Структура;
	Для Каждого Изменение Из Изменения Цикл
		Поле = Поля[Изменение.Ключ];
		Если Поле = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Этот параметр недоступен для изменения.'");
		КонецЕсли;
		ЗначениеПоля = Изменение.Значение;
		Если Поле.Group = "appearance" Тогда
			ВызватьИсключение НСтр("ru = 'Шрифт и цвет меняются через диалог выбора 1С.'");
		ИначеЕсли Поле.Kind = "tooltip" Тогда
			Если СтрРазделить("Снизу,Всплывающая,Кнопка,Нет", ",").Найти(ЗначениеПоля) = Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Недопустимый режим подсказок.'");
			КонецЕсли;
		ИначеЕсли ТипЗнч(ЗначениеПоля) <> Тип("Булево") Тогда
			ВызватьИсключение НСтр("ru = 'Некорректное значение переключателя.'");
		КонецЕсли;
		НовыеЗначения.Вставить(Изменение.Ключ, ЗначениеПоля);
	КонецЦикла;
	Для Каждого Пара Из НовыеЗначения Цикл
		ЭтотОбъект[Пара.Ключ] = Пара.Значение;
	КонецЦикла;
	Если НовыеЗначения.Количество() > 0 Тогда
		ОтметитьИзменениеДопНастроекHTMLПанелька();
	КонецЕсли;
КонецПроцедуры

// Передает накопленные флажки одним пакетом и очищает поле только после приема.
&НаКлиенте
Процедура ПринятьЛокальныеДопНастройкиHTMLПанелька()
	Если Не РежимHTMLНастроек Или ДопНастройкиОткрытыПанелька Тогда
		Возврат;
	КонецЕсли;
	ДокументHTML = Элементы.ПолеHTMLНастроек.Документ;
	Если ДокументHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеТемы = ДокументHTML.getElementById("panelkaThemeDraft");
	Если ПолеТемы <> Неопределено Тогда
		Тема = Строка(ПолеТемы.value);
		Если Тема = "dark" Или Тема = "light" Тогда
			СохранитьПользовательскуюНастройкуHTMLПанелька("ТемаНастроекHTML", Тема);
			ПолеТемы.value = "";
		КонецЕсли;
	КонецЕсли;
	ПолеЧерновика = ДокументHTML.getElementById("panelkaAdditionalDraft");
	Если ПолеЧерновика = Неопределено Или ПустаяСтрока(Строка(ПолеЧерновика.value)) Тогда
		Возврат;
	КонецЕсли;
	ПринятьЛокальныеДопНастройкиHTMLНаСервереПанелька(Строка(ПолеЧерновика.value));
	ПолеЧерновика.value = "";
КонецПроцедуры

&НаСервере
Процедура ПринятьЛокальныеДопНастройкиHTMLНаСервереПанелька(Изменения)
	ПроверитьПравоНастройкиПанелька();
	ПрименитьДопНастройкиHTMLПанелька(ПоляДопНастроекHTMLПанелька(), Изменения);
КонецПроцедуры

// Оформление меняется в том же черновике, что и параметры отображения.
&НаСервере
Процедура ОтметитьИзменениеДопНастроекHTMLПанелька()
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОтметитьИзменениеПанелька("full");
КонецПроцедуры

// Открывает штатный диалог 1С поверх Web-редактора.
&НаКлиенте
Процедура ВыбратьОформлениеHTMLПанелька(Знач Ключ)
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораОформленияHTMLПанелька", ЭтотОбъект, Ключ);
	Если Ключ = "ШрифтКолонки" Или Ключ = "ШрифтГруппировки" Тогда
		ДиалогШрифта = Новый ДиалогВыбораШрифта;
		ДиалогШрифта.Шрифт = ?(Ключ = "ШрифтКолонки", ШрифтКолонки, ШрифтГруппировки);
		ДиалогШрифта.Показать(Оповещение);
	ИначеЕсли Ключ = "ЦветКолонки" Или Ключ = "ЦветГруппировки" Тогда
		ДиалогЦвета = Новый ДиалогВыбораЦвета;
		ДиалогЦвета.Показать(Оповещение);
	КонецЕсли;
КонецПроцедуры

// Отмена диалога оставляет текущий черновик без изменений.
&НаКлиенте
Процедура ПослеВыбораОформленияHTMLПанелька(ВыбранноеЗначение, Ключ) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПередатьДопНастройкиHTMLПанелька(ПрименитьОформлениеHTMLНаСервереПанелька(Ключ, ВыбранноеЗначение));
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПрименитьОформлениеHTMLНаСервереПанелька(Знач Ключ, Знач ВыбранноеЗначение)
	ПроверитьПравоНастройкиПанелька();
	ТипЗначения = ТипЗнч(ВыбранноеЗначение);
	ЭтоШрифт = (Ключ = "ШрифтКолонки" Или Ключ = "ШрифтГруппировки") И ТипЗначения = Тип("Шрифт");
	ЭтоЦвет = (Ключ = "ЦветКолонки" Или Ключ = "ЦветГруппировки") И ТипЗначения = Тип("Цвет");
	Если Не ЭтоШрифт И Не ЭтоЦвет Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный параметр оформления.'");
	КонецЕсли;
	ЭтотОбъект[Ключ] = ВыбранноеЗначение;
	ОтметитьИзменениеДопНастроекHTMLПанелька();
	Возврат ОтветДопНастроекHTMLПанелька("settings");
КонецФункции

// Подготавливает сериализованный ответ за один серверный вызов.
&НаСервере
Функция ОтветДопНастроекHTMLПанелька(Действие, ЗначениеКоманды = "", Ревизия = "")
	Если Действие = "profiles" Тогда
		Данные = СписокПрофилейДопНастроекHTMLПанелька();
	ИначеЕсли Действие = "preview" Тогда
		Данные = ПросмотрПрофиляДопНастроекHTMLПанелька(ЗначениеКоманды, Ревизия);
	Иначе
		Данные = ДопНастройкиHTMLНаСервереПанелька(ЗначениеКоманды);
	КонецЕсли;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

// Публикует ответ вкладок в отдельное поле открытого документа.
&НаКлиенте
Процедура ПередатьДопНастройкиHTMLПанелька(ОтветJSON)
	ПолеОтвета = Элементы.ПолеHTMLНастроек.Документ.getElementById("panelkaAdditionalResponse");
	ПолеОтвета.value = ОтветJSON;
КонецПроцедуры

// Обслуживает действия встроенных вкладок через действующие контракты редактора.
&НаКлиенте
Процедура ВыполнитьДопНастройкиHTMLПанелька(Действие, ПараметрыКоманды)
	Если Действие = "open_additional_settings" Или Действие = "additional_apply" Тогда
		Изменения = ?(Действие = "additional_apply", ПолучитьПараметрHTMLНастроек(ПараметрыКоманды, "values", ""), "");
		ПередатьДопНастройкиHTMLПанелька(ОтветДопНастроекHTMLПанелька("settings", Изменения));
	ИначеЕсли Действие = "additional_choose_appearance" Тогда
		ВыбратьОформлениеHTMLПанелька(ПолучитьПараметрHTMLНастроек(ПараметрыКоманды, "key", ""));
	ИначеЕсли Действие = "additional_reset" Тогда
		ЗапроситьСбросНастроекПанелька();
	ИначеЕсли Действие = "additional_copy_common" Тогда
		Если ПерсональнаяНастройкаПанелька Тогда
			ЗапроситьКопированиеОбщейПанелиПанелька();
		КонецЕсли;
	ИначеЕсли Действие = "additional_profiles" Тогда
		ПередатьДопНастройкиHTMLПанелька(ОтветДопНастроекHTMLПанелька("profiles"));
	Иначе
		Если ПерсональнаяНастройкаПанелька Тогда
			ВызватьИсключение НСтр("ru = 'Управление чужими панелями доступно только в общих настройках.'");
		КонецЕсли;
		Пользователь = ПолучитьПараметрHTMLНастроек(ПараметрыКоманды, "user", "");
		Ревизия = ПолучитьПараметрHTMLНастроек(ПараметрыКоманды, "revision", "");
		Панель = Новый Структура("ИмяПользователя,Пользователь,Ревизия,Web", Пользователь, Пользователь, Ревизия, Истина);
		Если Действие = "additional_preview" Тогда
			ПередатьДопНастройкиHTMLПанелька(ОтветДопНастроекHTMLПанелька("preview", Пользователь, Ревизия));
		ИначеЕсли Действие = "additional_export_profile" Тогда
			ОткрытьЭкспортПерсональнойПанелиПанелька(Панель);
		ИначеЕсли Действие = "additional_delete_profile" Тогда
			ЗапроситьУдалениеПерсональнойПанелиПанелька(Панель);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Загружает список по явному запросу с проверкой прав на сервере.
&НаСервере
Функция СписокПрофилейДопНастроекHTMLПанелька()
	ПроверитьДоступКПрофилямHTMLПанелька();
	Результат = РеквизитФормыВЗначение("Объект").ПанелькаСписокПерсональныхПанелей();
	Профили = Новый Массив;
	Для Каждого СтрокаПрофиля Из Результат.Панели Цикл
		Профили.Добавить(Новый Структура("User,Name,Revision,Created,Updated,Pages,Links", СтрокаПрофиля.ИмяПользователя,
			СтрокаПрофиля.Пользователь, СтрокаПрофиля.Ревизия, Формат(СтрокаПрофиля.Создана, "ДЛФ=ДВ"),
			Формат(СтрокаПрофиля.Изменена, "ДЛФ=ДВ"), СтрокаПрофиля.Страниц, СтрокаПрофиля.Ссылок));
	КонецЦикла;
	Сообщение = СтрШаблон(НСтр("ru = 'Сохранённых панелей: %1. Пропущено при чтении: %2.'"), Профили.Количество(), Результат.Пропущено);
	Возврат Новый Структура("Profiles,Preview,PreviewTitle,Message", Профили, Неопределено, "", Сообщение);
КонецФункции

&НаСервере
Функция ПросмотрПрофиляДопНастроекHTMLПанелька(Пользователь, Ревизия)
	ПроверитьДоступКПрофилямHTMLПанелька();
	Дерево = РеквизитФормыВЗначение("Объект").ПанелькаАдминСоставПанели(Пользователь, Ревизия);
	Строки = Новый Массив;
	ДобавитьСтрокиПросмотраПрофиляHTMLПанелька(Дерево.Строки, Строки, 0);
	Возврат Новый Структура("Preview,PreviewTitle", Строки, СтрШаблон(НСтр("ru = 'Панель пользователя «%1» — только просмотр'"), Пользователь));
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьСтрокиПросмотраПрофиляHTMLПанелька(СтрокиДерева, Строки, Глубина)
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Строки.Добавить(Новый Структура("Name,Kind,Url,Hint,Depth", СтрокаДерева.Название, СтрокаДерева.Вид,
			СтрокаДерева.Ссылка, СтрокаДерева.Подсказка, Глубина));
		ДобавитьСтрокиПросмотраПрофиляHTMLПанелька(СтрокаДерева.Строки, Строки, Глубина + 1);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПроверитьДоступКПрофилямHTMLПанелька()
	Если ПерсональнаяНастройкаПанелька Тогда
		ВызватьИсключение НСтр("ru = 'Управление чужими панелями доступно только в общих настройках.'");
	КонецЕсли;
	РеквизитФормыВЗначение("Объект").ПанелькаПроверитьАдминистрированиеПанелей();
КонецПроцедуры

// Пустая строка означает цвет «Авто» или цвет, заданный стилем 1С.
&НаСервереБезКонтекста
Функция ПанелькаЦветВHTML(ЦветОформления)
	Если ТипЗнч(ЦветОформления) <> Тип("Цвет") Тогда
		Возврат "";
	КонецЕсли;
	Если ЦветОформления.Вид <> ВидЦвета.Абсолютный Тогда
		Возврат "";
	КонецЕсли;
	Возврат "#" + ПанелькаКомпонентаЦветаВHTML(ЦветОформления.Красный)
		+ ПанелькаКомпонентаЦветаВHTML(ЦветОформления.Зеленый)
		+ ПанелькаКомпонентаЦветаВHTML(ЦветОформления.Синий);
КонецФункции

&НаСервереБезКонтекста
Функция ПанелькаКомпонентаЦветаВHTML(Компонента)
	Цифры = "0123456789ABCDEF";
	СтаршийРазряд = Цел(Компонента / 16);
	Возврат Сред(Цифры, СтаршийРазряд + 1, 1) + Сред(Цифры, Компонента - СтаршийРазряд * 16 + 1, 1);
КонецФункции

#КонецОбласти

#Область КомандыHTML

// Разбирает HTML-команду, применяет черновик и направляет действие соответствующему обработчику.
&НаКлиенте
Процедура ВыполнитьКомандуHTMLНастроек(URL)
	Если ТипЗнч(URL) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	Позиция = СтрНайти(URL, "panelkasettings://");
	Если Позиция > 0 Тогда
		Остаток = Сред(URL, Позиция + СтрДлина("panelkasettings://"));
	Иначе
		Позиция = СтрНайти(URL, "#panelkasettings/");
		Если Позиция = 0 Тогда
			Возврат;
		КонецЕсли;
		Остаток = Сред(URL, Позиция + СтрДлина("#panelkasettings/"));
	КонецЕсли;
	Вопрос = СтрНайти(Остаток, "?");
	Действие = ?(Вопрос > 0, Лев(Остаток, Вопрос - 1), Остаток);
	ПараметрыКомандыHTML = РазобратьПараметрыHTMLНастроек(?(Вопрос > 0, Сред(Остаток, Вопрос + 1), ""));
	Попытка
		ПринятьЛокальныеДопНастройкиHTMLПанелька();
		// Частые команды выполняются одним обращением к серверу.
		Если СтрРазделить("set_metadata_group,set_source_mode,set_favorite_filter,apply_editor,apply_link_details,update_page,update_column,move_link,move_column,move_page,move_group,drag_structure,toggle_general,set_tooltip_mode,add_source,add_web,toggle_link_column,remove_link_from_column,unassign_link,delete_link,add_page,add_column,add_column_default,delete_column,delete_column_mode,delete_page,delete_page_mode,make_tooltip_common,reset_placement", ",").Найти(Действие) <> Неопределено Тогда
			ДанныеЧерновика = Неопределено;
			Черновик = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "draft", "");
			Если Не ПустаяСтрока(Черновик) Тогда
				РазделительЧерновика = СтрНайти(Черновик, "?");
				Если РазделительЧерновика = 0 Тогда
					ВызватьИсключение НСтр("ru = 'Некорректный черновик Web-интерфейса.'");
				КонецЕсли;
				ДанныеЧерновика = РазобратьПараметрыHTMLНастроек(Сред(Черновик, РазделительЧерновика + 1));
			КонецЕсли;
			Окна = Новый Массив;
			РежимИсточника = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "__sourceMode", HTMLНастройкиТипИсточника);
			Если Действие = "set_source_mode" Тогда
				РежимИсточника = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "mode", "metadata");
			ИначеЕсли Действие = "set_metadata_group" Тогда
				РежимИсточника = "metadata";
			КонецЕсли;
			Если РежимИсточника = "opened" Тогда
				Окна = ПолучитьОткрытыеОкнаДляHTMLНастроек();
			КонецЕсли;
			РезультатКоманды = ВыполнитьЧастуюКомандуHTMLНаСервереПанелька(Действие, ПараметрыКомандыHTML, ДанныеЧерновика, Окна,
				HTMLНастройкиКонтекстКартинки, ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollCenter"),
				ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollSources"), ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollProperties"));
			Попытка
				ОтветHTML = РезультатКоманды.ДанныеHTML;
				// Обновляем данные в открытом документе без замены HTMLНастроек.
				ПолеОтветаHTML = Элементы.ПолеHTMLНастроек.Документ.getElementById("panelkaServerResponse");
				ПолеОтветаHTML.value = ОтветHTML;
				Если Действие = "add_web" Тогда
					ПолеСостоянияHTML = Элементы.ПолеHTMLНастроек.Документ.getElementById("panelkaViewState");
					Если ПолеСостоянияHTML <> Неопределено Тогда
						ПолеСостоянияHTML.value = СостояниеHTMLПанелька;
					КонецЕсли;
				КонецЕсли;
			Исключение
				// Совместимость с уже открытым документом прежней версии.
				// Действие уже выполнено: повторно выполняется только формирование представления.
				ОбновитьHTMLНастроекЕслиНужно(ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollCenter"),
					ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollSources"), ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollProperties"));
			КонецПопытки;
			Если Не ПустаяСтрока(РезультатКоманды.Предупреждение) Тогда
				ПоказатьПредупреждение(Неопределено, РезультатКоманды.Предупреждение);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		ПринятьВыборHTMLПанелька(ПараметрыКомандыHTML);
		Черновик = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "draft", "");
		Если Не ПустаяСтрока(Черновик) Тогда
			ПрименитьСтрокуЧерновикаHTMLПанелька(Черновик);
		КонецЕсли;
		ПараметрыКомандыHTML = СогласоватьАдресаКомандыHTMLПанелька(ПараметрыКомандыHTML);
		СостояниеHTMLПанелька = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "__ui", СостояниеHTMLПанелька);
		Если Действие = "apply_editor" Тогда
			ОбновитьHTMLНастроекЕслиНужно();
			Возврат;
		ИначеЕсли Действие = "save_close" Тогда
			СохранитьНастройкиИЗакрытьПанелька();
			Возврат;
		ИначеЕсли Действие = "save" Тогда
			СохранитьНастройкиКлиентПанелька();
			Возврат;
		ИначеЕсли Действие = "export" Тогда
			ОткрытьЭкспортНастроекПанелька();
			Возврат;
		ИначеЕсли Действие = "import" Тогда
			ПодготовитьИмпортНастроекПанелька();
			ОбновитьHTMLНастроекЕслиНужно();
			Возврат;
		ИначеЕсли Действие = "additional_close" Тогда
			ОбновитьHTMLНастроекЕслиНужно(ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollCenter"),
				ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollSources"), ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollProperties"));
			Возврат;
		ИначеЕсли СтрРазделить("open_additional_settings,additional_apply,additional_choose_appearance,additional_profiles,additional_preview,additional_export_profile,additional_delete_profile,additional_reset,additional_copy_common", ",").Найти(Действие) <> Неопределено Тогда
			ВыполнитьДопНастройкиHTMLПанелька(Действие, ПараметрыКомандыHTML);
			Возврат;
		ИначеЕсли Действие = "switch_native" Тогда
			РежимHTMLНастроек = Ложь;
			СохранитьПользовательскуюНастройкуHTMLПанелька("РежимHTMLНастроек", Ложь);
			ПрименитьРежимHTMLНастроек();
			Возврат;
		ИначеЕсли Действие = "open_more_source" Тогда
			ПослеВыбораЕщеИсточника(Новый Структура("Значение", ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "type", "")),
				Неопределено);
		ИначеЕсли Действие = "choose_metadata_native" Тогда
			КомандаДобавитьИзМетаданных(Неопределено);
			Возврат;
		ИначеЕсли Действие = "choose_files" Тогда
			КомандаДобавитьВнешниеФайлы(Неопределено);
		ИначеЕсли Действие = "choose_folder" Тогда
			КомандаДобавитьВнешнююПапку(Неопределено);
		ИначеЕсли Действие = "choose_extra" Тогда
			КомандаДобавитьДопОбработки(Неопределено);
			Возврат;
		ИначеЕсли Действие = "choose_browser" Тогда
			КомандаЗагрузитьИзБраузеров(Неопределено);
			Возврат;
		ИначеЕсли Действие = "choose_roles" Тогда
			ОткрытьВыборРолей(ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "page", HTMLНастройкиАктивнаяСтраница));
			Возврат;
		ИначеЕсли Действие = "choose_icon" Тогда
			HTMLНастройкиКонтекстКартинки = Новый Структура("Kind,Name", ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "kind",
				"page"),
				?(ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "kind", "page") = "column", ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML,
				"objectId", ""), ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "name", "")));
		ИначеЕсли Действие = "close_icon_picker" Или Действие = "cancel_icon" Тогда
			HTMLНастройкиКонтекстКартинки = Неопределено;
		Иначе
			ПредупреждениеКоманды = ВыполнитьДействиеМодели(Действие, ПараметрыКомандыHTML);
			Если Не ПустаяСтрока(ПредупреждениеКоманды) Тогда
				ПоказатьПредупреждение(Неопределено, ПредупреждениеКоманды);
			КонецЕсли;
			Если Действие = "set_icon" Тогда
				HTMLНастройкиКонтекстКартинки = Неопределено;
			КонецЕсли;
		КонецЕсли;
	Исключение
		HTMLНастройкиОшибкаКомандыМоста = Истина;
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ОбновитьHTMLНастроекЕслиНужно(ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollCenter"), ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollSources"),
		ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, "__scrollProperties"));
КонецПроцедуры

// Применяет черновик, выполняет частую команду и возвращает данные для открытого HTML-документа.
// Изменения остаются в форме; запись в общее хранилище выполняется командой сохранения.
//
// Возвращаемое значение:
//  Структура - результат команды:
//   * ДанныеHTML - Строка - ответ JSON для открытого документа.
//   * Предупреждение - Строка - ожидаемый отказ переноса; пустая строка при выполнении.
&НаСервере
Функция ВыполнитьЧастуюКомандуHTMLНаСервереПанелька(Действие, ДанныеКоманды, ДанныеЧерновика,
	Окна, КонтекстКартинки, ПрокруткаЦентр, ПрокруткаИсточники, ПрокруткаСвойства)
	НачалоОбработки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПроверитьПравоНастройкиПанелька();
	ПринятьВыборHTMLПанелька(ДанныеКоманды);
	// Команда применения уже содержит все поля редактора. Её черновик не применяем второй раз.
	СсылкаДоИзменения = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ПолучитьПараметрHTMLНастроек(ДанныеКоманды, "id", ""));
	ТолькоСвойстваСсылки = Действие = "apply_link_details" И СсылкаДоИзменения <> Неопределено И
		Не ПерсональнаяНастройкаПанелька;
	Если ТолькоСвойстваСсылки Тогда
		ТолькоСвойстваСсылки = СсылкаДоИзменения.Ссылка = СокрЛП(ПолучитьПараметрHTMLНастроек(ДанныеКоманды, "url",
			""));
	КонецЕсли;
	НачатьПакетОбновленияПанелька();
	ПредупреждениеКоманды = "";
	Попытка
		Если ДанныеЧерновика <> Неопределено И Действие <> "apply_link_details" Тогда
			ПрименитьЧерновикHTMLНаСервереПанелька(ДанныеЧерновика);
		КонецЕсли;
		ДанныеКоманды = СогласоватьАдресаКомандыHTMLПанелька(ДанныеКоманды);
		СостояниеHTMLПанелька = ПолучитьПараметрHTMLНастроек(ДанныеКоманды, "__ui", СостояниеHTMLПанелька);
		Если Действие = "set_metadata_group" Тогда
			HTMLНастройкиКатегорияМетаданных = ПолучитьПараметрHTMLНастроек(ДанныеКоманды, "group", "Документы");
			HTMLНастройкиТипИсточника = "metadata";
		ИначеЕсли Действие = "set_source_mode" Тогда
			HTMLНастройкиТипИсточника = ПолучитьПараметрHTMLНастроек(ДанныеКоманды, "mode", "metadata");
		ИначеЕсли Действие = "set_favorite_filter" Тогда
			СохранитьПользовательскуюНастройкуHTMLПанелька("ФильтрИзбранногоHTML",
				ПолучитьПараметрHTMLНастроек(ДанныеКоманды, "filter", "all"));
		ИначеЕсли Действие = "apply_link_details" Или
			СтрРазделить("update_page,update_column,move_link,move_column,move_page,move_group,drag_structure,toggle_general,set_tooltip_mode,add_source,add_web,toggle_link_column,remove_link_from_column,unassign_link,delete_link,add_page,add_column,add_column_default,delete_column,delete_column_mode,delete_page,delete_page_mode,make_tooltip_common,reset_placement", ",").Найти(Действие) <> Неопределено Тогда
			ПредупреждениеКоманды = ВыполнитьДействиеМодели(Действие, ДанныеКоманды);
			Если Действие = "add_web" Тогда
				ОчиститьЧерновикНовойВебСсылкиHTMLПанелька();
			КонецЕсли;
		ИначеЕсли Действие <> "apply_editor" Тогда
			ВызватьИсключение НСтр("ru = 'Команда не поддерживает объединённое выполнение.'");
		КонецЕсли;
	Исключение
		ПрерватьПакетОбновленияПанелька();
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьПакетОбновленияПанелька();
	ТолькоИсточники = ДанныеЧерновика = Неопределено
		И (Действие = "set_metadata_group" Или Действие = "set_source_mode" Или Действие = "set_favorite_filter");
	ТолькоМакет = Ложь;
	Если ТолькоСвойстваСсылки Тогда
		Ответ = Новый Структура("Kind,Data", "link", СформироватьИзмененияСсылкиHTMLПанелька(СсылкаДоИзменения.ИД));
	ИначеЕсли ТолькоИсточники Тогда
		КонтекстДоступа = ПолучитьКонтекстДоступаРедактораПанелька();
		ГруппыМетаданных = ПолучитьГруппыМетаданныхHTML(КонтекстДоступа);
		НормализоватьГруппуМетаданныхHTML(ГруппыМетаданных);
		ДанныеОтвета = Новый Структура;
		ДанныеОтвета.Вставить("Sources", ОтфильтроватьЛичныеИсточникиПанелька(
			СформироватьИсточникиHTML(Окна, КонтекстДоступа), КонтекстДоступа));
		ДанныеОтвета.Вставить("AllowedSources", ПолитикаИсточниковРедактораПанелька(КонтекстДоступа));
		ДанныеОтвета.Вставить("MetadataGroups", ГруппыМетаданных);
		ДанныеОтвета.Вставить("SourceMode", HTMLНастройкиТипИсточника);
		ДанныеОтвета.Вставить("MetadataGroup", HTMLНастройкиКатегорияМетаданных);
		ДанныеОтвета.Вставить("FavoriteFilter", ПолучитьПользовательскуюНастройкуHTMLПанелька("ФильтрИзбранногоHTML",
			"all"));
		ДанныеОтвета.Вставить("State", СостояниеHTMLПанелька);
		Ответ = Новый Структура("Kind,Data", "sources", ДанныеОтвета);
	Иначе
		// Мутации сами обновляют производные поля. Структурный ответ не перечитывает источники.
		ТолькоМакет = СтрРазделить("apply_editor,apply_link_details,update_page,update_column,move_link,move_column,move_page,move_group,drag_structure,toggle_general,set_tooltip_mode,add_source,add_web,toggle_link_column,remove_link_from_column,unassign_link,delete_link,add_page,add_column,add_column_default,delete_column,delete_column_mode,delete_page,delete_page_mode,make_tooltip_common,reset_placement", ",").Найти(Действие) <> Неопределено;
		ПланОбновления = ПрочитатьПланОбновленияПанелька(ЖурналИзмененийПанелька);
		ЧастичныйМакет = ТолькоМакет И Не ПланОбновления.Full;
		ПараметрыМодели = ПараметрыФормированияМоделиHTMLПанелька();
		ПараметрыМодели.БезИсточников = ТолькоМакет И Не ПерсональнаяНастройкаПанелька
			И HTMLНастройкиТипИсточника <> "catalog";
		Если ЧастичныйМакет Тогда
			ПараметрыМодели.ИДКолонок = ПланОбновления.Columns;
			ПараметрыМодели.ИДСсылок = ПланОбновления.Links;
			// Эти операции меняют ссылки и размещения, сохраняя картинки заголовков.
			ПараметрыМодели.БезКартинокЗаголовков = СтрРазделить(
				"add_source,add_web,move_link,toggle_link_column,remove_link_from_column,unassign_link,make_tooltip_common,reset_placement",
				",").Найти(Действие) <> Неопределено;
		КонецЕсли;
		ДанныеОтвета = СформироватьМодельHTML(Окна, КонтекстКартинки, ПараметрыМодели);
		ДанныеОтвета.Ui.Вставить("ScrollCenter", ПрокруткаЦентр);
		ДанныеОтвета.Ui.Вставить("ScrollSources", ПрокруткаИсточники);
		ДанныеОтвета.Ui.Вставить("ScrollProperties", ПрокруткаСвойства);
		Ответ = Новый Структура("Kind,Data", ?(ЧастичныйМакет, "patch", ?(ТолькоМакет, "layout", "model")),
			ДанныеОтвета);
	КонецЕсли;
	Ответ.Вставить("Revision", ВерсияОбновленияПанелька);
	ИзмененияОтвета = Новый Структура;
	ИзмененияОтвета.Вставить("Sources", Не ТолькоСвойстваСсылки И Не ТолькоИсточники И Не ТолькоМакет);
	ИзмененияОтвета.Вставить("Structure", Не ТолькоСвойстваСсылки И Не ТолькоИсточники);
	ИзмененияОтвета.Вставить("Properties", Не ТолькоИсточники);
	ИзмененияОтвета.Вставить("General", Действие = "toggle_general" Или Действие = "set_tooltip_mode");
	Ответ.Вставить("Changes", ИзмененияОтвета);
	Если (ПерсональнаяНастройкаПанелька Или HTMLНастройкиТипИсточника = "catalog") И Не ТолькоСвойстваСсылки Тогда
		Ответ.Changes.Sources = Истина;
	КонецЕсли;
	ПланОтвета = ПрочитатьПланОбновленияПанелька(ЖурналИзмененийПанелька);
	Ответ.Changes.Вставить("Full", ПланОтвета.Full);
	Ответ.Changes.Вставить("Columns", ПланОтвета.Columns);
	Ответ.Changes.Вставить("Headers", ПланОтвета.Full Или
		СтрРазделить("update_page,move_page,add_page,delete_page,delete_page_mode",
		",").Найти(Действие) <> Неопределено);
	ЖурналИзмененийПанелька = "";
	// Длительность серверной обработки без передачи контекста формы и сериализации ответа.
	Ответ.Вставить("ServerMs", Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОбработки));
	ЗаписьОтвета = Новый ЗаписьJSON;
	ЗаписьОтвета.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьОтвета, Ответ);
	Возврат Новый Структура("ДанныеHTML,Предупреждение", ЗаписьОтвета.Закрыть(), ПредупреждениеКоманды);
КонецФункции

// Переводит идентификаторы HTML в тот же контракт переноса, что использует обычная форма.
// Родители и размещения повторно проверяются на сервере до изменения порядка.
//
// Возвращаемое значение:
//  Строка - предупреждение переноса; пустая строка при выполнении или отсутствии переноса.
&НаСервере
Функция ПеренестиСтруктуруHTMLПанелька(ПараметрыПереносаHTML)
	Вид = ПолучитьПараметрHTMLНастроек(ПараметрыПереносаHTML, "kind", "");
	ИдентификаторЭлемента = ПолучитьПараметрHTMLНастроек(ПараметрыПереносаHTML, "dragId", "");
	ВидЦели = ПолучитьПараметрHTMLНастроек(ПараметрыПереносаHTML, "targetKind", "");
	ИДЦели = ПолучитьПараметрHTMLНастроек(ПараметрыПереносаHTML, "targetId", "");
	Если Вид <> "Link" И Вид <> "Column" И Вид <> "Group" Тогда
		ВызватьИсключение НСтр("ru = 'Недопустимый вид переносимого элемента.'");
	КонецЕсли;
	Цель = Новый Структура;
	Цель.Вставить("Вид", ВидЦели);
	Цель.Вставить("ИД", ИДЦели);
	Цель.Вставить("ИДКолонки", "");
	Цель.Вставить("ИДСтраницы", "");
	КолонкаЦели = Неопределено;
	Если ВидЦели = "Link" Тогда
		РазмещениеЦели = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ИДЦели);
		Если РазмещениеЦели <> Неопределено Тогда
			КолонкаЦели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", РазмещениеЦели.ИДКолонки);
		КонецЕсли;
	ИначеЕсли ВидЦели = "Column" Или ВидЦели = "Group" Тогда
		КолонкаЦели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", ИДЦели);
	ИначеЕсли ВидЦели = "Page" И Вид = "Column" Тогда
		СтраницаЦели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", ИДЦели);
		Если СтраницаЦели <> Неопределено Тогда
			Цель.ИДСтраницы = СтраницаЦели.ИД;
		КонецЕсли;
	КонецЕсли;
	Если КолонкаЦели <> Неопределено Тогда
		Цель.ИДКолонки = КолонкаЦели.ИД;
		Цель.ИДСтраницы = КолонкаЦели.ИДСтраницы;
	ИначеЕсли ПустаяСтрока(Цель.ИДСтраницы) Тогда
		ВызватьИсключение НСтр("ru = 'Место назначения больше не существует.'");
	КонецЕсли;
	Если (Вид = "Link" И ВидЦели <> "Link" И ВидЦели <> "Column")
		Или (Вид = "Column" И ВидЦели <> "Column" И ВидЦели <> "Page")
		Или (Вид = "Group" И ВидЦели <> "Group" И ВидЦели <> "Column") Тогда
		ВызватьИсключение НСтр("ru = 'Элементы нельзя перенести в выбранное место.'");
	КонецЕсли;
	Если Вид = "Group" Тогда
		Если Не ГруппироватьПоТипуОбъекта Или ИдентификаторЭлемента <> Цель.ИДКолонки Тогда
			ВызватьИсключение НСтр("ru = 'Группу можно перемещать только внутри своей колонки.'");
		КонецЕсли;
		ИдентификаторЭлемента = "G:" + ИдентификаторЭлемента + ":" + ПолучитьПараметрHTMLНастроек(ПараметрыПереносаHTML, "group", "");
		Если ВидЦели = "Group" Тогда
			Цель.ИД = "G:" + Цель.ИДКолонки + ":" + ПолучитьПараметрHTMLНастроек(ПараметрыПереносаHTML, "targetGroup", "");
		КонецЕсли;
	ИначеЕсли Вид = ВидЦели И ИдентификаторЭлемента = ИДЦели Тогда
		Возврат "";
	КонецЕсли;
	Узлы = Новый Массив;
	Узлы.Добавить(Новый Структура("ИД", ИдентификаторЭлемента));
	ПредупреждениеПереноса = ПеренестиУзлыДерева(Новый Структура("Вид,Узлы", Вид, Узлы), Цель);
	Если Не ПустаяСтрока(ПредупреждениеПереноса) Тогда
		Возврат ПредупреждениеПереноса;
	КонецЕсли;
	Если Вид = "Link" Тогда
		HTMLНастройкиАктивнаяКолонка = КолонкаЦели.ИД;
		СтраницаЦели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", КолонкаЦели.ИДСтраницы);
		HTMLНастройкиАктивнаяСтраница = СтраницаЦели.ИмяСтраницы;
	КонецЕсли;
	Возврат "";
КонецФункции

// Возвращает только изменяемые свойства одной ссылки и всех её размещений.
// Адрес и структура неизменны: типы, картинки и списки источников повторно не запрашиваются.
&НаСервере
Функция СформироватьИзмененияСсылкиHTMLПанелька(СсылкаИД)
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", СсылкаИД);
	Размещения = Новый Массив;
	Для Каждого Размещение Из ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", СсылкаИД)) Цикл
		ИзменениеРазмещения = Новый Структура;
		ИзменениеРазмещения.Вставить("PlacementId", Размещение.ИД);
		ИзменениеРазмещения.Вставить("Name", Размещение.ИтоговоеНаименование);
		ИзменениеРазмещения.Вставить("Tooltip", Размещение.ИтоговаяПодсказка);
		ИзменениеРазмещения.Вставить("CustomName", Размещение.СвоеНаименование);
		ИзменениеРазмещения.Вставить("CustomTooltip", Размещение.СвояПодсказка);
		ИзменениеРазмещения.Вставить("Custom", Размещение.СвоеНаименование Или Размещение.СвояПодсказка);
		Размещения.Добавить(ИзменениеРазмещения);
	КонецЦикла;
	ИзмененияСсылки = Новый Структура;
	ИзмененияСсылки.Вставить("Id", СсылкаКаталога.ИД);
	ИзмененияСсылки.Вставить("Name", СсылкаКаталога.Наименование);
	ИзмененияСсылки.Вставить("Tooltip", СсылкаКаталога.Подсказка);
	ИзмененияСсылки.Вставить("Placements", Размещения);
	ИзмененияСсылки.Вставить("State", СостояниеHTMLПанелька);
	Возврат ИзмененияСсылки;
КонецФункции

// Проверяет доступ и выполняет действие над моделью по параметрам HTML-команды.
//
// Возвращаемое значение:
//  Строка - предупреждение переноса; для остальных выполненных действий пустая строка.
&НаСервере
Функция ВыполнитьДействиеМодели(Действие, ПараметрыДействия)
	ПроверитьПравоНастройкиПанелька();
	Имя = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "name", "");
	КолонкаИмя = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "columnId", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "column",
		HTMLНастройкиАктивнаяКолонка));
	СтраницаИмя = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "page", HTMLНастройкиАктивнаяСтраница);
	ИдентификаторСсылки = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "id", "");
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ИдентификаторСсылки);
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", КолонкаИмя);
	РазмещениеСсылки = Неопределено;
	Если СсылкаКаталога <> Неопределено И КолонкаПанели <> Неопределено Тогда
		РазмещениеСсылки = НайтиРазмещениеПоСвязи(СсылкаКаталога.ИД, КолонкаПанели.ИД);
	КонецЕсли;
	ИДРазмещения = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "placementId", "");
	Если ЗначениеЗаполнено(ИДРазмещения) Тогда
		Найденное = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ИДРазмещения);
		Если Найденное <> Неопределено И Найденное.ИДСсылки = ИдентификаторСсылки Тогда
			РазмещениеСсылки = Найденное;
		КонецЕсли;
	КонецЕсли;
	Если Действие = "drag_structure" Тогда
		Возврат ПеренестиСтруктуруHTMLПанелька(ПараметрыДействия);
	ИначеЕсли Действие = "move_group" Тогда
		КолонкаГруппы = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "columnId", ""));
		Если КолонкаГруппы = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Колонка группы больше не существует.'");
		КонецЕсли;
		СдвинутьГруппуПанелька(КолонкаГруппы.ИД, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "group", ""),
			?(ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "direction", "prev") = "prev", -1, 1));
	ИначеЕсли Действие = "select_page" Тогда
		HTMLНастройкиАктивнаяСтраница = СтраницаИмя;
		HTMLНастройкиАктивнаяКолонка = "";
		ВыбранныйТип = "Page";
	ИначеЕсли Действие = "select_column" Тогда
		HTMLНастройкиАктивнаяСтраница = СтраницаИмя;
		HTMLНастройкиАктивнаяКолонка = КолонкаИмя;
		ВыбранныйТип = "Column";
	ИначеЕсли Действие = "select_link" Тогда
		HTMLНастройкиАктивнаяКолонка = КолонкаИмя;
		ВыбратьСсылку(ИдентификаторСсылки, КолонкаИмя);
		Если РазмещениеСсылки <> Неопределено Тогда
			ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД;
		КонецЕсли;
	ИначеЕсли Действие = "apply_link_details" Тогда
		Если РазмещениеСсылки = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Размещение больше не существует. Выберите ссылку заново.'");
		КонецЕсли;
		ЗаписатьСвойстваСсылки(ИдентификаторСсылки, РазмещениеСсылки.ИД, Имя, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "tip", ""),
			ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "customName", "0") = "1", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "customTooltip",
			"0") = "1", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "url", ""));
		Возврат "";
	ИначеЕсли Действие = "make_tooltip_common" Тогда
		ПрименитьПодсказкуВсем(ИдентификаторСсылки, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "tip", ""));
	ИначеЕсли Действие = "reset_placement" Тогда
		Если РазмещениеСсылки <> Неопределено Тогда
			СброситьСвойстваРазмещения(РазмещениеСсылки.ИД);
		КонецЕсли;
	ИначеЕсли Действие = "add_source" Или Действие = "add_web" Тогда
		ОписаниеДобавления = ОписаниеДобавленияИзHTMLПанелька(Действие, ПараметрыДействия, Имя);
		ДобавитьСсылкуПоОписаниюПанелька(ОписаниеДобавления, Истина, Неопределено, Неопределено,
			Не ПерсональнаяНастройкаПанелька);
	ИначеЕсли Действие = "toggle_link_column" Тогда
		Если СсылкаКаталога = Неопределено Или КолонкаПанели = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Если РазмещениеСсылки <> Неопределено Тогда
			СнятьРазмещение(ИдентификаторСсылки, КолонкаИмя);
		Иначе
			ДобавитьСсылку(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка, СсылкаКаталога.Наименование, СсылкаКаталога.Подсказка, КолонкаИмя);
		КонецЕсли;
	ИначеЕсли Действие = "remove_link_from_column" Тогда
		СнятьРазмещение(ИдентификаторСсылки, КолонкаИмя);
	ИначеЕсли Действие = "unassign_link" Тогда
		Если РазмещениеСсылки = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Размещение не найдено.'");
		КонецЕсли;
		Пакет = Новый Массив;
		Пакет.Добавить(Новый Структура("Вид,ИД", "Link", РазмещениеСсылки.ИД));
		ВыполнитьПакетСерверПанелька("unassign", Пакет, "column-unassigned");
	ИначеЕсли Действие = "delete_link" Тогда
		УдалитьСсылку(ИдентификаторСсылки);
	ИначеЕсли Действие = "add_page" Тогда
		ДобавитьСтраницуМодели(Имя);
	ИначеЕсли Действие = "add_column" Или Действие = "add_column_default" Тогда
		ДобавитьКолонкуМодели(Имя, СтраницаИмя);
	ИначеЕсли Действие = "update_page" Тогда
		ИзменитьСтруктуруМодели("page", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "old", ""), Имя);
	ИначеЕсли Действие = "update_column" Тогда
		ИзменитьСтруктуруМодели("column", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "old", ""), Имя, СтраницаИмя);
	ИначеЕсли Действие = "delete_column" Или Действие = "delete_column_mode" Тогда
		УдалитьКолонкуМодели(КолонкаИмя, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "mode", "unassign"));
	ИначеЕсли Действие = "delete_page" Или Действие = "delete_page_mode" Тогда
		УдалитьСтраницуМодели(СтраницаИмя, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "mode", "unassign"));
	ИначеЕсли Действие = "move_link" Тогда
		Если РазмещениеСсылки <> Неопределено Тогда
			ПереместитьМодель("link", РазмещениеСсылки.ИД, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "direction", "next"));
		КонецЕсли;
	ИначеЕсли Действие = "move_page" Тогда
		Стр = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", СтраницаИмя);
		Если Стр <> Неопределено Тогда
			ПереместитьМодель("page", Стр.ИД, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "direction", "next"));
		КонецЕсли;
	ИначеЕсли Действие = "move_column" Тогда
		Если КолонкаПанели <> Неопределено Тогда
			ПереместитьМодель("column", КолонкаПанели.ИД, ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "direction", "next"));
		КонецЕсли;
	ИначеЕсли Действие = "set_source_mode" Тогда
		HTMLНастройкиТипИсточника = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "mode", "metadata");
	ИначеЕсли Действие = "set_metadata_group" Тогда
		HTMLНастройкиКатегорияМетаданных = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "group", "Документы");
		HTMLНастройкиТипИсточника = "metadata";
	ИначеЕсли Действие = "set_theme" Тогда
		СохранитьПользовательскуюНастройкуHTMLПанелька("ТемаНастроекHTML", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "theme",
			"light"));
	ИначеЕсли Действие = "set_favorite_filter" Тогда
		СохранитьПользовательскуюНастройкуHTMLПанелька("ФильтрИзбранногоHTML", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "filter",
			"all"));
	ИначеЕсли Действие = "set_icon" Тогда
		Вид = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "kind", "page");
		ТаблицаСтруктуры = ?(Вид = "page", ТаблицаСтраниц, ТаблицаКолонок);
		Поле = ?(Вид = "page", "ИмяСтраницы", "ИмяКолонки");
		Стр = НайтиСтрокуМодели(ТаблицаСтруктуры, Поле, Имя);
		Если Стр <> Неопределено Тогда
			Стр.ИмяКартинки = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "icon", "");
			НастройкиИзменены = Истина;
			ПредставленияАктуальныПанелька = Ложь;
		КонецЕсли;
	ИначеЕсли Действие = "toggle_general" Тогда
		ОтметитьИзменениеПанелька("full");
		КлючСвойства = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "property", "");
		ИменаСвойств = Новый Структура;
		ИменаСвойств.Вставить("GroupByType", "ГруппироватьПоТипуОбъекта");
		ИменаСвойств.Вставить("UnassignedTab", "НеРаспределенныеНаОтдельнойВкладке");
		ИменаСвойств.Вставить("StandardTab", "СтандартныеНаОтдельнойВкладке");
		ИменаСвойств.Вставить("FillMetadataComment", "ЗаполнятьКомментарийИзМетаданных");
		Свойство = "";
		ИменаСвойств.Свойство(КлючСвойства, Свойство);
		Если СтрРазделить("ГруппироватьПоТипуОбъекта,НеРаспределенныеНаОтдельнойВкладке,СтандартныеНаОтдельнойВкладке,ЗаполнятьКомментарийИзМетаданных", ",").Найти(Свойство) <> Неопределено Тогда
			ЭтотОбъект[Свойство] = Не ЭтотОбъект[Свойство];
			НастройкиИзменены = Истина;
			ПредставленияАктуальныПанелька = Ложь;
		КонецЕсли;
	ИначеЕсли Действие = "set_tooltip_mode" Тогда
		ОтметитьИзменениеПанелька("full");
		РежимОтображенияПодсказок = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "mode", "Снизу");
		НастройкиИзменены = Истина;
		ПредставленияАктуальныПанелька = Ложь;
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестная команда настроек: %1'"), Действие);
	КонецЕсли;
	Если СтрРазделить("select_page,select_column,select_link,set_source_mode,set_metadata_group,set_theme,set_favorite_filter,set_icon,toggle_general,set_tooltip_mode", ",").Найти(Действие) <> Неопределено Тогда
		ЗаполнитьРедактор();
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

#Область ДеревоОбычнойФормы

// Отмечает выбор узла для последующей обработки наблюдателем выделения.
&НаКлиенте
Процедура ОтметитьВыборУзлаДереваПанелька()
	Если ОбычныйИнтерфейсОбновляется Тогда
		Возврат;
	КонецЕсли;
	// Не меняем компоновку посреди события активации строки.
	// Постоянный обработчик ожидания прочитает окончательное выделение.
	ПоказатьВсеВыбранныеПанелька = Ложь;
	// Изменение состава выделения обнаруживает наблюдатель.
	// Повторная активация той же строки не требует заполнения свойств.
КонецПроцедуры

// Проверяет видимость дерева вместе с его родительскими группами.
&НаКлиенте
Функция ДеревоПанелиДоступноПанелька()
	// Видимость самой таблицы не учитывает скрытие родительской группы.
	// На 8.3.21 методы раскрытия веток недоступны для скрытого дерева.
	Возврат Не РежимHTMLНастроек
		И Не ДопНастройкиОткрытыПанелька
		И Элементы.ГруппаОбычныеНастройки.Видимость
		И Элементы.РабочаяОбласть.Видимость
		И Элементы.СтруктураПанели.Видимость
		И Элементы.ДеревоПанели.Видимость;
КонецФункции

// Перестраивает видимое дерево, восстанавливая раскрытие и выделение.
&НаКлиенте
Процедура ОбновитьОбычнуюФорму()
	Если Не ДеревоПанелиДоступноПанелька() Или ОбычныйИнтерфейсОбновляется Тогда
		Возврат;
	КонецЕсли;
	ОбычныйИнтерфейсОбновляется = Истина;
	Попытка
		ВыделениеДо = Новый Массив;
		Для Каждого Идентификатор Из Элементы.ДеревоПанели.ВыделенныеСтроки Цикл
			Узел = ДеревоПанели.НайтиПоИдентификатору(Идентификатор);
			Если Узел <> Неопределено Тогда
				ВыделенныйУзел = Новый Структура;
				ВыделенныйУзел.Вставить("Вид", Узел.Вид);
				ВыделенныйУзел.Вставить("ИД", Узел.ИД);
				ВыделенныйУзел.Вставить("Ключ", Узел.Ключ);
				ВыделенныйУзел.Вставить("Идентификатор", Идентификатор);
				ВыделениеДо.Добавить(ВыделенныйУзел);
			КонецЕсли;
		КонецЦикла;
		План = ПрочитатьПланОбновленияПанелька(ЖурналИзмененийПанелька);
		Раскрытые = Новый Соответствие;
		Для Каждого Ветка Из ВеткиПланаОбновленияПанелька(План) Цикл
			ЗапомнитьВеткиДерева(Ветка, Раскрытые);
		КонецЦикла;
		ПодготовитьОбычноеПредставление();
		СинхронизироватьВыборРазмещения();
		Для Каждого Ветка Из ВеткиПланаОбновленияПанелька(План) Цикл
			ВосстановитьВеткиДерева(Ветка, Раскрытые);
		КонецЦикла;
		ВосстановитьВыборПоПлануПанелька(ВыделениеДо, План);
		ЖурналИзмененийПанелька = "";
		Если Элементы.ДеревоПанели.ВыделенныеСтроки.Количество() = 0 И
			Элементы.ДеревоПанели.ТекущаяСтрока <> Неопределено Тогда
			Элементы.ДеревоПанели.ВыделенныеСтроки.Добавить(Элементы.ДеревоПанели.ТекущаяСтрока);
		КонецЕсли;
		ПодписьВыделенияПанелька = "";
	Исключение
		ОбычныйИнтерфейсОбновляется = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ОбычныйИнтерфейсОбновляется = Ложь;
	ПроверитьВыделениеПанелька();
КонецПроцедуры

// Возвращает только дочерние строки затронутых колонок; сами колонки сохраняются.
&НаКлиенте
Функция ВеткиПланаОбновленияПанелька(План)
	Ветки = Новый Массив;
	Если План.Full Тогда
		Ветки.Добавить(ДеревоПанели.ПолучитьЭлементы());
	Иначе
		Для Каждого Страница Из ДеревоПанели.ПолучитьЭлементы() Цикл
			Для Каждого Колонка Из Страница.ПолучитьЭлементы() Цикл
				Если План.Columns.Найти(Колонка.ИД) <> Неопределено Тогда
					Ветки.Добавить(Колонка.ПолучитьЭлементы());
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Возврат Ветки;
КонецФункции

// Не меняет текущую строку и выделение, если платформа сохранила их идентификаторы.
&НаКлиенте
Процедура ВосстановитьВыборПоПлануПанелька(ВыделениеДо, План)
	Текущий = Элементы.ДеревоПанели.ТекущиеДанные;
	Если Текущий = Неопределено Или Текущий.Ключ <> КлючВыбораДерева Тогда
		ВыделитьУзелДерева(ДеревоПанели.ПолучитьЭлементы(), КлючВыбораДерева);
	КонецЕсли;
	Если ВыделениеДо.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	НовыеИдентификаторы = Новый Массив;
	Для Каждого СохраненныйУзел Из ВыделениеДо Цикл
		Узел = ДеревоПанели.НайтиПоИдентификатору(СохраненныйУзел.Идентификатор);
		Если Узел <> Неопределено И Узел.Ключ <> СохраненныйУзел.Ключ Тогда
			Узел = Неопределено;
		КонецЕсли;
		Если Узел = Неопределено Тогда
			Для Каждого Ветка Из ВеткиПланаОбновленияПанелька(План) Цикл
				Узел = НайтиУзелПоВидуИИДПанелька(Ветка, СохраненныйУзел.Вид, СохраненныйУзел.ИД);
				Если Узел <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Узел <> Неопределено Тогда
			НовыеИдентификаторы.Добавить(Узел.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
	Совпадает = НовыеИдентификаторы.Количество() = Элементы.ДеревоПанели.ВыделенныеСтроки.Количество();
	Если Совпадает Тогда
		Для Каждого ИД Из Элементы.ДеревоПанели.ВыделенныеСтроки Цикл
			Если НовыеИдентификаторы.Найти(ИД) = Неопределено Тогда
				Совпадает = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не Совпадает Тогда
		Элементы.ДеревоПанели.ВыделенныеСтроки.Очистить();
		Для Каждого ИД Из НовыеИдентификаторы Цикл
			Элементы.ДеревоПанели.ВыделенныеСтроки.Добавить(ИД);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Согласует текущую строку таблицы размещений с выбранным размещением.
&НаКлиенте
Процедура СинхронизироватьВыборРазмещения()
	Если ВыбранныйТип <> "Link" Тогда
		Возврат;
	КонецЕсли;
	РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
	Если РазмещениеСсылки <> Неопределено Тогда
		Элементы.Размещения.ТекущаяСтрока = РазмещениеСсылки.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

// Запоминает состояние раскрытия веток видимого дерева.
&НаКлиенте
Процедура ЗапомнитьВеткиДерева(Строки, Раскрытые)
	Если Не ДеревоПанелиДоступноПанелька() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Узел Из Строки Цикл
		Если Узел.Вид <> "Link" Тогда
			Раскрытые.Вставить(Узел.Ключ, Элементы.ДеревоПанели.Развернут(Узел.ПолучитьИдентификатор()));
		КонецЕсли;
		ЗапомнитьВеткиДерева(Узел.ПолучитьЭлементы(), Раскрытые);
	КонецЦикла;
КонецПроцедуры

// Восстанавливает раскрытие веток после обновления структуры.
&НаКлиенте
Процедура ВосстановитьВеткиДерева(Строки, Раскрытые)
	Если Не ДеревоПанелиДоступноПанелька() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Узел Из Строки Цикл
		Если Узел.Вид <> "Link" И Раскрытые[Узел.Ключ] <> Ложь И
			Не Элементы.ДеревоПанели.Развернут(Узел.ПолучитьИдентификатор()) Тогда
			Элементы.ДеревоПанели.Развернуть(Узел.ПолучитьИдентификатор());
		КонецЕсли;
		ВосстановитьВеткиДерева(Узел.ПолучитьЭлементы(), Раскрытые);
		Если Узел.Вид <> "Link" И Раскрытые[Узел.Ключ] = Ложь И
			Элементы.ДеревоПанели.Развернут(Узел.ПолучитьИдентификатор()) Тогда
			Элементы.ДеревоПанели.Свернуть(Узел.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Выбирает строку дерева по устойчивому ключу.
&НаКлиенте
Функция ВыделитьУзелДерева(Строки, Ключ)
	Для Каждого Узел Из Строки Цикл
		Если Узел.Ключ = Ключ Тогда
			Элементы.ДеревоПанели.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
			Возврат Истина;
		КонецЕсли;
		Если ВыделитьУзелДерева(Узел.ПолучитьЭлементы(), Ключ) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Возвращает картинку из библиотеки для обычной формы на сервере.
&НаКлиентеНаСервереБезКонтекста
Функция КартинкаОбычнойФормы(Имя)
	Если ПустаяСтрока(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат БиблиотекаКартинок[Имя];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Подготавливает дерево и свойства обычного интерфейса на сервере.
&НаСервере
Процедура ПодготовитьОбычноеПредставление()
	КлючГруппы = КлючВыбораДерева;
	Если ВыбранныйТип = "Group" И Не ГруппироватьПоТипуОбъекта Тогда
		ВыбранныйТип = "Column";
	КонецЕсли;
	ОбновитьПредставления();
	Если ВыбранныйТип = "Link" Тогда
		СогласоватьВыборСРазмещением();
	КонецЕсли;
	// Используем то же представление страниц и размещений, что HTML.
	// Дерево — временный реквизит, не пятая таблица хранения.
	ТипыДоп = ПолучитьТипыДопИсточниковПанелька();
	ПланОбновления = ПрочитатьПланОбновленияПанелька(ЖурналИзмененийПанелька);
	ФильтрКолонок = ?(ПланОбновления.Full, Неопределено, ПланОбновления.Columns);
	Если ДеревоПанели.ПолучитьЭлементы().Количество() = 0 Тогда
		ФильтрКолонок = Неопределено;
	КонецЕсли;
	Представление = РассчитатьСтруктуруПанелиПанелька(ФильтрКолонок);
	СтраницыПоИД = ИндексСтрокПоИДПанелька(ТаблицаСтраниц);
	КолонкиПоИД = ИндексСтрокПоИДПанелька(ТаблицаКолонок);
	Дерево = Новый ДеревоЗначений;
	Для Каждого Имя Из СтрРазделить("Ключ,Вид,ИД,ИДСтраницы,ИДКолонки,Название,Подсказка,Отображение", ",") Цикл
		Дерево.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Дерево.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Картинка"));
	Для Каждого Страница Из Представление.Pages Цикл
		СтраницаПанели = СтраницыПоИД[Страница.Id];
		УзелС = Дерево.Строки.Добавить();
		УзелС.Ключ = "P:" + СтраницаПанели.ИД;
		УзелС.Вид = "Page";
		УзелС.ИД = СтраницаПанели.ИД;
		УзелС.ИДСтраницы = СтраницаПанели.ИД;
		УзелС.Название = СтраницаПанели.ИмяСтраницы;
		УзелС.Картинка = КартинкаОбычнойФормы(СтраницаПанели.ИмяКартинки);
		Для Каждого Колонка Из Страница.Columns Цикл
			КолонкаПанели = КолонкиПоИД[Колонка.Id];
			УзелК = УзелС.Строки.Добавить();
			УзелК.Ключ = "C:" + КолонкаПанели.ИД;
			УзелК.Вид = "Column";
			УзелК.ИД = КолонкаПанели.ИД;
			УзелК.ИДСтраницы = СтраницаПанели.ИД;
			УзелК.ИДКолонки = КолонкаПанели.ИД;
			УзелК.Название = КолонкаПанели.ИмяКолонки;
			УзелК.Картинка = КартинкаОбычнойФормы(КолонкаПанели.ИмяКартинки);
			Список = Новый ТаблицаЗначений;
			Список.Колонки.Добавить("Данные");
			Список.Колонки.Добавить("Порядок");
			Список.Колонки.Добавить("Тип");
			Для Каждого Ссылка Из Колонка.Links Цикл
				Стр = Список.Добавить();
				Стр.Данные = Ссылка;
				Стр.Порядок = Ссылка.Order;
				Стр.Тип = ТипОбъектаОбычнойФормы(Ссылка.Source, Ссылка.Url, ТипыДоп);
			КонецЦикла;
			Список.Сортировать("Порядок");
			Группы = Новый Массив;
			Если ГруппироватьПоТипуОбъекта Тогда
				Для Каждого Стр Из Список Цикл
					Если Группы.Найти(Стр.Тип) = Неопределено Тогда
						Группы.Добавить(Стр.Тип);
					КонецЕсли;
				КонецЦикла;
			Иначе
				Группы.Добавить("");
			КонецЕсли;
			Для Каждого ТипГруппы Из Группы Цикл
				РодительСсылок = УзелК;
				Если ГруппироватьПоТипуОбъекта Тогда
					РодительСсылок = УзелК.Строки.Добавить();
					РодительСсылок.Ключ = "G:" + КолонкаПанели.ИД + ":" + ТипГруппы;
					РодительСсылок.Вид = "Group";
					РодительСсылок.ИД = РодительСсылок.Ключ;
					РодительСсылок.ИДСтраницы = СтраницаПанели.ИД;
					РодительСсылок.ИДКолонки = КолонкаПанели.ИД;
					РодительСсылок.Название = ТипГруппы;
					Для Каждого Стр Из Список Цикл
						Если Стр.Тип = ТипГруппы Тогда
							РодительСсылок.Картинка = ИконкаОбъектаОбычнойФормы(Стр.Данные.Source, Стр.Данные.Url,
								ТипГруппы);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Для Каждого Стр Из Список Цикл
					Если ГруппироватьПоТипуОбъекта И Стр.Тип <> ТипГруппы Тогда
						Продолжить;
					КонецЕсли;
					Ссылка = Стр.Данные;
					Узел = РодительСсылок.Строки.Добавить();
					Узел.Ключ = "L:" + Ссылка.PlacementId;
					Узел.Вид = "Link";
					Узел.ИД = Ссылка.PlacementId;
					Узел.ИДСтраницы = СтраницаПанели.ИД;
					Узел.ИДКолонки = КолонкаПанели.ИД;
					Узел.Название = Ссылка.Name;
					Узел.Подсказка = Ссылка.Tooltip;
					Узел.Отображение = ?(Ссылка.Custom, "Есть отличия", "Общие свойства");
					Узел.Картинка = ИконкаОбъектаОбычнойФормы(Ссылка.Source, Ссылка.Url, Стр.Тип);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	СинхронизироватьВеткиДереваПанелька(ДеревоПанели.ПолучитьЭлементы(), Дерево.Строки, ФильтрКолонок);
	ЗаполнитьОбычныеСвойства();
	Если ВыбранныйТип = "Group" Тогда
		КлючВыбораДерева = КлючГруппы;
	КонецЕсли;
	Если ОбычныйИсточник = "Каталог панели" Тогда
		ОбновитьИсточникиОбычныеНаСервере(Новый Массив);
	КонецЕсли;
КонецПроцедуры

// Сохраняет идентификаторы неизменных веток; заменяет только изменённый уровень.
&НаСервере
Процедура СинхронизироватьВеткиДереваПанелька(СтрокиФормы, СтрокиДерева, ФильтрКолонок = Неопределено)
	СовпадаетУровень = СтрокиФормы.Количество() = СтрокиДерева.Количество();
	Если СовпадаетУровень Тогда
		Для Номер = 0 По СтрокиФормы.Количество() - 1 Цикл
			Если СтрокиФормы[Номер].Ключ <> СтрокиДерева[Номер].Ключ Тогда
				СовпадаетУровень = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не СовпадаетУровень Тогда
		СтрокиФормы.Очистить();
		Для Каждого СтрокаДерева Из СтрокиДерева Цикл
			НоваяСтрока = СтрокиФормы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
			СинхронизироватьВеткиДереваПанелька(НоваяСтрока.ПолучитьЭлементы(), СтрокаДерева.Строки);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Для Номер = 0 По СтрокиФормы.Количество() - 1 Цикл
		СтрокаФормы = СтрокиФормы[Номер];
		СтрокаДерева = СтрокиДерева[Номер];
		Для Каждого Имя Из СтрРазделить("Вид,ИД,ИДСтраницы,ИДКолонки,Название,Подсказка,Отображение", ",") Цикл
			Если СтрокаФормы[Имя] <> СтрокаДерева[Имя] Тогда
				СтрокаФормы[Имя] = СтрокаДерева[Имя];
			КонецЕсли;
		КонецЦикла;
		СтрокаФормы.Картинка = СтрокаДерева.Картинка;
		Если ФильтрКолонок <> Неопределено И СтрокаФормы.Вид = "Column" И
			ФильтрКолонок.Найти(СтрокаФормы.ИД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СинхронизироватьВеткиДереваПанелька(СтрокаФормы.ПолучитьЭлементы(), СтрокаДерева.Строки, ФильтрКолонок);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область РедакторСвойств

// Применяет изменённые текстовые свойства и согласует представление редактора.
&НаКлиенте
Процедура ПрименитьИзмененияТекстовогоРедактораПанелька()
	Если Не ЕстьИзмененияОбычногоРедактораПанелька() Тогда
		Возврат;
	КонецЕсли;
	ОбычныйИнтерфейсОбновляется = Истина;
	Попытка
		ПолноеОбновление = ПрименитьТекстовыйРедакторПанелька();
	Исключение
		ОбычныйИнтерфейсОбновляется = Ложь;
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	ОбычныйИнтерфейсОбновляется = Ложь;
	Если ПолноеОбновление Тогда
		ОбновитьОбычнуюФорму();
	Иначе
		ПодписьВыделенияПанелька = "";
		ПроверитьВыделениеПанелька();
	КонецЕсли;
КонецПроцедуры

// Заполняет свойства и доступность элементов обычного интерфейса на сервере.
&НаСервере
Процедура ЗаполнитьОбычныеСвойства()
	ОбновитьКонтекстноеМенюДерева();
	ОбновитьНазначениеДобавленияПанелька();
	Если ВыбранныйТип = "Link" И ЗначениеЗаполнено(ВыбраннаяСсылкаИД) Тогда
		ЗаполнитьРедактор();
	КонецЕсли;
	ЗаполнитьПредставлениеОбычныхСвойствПанелька(ЭтотОбъект);
КонецПроцедуры

// Применяет одинаковые правила видимости, подписей и выбранной структуры в обоих контекстах.
// Форма — УправляемаяФорма с уже рассчитанными разрешениями и полями редактора.
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПредставлениеОбычныхСвойствПанелька(Форма)
	Если Форма.ВыбранныйТип = "Group" Тогда
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.СостоянияСвойствПанелька, "ТекущаяСтраница",
			Форма.Элементы.СтраницаГруппаПанелька);
		Форма.КонтекстВыбораОбычный = СтрШаблон(НСтр("ru = 'Группа объектов%1Перетащите группу внутри колонки или используйте команды «Поднять выше» и «Опустить ниже».'"), Символы.ПС);
		Возврат;
	КонецЕсли;
	ЭтоСсылка = Форма.ВыбранныйТип = "Link" И ЗначениеЗаполнено(Форма.ВыбраннаяСсылкаИД);
	НесколькоКолонок = ЭтоСсылка И Форма.ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки",
		Форма.ВыбраннаяСсылкаИД)).Количество() > 1;
	УстановитьСвойствоЭлементаПанелька(Форма.Элементы.ПояснениеНазвания, "Видимость", НесколькоКолонок);
	УстановитьСвойствоЭлементаПанелька(Форма.Элементы.ПояснениеПодсказки, "Видимость", НесколькоКолонок);
	Если ЭтоСсылка Тогда
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.СостоянияСвойствПанелька, "ТекущаяСтраница",
			Форма.Элементы.СтраницаСсылкаПанелька);
		РазмещениеСсылки = НайтиСтрокуМодели(Форма.ТаблицаРазмещений, "ИД", Форма.ВыбранноеРазмещениеИД);
		Если РазмещениеСсылки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Форма.КлючВыбораДерева = "L:" + РазмещениеСсылки.ИД;
		Форма.КонтекстВыбораОбычный = Форма.HTMLНастройкиАктивнаяСтраница + " → " +
			ИмяКолонкиПанелька(Форма.ТаблицаКолонок, Форма.HTMLНастройкиАктивнаяКолонка) + " → " + Форма.РедакторНазвание;
		Форма.ОбластьНазвания = ?(Форма.РедакторСвоеНазвание, "Только в «" + ИмяКолонкиПанелька(Форма.ТаблицаКолонок,
			Форма.HTMLНастройкиАктивнаяКолонка) + "»", "Во всех колонках с общим значением");
		Форма.ОбластьПодсказки = ?(Форма.РедакторСвояПодсказка, "Только в «" + ИмяКолонкиПанелька(Форма.ТаблицаКолонок,
			Форма.HTMLНастройкиАктивнаяКолонка) + "»", "Во всех колонках с общим значением");
		Форма.ПояснениеНазвания = ?(Форма.РедакторСвоеНазвание, "Изменится только в выбранной колонке.",
			"Изменится во всех колонках с общим названием.");
		Форма.ПояснениеПодсказки = ?(Форма.РедакторСвояПодсказка,
			"Изменится только в выбранной колонке. Пустой текст допустим.",
			"Изменится во всех колонках с общей подсказкой.");
	Иначе
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.СостоянияСвойствПанелька, "ТекущаяСтраница",
			Форма.Элементы.СтраницаСвойстваПанелька);
		ЭтоСтраница = Форма.ВыбранныйТип <> "Column";
		ТаблицаСтруктуры = ?(ЭтоСтраница, Форма.ТаблицаСтраниц, Форма.ТаблицаКолонок);
		Поле = ?(ЭтоСтраница, "ИмяСтраницы", "ИмяКолонки");
		Стр = НайтиСтрокуМодели(ТаблицаСтруктуры, Поле, ?(ЭтоСтраница, Форма.HTMLНастройкиАктивнаяСтраница,
			Форма.HTMLНастройкиАктивнаяКолонка));
		Если Стр = Неопределено Тогда
			Форма.ВыбранныйТип = "Page";
			Форма.HTMLНастройкиАктивнаяСтраница = "Главная";
			Форма.HTMLНастройкиАктивнаяКолонка = "";
			Стр = НайтиСтрокуМодели(Форма.ТаблицаСтраниц, "ИД", "page-main");
			ЭтоСтраница = Истина;
			Поле = "ИмяСтраницы";
		КонецЕсли;
		Форма.КлючВыбораДерева = ?(ЭтоСтраница, "P:", "C:") + Стр.ИД;
		Форма.СтруктураНазвание = Стр[Поле];
		Форма.СтруктураКартинка = Стр.ИмяКартинки;
		Форма.ПредпросмотрКартинки = КартинкаОбычнойФормы(Стр.ИмяКартинки);
		Форма.СтруктураСтраница = ?(ЭтоСтраница, "", Стр.Страница);
		Форма.СтруктураРоли = ?(ЭтоСтраница, Стр.РолиДоступа, "");
		Форма.КонтекстВыбораОбычный = ?(ЭтоСтраница, "Страница: ", "Колонка: " + Форма.СтруктураСтраница + " → ") +
			Форма.СтруктураНазвание;
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.СостоянияСтруктурыПанелька, "Видимость", Не (ЭтоСтраница И
			Форма.ПерсональнаяНастройкаПанелька));
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.СостоянияСтруктурыПанелька, "ТекущаяСтраница", ?(ЭтоСтраница,
			Форма.Элементы.СтраницаРолиПанелька, Форма.Элементы.СтраницаРодительПанелька));
		Системный = ЭтоСистемныйИД(Стр.ИД);
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.СтруктураНазвание, "Доступность", Не Системный);
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.СтруктураСтраница, "Доступность", Не Системный);
		УстановитьСвойствоЭлементаПанелька(Форма.Элементы.ВыбратьРолиКнопка, "Доступность", ЭтоСтраница И
			Стр.ИД <> "page-main");
	КонецЕсли;
	УстановитьСвойствоЭлементаПанелька(Форма.Элементы.ПодсказкаДобавления, "Высота", Макс(1,
		СтрЧислоСтрок(Форма.ПодсказкаДобавления)));
	УстановитьСвойствоЭлементаПанелька(Форма.Элементы.ПояснениеНазвания, "Высота", 1);
	УстановитьСвойствоЭлементаПанелька(Форма.Элементы.ПояснениеПодсказки, "Высота", 1);
КонецПроцедуры

// Применяет изменения активного редактора и сообщает об ошибке проверки.
&НаКлиенте
Функция ПрименитьОбычныйРедактор()
	Если ДопНастройкиОткрытыПанелька Тогда
		// Черновик рабочего редактора уже применен при открытии вкладок.
		Возврат Истина;
	КонецЕсли;
	Если РежимHTMLНастроек Тогда
		Если Не СинхронизироватьКомандыHTMLПанелька() Тогда
			Возврат Ложь;
		КонецЕсли;
		Если HTMLНастройкиКомандаСинхронизирована = Истина Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат ПрименитьЧерновикHTMLПанелька();
	КонецЕсли;
	Если ОбычныйИнтерфейсОбновляется Или МножественныйВыборПанелька = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не ЕстьИзмененияОбычногоРедактораПанелька() Тогда
		Возврат Истина;
	КонецЕсли;
	ОбычныйИнтерфейсОбновляется = Истина;
	Попытка
		ПрименитьОбычныйРедакторНаСервере();
		ОбычныйИнтерфейсОбновляется = Ложь;
		Возврат Истина;
	Исключение
		ОбычныйИнтерфейсОбновляется = Ложь;
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Не отправляет неизменённый редактор на сервер перед каждой командой.
&НаКлиенте
Функция ЕстьИзмененияОбычногоРедактораПанелька()
	Если ВыбранныйТип = "Page" Или ВыбранныйТип = "Column" Тогда
		Возврат СтруктураНазвание <> ?(ВыбранныйТип = "Page", HTMLНастройкиАктивнаяСтраница,
			ИмяКолонкиПанелька(ТаблицаКолонок, HTMLНастройкиАктивнаяКолонка));
	КонецЕсли;
	Если ВыбранныйТип <> "Link" Или Не ЗначениеЗаполнено(ВыбранноеРазмещениеИД) Тогда
		Возврат Ложь;
	КонецЕсли;
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ВыбраннаяСсылкаИД);
	РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
	Если СсылкаКаталога = Неопределено Или РазмещениеСсылки = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат РедакторАдрес <> СсылкаКаталога.Ссылка
		Или РедакторСвоеНазвание <> РазмещениеСсылки.СвоеНаименование
		Или РедакторСвояПодсказка <> РазмещениеСсылки.СвояПодсказка
		Или РедакторНазвание <> ?(РедакторСвоеНазвание, РазмещениеСсылки.Наименование, СсылкаКаталога.Наименование)
		Или РедакторПодсказка <> ?(РедакторСвояПодсказка, РазмещениеСсылки.Подсказка, СсылкаКаталога.Подсказка);
КонецФункции

// Применяет текст и обновляет существующие строки; смена адреса может изменить группу.
&НаСервере
Функция ПрименитьТекстовыйРедакторПанелька()
	ПолноеОбновление = Ложь;
	Если ВыбранныйТип = "Link" Тогда
		СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ВыбраннаяСсылкаИД);
		ПолноеОбновление = СсылкаКаталога = Неопределено;
		Если СсылкаКаталога <> Неопределено Тогда
			ПолноеОбновление = СсылкаКаталога.Ссылка <> СокрЛП(РедакторАдрес);
		КонецЕсли;
	КонецЕсли;
	ПрименитьОбычныйРедакторНаСервере();
	Если Не ПолноеОбновление Тогда
		ОбновитьТекстыИзМоделиПанелька(ДеревоПанели.ПолучитьЭлементы(),
			ИндексСтрокПоИДПанелька(ТаблицаСтраниц), ИндексСтрокПоИДПанелька(ТаблицаКолонок),
			ИндексСтрокПоИДПанелька(ТаблицаРазмещений));
		ЗаполнитьОбычныеСвойства();
		Если ОбычныйИсточник = "Каталог панели" Тогда
			ОбновитьИсточникиОбычныеНаСервере(Новый Массив);
		КонецЕсли;
	КонецЕсли;
	Если Не ПолноеОбновление Тогда
		ЖурналИзмененийПанелька = "";
	КонецЕсли;
	Возврат ПолноеОбновление;
КонецФункции

// Обновляет подписи без изменения состава строк, картинок, раскрытия и текущей позиции.
&НаСервере
Процедура ОбновитьТекстыИзМоделиПанелька(Строки, Страницы, Колонки, Размещения)
	Для Каждого Узел Из Строки Цикл
		Если Узел.Вид = "Page" Тогда
			Данные = Страницы[Узел.ИД];
			Если Данные <> Неопределено Тогда
				Если Узел.Название <> Данные.ИмяСтраницы Тогда
					Узел.Название = Данные.ИмяСтраницы;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Узел.Вид = "Column" Тогда
			Данные = Колонки[Узел.ИД];
			Если Данные <> Неопределено Тогда
				Если Узел.Название <> Данные.ИмяКолонки Тогда
					Узел.Название = Данные.ИмяКолонки;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Узел.Вид = "Link" Тогда
			Данные = Размещения[Узел.ИД];
			Если Данные <> Неопределено Тогда
				Если Узел.Название <> Данные.ИтоговоеНаименование Тогда
					Узел.Название = Данные.ИтоговоеНаименование;
				КонецЕсли;
				Если Узел.Подсказка <> Данные.ИтоговаяПодсказка Тогда
					Узел.Подсказка = Данные.ИтоговаяПодсказка;
				КонецЕсли;
				Отображение = ?(Данные.СвоеНаименование Или Данные.СвояПодсказка, "Есть отличия", "Общие свойства");
				Если Узел.Отображение <> Отображение Тогда
					Узел.Отображение = Отображение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ОбновитьТекстыИзМоделиПанелька(Узел.ПолучитьЭлементы(), Страницы, Колонки, Размещения);
	КонецЦикла;
КонецПроцедуры

// Переносит поля обычного редактора в модель на сервере.
&НаСервере
Процедура ПрименитьОбычныйРедакторНаСервере()
	Если ВыбранныйТип = "Link" И ЗначениеЗаполнено(ВыбранноеРазмещениеИД) Тогда
		ЗаписатьСвойстваСсылки(ВыбраннаяСсылкаИД, ВыбранноеРазмещениеИД, РедакторНазвание, РедакторПодсказка,
			РедакторСвоеНазвание, РедакторСвояПодсказка, РедакторАдрес);
	ИначеЕсли ВыбранныйТип = "Page" Или ВыбранныйТип = "Column" Тогда
		Вид = ?(ВыбранныйТип = "Page", "page", "column");
		СтароеИмя = ?(Вид = "page", HTMLНастройкиАктивнаяСтраница, HTMLНастройкиАктивнаяКолонка);
		Если СтруктураНазвание <> ?(Вид = "page", СтароеИмя, ИмяКолонкиПанелька(ТаблицаКолонок, СтароеИмя)) Тогда
			ИзменитьСтруктуруМодели(Вид, СтароеИмя, СтруктураНазвание, СтруктураСтраница);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Открывает выбор области применения названия или подсказки.
&НаКлиенте
Процедура ОбластьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.Добавить("common",НСтр("ru = 'Во всех колонках с общим значением'"));
	Список.Добавить("local",СтрШаблон(НСтр("ru = 'Только в «%1»'"), ИмяКолонкиПанелька(ТаблицаКолонок,
		HTMLНастройкиАктивнаяКолонка)));
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораОбласти", ЭтотОбъект, Элемент.Имя), Список, Элемент);
КонецПроцедуры

// Применяет выбранную область общих или индивидуальных свойств.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  Имя - Строка - имя редактора области названия или подсказки.
&НаКлиенте
Процедура ПослеВыбораОбласти(Результат, Имя) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Имя = "ОбластьНазвания" Тогда
		РедакторСвоеНазвание = Результат.Значение = "local";
	Иначе
		РедакторСвояПодсказка = Результат.Значение = "local";
	КонецЕсли;
	ИзменитьРежимРедактора();
	ОбновитьОбычнуюФорму();
КонецПроцедуры

#КонецОбласти

#Область КомандыСтруктуры

// Возвращает выбранному размещению общие свойства.
&НаКлиенте
Процедура СброситьСвойстваВыбранногоРазмещенияПанелька()
	СброситьСвойстваРазмещения(ВыбранноеРазмещениеИД);
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Запрашивает подтверждение удаления ссылки из всех колонок.
&НаКлиенте
Процедура ЗапроситьУдалениеСсылкиПанелька()
	Если ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", ВыбраннаяСсылкаИД)).Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ВыбраннаяСсылкаИД) Тогда
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеУдаленияСсылки", ЭтотОбъект, ВыбраннаяСсылкаИД),
		НСтр("ru = 'Удалить ссылку из всех колонок и каталога?'"), РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

// Применяет редактор и создаёт страницу.
&НаКлиенте
Процедура ДобавитьСтраницуКлиентПанелька()
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	ДобавитьСтраницуМодели("");
	HTMLНастройкиАктивнаяКолонка = "";
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Применяет редактор и создаёт колонку на активной странице.
&НаКлиенте
Процедура ДобавитьКолонкуКлиентПанелька()
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	ДобавитьКолонкуМодели("", HTMLНастройкиАктивнаяСтраница);
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Запрашивает подтверждение удаления страницы или колонки.
&НаКлиенте
Процедура ЗапроситьУдалениеСтруктурыПанелька()
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Контекст = Новый Структура("Вид,Имя", ВыбранныйТип, ?(ВыбранныйТип = "Page", HTMLНастройкиАктивнаяСтраница,
		HTMLНастройкиАктивнаяКолонка));
	Варианты = Новый СписокЗначений;
	Варианты.Добавить("unassign", НСтр("ru = 'Перенести ссылки в «Не распределено»'"));
	Варианты.Добавить("delete_links", НСтр("ru = 'Удалить ссылки только из удаляемой страницы или колонки'"));
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеУдаленияСтруктуры", ЭтотОбъект, Контекст), Варианты);
КонецПроцедуры

// Предлагает страницы для переноса выбранной колонки.
//
// Параметры:
//  Элемент - ПолеФормы - поле страницы для размещения списка выбора.
&НаКлиенте
Процедура ВыбратьСтраницуКолонкиПанелька(Элемент)
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", HTMLНастройкиАктивнаяКолонка);
	Если КолонкаПанели = Неопределено Или ЭтоСистемныйИД(КолонкаПанели.ИД) Тогда
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Для Каждого СтраницаПанели Из ТаблицаСтраниц Цикл
		Если СтраницаПанели.ИД = "page-main" Или Не ЭтоСистемныйИД(СтраницаПанели.ИД) Тогда
			Список.Добавить(СтраницаПанели.ИД, СтраницаПанели.ИмяСтраницы);
		КонецЕсли;
	КонецЦикла;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораСтраницыКолонки", ЭтотОбъект, КолонкаПанели.ИД), Список, Элемент);
КонецПроцедуры

// Передаёт изменение порядка выбранного элемента в модель.
&НаКлиенте
Процедура ПереместитьСтруктуруКлиент(Направление)
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйТип = "Link" Тогда
		ИдентификаторЭлемента = ВыбранноеРазмещениеИД;
		Вид = "link";
	ИначеЕсли ВыбранныйТип = "Page" Тогда
		Стр = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", HTMLНастройкиАктивнаяСтраница);
		ИдентификаторЭлемента = Стр.ИД;
		Вид = "page";
	Иначе
		Стр = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", HTMLНастройкиАктивнаяКолонка);
		Если Стр = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ИдентификаторЭлемента = Стр.ИД;
		Вид = "column";
	КонецЕсли;
	ПереместитьМодель(Вид, ИдентификаторЭлемента, Направление);
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Удаляет элемент структуры после подтверждения.
//
// Параметры:
//  Ответ - Неопределено, ЭлементСпискаЗначений - способ удаления; Неопределено при отмене.
//  Контекст - Структура - адрес элемента структуры:
//   * Вид - Строка - Page или Column.
//   * Имя - Строка - имя страницы либо идентификатор колонки.
&НаКлиенте
Процедура ПослеУдаленияСтруктуры(Ответ, Контекст) Экспорт
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Контекст.Вид = "Page" Тогда
		УдалитьСтраницуМодели(Контекст.Имя, Ответ.Значение);
	Иначе
		УдалитьКолонкуМодели(Контекст.Имя, Ответ.Значение);
	КонецЕсли;
	ВыбранныйТип = "Page";
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Предлагает допустимые колонки для копирования или переноса размещения.
&НаКлиенте
Процедура ВыбратьКолонкуРазмещения(Перенос, КопироватьСвойства = Ложь)
	Если Не ПрименитьОбычныйРедактор() Или ПустаяСтрока(ВыбраннаяСсылкаИД) Тогда
		Возврат;
	КонецЕсли;
	Список = КолонкиРазмещенияПоПорядкуПанелька(ТаблицаСтраниц, ТаблицаКолонок,
		ТаблицаРазмещений, ВыбраннаяСсылкаИД);
	Если Список.Количество() = 0 Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Нет свободных колонок для этой ссылки. Добавьте новую колонку.'"));
		Возврат;
	КонецЕсли;
	Контекст = Новый Структура;
	Контекст.Вставить("СсылкаИД", ВыбраннаяСсылкаИД);
	Контекст.Вставить("РазмещениеИД", ВыбранноеРазмещениеИД);
	Контекст.Вставить("Перенос", Перенос);
	Контекст.Вставить("КопироватьСвойства", КопироватьСвойства);
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораРазмещения", ЭтотОбъект, Контекст), Список);
КонецПроцедуры

// Формирует список назначения в порядке страниц и колонок, без обращения к серверу.
// Параметры:
//  Страницы - ДанныеФормыКоллекция - страницы текущего редактора.
//  Колонки - ДанныеФормыКоллекция - колонки текущего редактора.
//  Размещения - ДанныеФормыКоллекция - размещения текущего редактора.
//  СсылкаИД - Строка - ссылка, для которой исключаются уже занятые колонки.
// Возвращаемое значение:
//  СписокЗначений из Строка - идентификаторы колонок с подписями «Страница → Колонка».
&НаКлиентеНаСервереБезКонтекста
Функция КолонкиРазмещенияПоПорядкуПанелька(Страницы, Колонки, Размещения, СсылкаИД)
	Результат = Новый СписокЗначений;
	ПорядокСтраниц = Новый СписокЗначений;
	ЗанятыеКолонки = Новый Соответствие;
	Для Каждого Размещение Из Размещения Цикл
		Если Размещение.ИДСсылки = СсылкаИД Тогда
			ЗанятыеКолонки.Вставить(Размещение.ИДКолонки, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтраницаПанели Из Страницы Цикл
		ПорядокСтраниц.Добавить(СтраницаПанели.Порядок, СтраницаПанели.ИД);
	КонецЦикла;
	ПорядокСтраниц.СортироватьПоЗначению();
	Для Каждого ПозицияСтраницы Из ПорядокСтраниц Цикл
		СтраницаПанели = НайтиСтрокуМодели(Страницы, "ИД", ПозицияСтраницы.Представление);
		ПорядокКолонок = Новый СписокЗначений;
		Для Каждого КолонкаПанели Из Колонки Цикл
			Если КолонкаПанели.ИДСтраницы = СтраницаПанели.ИД
				И Не ЭтоСистемныйИД(КолонкаПанели.ИД) И ЗанятыеКолонки[КолонкаПанели.ИД] = Неопределено Тогда
				ПорядокКолонок.Добавить(КолонкаПанели.Порядок, КолонкаПанели.ИД);
			КонецЕсли;
		КонецЦикла;
		ПорядокКолонок.СортироватьПоЗначению();
		Для Каждого ПозицияКолонки Из ПорядокКолонок Цикл
			КолонкаПанели = НайтиСтрокуМодели(Колонки, "ИД", ПозицияКолонки.Представление);
			Результат.Добавить(КолонкаПанели.ИД, СтраницаПанели.ИмяСтраницы + " → " + КолонкаПанели.ИмяКолонки);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Применяет выбранную колонку назначения.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  Контекст - Структура - параметры переноса или копирования:
//   * СсылкаИД - Строка - идентификатор ссылки.
//   * РазмещениеИД - Строка - идентификатор прежнего размещения.
//   * Перенос - Булево - удалить прежнее размещение.
//   * КопироватьСвойства - Булево - перенести индивидуальные свойства.
&НаКлиенте
Процедура ПослеВыбораРазмещения(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		НазначитьКолонкуОбычнойФормы(Контекст, Результат.Значение);
		ОбновитьОбычнуюФорму();
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Изменяет связь размещения с колонкой на сервере.
&НаСервере
Процедура НазначитьКолонкуОбычнойФормы(Контекст, КолонкаИД)
	ОтметитьИзменениеПанелька("full");
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", Контекст.СсылкаИД);
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", КолонкаИД);
	Если СсылкаКаталога = Неопределено Или КолонкаПанели = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЭтоСистемныйИД(КолонкаПанели.ИД) Тогда
		ВызватьИсключение НСтр("ru = 'Выберите пользовательскую колонку.'");
	КонецЕсли;
	Если Контекст.КопироватьСвойства Тогда
		Исходное = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", Контекст.РазмещениеИД);
		Если Исходное = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если НайтиРазмещениеПоСвязи(СсылкаКаталога.ИД, КолонкаПанели.ИД) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Ссылка уже есть в этой колонке. Её свойства сохранены.'");
		КонецЕсли;
		Копия = СоздатьРазмещение(СсылкаКаталога.ИД, КолонкаПанели.ИД);
		Копия.СвоеНаименование = Исходное.СвоеНаименование;
		Копия.Наименование = Исходное.Наименование;
		Копия.СвояПодсказка = Исходное.СвояПодсказка;
		Копия.Подсказка = Исходное.Подсказка;
		ВыбраннаяСсылкаИД = СсылкаКаталога.ИД;
		ВыбранноеРазмещениеИД = Копия.ИД;
		НастройкиИзменены = Истина;
		ПредставленияАктуальныПанелька = Ложь;
		ОбновитьПредставления();
	ИначеЕсли Контекст.Перенос Тогда
		РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", Контекст.РазмещениеИД);
		Если РазмещениеСсылки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Другое = НайтиРазмещениеПоСвязи(СсылкаКаталога.ИД, КолонкаПанели.ИД);
		Если Другое <> Неопределено И Другое.ИД <> РазмещениеСсылки.ИД Тогда
			ВызватьИсключение НСтр("ru = 'Ссылка уже есть в этой колонке. Выберите её размещение в дереве.'");
		КонецЕсли;
		Максимум = 0;
		Для Каждого ПроверяемоеРазмещение Из ТаблицаРазмещений Цикл
			Если ПроверяемоеРазмещение.ИДКолонки = КолонкаПанели.ИД Тогда
				Максимум = Макс(Максимум, ПроверяемоеРазмещение.Порядок);
			КонецЕсли;
		КонецЦикла;
		Если РазмещениеСсылки.ИДКолонки <> КолонкаПанели.ИД Тогда
			РазмещениеСсылки.ИДКолонки = КолонкаПанели.ИД;
			РазмещениеСсылки.Порядок = Максимум + 10;
		КонецЕсли;
		ВыбраннаяСсылкаИД = СсылкаКаталога.ИД;
		ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД;
		НастройкиИзменены = Истина;
		ПредставленияАктуальныПанелька = Ложь;
		ОбновитьПредставления();
	Иначе
		ДобавитьСсылку(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка, СсылкаКаталога.Наименование, СсылкаКаталога.Подсказка, КолонкаПанели.ИД);
	КонецЕсли;
	HTMLНастройкиАктивнаяКолонка = КолонкаПанели.ИД;
	HTMLНастройкиАктивнаяСтраница = КолонкаПанели.Страница;
	ВыбранныйТип = "Link";
КонецПроцедуры

// Согласует текущую ссылку и колонку с выбранным размещением.
&НаСервере
Процедура СогласоватьВыборСРазмещением()
	РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
	Если РазмещениеСсылки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", РазмещениеСсылки.ИДКолонки);
	СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", РазмещениеСсылки.ИДСсылки);
	Если СтандартныеНаОтдельнойВкладке И СсылкаКаталога.Источник = "objects" И Лев(СсылкаКаталога.Ссылка, 8) = "sys_cmd:" Тогда
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", "column-standard");
	ИначеЕсли КолонкаПанели.ИД = "column-standard" И Не СтандартныеНаОтдельнойВкладке Тогда
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", "column-unassigned");
	КонецЕсли;
	HTMLНастройкиАктивнаяКолонка = КолонкаПанели.ИД;
	HTMLНастройкиАктивнаяСтраница = КолонкаПанели.Страница;
	Если КолонкаПанели.ИД = "column-unassigned" И Не НеРаспределенныеНаОтдельнойВкладке Тогда
		HTMLНастройкиАктивнаяСтраница = "Главная";
	КонецЕсли;
КонецПроцедуры

// Удаляет ссылку после подтверждения пользователя.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - результат подтверждения удаления.
//  ИдентификаторСсылки - Строка - идентификатор удаляемой ссылки.
&НаКлиенте
Процедура ПослеУдаленияСсылки(Ответ, ИдентификаторСсылки) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	УдалитьСсылку(ИдентификаторСсылки);
	ВыбранныйТип = "Column";
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Переносит колонку на выбранную страницу.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  ИдентификаторКолонки - Строка - идентификатор перемещаемой колонки.
&НаКлиенте
Процедура ПослеВыбораСтраницыКолонки(Результат, ИдентификаторКолонки) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", ИдентификаторКолонки);
	СтраницаПанели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", Результат.Значение);
	Если КолонкаПанели = Неопределено Или СтраницаПанели = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НайтиКолонкуНаСтраницеПанелька(ТаблицаКолонок, СтраницаПанели.ИД, КолонкаПанели.ИмяКолонки, КолонкаПанели.ИД) <> Неопределено Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'На странице назначения уже есть колонка с таким названием.'"));
		Возврат;
	КонецЕсли;
	КолонкаПанели.ИДСтраницы = СтраницаПанели.ИД;
	HTMLНастройкиАктивнаяСтраница = СтраницаПанели.ИмяСтраницы;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ЖурналИзмененийПанелька = "";
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Применяет выбранную картинку к странице или колонке.
//
// Параметры:
//  Результат - Неопределено, Структура - выбранная картинка в поле Значение; Неопределено при отмене.
//  Контекст - Структура - адрес элемента структуры:
//   * Вид - Строка - Page или Column.
//   * Имя - Строка - имя страницы либо идентификатор колонки.
&НаКлиенте
Процедура ПослеВыбораКартинкиV3(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТаблицаСтруктуры = ?(Контекст.Вид = "Page", ТаблицаСтраниц, ТаблицаКолонок);
	Поле = ?(Контекст.Вид = "Page", "ИмяСтраницы", "ИмяКолонки");
	Стр = НайтиСтрокуМодели(ТаблицаСтруктуры, Поле, Контекст.Имя);
	Если Стр <> Неопределено Тогда
		Стр.ИмяКартинки = Результат.Значение;
		НастройкиИзменены = Истина;
		ПредставленияАктуальныПанелька = Ложь;
	КонецЕсли;
	ЖурналИзмененийПанелька = "";
	ОбновитьОбычнуюФорму();
КонецПроцедуры

// Открывает диалог задания ролей страницы.
&НаКлиенте
Процедура ОткрытьВыборРолей(Имя)
	Если ПерсональнаяНастройкаПанелька Тогда
		Возврат;
	КонецЕсли;
	СтраницаПанели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", Имя);
	Если СтраницаПанели = Неопределено Или СтраницаПанели.ИД = "page-main" Тогда
		Возврат;
	КонецЕсли;
	ПараметрыВыбора = Новый Структура("РежимОтображения,ТекущиеВыбранные", "ВыборРолей", СтраницаПанели.РолиДоступа);
	ОткрытьФорму(ИмяСоседнейФормыПанелька("ВыборОбъектовМетаданных"), ПараметрыВыбора, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеВыбораРолейV3", ЭтотОбъект, СтраницаПанели.ИД),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Передаёт выбранные роли на проверку и запись.
//
// Параметры:
//  Результат - Неопределено, Массив из Структура - выбранные строки формы; Неопределено при отмене:
//   * Представление - Строка - подпись выбранного объекта.
//   * Ссылка - Строка - адрес объекта или имя роли.
//   * Подсказка - Строка - дополнительное описание; поле может отсутствовать у файлов.
//  ИдентификаторСтраницы - Строка - идентификатор страницы с изменяемыми ролями.
&НаКлиенте
Процедура ПослеВыбораРолейV3(Результат, ИдентификаторСтраницы) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Роль Из Результат Цикл
		Имена.Добавить(Роль.Ссылка);
	КонецЦикла;
	ПроверитьРолиИЗаписать(ИдентификаторСтраницы, СтрСоединить(Имена, ", "));
	ОбновитьHTMLНастроекЕслиНужно();
КонецПроцедуры

// Проверяет имена ролей и записывает их для страницы.
&НаСервере
Процедура ПроверитьРолиИЗаписать(ИдентификаторСтраницы, Текст)
	Если ПерсональнаяНастройкаПанелька Тогда
		Возврат;
	КонецЕсли;
	ОтметитьИзменениеПанелька("full");
	Для Каждого Имя Из СтрРазделить(Текст, ",", Ложь) Цикл
		Если Метаданные.Роли.Найти(СокрЛП(Имя)) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не найдена роль: %1'"), Имя);
		КонецЕсли;
	КонецЦикла;
	СтраницаПанели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", ИдентификаторСтраницы);
	Если СтраницаПанели <> Неопределено Тогда
		СтраницаПанели.РолиДоступа = Текст;
		НастройкиИзменены = Истина;
		ПредставленияАктуальныПанелька = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область КаталогИсточников

// Применяет редактор перед выполнением команды добавления источника.
//
// Параметры:
//  ВидИсточника - Строка - web, browser, files, folder, metadata или extra.
&НаКлиенте
Процедура ВыбратьДополнительныйИсточникПанелька(ВидИсточника)
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	ДобавитьИзДополнительногоИсточникаПанелька(ВидИсточника);
КонецПроцедуры

// Проверяет разрешение источника и открывает соответствующий способ добавления.
//
// Параметры:
//  ВидИсточника - Строка - standard, web, browser, files, folder, metadata или extra.
&НаКлиенте
Процедура ДобавитьИзДополнительногоИсточникаПанелька(ВидИсточника)
	Если Не ИсточникРедактораРазрешенПанелька(ВидИсточника) Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Этот источник запрещён администратором.'"));
		Возврат;
	КонецЕсли;
	Если ВидИсточника = "standard" Тогда
		КомандаДобавитьСтандартныеИнструментыПанелька(Неопределено);
	ИначеЕсли ВидИсточника = "web" Тогда
		ДобавитьВебКоманда(Неопределено);
	ИначеЕсли ВидИсточника = "browser" Тогда
		КомандаЗагрузитьИзБраузеров(Неопределено);
	ИначеЕсли ВидИсточника = "extra" Тогда
		КомандаДобавитьДопОбработки(Неопределено);
	ИначеЕсли ВидИсточника = "metadata" Тогда
		КомандаДобавитьИзМетаданных(Неопределено);
	ИначеЕсли ВидИсточника = "files" Тогда
		КомандаДобавитьВнешниеФайлы(Неопределено);
		ОбновитьОбычнуюФорму();
	ИначеЕсли ВидИсточника = "folder" Тогда
		КомандаДобавитьВнешнююПапку(Неопределено);
		ОбновитьОбычнуюФорму();
	КонецЕсли;
КонецПроцедуры

// Обновляет каталог источников обычной формы.
&НаКлиенте
Процедура ОбновитьИсточникиОбычнойФормы()
	Окна = Новый Массив;
	Если ОбычныйИсточник = "Открытые окна" Тогда
		Окна = ПолучитьОткрытыеОкнаДляHTMLНастроек();
	КонецЕсли;
	ОбновитьИсточникиОбычныеНаСервере(Окна);
КонецПроцедуры

// Формирует строки каталога источников на сервере.
&НаСервере
Процедура ОбновитьИсточникиОбычныеНаСервере(Окна)
	КонтекстДоступа = ПолучитьКонтекстДоступаРедактораПанелька();
	Если Не ИсточникРедактораРазрешенПанелька(ОбычныйИсточник) Тогда
		ОбычныйИсточник = "Избранное";
	КонецЕсли;
	Если ОбычныйИсточник = "Метаданные" Тогда
		Группы = ПолучитьГруппыМетаданныхHTML();
		Найдена = Ложь;
		Для Каждого Группа Из Группы Цикл
			Если Группа.Id = ОбычнаяКатегория Тогда
				Найдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Найдена Тогда
			ОбычнаяКатегория = ?(Группы.Количество() = 0, "", Группы[0].Id);
		КонецЕсли;
	КонецЕсли;
	ИсточникиОбычные.Очистить();
	Данные = Новый Массив;
	Если ОбычныйИсточник = "Каталог панели" Тогда
		Данные = КаталогИсточниковПанелька();
	ИначеЕсли ОбычныйИсточник = "Дополнительные отчёты и обработки" Тогда
		Данные = ДополнительныеИсточникиОбычнойФормы(КонтекстДоступа);
	ИначеЕсли ОбычныйИсточник = "Стандартные инструменты" Тогда
		Данные = СтандартныеИсточникиПанелька();
	ИначеЕсли ОбычныйИсточник = "Метаданные" Тогда
		Данные = ПолучитьМетаданныеКатегорииHTML(ОбычнаяКатегория);
	ИначеЕсли ОбычныйИсточник = "Избранное" Тогда
		Данные = ПолучитьИзбранноеДляHTMLНастроек();
	ИначеЕсли ОбычныйИсточник = "Открытые окна" Тогда
		Данные = ПолучитьОткрытыеОкнаКакИсточникиHTML(Окна);
	КонецЕсли;
	Для Каждого ДанныеИсточника Из ОтфильтроватьЛичныеИсточникиПанелька(Данные, КонтекстДоступа) Цикл
		Стр = ИсточникиОбычные.Добавить();
		Стр.Название = ДанныеИсточника.Name;
		Стр.Ссылка = ДанныеИсточника.Url;
		Стр.Подсказка = ДанныеИсточника.Tooltip;
		Стр.Тип = ДанныеИсточника.Type;
		Стр.Источник = "objects";
		Источник = "";
		ИД = "";
		Если ДанныеИсточника.Свойство("Source", Источник) Тогда
			Стр.Источник = Источник;
		КонецЕсли;
		Если ДанныеИсточника.Свойство("Id", ИД) Тогда
			Стр.ИДСсылки = ИД;
		КонецЕсли;
	КонецЦикла;
	Если ОбычныйИсточник = "Избранное" Тогда
		Фильтр = ПолучитьПользовательскуюНастройкуHTMLПанелька("ФильтрИзбранногоHTML", "all");
		ОбычнаяКатегория = ?(Фильтр = "objects", "Конкретные объекты", ?(Фильтр = "lists", "Списки и отчёты",
			"Все ссылки"));
	КонецЕсли;
	УстановитьСвойствоЭлементаПанелька(Элементы.ОбычнаяКатегория, "Видимость", ОбычныйИсточник = "Метаданные" Или
		ОбычныйИсточник = "Избранное");
	УстановитьСвойствоЭлементаПанелька(Элементы.ИсточникиСписокТип, "Видимость", ОбычныйИсточник <> "Метаданные" И
		ОбычныйИсточник <> "Стандартные инструменты");
	УстановитьСвойствоЭлементаПанелька(Элементы.ДополнительныеИсточники, "Видимость", ОбычныйИсточник = "Ещё источники");
	УстановитьСвойствоЭлементаПанелька(Элементы.ИсточникиСписок, "Видимость", ОбычныйИсточник <> "Ещё источники");
	ОбновитьНазначениеДобавленияПанелька();
КонецПроцедуры

// Предлагает доступные виды источников.
&НаКлиенте
Процедура ИсточникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Список = ПолучитьСписокИсточниковРедактораПанелька();
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораИсточника", ЭтотОбъект), Список, Элемент);
КонецПроцедуры

// Применяет выбранный вид источника.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораИсточника(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбычныйИсточник = Результат.Значение;
	ОбновитьИсточникиОбычнойФормы();
КонецПроцедуры

// Применяет режим фильтрации избранного.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеФильтраИзбранногоОбычный(Результат, Контекст) Экспорт
	Если Результат <> Неопределено Тогда
		СохранитьПользовательскуюНастройкуHTMLПанелька("ФильтрИзбранногоHTML", Результат.Значение);
	КонецЕсли;
	ОбновитьИсточникиОбычнойФормы();
КонецПроцедуры

// Предлагает категории объектов выбранного источника.
&НаКлиенте
Процедура КатегорияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ОбычныйИсточник = "Избранное" Тогда
		Список = Новый СписокЗначений;
		Список.Добавить("all",НСтр("ru = 'Все ссылки'"));
		Список.Добавить("lists",НСтр("ru = 'Списки и отчёты'"));
		Список.Добавить("objects",НСтр("ru = 'Конкретные объекты'"));
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеФильтраИзбранногоОбычный", ЭтотОбъект), Список, Элемент);
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Для Каждого Группа Из ПолучитьГруппыМетаданныхHTML() Цикл
		Список.Добавить(Группа.Id, Группа.Name);
	КонецЦикла;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораКатегории", ЭтотОбъект), Список, Элемент);
КонецПроцедуры

// Применяет выбранную категорию источника.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораКатегории(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбычнаяКатегория = Результат.Значение;
	ОбновитьИсточникиОбычнойФормы();
КонецПроцедуры

// Добавляет выбранные элементы каталога в активную колонку.
&НаКлиенте
Процедура ДобавитьИсточникКоманда(Команда)
	Пакет = ВыбранныеИсточникиДляДобавления();
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", HTMLНастройкиАктивнаяКолонка);
	Если КолонкаПанели = Неопределено Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Сначала выберите колонку в дереве панели.'"));
		Возврат;
	КонецЕсли;
	ДобавитьПакетИсточниковКлиент(Пакет, КолонкаПанели.ИД);
КонецПроцедуры

// Запускает выбранный способ добавления из дополнительных источников.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений, Структура - выбранный пункт или параметры программного вызова:
//   * Значение - Строка - технический вид источника.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораЕщеИсточника(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДобавитьИзДополнительногоИсточникаПанелька(Результат.Значение);
КонецПроцедуры

// Возвращает доступные дополнительные отчёты и обработки.
&НаСервере
Функция ДополнительныеИсточникиОбычнойФормы(КонтекстДоступа = Неопределено)
	Обработка = РеквизитФормыВЗначение("Объект");
	Доступные = Обработка.ПанелькаДоступныеДополнительныеИнструменты(ПерсональнаяНастройкаПанелька, КонтекстДоступа);
	Если КонтекстДоступа <> Неопределено Тогда
		КонтекстДоступа.ДоступныеДополнительные = Новый Соответствие;
		Для Каждого Инструмент Из Доступные.Источники Цикл
			Ключ = Обработка.ПанелькаКлючДополнительнойСсылки(Инструмент.Url);
			Если Не ПустаяСтрока(Ключ) Тогда
				КонтекстДоступа.ДоступныеДополнительные.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Сообщение Из Доступные.Сообщения Цикл
		СообщитьПользователюПанелька(Сообщение);
	КонецЦикла;
	Результат = Доступные.Источники;
	Типы = Новый Соответствие;
	Для Каждого Источник Из Результат Цикл
		Типы.Вставить(Источник.Url, Источник.Type);
	КонецЦикла;
	Если Не ПустаяСтрока(АдресКэшаТиповДопПанелька) Тогда
		УдалитьИзВременногоХранилища(АдресКэшаТиповДопПанелька);
	КонецЕсли;
	АдресКэшаТиповДопПанелька = ПоместитьВоВременноеХранилище(Типы, УникальныйИдентификатор);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область КонтекстноеМеню

// Выполняет явно заданное действие над текущим узлом или пакетом выделенных ссылок.
//
// Параметры:
//  Действие - Строка - действие контекстного меню: prev, next, properties, reset, unassign,
//   copy, move, move_column, add_page, add_column, delete, delete_structure, delete_all.
&НаКлиенте
Процедура ВыполнитьДействиеМенюДереваПанелька(Действие)
	ПроверитьВыделениеПанелька();
	Пакет = ПакетВыбранныхСсылокПанелька();
	Если Пакет.Количество() > 0 И (Действие = "delete" Или Действие = "unassign" Или
		Действие = "reset" Или Действие = "prev" Или Действие = "next" Или Действие = "copy" Или
		Действие = "move") Тогда
		Если Действие = "copy" Или Действие = "move" Тогда
			ВыбратьНазначениеПакетаПанелька(Действие, Пакет);
		Иначе
			ВыполнитьПакетКлиентПанелька(Действие, Пакет);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если МножественныйВыборПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	ОтметитьВыборУзлаДереваПанелька();
	Узел = Элементы.ДеревоПанели.ТекущиеДанные;
	Если Узел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Узел.Ключ <> КлючВыбораДерева Тогда
		Возврат;
	КонецЕсли;
	Если Узел.Вид = "Group" И (Действие = "prev" Или Действие = "next") Тогда
		СдвинутьГруппуПанелька(Узел.ИДКолонки, Узел.Название, ?(Действие = "prev", -1, 1));
		ОбновитьОбычнуюФорму();
		Возврат;
	КонецЕсли;
	Если Действие = "properties" Тогда
		ТекущийЭлемент = ?(ВыбранныйТип = "Link", Элементы.РедакторНазвание, Элементы.СтруктураНазвание);
	ИначеЕсли Действие = "add_page" Тогда
		ДобавитьСтраницуКлиентПанелька();
	ИначеЕсли Действие = "add_column" Тогда
		ДобавитьКолонкуКлиентПанелька();
	ИначеЕсли Действие = "move_column" Тогда
		ВыбратьСтраницуКолонкиПанелька(Элементы.СтруктураСтраница);
	ИначеЕсли Действие = "copy" Тогда
		ВыбратьКолонкуРазмещения(Ложь, Истина);
	ИначеЕсли Действие = "move" Тогда
		ВыбратьКолонкуРазмещения(Истина);
	ИначеЕсли Действие = "reset" Тогда
		СброситьСвойстваВыбранногоРазмещенияПанелька();
	ИначеЕсли Действие = "prev" Тогда
		ПереместитьСтруктуруКлиент("prev");
	ИначеЕсли Действие = "next" Тогда
		ПереместитьСтруктуруКлиент("next");
	ИначеЕсли Действие = "delete_structure" Тогда
		ЗапроситьУдалениеСтруктурыПанелька();
	ИначеЕсли Действие = "delete" Тогда
		ВыполнитьПакетКлиентПанелька("delete", ПакетВыбранныхСсылокПанелька());
	ИначеЕсли Действие = "delete_all" Тогда
		ЗапроситьУдалениеСсылкиПанелька();
	КонецЕсли;
КонецПроцедуры

// Согласует контекстное меню дерева на сервере.
// Контекстные команды используют тот же редактор и ту же модель, что кнопки формы.
&НаСервере
Процедура ОбновитьКонтекстноеМенюДерева()
	Ссылка = ВыбранныйТип = "Link";
	НесколькоРазмещений = ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки",
		ВыбраннаяСсылкаИД)).Количество() > 1;
	УстановитьСвойствоЭлементаПанелька(Элементы.УдалитьСсылкуКнопка, "Доступность", Ссылка И НесколькоРазмещений);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюУдалитьВездеКнопка, "Доступность", Ссылка И НесколькоРазмещений);
	ТекущееРазмещение = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
	ЕстьСвои = Ложь;
	Если ТекущееРазмещение <> Неопределено Тогда
		ЕстьСвои = ТекущееРазмещение.СвоеНаименование Или ТекущееРазмещение.СвояПодсказка;
	КонецЕсли;
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюСбросКнопка, "Доступность", ЕстьСвои);
	УстановитьСвойствоЭлементаПанелька(Элементы.СброситьСвойстваКнопка, "Доступность", ЕстьСвои);
	Страница = ВыбранныйТип = "Page";
	Колонка = ВыбранныйТип = "Column";
	СтраницаПанели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", HTMLНастройкиАктивнаяСтраница);
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", HTMLНастройкиАктивнаяКолонка);
	ОбычнаяСтраница = СтраницаПанели <> Неопределено;
	Если ОбычнаяСтраница Тогда
		ОбычнаяСтраница = СтраницаПанели.ИД <> "page-standard" И СтраницаПанели.ИД <> "page-unassigned";
	КонецЕсли;
	УдаляемаяСтраница = Ложь;
	ОбычнаяКолонка = Ложь;
	Если СтраницаПанели <> Неопределено Тогда
		УдаляемаяСтраница = Не ЭтоСистемныйИД(СтраницаПанели.ИД);
	КонецЕсли;
	Если КолонкаПанели <> Неопределено Тогда
		ОбычнаяКолонка = Не ЭтоСистемныйИД(КолонкаПанели.ИД);
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Копия,Перенос,Нераспределено,Сброс,Убрать,УдалитьВезде", ",") Цикл
		УстановитьСвойствоЭлементаПанелька(Элементы["Меню" + Имя + "Кнопка"], "Видимость", Ссылка);
	КонецЦикла;
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюКолонкаКнопка, "Видимость", Не Ссылка И ОбычнаяСтраница);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюПереносКолонкиКнопка, "Видимость", Колонка И ОбычнаяКолонка);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюУдалениеСтраницыКнопка, "Видимость", Страница И УдаляемаяСтраница);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюУдалениеКолонкиКнопка, "Видимость", Колонка И ОбычнаяКолонка);
	МожноДвигать = ВыбранныйТип = "Group" Или Ссылка Или (Страница И УдаляемаяСтраница) Или (Колонка И ОбычнаяКолонка);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюГруппаПорядок, "Видимость", МожноДвигать);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюГруппаРазмещение, "Видимость", Ссылка Или (Колонка И ОбычнаяКолонка));
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюГруппаУдаление, "Видимость", Ссылка Или (Колонка И
		ОбычнаяКолонка) Или (Страница И УдаляемаяСтраница));
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюВверхКнопка, "Видимость", МожноДвигать);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюВнизКнопка, "Видимость", МожноДвигать);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюВверхКнопка, "Доступность", МожноДвигать);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюВнизКнопка, "Доступность", МожноДвигать);
КонецПроцедуры

#КонецОбласти

#Область ПеретаскиваниеИсточников

// Собирает копии данных выделенных источников до серверного вызова.
&НаКлиенте
Функция ВыбранныеИсточникиДляДобавления()
	Пакет = Новый Массив;
	// Копируем значения до серверного вызова: каталог слева может перестроиться.
	Для Каждого Стр Из ИсточникиОбычные Цикл
		Если Элементы.ИсточникиСписок.ВыделенныеСтроки.Найти(Стр.ПолучитьИдентификатор()) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пакет.Добавить(ДанныеИсточникаДляДобавленияПанелька(Стр));
	КонецЦикла;
	Если Пакет.Количество() = 0 Тогда
		Стр = Элементы.ИсточникиСписок.ТекущиеДанные;
		Если Стр <> Неопределено Тогда
			Пакет.Добавить(ДанныеИсточникаДляДобавленияПанелька(Стр));
		КонецЕсли;
	КонецЕсли;
	Возврат Пакет;
КонецФункции

// Копирует данные выбранного источника до изменения каталога серверным вызовом.
&НаКлиенте
Функция ДанныеИсточникаДляДобавленияПанелька(СтрокаИсточника)
	ДанныеИсточника = Новый Структура;
	ДанныеИсточника.Вставить("Источник", СтрокаИсточника.Источник);
	ДанныеИсточника.Вставить("Ссылка", СтрокаИсточника.Ссылка);
	ДанныеИсточника.Вставить("Название", СтрокаИсточника.Название);
	ДанныеИсточника.Вставить("Подсказка", СтрокаИсточника.Подсказка);
	Возврат ДанныеИсточника;
КонецФункции

// Находит узел дерева по идентификатору строки формы.
&НаКлиенте
Функция УзелДереваПоИдентификатору(Строки, Идентификатор)
	Для Каждого Узел Из Строки Цикл
		Если Узел.ПолучитьИдентификатор() = Идентификатор Тогда
			Возврат Узел;
		КонецЕсли;
		Найденный = УзелДереваПоИдентификатору(Узел.ПолучитьЭлементы(), Идентификатор);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Определяет целевую колонку при перетаскивании источников.
&НаКлиенте
Функция КолонкаПриемникПеретаскивания(ЗначениеПеретаскивания, Строка)
	Если ТипЗнч(ЗначениеПеретаскивания) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	Формат = "";
	Ссылки = Неопределено;
	Если Не ЗначениеПеретаскивания.Свойство("Формат", Формат) Тогда
		Возврат "";
	КонецЕсли;
	Если Формат <> "ПанелькаИсточникиV3" Тогда
		Возврат "";
	КонецЕсли;
	Если Не ЗначениеПеретаскивания.Свойство("Ссылки", Ссылки) Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Ссылки) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	Если Ссылки.Количество() = 0 Или Строка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Узел = УзелДереваПоИдентификатору(ДеревоПанели.ПолучитьЭлементы(), Строка);
	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	// Сброс на ссылку добавляет в её колонку. Страница не задаёт однозначного адресата.
	Если Узел.Вид <> "Column" И Узел.Вид <> "Link" И Узел.Вид <> "Group" Тогда
		Возврат "";
	КонецЕсли;
	Если ЭтоСистемныйИД(Узел.ИДКолонки) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Узел.ИДКолонки;
КонецФункции

// Передаёт пакет источников на сервер и обновляет выделение.
&НаКлиенте
Процедура ДобавитьПакетИсточниковКлиент(Пакет, КолонкаИД)
	Если Пакет.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Добавленные = ДобавитьПакетИсточниковНаСервере(Пакет, КолонкаИД);
		ОбновитьОбычнуюФорму();
		ВыделитьДобавленныеСсылкиПанелька(Добавленные);
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Добавляет пакет источников с одним итоговым обновлением представлений.
&НаСервере
Функция ДобавитьПакетИсточниковНаСервере(Пакет, КолонкаИД)
	НачатьПакетОбновленияПанелька();
	Попытка
		Результат = ДобавитьПакетИсточниковНаСервереБезОбновления(Пакет, КолонкаИД);
	Исключение
		ПрерватьПакетОбновленияПанелька();
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьПакетОбновленияПанелька();
	Возврат Результат;
КонецФункции

// Внутренняя часть пакетной операции; вызывается через внешний обработчик.
&НаСервере
Функция ДобавитьПакетИсточниковНаСервереБезОбновления(Пакет, КолонкаИД)
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", КолонкаИД);
	Если КолонкаПанели = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Колонка больше не существует.'");
	КонецЕсли;
	Если ЭтоСистемныйИД(КолонкаПанели.ИД) Тогда
		ВызватьИсключение НСтр("ru = 'Выберите пользовательскую колонку.'");
	КонецЕсли;
	Для Каждого Данные Из Пакет Цикл
		Если ПустаяСтрока(Данные.Ссылка) Тогда
			ВызватьИсключение НСтр("ru = 'У выбранной ссылки не заполнен адрес.'");
		КонецЕсли;
		ПроверитьФорматАдресаПанелька(Данные.Источник, Данные.Ссылка);
	КонецЦикла;
	Добавленные = Новый Массив;
	КонтекстДоступа = ПолучитьКонтекстДоступаРедактораПанелька();
	ИндексДобавления = ИндексПакетногоДобавленияПанелька();
	Для Каждого Данные Из Пакет Цикл
		Описание = ОписаниеДобавляемойСсылкиПанелька(Данные.Источник, Данные.Ссылка, Данные.Название,
			Данные.Подсказка, КолонкаПанели.ИД);
		ИДСсылки = ДобавитьСсылкуПоОписаниюПанелька(Описание, Ложь, КонтекстДоступа, ИндексДобавления);
		РазмещениеСсылки = НайтиРазмещениеПоСвязи(ИДСсылки, КолонкаПанели.ИД, ИндексДобавления);
		Если РазмещениеСсылки <> Неопределено Тогда
			Добавленные.Добавить(РазмещениеСсылки.ИД);
		КонецЕсли;
	КонецЦикла;
	HTMLНастройкиАктивнаяСтраница = КолонкаПанели.Страница;
	HTMLНастройкиАктивнаяКолонка = КолонкаПанели.ИД;
	ОбновитьПредставления();
	СогласоватьВыборСРазмещением();
	Возврат Добавленные;
КонецФункции

#КонецОбласти

#Область СбросНастроек

// Сбрасывает настройки после подтверждения пользователя.
//
// Параметры:
//  Ответ - КодВозвратаДиалога - результат подтверждения удаления.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеУдаленияВсехНастроек(Ответ, Контекст) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьВсеНастройкиПанелькаНаСервере();
		НастройкиИзменены = Ложь;
		ЗакрытиеПодтвержденоПанелька = Истина;
		Оповестить("Панелька_ОбновитьДашборд");
		Закрыть();
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Записывает отсутствие настроек через защищённый адаптер хранения.
&НаСервере
Процедура УдалитьВсеНастройкиПанелькаНаСервере()
	// Основная форма уже трактует Неопределено как отсутствие общих настроек.
	// Используем известную операцию записи; отказ удаления не маскируется запасным вызовом.
	ПанелькаНастройкиЗаписать(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ПеретаскиваниеСтруктуры

// Собирает вид и идентификатор выделенных узлов дерева.
&НаКлиенте
Процедура СобратьВыделенныеУзлы(Строки, Пакет)
	Для Каждого Узел Из Строки Цикл
		Если Элементы.ДеревоПанели.ВыделенныеСтроки.Найти(Узел.ПолучитьИдентификатор()) <> Неопределено Тогда
			Пакет.Добавить(Новый Структура("Вид,ИД", Узел.Вид, Узел.ИД));
		КонецЕсли;
		СобратьВыделенныеУзлы(Узел.ПолучитьЭлементы(), Пакет);
	КонецЦикла;
КонецПроцедуры

// Определяет допустимого получателя внутреннего переноса.
&НаКлиенте
Функция ПриемникВнутреннегоПереноса(Данные, Строка)
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Формат = "";
	Если Не Данные.Свойство("Формат", Формат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Формат <> "ПанелькаДеревоV3" Или Строка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Узел = УзелДереваПоИдентификатору(ДеревоПанели.ПолучитьЭлементы(), Строка);
	Если Узел = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ПереносимыйУзел Из Данные.Узлы Цикл
		Если ПереносимыйУзел.ИД = Узел.ИД Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Данные.Вид = "Group" Тогда
		Если Не ГруппироватьПоТипуОбъекта Или Данные.Узлы.Количество() <> 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Узел.Вид <> "Group" И Узел.Вид <> "Column" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Лев(Данные.Узлы[0].ИД, СтрДлина("G:" + Узел.ИДКолонки + ":")) <> "G:" + Узел.ИДКолонки + ":" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ОписаниеУзлаПереносаПанелька(Узел);
	КонецЕсли;
	Если Данные.Вид = "Link" Тогда
		Если Узел.Вид <> "Column" И Узел.Вид <> "Link" И Узел.Вид <> "Group" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если ЭтоСистемныйИД(Узел.ИДКолонки) Тогда
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Если Узел.Вид <> "Page" И Узел.Вид <> "Column" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Узел.ИДСтраницы = "page-standard" Или Узел.ИДСтраницы = "page-unassigned" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если Узел.Вид = "Column" И ЭтоСистемныйИД(Узел.ИД) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Возврат ОписаниеУзлаПереносаПанелька(Узел);
КонецФункции

// Возвращает вид и устойчивые идентификаторы узла назначения переноса.
&НаКлиенте
Функция ОписаниеУзлаПереносаПанелька(Узел)
	ОписаниеУзла = Новый Структура;
	ОписаниеУзла.Вставить("Вид", Узел.Вид);
	ОписаниеУзла.Вставить("ИД", Узел.ИД);
	ОписаниеУзла.Вставить("ИДСтраницы", Узел.ИДСтраницы);
	ОписаниеУзла.Вставить("ИДКолонки", Узел.ИДКолонки);
	Возврат ОписаниеУзла;
КонецФункции

// Переносит выделенные ссылки, колонки или группу в модели.
// Ожидаемые конфликты проверяет до изменения модели и журнала обновления.
//
// Возвращаемое значение:
//  Строка - текст предупреждения при отказе; пустая строка при выполнении или отсутствии переноса.
&НаСервере
Функция ПеренестиУзлыДерева(Данные, Цель)
	Если Данные.Вид = "Group" Тогда
		Префикс = "G:" + Цель.ИДКолонки + ":";
		Если Данные.Узлы.Количество() <> 1 Или Лев(Данные.Узлы[0].ИД, СтрДлина(Префикс)) <> Префикс Тогда
			Возврат "";
		КонецЕсли;
		ТипГруппы = Сред(Данные.Узлы[0].ИД, СтрДлина(Префикс) + 1);
		ПередГруппой = ?(Цель.Вид = "Group", Сред(Цель.ИД, СтрДлина(Префикс) + 1), "");
		СдвинутьГруппуПанелька(Цель.ИДКолонки, ТипГруппы, 0, ПередГруппой);
		Возврат "";
	КонецЕсли;
	Если Данные.Узлы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ЭтоСсылки = Данные.Вид = "Link";
	Таблица = ?(ЭтоСсылки, ТаблицаРазмещений, ТаблицаКолонок);
	ПолеРодителя = ?(ЭтоСсылки, "ИДКолонки", "ИДСтраницы");
	РодительИД = ?(ЭтоСсылки, Цель.ИДКолонки, Цель.ИДСтраницы);
	Если ЭтоСсылки Тогда
		Родитель = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", РодительИД);
		Если Родитель = Неопределено Или ЭтоСистемныйИД(РодительИД) Тогда
			Возврат НСтр("ru = 'Выберите пользовательскую колонку.'");
		КонецЕсли;
	Иначе
		Родитель = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", РодительИД);
		Если Родитель = Неопределено Или РодительИД = "page-standard" Или РодительИД = "page-unassigned" Тогда
			Возврат НСтр("ru = 'Выберите пользовательскую страницу.'");
		КонецЕсли;
	КонецЕсли;
	Переносимые = Новый Массив;
	Ссылки = Новый Массив;
	// Полная проверка пакета до первого изменения: конфликт отменяет весь перенос.
	Для Каждого ПереносимыйУзел Из Данные.Узлы Цикл
		Стр = НайтиСтрокуМодели(Таблица, "ИД", ПереносимыйУзел.ИД);
		Если Стр = Неопределено Тогда
			Возврат НСтр("ru = 'Переносимый элемент больше не существует.'");
		КонецЕсли;
		Если Не ЭтоСсылки И ЭтоСистемныйИД(Стр.ИД) Тогда
			Возврат НСтр("ru = 'Системные колонки не переносятся.'");
		КонецЕсли;
		Если ЭтоСсылки Тогда
			Другое = НайтиРазмещениеПоСвязи(Стр.ИДСсылки, РодительИД);
			Если Другое <> Неопределено Тогда
				Если Другое.ИД <> Стр.ИД Тогда
					Возврат НСтр("ru = 'Одна из ссылок уже есть в колонке назначения. Перенос отменён; свойства сохранены.'");
				КонецЕсли;
			КонецЕсли;
			Если Ссылки.Найти(Стр.ИДСсылки) <> Неопределено Тогда
				Возврат НСтр("ru = 'Выбраны два размещения одной ссылки. Переносите их отдельно.'");
			КонецЕсли;
			Ссылки.Добавить(Стр.ИДСсылки);
		КонецЕсли;
		Если Не ЭтоСсылки Тогда
			Если НайтиКолонкуНаСтраницеПанелька(ТаблицаКолонок, РодительИД, Стр.ИмяКолонки, Стр.ИД) <> Неопределено Тогда
				Возврат НСтр("ru = 'На странице назначения уже есть колонка с таким названием.'");
			КонецЕсли;
			Для Каждого РанееИД Из Переносимые Цикл
				Ранее = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", РанееИД);
				Если НРег(СокрЛП(Ранее.ИмяКолонки)) = НРег(СокрЛП(Стр.ИмяКолонки)) Тогда
					Возврат НСтр("ru = 'Выбраны одноимённые колонки. Переносите их на разные страницы.'");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Переносимые.Добавить(Стр.ИД);
	КонецЦикла;
	ПередИД = "";
	Если (ЭтоСсылки И Цель.Вид = "Link") Или (Не ЭтоСсылки И Цель.Вид = "Column") Тогда
		ПередИД = Цель.ИД;
	КонецЕсли;
	// При группировке разрешаем вставку только в своей группе.
	Если ЭтоСсылки И ГруппироватьПоТипуОбъекта И Не ПустаяСтрока(ПередИД) Тогда
		ТипыДоп = ПолучитьТипыДопИсточниковПанелька();
		РазмещениеЦели = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ПередИД);
		СсылкаЦели = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", РазмещениеЦели.ИДСсылки);
		Для Каждого ИдентификаторЭлемента Из Переносимые Цикл
			РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ИдентификаторЭлемента);
			СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", РазмещениеСсылки.ИДСсылки);
			Если ТипОбъектаОбычнойФормы(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка, ТипыДоп) <> ТипОбъектаОбычнойФормы(СсылкаЦели.Источник,
				СсылкаЦели.Ссылка, ТипыДоп) Тогда
				ПередИД = "";
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЭтоСсылки Тогда
		ОтметитьИзменениеПанелька("column", Цель.ИДКолонки);
		Для Каждого УзелПереноса Из Данные.Узлы Цикл
			РазмещениеПереноса = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", УзелПереноса.ИД);
			Если РазмещениеПереноса <> Неопределено Тогда
				ОтметитьИзменениеПанелька("column", РазмещениеПереноса.ИДКолонки);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ОтметитьИзменениеПанелька("full");
	КонецЕсли;
	Упорядоченные = Таблица.Выгрузить();
	Упорядоченные.Сортировать("Порядок, ИД");
	Очередь = Новый Массив;
	Для Каждого Стр Из Упорядоченные Цикл
		Если Стр[ПолеРодителя] <> РодительИД Или Переносимые.Найти(Стр.ИД) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Стр.ИД = ПередИД Тогда
			Для Каждого ИдентификаторЭлемента Из Переносимые Цикл
				Очередь.Добавить(ИдентификаторЭлемента);
			КонецЦикла;
		КонецЕсли;
		Очередь.Добавить(Стр.ИД);
	КонецЦикла;
	Если ПустаяСтрока(ПередИД) Тогда
		Для Каждого ИдентификаторЭлемента Из Переносимые Цикл
			Очередь.Добавить(ИдентификаторЭлемента);
		КонецЦикла;
	КонецЕсли;
	Порядок = 0;
	Для Каждого ИдентификаторЭлемента Из Очередь Цикл
		Стр = НайтиСтрокуМодели(Таблица, "ИД", ИдентификаторЭлемента);
		Порядок = Порядок + 10;
		Стр[ПолеРодителя] = РодительИД;
		Стр.Порядок = Порядок;
	КонецЦикла;
	Если ЭтоСсылки Тогда
		ВыбранноеРазмещениеИД = Переносимые[0];
		РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
		ВыбраннаяСсылкаИД = РазмещениеСсылки.ИДСсылки;
		ВыбранныйТип = "Link";
	Иначе
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", Переносимые[0]);
		HTMLНастройкиАктивнаяКолонка = КолонкаПанели.ИД;
		HTMLНастройкиАктивнаяСтраница = Родитель.ИмяСтраницы;
		ВыбранныйТип = "Column";
	КонецЕсли;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления();
	Возврат "";
КонецФункции

#КонецОбласти

#Область УровниДерева

// Меняет раскрытие дерева и восстанавливает согласованное выделение.
//
// Параметры:
//  Уровень - Строка - Page, Column, Group или All.
//  Разворачивать - Булево - Истина для раскрытия, Ложь для сворачивания.
&НаКлиенте
Процедура УстановитьРаскрытиеДереваПанелька(Уровень, Разворачивать)
	Если Не ДеревоПанелиДоступноПанелька() Тогда
		Возврат;
	КонецЕсли;
	ОбычныйИнтерфейсОбновляется = Истина;
	Попытка
		ИзменитьУровниДерева(ДеревоПанели.ПолучитьЭлементы(), Уровень, Разворачивать);
		ОбычныйИнтерфейсОбновляется = Ложь;
	Исключение
		ОбычныйИнтерфейсОбновляется = Ложь;
		СообщитьПользователюПанелька(ОписаниеОшибки());
	КонецПопытки;
	// Сворачивание может переместить текущую строку на родителя.
	ОтметитьВыборУзлаДереваПанелька();
КонецПроцедуры

// Рекурсивно изменяет раскрытие узлов до указанного уровня.
&НаКлиенте
Процедура ИзменитьУровниДерева(Строки, Уровень, Разворачивать)
	Если Не ДеревоПанелиДоступноПанелька() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Узел Из Строки Цикл
		Если Узел.Вид = "Link" Тогда
			Продолжить;
		КонецЕсли;
		Если Разворачивать Тогда
			// Для раскрытия колонок раскрываем и родительские страницы.
			Если Уровень = "All" Или Уровень = "Group" Или (Уровень = "Column" И Узел.Вид <> "Group") Или
				Узел.Вид = "Page" Тогда
				Элементы.ДеревоПанели.Развернуть(Узел.ПолучитьИдентификатор());
			КонецЕсли;
		КонецЕсли;
		ИзменитьУровниДерева(Узел.ПолучитьЭлементы(), Уровень, Разворачивать);
		Если Не Разворачивать И (Уровень = "All" Или Уровень = Узел.Вид) Тогда
			Элементы.ДеревоПанели.Свернуть(Узел.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область МножественныйВыборИПакетныеОперации

// Возвращает пакет выделенных ссылок; смешанное выделение отклоняется.
&НаКлиенте
Функция ПакетВыбранныхСсылокПанелька()
	Пакет = Новый Массив;
	СобратьВыделенныеУзлы(ДеревоПанели.ПолучитьЭлементы(), Пакет);
	Если Пакет.Количество() = 0 Тогда
		Узел = Элементы.ДеревоПанели.ТекущиеДанные;
		Если Узел <> Неопределено Тогда
			Пакет.Добавить(Новый Структура("Вид,ИД", Узел.Вид, Узел.ИД));
		КонецЕсли;
	КонецЕсли;
	Для Каждого ВыбранныйУзел Из Пакет Цикл
		Если ВыбранныйУзел.Вид <> "Link" Тогда
			Возврат Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Возврат Пакет;
КонецФункции

// Согласует свойства с окончательным выделением без прямых серверных вызовов.
&НаКлиенте
Процедура ПроверитьВыделениеПанелька() Экспорт
	Если Не ДеревоПанелиДоступноПанелька() Или ОбычныйИнтерфейсОбновляется Тогда
		Возврат;
	КонецЕсли;
	БыстраяПодпись = Строка(Элементы.ДеревоПанели.ТекущаяСтрока);
	Для Каждого ИдентификаторСтроки Из Элементы.ДеревоПанели.ВыделенныеСтроки Цикл
		БыстраяПодпись = БыстраяПодпись + ";" + Строка(ИдентификаторСтроки);
	КонецЦикла;
	Если Не ПустаяСтрока(ПодписьВыделенияПанелька)
		И БыстраяПодпись = БыстраяПодписьВыделенияПанелька Тогда
		СтраницаСвойств = Элементы.СтраницаСвойстваПанелька;
		Если МножественныйВыборПанелька Тогда
			СтраницаСвойств = Элементы.СтраницаВыделениеПанелька;
		ИначеЕсли ВыбранныйТип = "Link" Тогда
			СтраницаСвойств = Элементы.СтраницаСсылкаПанелька;
		ИначеЕсли ВыбранныйТип = "Group" Тогда
			СтраницаСвойств = Элементы.СтраницаГруппаПанелька;
		КонецЕсли;
		Если Элементы.СостоянияСвойствПанелька.ТекущаяСтраница = СтраницаСвойств Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Узлы = Новый Массив;
	// Читаем только выделенные строки. Полный обход дерева может подгружать
	// невидимые ветки на клиент и не нужен для обновления панели свойств.
	Для Каждого ИдентификаторСтроки Из Элементы.ДеревоПанели.ВыделенныеСтроки Цикл
		ВыделенныйУзел = ДеревоПанели.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если ВыделенныйУзел <> Неопределено Тогда
			Узлы.Добавить(Новый Структура("Вид,ИД", ВыделенныйУзел.Вид, ВыделенныйУзел.ИД));
			ПоследнийВыделенныйУзел = ВыделенныйУзел;
		КонецЕсли;
	КонецЦикла;
	ТекущийУзел = Элементы.ДеревоПанели.ТекущиеДанные;
	Если Узлы.Количество() = 1 Тогда
		ТекущийУзел = ПоследнийВыделенныйУзел;
	КонецЕсли;
	Подпись = ?(ТекущийУзел = Неопределено, "", ТекущийУзел.Ключ);
	Для Каждого ДанныеВыделенногоУзла Из Узлы Цикл
		Подпись = Подпись + ДанныеВыделенногоУзла.ИД + ";";
		Если ДанныеВыделенногоУзла.Вид = "Link" Тогда
			РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ДанныеВыделенногоУзла.ИД);
			Если РазмещениеСсылки <> Неопределено Тогда
				Подпись = Подпись + Строка(РазмещениеСсылки.СвоеНаименование) + Строка(РазмещениеСсылки.СвояПодсказка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ОжидаетсяМного = Узлы.Количество() > 1;
	ОжидаемаяСтраница = ?(ОжидаетсяМного, Элементы.СтраницаВыделениеПанелька, Элементы.СтраницаСвойстваПанелька);
	Если Не ОжидаетсяМного И ТекущийУзел <> Неопределено Тогда
		Если ТекущийУзел.Вид = "Link" Тогда
			ОжидаемаяСтраница = Элементы.СтраницаСсылкаПанелька;
		ИначеЕсли ТекущийУзел.Вид = "Group" Тогда
			ОжидаемаяСтраница = Элементы.СтраницаГруппаПанелька;
		КонецЕсли;
	КонецЕсли;
	ВидимостьСогласована = Элементы.СостоянияСвойствПанелька.ТекущаяСтраница = ОжидаемаяСтраница;
	Если Подпись = ПодписьВыделенияПанелька И ВидимостьСогласована Тогда
		Возврат;
	КонецЕсли;
	МножественныйВыборПанелька = Узлы.Количество() > 1;
	ОбычныйИнтерфейсОбновляется = Истина;
	Попытка
		Если ТекущийУзел <> Неопределено Тогда
			ВыбратьУзелОбычнойФормыНаКлиенте(ТекущийУзел.Вид, ТекущийУзел.ИД, ТекущийУзел.ИДСтраницы,
				ТекущийУзел.ИДКолонки, Ложь);
		КонецЕсли;
		ПоказатьСостояниеВыделенияПанелькаНаКлиенте(Узлы);
		// Из обработчика ожидания явно обновляем представление только правой панели.
		ПоляДляОбновления = Новый Массив;
		СобратьПоляСвойствДляОбновленияПанелька(ПоляДляОбновления);
		ПоляДляОбновления.Добавить(Элементы.ПодсказкаДобавления);
		ОбновитьОтображениеДанных(ПоляДляОбновления);
		ПодписьВыделенияПанелька = Подпись;
		БыстраяПодписьВыделенияПанелька = БыстраяПодпись;
	Исключение
		ОбычныйИнтерфейсОбновляется = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ОбычныйИнтерфейсОбновляется = Ложь;
КонецПроцедуры

// Предлагает колонку, доступную для всего выбранного пакета.
&НаКлиенте
Процедура ВыбратьНазначениеПакетаПанелька(Действие, Пакет)
	Если Пакет.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	// Тот же порядок, что у выбора назначения одной ссылки.
	ВсеКолонки = КолонкиРазмещенияПоПорядкуПанелька(ТаблицаСтраниц, ТаблицаКолонок, ТаблицаРазмещений, "");
	Для Каждого ЭлементКолонки Из ВсеКолонки Цикл
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", ЭлементКолонки.Значение);
		Если ЭтоСистемныйИД(КолонкаПанели.ИД) Тогда
			Продолжить;
		КонецЕсли;
		Свободна = Истина;
		Для Каждого ЭлементПакета Из Пакет Цикл
			РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ЭлементПакета.ИД);
			Если РазмещениеСсылки = Неопределено Тогда
				Свободна = Ложь;
				Прервать;
			КонецЕсли;
			Если ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки,ИДКолонки", РазмещениеСсылки.ИДСсылки,
				КолонкаПанели.ИД)).Количество() > 0 Тогда
				Свободна = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Свободна Тогда
			Список.Добавить(КолонкаПанели.ИД, КолонкаПанели.Страница + " → " + КолонкаПанели.ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	Если Список.Количество() = 0 Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Нет колонки, свободной для всех выбранных ссылок.'"));
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеНазначенияПакетаПанелька", ЭтотОбъект,
		Новый Структура("Действие,Пакет", Действие, Пакет)), Список);
КонецПроцедуры

// Применяет выбранное назначение групповой операции.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  Контекст - Структура - параметры групповой операции:
//   * Действие - Строка - вид операции над размещениями.
//   * Пакет - Массив из Структура - выбранные узлы:
//   ** Вид - Строка - Link для выбранной ссылки.
//   ** ИД - Строка - идентификатор размещения.
&НаКлиенте
Процедура ПослеНазначенияПакетаПанелька(Результат, Контекст) Экспорт
	Если Результат <> Неопределено Тогда
		ВыполнитьПакетКлиентПанелька(Контекст.Действие, Контекст.Пакет, Результат.Значение);
	КонецЕсли;
КонецПроцедуры

// Применяет редактор, выполняет пакетную операцию и обновляет обычный интерфейс.
&НаКлиенте
Процедура ВыполнитьПакетКлиентПанелька(Действие, Пакет, КолонкаИД = "")
	Если Пакет.Количество() = 0 Или Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ВыполнитьПакетСерверПанелька(Действие, Пакет, КолонкаИД);
		МножественныйВыборПанелька = Ложь;
		ПодписьВыделенияПанелька = "";
		ОбновитьОбычнуюФорму();
		ПроверитьВыделениеПанелька();
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Выполняет групповое действие над размещениями на сервере.
&НаСервере
Процедура ВыполнитьПакетСерверПанелька(Действие, Пакет, КолонкаИД)
	НачатьПакетОбновленияПанелька();
	Попытка
		ВыполнитьПакетСерверПанелькаБезОбновления(Действие, Пакет, КолонкаИД);
	Исключение
		ПрерватьПакетОбновленияПанелька();
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьПакетОбновленияПанелька();
КонецПроцедуры

// Внутренняя часть пакетной операции; вызывается через внешний обработчик.
&НаСервере
Процедура ВыполнитьПакетСерверПанелькаБезОбновления(Действие, Пакет, КолонкаИД)
	Если Действие = "delete" Тогда
		ОтметитьИзменениеПанелька("full");
	Иначе
		Для Каждого ЭлементПакета Из Пакет Цикл
			РП = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ЭлементПакета.ИД);
			Если РП <> Неопределено Тогда
				ОтметитьИзменениеПанелька("column", РП.ИДКолонки);
			КонецЕсли;
		КонецЦикла;
		Если Не ПустаяСтрока(КолонкаИД) Тогда
			ОтметитьИзменениеПанелька("column", КолонкаИД);
		КонецЕсли;
	КонецЕсли;
	Если Действие = "unassign" Тогда
		КолонкаИД = "column-unassigned";
	КонецЕсли;
	Если Действие = "copy" Или Действие = "move" Или Действие = "unassign" Тогда
		КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", КолонкаИД);
		Если КолонкаПанели = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Колонка не найдена.'");
		КонецЕсли;
	КонецЕсли;
	ИДСсылок = Новый Массив;
	Для Каждого ВыбранныйУзел Из Пакет Цикл
		РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранныйУзел.ИД);
		Если ВыбранныйУзел.Вид <> "Link" Или РазмещениеСсылки = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Выберите существующие ссылки.'");
		КонецЕсли;
		Если Действие = "copy" Или Действие = "move" Или Действие = "unassign" Тогда
			Другое = НайтиРазмещениеПоСвязи(РазмещениеСсылки.ИДСсылки, КолонкаИД);
			Если Другое <> Неопределено Тогда
				Если Другое.ИД <> РазмещениеСсылки.ИД Или Действие = "copy" Тогда
					ВызватьИсключение НСтр("ru = 'Ссылка уже есть в назначении. Весь набор оставлен без изменений.'");
				КонецЕсли;
			КонецЕсли;
			Если ИДСсылок.Найти(РазмещениеСсылки.ИДСсылки) <> Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Выбрано несколько размещений одной ссылки. Выберите одно из них.'");
			КонецЕсли;
			ИДСсылок.Добавить(РазмещениеСсылки.ИДСсылки);
		КонецЕсли;
	КонецЦикла;
	Если Действие = "prev" Или Действие = "next" Тогда
		СдвинутьПакетПанелька(Пакет, Действие);
	Иначе
		Максимум = 0;
		Для Каждого РазмещениеСсылки Из ТаблицаРазмещений Цикл
			Если РазмещениеСсылки.ИДКолонки = КолонкаИД Тогда
				Максимум = Макс(Максимум, РазмещениеСсылки.Порядок);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ВыбранныйУзел Из Пакет Цикл
			РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранныйУзел.ИД);
			Если Действие = "delete" Тогда
				СсылкаИД = РазмещениеСсылки.ИДСсылки;
				ТаблицаРазмещений.Удалить(РазмещениеСсылки);
				Если ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", СсылкаИД)).Количество() = 0 Тогда
					СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", СсылкаИД);
					Если СсылкаКаталога <> Неопределено Тогда
						ТаблицаСсылок.Удалить(СсылкаКаталога);
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Действие = "reset" Тогда
				РазмещениеСсылки.СвоеНаименование = Ложь;
				РазмещениеСсылки.СвояПодсказка = Ложь;
				РазмещениеСсылки.Наименование = "";
				РазмещениеСсылки.Подсказка = "";
			ИначеЕсли Действие = "copy" Тогда
				Новое = СоздатьРазмещение(РазмещениеСсылки.ИДСсылки, КолонкаИД);
				Новое.СвоеНаименование = РазмещениеСсылки.СвоеНаименование;
				Новое.СвояПодсказка = РазмещениеСсылки.СвояПодсказка;
				Новое.Наименование = РазмещениеСсылки.Наименование;
				Новое.Подсказка = РазмещениеСсылки.Подсказка;
			ИначеЕсли РазмещениеСсылки.ИДКолонки <> КолонкаИД Тогда
				Максимум = Максимум + 10;
				РазмещениеСсылки.ИДКолонки = КолонкаИД;
				РазмещениеСсылки.Порядок = Максимум;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Действие = "delete" Тогда
		ВыбранныйТип = "Column";
		ВыбраннаяСсылкаИД = "";
		ВыбранноеРазмещениеИД = "";
	Иначе
		РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", Пакет[0].ИД);
		Если Действие = "copy" Тогда
			РазмещениеСсылки = НайтиРазмещениеПоСвязи(РазмещениеСсылки.ИДСсылки, КолонкаИД);
		КонецЕсли;
		ВыбранныйТип = "Link";
		ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД;
		ВыбраннаяСсылкаИД = РазмещениеСсылки.ИДСсылки;
	КонецЕсли;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	ОбновитьПредставления();
КонецПроцедуры

// Сдвигает выбранные размещения, сохраняя их взаимный порядок.
&НаСервере
Процедура СдвинутьПакетПанелька(Пакет, Направление)
	Выбранные = Новый Массив;
	Для Каждого ВыбранныйУзел Из Пакет Цикл
		Выбранные.Добавить(ВыбранныйУзел.ИД);
	КонецЦикла;
	ТипыДоп = ПолучитьТипыДопИсточниковПанелька();
	СсылкиПоИД = ИндексСтрокПоИДПанелька(ТаблицаСсылок);
	РазмещенияПоИД = ИндексСтрокПоИДПанелька(ТаблицаРазмещений);
	КолонкиПеремещения = Новый Соответствие;
	Для Каждого ИД Из Выбранные Цикл
		РазмещениеСсылки = РазмещенияПоИД[ИД];
		Если РазмещениеСсылки <> Неопределено Тогда
			КолонкиПеремещения.Вставить(РазмещениеСсылки.ИДКолонки, Истина);
		КонецЕсли;
	КонецЦикла;
	Группы = Новый Соответствие;
	УпорядоченныеРазмещения = ТаблицаРазмещений.Выгрузить();
	УпорядоченныеРазмещения.Сортировать("Порядок, ИД");
	// После переноса из другой колонки позиции могут совпасть. Нормализуем
	// всю такую колонку до разделения по типам, сохраняя её исходный порядок.
	ПоследниеПозиции = Новый Соответствие;
	КолонкиСПовторами = Новый Соответствие;
	Для Каждого РазмещениеСсылки Из УпорядоченныеРазмещения Цикл
		Если КолонкиПеремещения[РазмещениеСсылки.ИДКолонки] = Истина
			И ПоследниеПозиции[РазмещениеСсылки.ИДКолонки] = РазмещениеСсылки.Порядок Тогда
			КолонкиСПовторами.Вставить(РазмещениеСсылки.ИДКолонки, Истина);
		КонецЕсли;
		ПоследниеПозиции.Вставить(РазмещениеСсылки.ИДКолонки, РазмещениеСсылки.Порядок);
	КонецЦикла;
	НомераПозиций = Новый Соответствие;
	Для Каждого РазмещениеСсылки Из УпорядоченныеРазмещения Цикл
		Если КолонкиСПовторами[РазмещениеСсылки.ИДКолонки] = Истина Тогда
			НомерПозиции = НомераПозиций[РазмещениеСсылки.ИДКолонки];
			Если НомерПозиции = Неопределено Тогда
				НомерПозиции = 0;
			КонецЕсли;
			НомерПозиции = НомерПозиции + 10;
			СтрокаМодели = РазмещенияПоИД[РазмещениеСсылки.ИД];
			СтрокаМодели.Порядок = НомерПозиции;
			НомераПозиций.Вставить(РазмещениеСсылки.ИДКолонки, НомерПозиции);
		КонецЕсли;
	КонецЦикла;
	Для Каждого РазмещениеСсылки Из УпорядоченныеРазмещения Цикл
		СсылкаКаталога = СсылкиПоИД[РазмещениеСсылки.ИДСсылки];
		Ключ = РазмещениеСсылки.ИДКолонки + ?(ГруппироватьПоТипуОбъекта, ":" + ТипОбъектаОбычнойФормы(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка,
			ТипыДоп), "");
		Очередь = Группы[Ключ];
		Если Очередь = Неопределено Тогда
			Очередь = Новый Массив;
			Группы.Вставить(Ключ, Очередь);
		КонецЕсли;
		Очередь.Добавить(РазмещениеСсылки.ИД);
	КонецЦикла;
	Для Каждого ПараГруппы Из Группы Цикл
		Очередь = ПараГруппы.Значение;
		Позиции = Новый Массив;
		Для Каждого ИД Из Очередь Цикл
			РазмещениеСсылки = РазмещенияПоИД[ИД];
			Позиции.Добавить(РазмещениеСсылки.Порядок);
		КонецЦикла;
		Шаг = ?(Направление = "prev", 1, -1);
		ИндексОчереди = ?(Направление = "prev", 1, Очередь.Количество() - 2);
		Пока ИндексОчереди >= 0 И ИндексОчереди < Очередь.Количество() Цикл
			Сосед = ИндексОчереди - Шаг;
			Если Сосед >= 0 И Сосед < Очередь.Количество() Тогда
				Если Выбранные.Найти(Очередь[ИндексОчереди]) <> Неопределено И Выбранные.Найти(Очередь[Сосед]) = Неопределено Тогда
					ИД = Очередь[ИндексОчереди];
					Очередь[ИндексОчереди] = Очередь[Сосед];
					Очередь[Сосед] = ИД;
				КонецЕсли;
			КонецЕсли;
			ИндексОчереди = ИндексОчереди + Шаг;
		КонецЦикла;
		ИндексОчереди = 0;
		Для Каждого ИД Из Очередь Цикл
			РазмещениеСсылки = РазмещенияПоИД[ИД];
			РазмещениеСсылки.Порядок = Позиции[ИндексОчереди];
			ИндексОчереди = ИндексОчереди + 1;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Восстанавливает множественное выделение по виду и идентификатору узлов.
&НаКлиенте
Процедура ВосстановитьВыделениеПанелька(Строки, Выделение)
	Для Каждого Узел Из Строки Цикл
		Для Каждого СохраненныйУзел Из Выделение Цикл
			Если СохраненныйУзел.Вид = Узел.Вид И СохраненныйУзел.ИД = Узел.ИД Тогда
				Элементы.ДеревоПанели.ВыделенныеСтроки.Добавить(Узел.ПолучитьИдентификатор());
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ВосстановитьВыделениеПанелька(Узел.ПолучитьЭлементы(), Выделение);
	КонецЦикла;
КонецПроцедуры

// Завершает просмотр полного списка, не изменяя дерево.
//
// Параметры:
//  Результат - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  ДополнительныеПараметры - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеПросмотраВыделенныхПанелька(Результат, ДополнительныеПараметры) Экспорт
	// Список предназначен для просмотра. Выбор строки и отмена не меняют дерево.
КонецПроцедуры

// Рассчитывает краткий текст и доступность групповых действий для выделения.
&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьВыделениеПанелька(Узлы, Размещения)
	ТекстВыделения = "";
	НомерСсылки = 0;
	КолонкиВыбора = Новый Массив;
	Много = Узлы.Количество() > 1;
	ВсеСсылки = Узлы.Количество() > 0;
	ЕстьСвои = Ложь;
	Имена = "";
	Для Каждого ВыбранныйУзел Из Узлы Цикл
		Если ВыбранныйУзел.Вид <> "Link" Тогда
			ВсеСсылки = Ложь;
			Продолжить;
		КонецЕсли;
		РазмещениеСсылки = НайтиСтрокуМодели(Размещения, "ИД", ВыбранныйУзел.ИД);
		Если РазмещениеСсылки = Неопределено Тогда
			ВсеСсылки = Ложь;
			Продолжить;
		КонецЕсли;
		ЕстьСвои = ЕстьСвои Или РазмещениеСсылки.СвоеНаименование Или РазмещениеСсылки.СвояПодсказка;
		НомерСсылки = НомерСсылки + 1;
		Если КолонкиВыбора.Найти(РазмещениеСсылки.ИмяКолонки) = Неопределено Тогда
			КолонкиВыбора.Добавить(РазмещениеСсылки.ИмяКолонки);
		КонецЕсли;
		Если НомерСсылки <= 5 Тогда
			Имена = Имена + ?(ПустаяСтрока(Имена), "", Символы.ПС) + "* " +
				КраткийТекстВыделенияПанелька(РазмещениеСсылки.ИтоговоеНаименование);
		КонецЕсли;
	КонецЦикла;
	Если Много Тогда
		Если НомерСсылки > 5 Тогда
			Имена = Имена + Символы.ПС + "Ещё: " + Строка(НомерСсылки - 5);
		КонецЕсли;
		ТекстКолонок = КраткийТекстВыделенияПанелька(СтрСоединить(КолонкиВыбора, ", "));
		Если ПустаяСтрока(ТекстКолонок) Тогда
			ТекстКолонок = "—";
		КонецЕсли;
		ТекстВыделения = ?(ВсеСсылки, "Выбрано ссылок: ", "Выбрано элементов: ") + Строка(Узлы.Количество())
			+ Символы.ПС + "В колонках: " + ТекстКолонок + Символы.ПС + Имена + Символы.ПС + Символы.ПС
			+ ?(ВсеСсылки,
			"Используйте контекстное меню для выбранных ссылок или перетащите их в нужную колонку. Для редактирования свойств выберите одну ссылку.", "Выберите только ссылки для групповых команд. Колонки можно переносить отдельным выделением.");
	КонецЕсли;
	СостояниеВыделения = Новый Структура;
	СостояниеВыделения.Вставить("Много", Много);
	СостояниеВыделения.Вставить("ВсеСсылки", ВсеСсылки);
	СостояниеВыделения.Вставить("ЕстьСвои", ЕстьСвои);
	СостояниеВыделения.Вставить("Текст", ТекстВыделения);
	Возврат СостояниеВыделения;
КонецФункции

#КонецОбласти

#Область ТипыИКартинкиОбъектов

// Возвращает тип объекта для обычного представления.
&НаСервере
Функция ТипОбъектаОбычнойФормы(Источник, Адрес, ТипыДоп)
	Возврат КлассифицироватьСсылкуПанелька(Источник, Адрес, ТипыДоп);
КонецФункции

// Подбирает иконку по виду объекта.
&НаСервере
Функция ИконкаОбъектаОбычнойФормы(Источник, Адрес, ТипОбъекта)
	Если Источник = "web" Тогда
		Возврат КартинкаОбычнойФормы("ГеографическаяСхема");
	КонецЕсли;
	Если Источник = "files" Тогда
		Возврат КартинкаОбычнойФормы("Скрепка");
	КонецЕсли;
	Если Источник = "extra" Тогда
		Возврат КартинкаОбычнойФормы(?(ТипОбъекта = "Дополнительные отчеты", "Отчет", "Обработка"));
	КонецЕсли;
	Если Лев(Адрес, 8) = "sys_cmd:" Тогда
		Возврат КартинкаОбычнойФормы("Настройка");
	КонецЕсли;
	Если СтрНайти(Адрес, "Справочник.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("Справочник");
	КонецЕсли;
	Если СтрНайти(Адрес, "Документ.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("Документ");
	КонецЕсли;
	Если СтрНайти(Адрес, "ЖурналДокументов.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("ЖурналДокументов");
	КонецЕсли;
	Если СтрНайти(Адрес, "Отчет.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("Отчет");
	КонецЕсли;
	Если СтрНайти(Адрес, "Обработка.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("Обработка");
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланВидовХарактеристик.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("ПланВидовХарактеристик");
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланСчетов.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("ПланСчетов");
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланВидовРасчета.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("ПланВидовРасчета");
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланОбмена.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("ПланОбмена");
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрСведений.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("РегистрСведений");
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрНакопления.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("РегистрНакопления");
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрБухгалтерии.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("РегистрБухгалтерии");
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрРасчета.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("РегистрРасчета");
	КонецЕсли;
	Если СтрНайти(Адрес, "БизнесПроцесс.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("БизнесПроцесс");
	КонецЕсли;
	Если СтрНайти(Адрес, "Задача.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("Задача");
	КонецЕсли;
	Если СтрНайти(Адрес, "ОбщаяФорма.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("Форма");
	КонецЕсли;
	Если СтрНайти(Адрес, "Константа.") > 0 Тогда
		Возврат КартинкаОбычнойФормы("Константа");
	КонецЕсли;
	Возврат КартинкаОбычнойФормы("Форма");
КонецФункции

// Определяет тип объекта по источнику, адресу и карте дополнительных обработок.
&НаКлиентеНаСервереБезКонтекста
Функция КлассифицироватьСсылкуПанелька(Источник, Адрес, ТипыДоп = Неопределено)
	Если Источник = "files" Тогда
		Возврат "Внешние файлы";
	КонецЕсли;
	Если Источник = "web" Тогда
		Возврат "Веб-ссылки";
	КонецЕсли;
	Если Лев(Адрес, 8) = "sys_cmd:" Тогда
		Возврат "Стандартные инструменты";
	КонецЕсли;
	Если Источник = "extra" Тогда
		Если ТипыДоп = Неопределено Тогда
			Возврат "Тип не определён";
		КонецЕсли;
		ТипДоп = ТипыДоп[Адрес];
		Возврат ?(ТипДоп = Неопределено, "Тип не определён", ТипДоп);
	КонецЕсли;
	Если СтрНайти(Адрес, "Справочник.") > 0 Тогда
		Возврат "Справочники";
	КонецЕсли;
	Если СтрНайти(Адрес, "Документ.") > 0 Тогда
		Возврат "Документы";
	КонецЕсли;
	Если СтрНайти(Адрес, "ЖурналДокументов.") > 0 Тогда
		Возврат "Журналы документов";
	КонецЕсли;
	Если СтрНайти(Адрес, "Отчет.") > 0 Тогда
		Возврат "Отчеты";
	КонецЕсли;
	Если СтрНайти(Адрес, "Обработка.") > 0 Тогда
		Возврат "Обработки";
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланВидовХарактеристик.") > 0 Тогда
		Возврат "Планы видов характеристик";
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланСчетов.") > 0 Тогда
		Возврат "Планы счетов";
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланВидовРасчета.") > 0 Тогда
		Возврат "Планы видов расчета";
	КонецЕсли;
	Если СтрНайти(Адрес, "ПланОбмена.") > 0 Тогда
		Возврат "Планы обмена";
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрСведений.") > 0 Тогда
		Возврат "Регистры сведений";
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрНакопления.") > 0 Тогда
		Возврат "Регистры накопления";
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрБухгалтерии.") > 0 Тогда
		Возврат "Регистры бухгалтерии";
	КонецЕсли;
	Если СтрНайти(Адрес, "РегистрРасчета.") > 0 Тогда
		Возврат "Регистры расчета";
	КонецЕсли;
	Если СтрНайти(Адрес, "БизнесПроцесс.") > 0 Тогда
		Возврат "Бизнес-процессы";
	КонецЕсли;
	Если СтрНайти(Адрес, "Задача.") > 0 Тогда
		Возврат "Задачи";
	КонецЕсли;
	Если СтрНайти(Адрес, "ОбщаяФорма.") > 0 Тогда
		Возврат "Общие формы";
	КонецЕсли;
	Если СтрНайти(Адрес, "Константа.") > 0 Тогда
		Возврат "Константы";
	КонецЕсли;
	Возврат "Прочее";
КонецФункции

#КонецОбласти

#Область КлиентскоеПредставлениеСвойств

// Заполняет видимую страницу свойств по данным формы на клиенте.
&НаКлиенте
Процедура ЗаполнитьОбычныеСвойстваНаКлиенте(ОбновлятьМеню = Истина)
	Если ОбновлятьМеню Тогда
		ОбновитьКонтекстноеМенюДереваНаКлиенте();
	КонецЕсли;
	ОбновитьНазначениеДобавленияПанелькаНаКлиенте();
	Если ВыбранныйТип = "Link" И ЗначениеЗаполнено(ВыбраннаяСсылкаИД) Тогда
		ЗаполнитьРедакторНаКлиенте();
	КонецЕсли;
	ЗаполнитьПредставлениеОбычныхСвойствПанелька(ЭтотОбъект);
КонецПроцедуры

// Согласует доступность и видимость команд контекстного меню на клиенте.
&НаКлиенте
Процедура ОбновитьКонтекстноеМенюДереваНаКлиенте(Состояние = Неопределено)
	Ссылка = ВыбранныйТип = "Link";
	НесколькоРазмещений = ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки",
		ВыбраннаяСсылкаИД)).Количество() > 1;
	ТекущееРазмещение = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ВыбранноеРазмещениеИД);
	ЕстьСвои = Ложь;
	Если ТекущееРазмещение <> Неопределено Тогда
		ЕстьСвои = ТекущееРазмещение.СвоеНаименование Или ТекущееРазмещение.СвояПодсказка;
	КонецЕсли;
	Страница = ВыбранныйТип = "Page";
	Колонка = ВыбранныйТип = "Column";
	СтраницаПанели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИмяСтраницы", HTMLНастройкиАктивнаяСтраница);
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", HTMLНастройкиАктивнаяКолонка);
	ОбычнаяСтраница = СтраницаПанели <> Неопределено;
	Если ОбычнаяСтраница Тогда
		ОбычнаяСтраница = СтраницаПанели.ИД <> "page-standard" И СтраницаПанели.ИД <> "page-unassigned";
	КонецЕсли;
	УдаляемаяСтраница = Ложь;
	ОбычнаяКолонка = Ложь;
	Если СтраницаПанели <> Неопределено Тогда
		УдаляемаяСтраница = Не ЭтоСистемныйИД(СтраницаПанели.ИД);
	КонецЕсли;
	Если КолонкаПанели <> Неопределено Тогда
		ОбычнаяКолонка = Не ЭтоСистемныйИД(КолонкаПанели.ИД);
	КонецЕсли;
	Много = Ложь;
	ВсеСсылки = Ссылка;
	Если Состояние <> Неопределено Тогда
		Много = Состояние.Много;
		ВсеСсылки = Состояние.ВсеСсылки;
		ЕстьСвои = Состояние.ЕстьСвои;
	КонецЕсли;
	// Сначала вычисляем конечное состояние, затем назначаем каждое свойство один раз.
	МожноДвигать = ?(Много, ВсеСсылки, ВыбранныйТип = "Group" Или Ссылка
		Или (Страница И УдаляемаяСтраница) Или (Колонка И ОбычнаяКолонка));
	МожноУдалитьВезде = Не Много И Ссылка И НесколькоРазмещений;
	УстановитьСвойствоЭлементаПанелька(Элементы.УдалитьСсылкуКнопка, "Доступность", МожноУдалитьВезде);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюУдалитьВездеКнопка, "Доступность", МожноУдалитьВезде);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюУдалитьВездеКнопка, "Видимость", Ссылка);
	Для Каждого Имя Из СтрРазделить("Копия,Перенос,Нераспределено,Сброс,Убрать", ",") Цикл
		УстановитьСвойствоЭлементаПанелька(Элементы["Меню" + Имя + "Кнопка"], "Видимость", ВсеСсылки);
		УстановитьСвойствоЭлементаПанелька(Элементы["Меню" + Имя + "Кнопка"], "Доступность",
			ВсеСсылки И (Имя <> "Сброс" Или ЕстьСвои));
	КонецЦикла;
	УстановитьСвойствоЭлементаПанелька(Элементы.СброситьСвойстваКнопка, "Доступность", ВсеСсылки И ЕстьСвои);
	Для Каждого Имя Из СтрРазделить("Свойства,Страница,Колонка,ПереносКолонки,УдалениеСтраницы,УдалениеКолонки",
		",") Цикл
		УстановитьСвойствоЭлементаПанелька(Элементы["Меню" + Имя + "Кнопка"], "Доступность", Не Много И
			ВыбранныйТип <> "Group");
	КонецЦикла;
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюКолонкаКнопка, "Видимость", Не Ссылка И ОбычнаяСтраница);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюПереносКолонкиКнопка, "Видимость", Колонка И ОбычнаяКолонка);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюУдалениеСтраницыКнопка, "Видимость", Страница И УдаляемаяСтраница);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюУдалениеКолонкиКнопка, "Видимость", Колонка И ОбычнаяКолонка);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюГруппаПорядок, "Видимость", МожноДвигать);
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюГруппаРазмещение, "Видимость", ?(Много, ВсеСсылки, Ссылка Или
		(Колонка И ОбычнаяКолонка)));
	УстановитьСвойствоЭлементаПанелька(Элементы.МенюГруппаУдаление, "Видимость", ?(Много, ВсеСсылки, Ссылка Или
		(Колонка И ОбычнаяКолонка) Или (Страница И УдаляемаяСтраница)));
	Для Каждого Имя Из СтрРазделить("Вверх,Вниз", ",") Цикл
		УстановитьСвойствоЭлементаПанелька(Элементы["Меню" + Имя + "Кнопка"], "Видимость", МожноДвигать);
		УстановитьСвойствоЭлементаПанелька(Элементы["Меню" + Имя + "Кнопка"], "Доступность", МожноДвигать);
	КонецЦикла;
КонецПроцедуры

// Устанавливает клиентский контекст выбранного узла.
&НаКлиенте
Процедура ВыбратьУзелОбычнойФормыНаКлиенте(Вид, ИдентификаторУзла, СтраницаИД, КолонкаИД, ЗаполнятьСвойства = Истина)
	СтраницаПанели = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", СтраницаИД);
	КолонкаПанели = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", КолонкаИД);
	HTMLНастройкиАктивнаяСтраница = ?(СтраницаПанели = Неопределено, "Главная", СтраницаПанели.ИмяСтраницы);
	HTMLНастройкиАктивнаяКолонка = ?(КолонкаПанели = Неопределено, "", КолонкаПанели.ИД);
	ВыбранныйТип = Вид;
	ВыбраннаяСсылкаИД = "";
	ВыбранноеРазмещениеИД = "";
	Если Вид = "Link" Тогда
		РазмещениеСсылки = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ИдентификаторУзла);
		Если РазмещениеСсылки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ВыбраннаяСсылкаИД = РазмещениеСсылки.ИДСсылки;
		ВыбранноеРазмещениеИД = РазмещениеСсылки.ИД;
	КонецЕсли;
	Если ЗаполнятьСвойства Тогда
		ЗаполнитьОбычныеСвойстваНаКлиенте();
	КонецЕсли;
	Если Вид = "Group" Тогда
		КлючВыбораДерева = ИдентификаторУзла;
	КонецЕсли;
КонецПроцедуры

// Отображает одиночное или множественное выделение и доступные групповые команды.
&НаКлиенте
Процедура ПоказатьСостояниеВыделенияПанелькаНаКлиенте(Узлы)
	Если Узлы.Количество() <= 1 Тогда
		ЗаполнитьОбычныеСвойстваНаКлиенте(Ложь);
	Иначе
		ОбновитьНазначениеДобавленияПанелькаНаКлиенте(Узлы);
	КонецЕсли;
	Состояние = РассчитатьВыделениеПанелька(Узлы, ТаблицаРазмещений);
	Много = Состояние.Много;
	ТекстВыделения = Состояние.Текст;
	ОбновитьКонтекстноеМенюДереваНаКлиенте(Состояние);
	Если Много Тогда
		ОписаниеВыделенияПанелька = ТекстВыделения;
		УстановитьСвойствоЭлементаПанелька(Элементы.СостоянияСвойствПанелька, "ТекущаяСтраница", Элементы.СтраницаВыделениеПанелька);
	КонецЕсли;
	УстановитьСвойствоЭлементаПанелька(Элементы.ПодсказкаДобавления, "Высота", Макс(1, СтрЧислоСтрок(ПодсказкаДобавления)));
	УстановитьСвойствоЭлементаПанелька(Элементы.ПояснениеНазвания, "Высота", 1);
	УстановитьСвойствоЭлементаПанелька(Элементы.ПояснениеПодсказки, "Высота", 1);
КонецПроцедуры

// Заполняет клиентский редактор ссылки с учётом наследования свойств.
&НаКлиенте
Процедура ЗаполнитьРедакторНаКлиенте()
	СсылкаИД = ЗаполнитьРедакторСсылкиПанелька(ЭтотОбъект);
	Если СсылкаИД <> Неопределено Тогда
		УстановитьОтборРазмещенийНаКлиентеПанелька(СсылкаИД);
	КонецЕсли;
КонецПроцедуры

// Не переустанавливает отбор при переходе между размещениями одной ссылки.
// Проверяется фактический отбор: серверное обновление не оставляет устаревший клиентский кэш.
&НаКлиенте
Процедура УстановитьОтборРазмещенийНаКлиентеПанелька(СсылкаИД)
	Отбор = Элементы.Размещения.ОтборСтрок;
	ТекущаяСсылкаИД = Неопределено;
	Если Отбор <> Неопределено Тогда
		Если Отбор.Свойство("ИДСсылки", ТекущаяСсылкаИД) И ТекущаяСсылкаИД = СсылкаИД Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Элементы.Размещения.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("ИДСсылки", СсылкаИД));
КонецПроцедуры

// Находит узел по виду и устойчивому идентификатору модели.
&НаКлиенте
Функция НайтиУзелПоВидуИИДПанелька(Строки, Вид, ИдентификаторУзла)
	Для Каждого Узел Из Строки Цикл
		Если Узел.Вид = Вид И Узел.ИД = ИдентификаторУзла Тогда
			Возврат Узел;
		КонецЕсли;
		Найденный = НайтиУзелПоВидуИИДПанелька(Узел.ПолучитьЭлементы(), Вид, ИдентификаторУзла);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Собирает поля текущей страницы свойств для точечного обновления отображения.
&НаКлиенте
Процедура СобратьПоляСвойствДляОбновленияПанелька(Поля)
	Если МножественныйВыборПанелька Тогда
		ИменаПолей = "ОписаниеВыделенияПанелька";
	ИначеЕсли ВыбранныйТип = "Link" Тогда
		ИменаПолей = "КонтекстСсылкиПанелька,ОбластьНазвания,РедакторНазвание,ПояснениеНазвания,ОбластьПодсказки,РедакторПодсказка,ПояснениеПодсказки,РедакторАдрес,Размещения";
	ИначеЕсли ВыбранныйТип = "Group" Тогда
		ИменаПолей = "КонтекстГруппыПанелька";
	Иначе
		ИменаПолей = "КонтекстВыбораОбычный,СтруктураНазвание,СтруктураСтраница,КартинкаСтруктуры,СтруктураРоли";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(ИменаПолей, ",") Цикл
		Если Элементы[Имя].Видимость Тогда
			Поля.Добавить(Элементы[Имя]);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ВспомогательныеФункцииИнтерфейса

// Меняет свойство элемента только при отличии значения, сокращая перерасчёты формы.
// Повторная запись свойств оформления может пересчитать размещение элементов.
// При чтении выделения меняем только действительно отличающиеся значения.
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойствоЭлементаПанелька(Элемент, ИмяСвойства, НовоеЗначение)
	Если Элемент[ИмяСвойства] <> НовоеЗначение Тогда
		Элемент[ИмяСвойства] = НовоеЗначение;
	КонецЕсли;
КонецПроцедуры

// Ограничивает длину представления элемента в кратком списке выделения.
&НаКлиентеНаСервереБезКонтекста
Функция КраткийТекстВыделенияПанелька(Текст)
	Текст = СтрЗаменить(СтрЗаменить(Строка(Текст), Символы.ПС, " "), Символы.ВК, " ");
	Возврат ?(СтрДлина(Текст) > 60, Лев(Текст, 59) + "…", Текст);
КонецФункции

#КонецОбласти

#Область ВставкаСсылки

// Подбирает представление для вставленной ссылки.
&НаСервере
Функция ПодобратьНазваниеВставленнойСсылки(Адрес)
	Если ПустаяСтрока(Адрес) Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Адрес, 11) = "e1cib/data/" Тогда
		Имя = ПредставлениеВставленногоОбъектаПанелька(Адрес, 1);
		Если Не ПустаяСтрока(Имя) Тогда
			Возврат Имя;
		КонецЕсли;
	Иначе
		АдресБезПараметров = СтрРазделить(Адрес, "?")[0];
		Для Каждого ГруппаМетаданных Из ПолучитьГруппыМетаданныхHTML() Цикл
			Для Каждого ДанныеОбъектаМетаданных Из ПолучитьМетаданныеКатегорииHTML(ГруппаМетаданных.Id) Цикл
				Если ДанныеОбъектаМетаданных.Url = АдресБезПараметров Тогда
					Возврат ДанныеОбъектаМетаданных.Name;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Возврат "Не удалось найти ссылку в базе";
КонецФункции

#КонецОбласти

#Область НазначениеДобавления

// Разрешения вычисляются на сервере; клиент использует полученный признак для того же текста.
&НаСервере
Процедура ОбновитьНазначениеДобавленияПанелька(Узлы = Неопределено)
	ПолитикаИсточников = ПолитикаИсточниковРедактораПанелька();
	ИсточникиОграниченыВРедактореПанелька = Ложь;
	Если ПерсональнаяНастройкаПанелька Тогда
		Для Каждого Пара Из ПолитикаИсточников Цикл
			Если Не Пара.Значение Тогда
				ИсточникиОграниченыВРедактореПанелька = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Состояние = СостояниеНазначенияДобавленияПанелька(Узлы, ТаблицаРазмещений, ТаблицаКолонок,
		HTMLНастройкиАктивнаяКолонка, HTMLНастройкиАктивнаяСтраница, ОбычныйИсточник,
		СтандартныеНаОтдельнойВкладке, ИсточникиОграниченыВРедактореПанелька);
	HTMLНастройкиАктивнаяКолонка = Состояние.Колонка;
	ПодсказкаДобавления = Состояние.Подсказка;
	УстановитьСвойствоЭлементаПанелька(Элементы.ДобавитьВставленнуюСсылкуКнопка, "Доступность", Состояние.МожноДобавить);
	Для Каждого Имя Из СтрРазделить("web,browser,files,folder,metadata,extra", ",") Цикл
		УстановитьСвойствоЭлементаПанелька(Элементы["ДопИсточник" + Имя + "Кнопка"], "Доступность", Состояние.МожноДобавить);
		УстановитьСвойствоЭлементаПанелька(Элементы["ДопИсточник" + Имя + "Кнопка"], "Видимость",
			ИсточникРедактораРазрешенПанелька(Имя, ПолитикаИсточников));
	КонецЦикла;
	УстановитьСвойствоЭлементаПанелька(Элементы.ПодсказкаДобавления, "Высота", Макс(1, СтрЧислоСтрок(ПодсказкаДобавления)));
КонецПроцедуры

// Пересчитывает представление без серверного вызова и без потери пояснения об ограничениях.
&НаКлиенте
Процедура ОбновитьНазначениеДобавленияПанелькаНаКлиенте(Узлы = Неопределено)
	Состояние = СостояниеНазначенияДобавленияПанелька(Узлы, ТаблицаРазмещений, ТаблицаКолонок,
		HTMLНастройкиАктивнаяКолонка, HTMLНастройкиАктивнаяСтраница, ОбычныйИсточник,
		СтандартныеНаОтдельнойВкладке, ИсточникиОграниченыВРедактореПанелька);
	HTMLНастройкиАктивнаяКолонка = Состояние.Колонка;
	ПодсказкаДобавления = Состояние.Подсказка;
	УстановитьСвойствоЭлементаПанелька(Элементы.ДобавитьВставленнуюСсылкуКнопка, "Доступность", Состояние.МожноДобавить);
	Для Каждого Имя Из СтрРазделить("web,browser,files,folder,metadata,extra", ",") Цикл
		УстановитьСвойствоЭлементаПанелька(Элементы["ДопИсточник" + Имя + "Кнопка"], "Доступность", Состояние.МожноДобавить);
	КонецЦикла;
	УстановитьСвойствоЭлементаПанелька(Элементы.ПодсказкаДобавления, "Высота", Макс(1, СтрЧислоСтрок(ПодсказкаДобавления)));
КонецПроцедуры

// Чистый расчёт представления назначения для обоих контекстов формы.
//
// Параметры:
//  Узлы - Неопределено, Массив из Структура - выбранные узлы дерева:
//   * Вид - Строка - тип узла.
//   * ИД - Строка - идентификатор узла или размещения.
//  Размещения - ДанныеФормыКоллекция из ДанныеФормыСтруктура - строки размещений формы; читаются ИД и ИДКолонки.
//  Колонки - ДанныеФормыКоллекция из ДанныеФормыСтруктура - строки колонок формы; читаются ИД и ИмяКолонки.
//  АктивнаяКолонка - Строка - идентификатор или прежнее имя активной колонки.
//  АктивнаяСтраница - Строка - имя активной страницы.
//  Источник - Строка - выбранный источник обычного редактора.
//  СтандартныеОтдельно - Булево - отдельная вкладка стандартных инструментов.
//  ИсточникиОграничены - Булево - серверный признак ограничения источников.
//
// Возвращаемое значение:
//  Структура - представление назначения:
//  * Колонка - Строка - допустимое назначение либо пустая строка.
//  * МожноДобавить - Булево - выбрана пользовательская колонка.
//  * Подсказка - Строка - пояснение назначения и ограничений.
&НаКлиентеНаСервереБезКонтекста
Функция СостояниеНазначенияДобавленияПанелька(Узлы, Размещения, Колонки, АктивнаяКолонка,
	АктивнаяСтраница, Источник, СтандартныеОтдельно, ИсточникиОграничены)
	КолонкаНазначения = АктивнаяКолонка;
	Если Узлы <> Неопределено И Узлы.Количество() > 1 Тогда
		ВыбранныеКолонки = Новый Массив;
		Для Каждого Узел Из Узлы Цикл
			Если Узел.Вид <> "Link" Тогда
				ВыбранныеКолонки.Добавить("");
				Продолжить;
			КонецЕсли;
			Размещение = НайтиСтрокуМодели(Размещения, "ИД", Узел.ИД);
			Если Размещение <> Неопределено И ВыбранныеКолонки.Найти(Размещение.ИДКолонки) = Неопределено Тогда
				ВыбранныеКолонки.Добавить(Размещение.ИДКолонки);
			КонецЕсли;
		КонецЦикла;
		Если ВыбранныеКолонки.Количество() <> 1 Или ВыбранныеКолонки[0] = "" Тогда
			КолонкаНазначения = "";
		КонецЕсли;
	КонецЕсли;
	Колонка = НайтиСтрокуМодели(Колонки, "ИмяКолонки", КолонкаНазначения);
	МожноДобавить = Колонка <> Неопределено;
	Если МожноДобавить Тогда
		МожноДобавить = Не ЭтоСистемныйИД(Колонка.ИД);
	КонецЕсли;
	Подсказка = ?(МожноДобавить,
		СтрШаблон(НСтр("ru = 'Добавление в: %1 → %2'"), АктивнаяСтраница,
			ИмяКолонкиПанелька(Колонки, КолонкаНазначения)),
		НСтр("ru = 'Для добавления выберите колонку в центре.'"))
		+ Символы.ПС + НСтр("ru = 'Ctrl / Shift — выбрать несколько.'")
		+ Символы.ПС + НСтр("ru = 'Перетащите ссылки в нужную колонку.'");
	Если Источник = "Стандартные инструменты" И СтандартныеОтдельно Тогда
		Подсказка = Подсказка + Символы.ПС + НСтр("ru = 'Стандартные инструменты отображаются на отдельной вкладке.'");
	КонецЕсли;
	Если ИсточникиОграничены Тогда
		Подсказка = Подсказка + Символы.ПС + НСтр("ru = 'Часть источников ограничена администратором.'");
	КонецЕсли;
	Возврат Новый Структура("Колонка,МожноДобавить,Подсказка", КолонкаНазначения, МожноДобавить, Подсказка);
КонецФункции

#КонецОбласти

#Область СтандартныеИнструменты

// Формирует каталог стандартных инструментов платформы.
&НаСервере
Функция СтандартныеИсточникиПанелька(КонтекстДоступа = Неопределено)
	Если Не ИсточникРедактораРазрешенПанелька("standard", ПолитикаИсточниковРедактораПанелька(КонтекстДоступа)) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Дерево = Новый ДеревоЗначений;
	Для Каждого Имя Из СтрРазделить("Представление,СсылкаНаОбъект,ЭтоГруппа,Картинка", ",") Цикл
		Дерево.Колонки.Добавить(Имя);
	КонецЦикла;
	ДобавитьВеткуПлатформыПанелька(Дерево);
	Результат = Новый Массив;
	Для Каждого ГруппаИнструментов Из Дерево.Строки Цикл
		Для Каждого ИнструментПлатформы Из ГруппаИнструментов.Строки Цикл
			ИсточникHTML = Новый Структура;
			ИсточникHTML.Вставить("Name", ИнструментПлатформы.Представление);
			ИсточникHTML.Вставить("Url", ИнструментПлатформы.СсылкаНаОбъект);
			ИсточникHTML.Вставить("Tooltip", "");
			ИсточникHTML.Вставить("Type", "Стандартный инструмент");
			Результат.Добавить(ИсточникHTML);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Читает встроенный список инструментов платформы в дерево источников.
&НаСервере
Процедура ДобавитьВеткуПлатформыПанелька(ДеревоЗнач)
	Ветка = ДеревоЗнач.Строки.Добавить();
	Ветка.ЭтоГруппа = Истина;
	Ветка.Картинка = БиблиотекаКартинок.Обработка;
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	РезультатЧтения = ОбъектОбработки.ПанелькаПрочитатьСистемныеИнструменты();
	Для Каждого Инструмент Из РезультатЧтения.Инструменты Цикл
		НоваяСтрока = Ветка.Строки.Добавить();
		НоваяСтрока.Представление = Инструмент.Наименование;
		НоваяСтрока.СсылкаНаОбъект = Инструмент.Ссылка;
		НоваяСтрока.ЭтоГруппа = Ложь;
		НоваяСтрока.Картинка = Ветка.Картинка;
	КонецЦикла;
	Ветка.Представление = СтрШаблон(НСтр("ru = 'Стандартные инструменты (%1)'"), Ветка.Строки.Количество());
	Если РезультатЧтения.НеполныйСписок Тогда
		Ветка.Представление = Ветка.Представление + НСтр("ru = ' — список неполный'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Часть стандартных инструментов не удалось прочитать. Доступные записи показаны. Обратитесь к администратору.'");
		Сообщение.Сообщить();
	КонецЕсли;
	Ветка.Строки.Сортировать("Представление Возр");
КонецПроцедуры

#КонецОбласти

#Область ВыделениеДобавленныхСсылок

// Выделяет размещения, добавленные последней операцией.
&НаКлиенте
Процедура ВыделитьДобавленныеСсылкиПанелька(ИДРазмещений)
	Если ИДРазмещений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Элементы.ДеревоПанели.ВыделенныеСтроки.Очистить();
	РаскрытьДобавленныеСсылкиПанелька(ДеревоПанели.ПолучитьЭлементы(), ИДРазмещений);
	ПоказатьВсеВыбранныеПанелька = Ложь;
	ПодписьВыделенияПанелька = "";
	ПроверитьВыделениеПанелька();
КонецПроцедуры

// Раскрывает родителей добавленных ссылок в видимом дереве.
&НаКлиенте
Функция РаскрытьДобавленныеСсылкиПанелька(Строки, ИДРазмещений)
	Если Не ДеревоПанелиДоступноПанелька() Тогда
		Возврат Ложь;
	КонецЕсли;
	Найдено = Ложь;
	Для Каждого Узел Из Строки Цикл
		Если Узел.Вид = "Link" И ИДРазмещений.Найти(Узел.ИД) <> Неопределено Тогда
			Если Элементы.ДеревоПанели.ВыделенныеСтроки.Количество() = 0 Тогда
				Элементы.ДеревоПанели.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
			КонецЕсли;
			Элементы.ДеревоПанели.ВыделенныеСтроки.Добавить(Узел.ПолучитьИдентификатор());
			Найдено = Истина;
		КонецЕсли;
		Если РаскрытьДобавленныеСсылкиПанелька(Узел.ПолучитьЭлементы(), ИДРазмещений) Тогда
			Элементы.ДеревоПанели.Развернуть(Узел.ПолучитьИдентификатор());
			Найдено = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;
КонецФункции

#КонецОбласти

#Область ДобавлениеИзВнешнихИсточников

// Добавляет объекты, выбранные в расширенном дереве метаданных.
//
// Параметры:
//  Результат - Неопределено, Массив из Структура - выбранные строки формы; Неопределено при отмене:
//   * Представление - Строка - подпись выбранного объекта.
//   * Ссылка - Строка - адрес объекта или имя роли.
//   * Подсказка - Строка - дополнительное описание; поле может отсутствовать у файлов.
//  ДополнительныеПараметры - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораИзДерева(Результат, ДополнительныеПараметры) Экспорт
	ДобавитьВыбранныеИсточники(Результат, "objects", HTMLНастройкиАктивнаяКолонка);
	ОбновитьHTMLНастроекЕслиНужно();
КонецПроцедуры

// Добавляет результат выбора дополнительных обработок БСП.
//
// Параметры:
//  Результат - Неопределено, Массив из Структура - выбранные строки формы; Неопределено при отмене:
//   * Представление - Строка - подпись выбранного объекта.
//   * Ссылка - Строка - адрес объекта или имя роли.
//   * Подсказка - Строка - дополнительное описание; поле может отсутствовать у файлов.
//  ДополнительныеПараметры - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораДопОбработкиБСП(Результат, ДополнительныеПараметры) Экспорт
	ДобавитьВыбранныеИсточники(Результат, "extra", HTMLНастройкиАктивнаяКолонка);
	ОбновитьHTMLНастроекЕслиНужно();
КонецПроцедуры

// Добавляет выбранные закладки браузера.
//
// Параметры:
//  Результат - Неопределено, Массив из Структура - выбранные строки формы; Неопределено при отмене:
//   * Представление - Строка - подпись выбранного объекта.
//   * Ссылка - Строка - адрес объекта или имя роли.
//   * Подсказка - Строка - дополнительное описание; поле может отсутствовать у файлов.
//  ДополнительныеПараметры - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораЗакладокБраузера(Результат, ДополнительныеПараметры) Экспорт
	ДобавитьВыбранныеИсточники(Результат, "web", HTMLНастройкиАктивнаяКолонка);
	ОбновитьHTMLНастроекЕслиНужно();
КонецПроцедуры

// Переносит выбранные источники в каталог и размещения модели.
&НаСервере
Процедура ДобавитьВыбранныеИсточники(Результат, Источник, Колонка)
	НачатьПакетОбновленияПанелька();
	Попытка
		ДобавитьВыбранныеИсточникиБезОбновления(Результат, Источник, Колонка);
	Исключение
		ПрерватьПакетОбновленияПанелька();
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьПакетОбновленияПанелька();
КонецПроцедуры

// Внутренняя часть пакетной операции; вызывается через внешний обработчик.
&НаСервере
Процедура ДобавитьВыбранныеИсточникиБезОбновления(Результат, Источник, Колонка)
	Если ТипЗнч(Результат) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Стр Из Результат Цикл
		Если Не ПустаяСтрока(Стр.Ссылка) Тогда
			ПроверитьФорматАдресаПанелька(Источник, Стр.Ссылка);
		КонецЕсли;
	КонецЦикла;
	КонтекстДоступа = ПолучитьКонтекстДоступаРедактораПанелька();
	ИндексДобавления = ИндексПакетногоДобавленияПанелька();
	Для Каждого Стр Из Результат Цикл
		Подсказка = "";
		// Классификация в форме выбора не является пользовательской подсказкой.
		Описание = ОписаниеДобавляемойСсылкиПанелька(Источник, Стр.Ссылка, Стр.Представление, Подсказка, Колонка);
		ДобавитьСсылкуПоОписаниюПанелька(Описание, Ложь, КонтекстДоступа, ИндексДобавления);
	КонецЦикла;
	ОбновитьПредставления();
КонецПроцедуры

// Запрашивает адрес новой веб-ссылки.
&НаКлиенте
Процедура ДобавитьВебКоманда(Команда)
	Если Не ИсточникРедактораРазрешенПанелька("web") Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Этот источник запрещён администратором.'"));
		Возврат;
	КонецЕсли;
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ПослеВводаВебСсылки", ЭтотОбъект, HTMLНастройкиАктивнаяКолонка), "",
		НСтр("ru = 'Введите адрес веб-ссылки'"));
КонецПроцедуры

// Добавляет введённую веб-ссылку в выбранную колонку.
//
// Параметры:
//  Адрес - Неопределено, Строка - введенный URL; Неопределено при отмене.
//  Колонка - Строка - идентификатор колонки назначения.
&НаКлиенте
Процедура ПослеВводаВебСсылки(Адрес, Колонка) Экспорт
	Если Адрес = Неопределено Или ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;
	ДобавитьСсылку("web", Адрес, Адрес, "", Колонка);
	ОбновитьHTMLНастроекЕслиНужно();
КонецПроцедуры

// Добавляет файлы из результата асинхронного выбора.
//
// Параметры:
//  Файлы - Неопределено, Массив из Строка - выбранные полные пути; Неопределено при отмене.
//  Колонка - Строка - идентификатор колонки назначения.
&НаКлиенте
Процедура ПослеВыбораВнешнихФайловПанелька(Файлы, Колонка) Экспорт
	Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Пакет = Новый Массив;
	Для Каждого Путь Из Файлы Цикл
		Файл = Новый Файл(Путь);
		Пакет.Добавить(Новый Структура("Ссылка,Представление", Путь, Файл.ИмяБезРасширения));
	КонецЦикла;
	ДобавитьВыбранныеИсточники(Пакет, "files", Колонка);
	ОбновитьHTMLНастроекЕслиНужно();
КонецПроцедуры

// Находит внешние файлы в выбранной папке и добавляет их пакетом.
//
// Параметры:
//  Папки - Неопределено, Массив из Строка - выбранные полные пути; Неопределено при отмене.
//  Колонка - Строка - идентификатор колонки назначения.
&НаКлиенте
Асинх Процедура ПослеВыбораВнешнейПапкиПанелька(Папки, Колонка) Экспорт
	Если Папки = Неопределено Или Папки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Пути = Новый Массив;
	Попытка
		Для Каждого Маска Из СтрРазделить(МаскиВнешнихФайловПанелька(), ";", Ложь) Цикл
			Файлы = Ждать НайтиФайлыАсинх(Папки[0], Маска);
			Для Каждого Файл Из Файлы Цикл
				Пути.Добавить(Файл.ПолноеИмя);
			КонецЦикла;
		КонецЦикла;
		ПослеВыбораВнешнихФайловПанелька(Пути, Колонка);
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось прочитать папку: %1'"), ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ИмпортИЭкспортXML

// Общие разрешения читаются заново при каждом действии; личный XML не влияет на них.
&НаСервере
Функция ПолучитьРазрешенияОбменаПанелька(КонтекстДоступа = Неопределено)
	Если КонтекстДоступа = Неопределено Тогда
		ПроверитьПравоНастройкиПанелька();
	КонецЕсли;
	Если Не ПерсональнаяНастройкаПанелька Тогда
		Возврат Новый Структура("Импорт,Экспорт", Истина, Истина);
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Если КонтекстДоступа = Неопределено Тогда
		Настройки = ПанелькаОбщиеНастройкиПрочитать();
	Иначе
		Обработка.ПанелькаПроверитьПравоЛичнойПанели(КонтекстДоступа);
		Настройки = КонтекстДоступа.Настройки;
	КонецЕсли;
	Возврат Новый Структура("Импорт,Экспорт",
		Обработка.ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(Настройки, "import"),
		Обработка.ПанелькаРазрешениеОбменаЛичнойПанелиИзНастроек(Настройки, "export"));
КонецФункции

&НаСервере
Процедура ПроверитьРазрешениеОбменаПанелька(Операция)
	ПроверитьПравоНастройкиПанелька();
	Если Операция <> "import" И Операция <> "export" Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестная операция обмена настройками панели.'");
	КонецЕсли;
	Если Не ПерсональнаяНастройкаПанелька Тогда
		Возврат;
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Если Не Обработка.ПанелькаОбменЛичнойПанелиРазрешен(Операция) Тогда
		Если Операция = "import" Тогда
			ВызватьИсключение НСтр("ru = 'Импорт настроек персональной панели отключён администратором.'");
		Иначе
			ВызватьИсключение НСтр("ru = 'Экспорт настроек персональной панели отключён администратором.'");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ОбменНастроекРазрешенНаКлиентеПанелька(Операция)
	Попытка
		ПроверитьРазрешениеОбменаПанелька(Операция);
		Возврат Истина;
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции


// Применяет редактор и открывает диалог экспорта настроек.
&НаКлиенте
Процедура ОткрытьЭкспортНастроекПанелька()
	Если Не ОбменНастроекРазрешенНаКлиентеПанелька("export") Тогда
		Возврат;
	КонецЕсли;
	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ТекстXML = СформироватьXMLОбъектовКонфигурации();
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Выгрузить настройки «Панельки»'");
	Диалог.Фильтр = НСтр("ru = 'Настройки XML (*.xml)|*.xml'");
	Диалог.Расширение = "xml";
	Диалог.ПолноеИмяФайла = "Настройки Панельки(" + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + ").xml";
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаЭкспортаПанелька", ЭтотОбъект, ТекстXML));
КонецПроцедуры

// Проверяет ожидающие команды и незаписанные правки перед импортом.
&НаКлиенте
Процедура ПодготовитьИмпортНастроекПанелька()
	Если Не ОбменНастроекРазрешенНаКлиентеПанелька("import") Тогда
		Возврат;
	КонецЕсли;
	Если Не СинхронизироватьКомандыHTMLПанелька() Тогда
		Возврат;
	КонецЕсли;
	Если НастройкиИзменены Тогда
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("save",НСтр("ru = 'Сохранить и загрузить'"));
		Кнопки.Добавить("replace",НСтр("ru = 'Заменить без сохранения'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияИмпортаПанелька", ЭтотОбъект),
			НСтр("ru = 'Перед загрузкой другого файла сохранить текущие изменения в базе?'"), Кнопки, 0,
			КодВозвратаДиалога.Отмена);
	Иначе
		ОткрытьДиалогИмпортаПанелька();
	КонецЕсли;
КонецПроцедуры

// Сериализует текущую модель для экспорта настроек.
&НаСервере
Функция СформироватьXMLОбъектовКонфигурации()
	ПроверитьРазрешениеОбменаПанелька("export");
	МодельПанели = СобратьМодель();
	ОбработкаПанелька = РеквизитФормыВЗначение("Объект");
	ОбработкаПанелька.ПанелькаПроверитьМодельРедактора(МодельПанели);
	Возврат ПолучитьЗначениеОформленияВXML(МодельПанели);
КонецФункции

// Проверяет импортируемый XML до замены активной модели формы.
&НаСервере
Процедура ЗагрузитьОбъектыКонфигурацииИзXML(Текст)
	ПроверитьРазрешениеОбменаПанелька("import");
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	Корень = "";
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Корень = Чтение.Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Если Корень = "Значение" Тогда
		Данные = ПолучитьЗначениеОформленияИзXML(Текст, Тип("Структура"));
		Если ТипЗнч(Данные) <> Тип("Структура") Тогда
			ВызватьИсключение НСтр("ru = 'Не удалось прочитать структуру настроек из XML.'");
		КонецЕсли;
	Иначе
		ВызватьИсключение НСтр("ru = 'Файл не является настройками Панелька.'");
	КонецЕсли;
	ОбработкаПанелька = РеквизитФормыВЗначение("Объект");
	МодельПанели = ОбработкаПанелька.ПанелькаПодготовитьМодельРедактора(Данные);
	Для Каждого СсылкаКаталога Из МодельПанели.КаталогСсылок Цикл
		ПроверитьФорматАдресаПанелька(СсылкаКаталога.Источник, СсылкаКаталога.Ссылка);
	КонецЦикла;
	Если ПерсональнаяНастройкаПанелька Тогда
		ОбработкаПанелька.ПанелькаПроверитьИсточникиЛичнойМодели(МодельПанели);
	КонецЕсли;
	// До этой точки активные данные формы не менялись.
	ЗагрузитьМодельВФорму(МодельПанели);
	Если ПерсональнаяНастройкаПанелька Тогда
		ЗаменитьЛичнуюПанельПанелька = Истина;
		ИсточникЛичнойПанелиПанелька = "import";
		РевизияОбщейПанелиПанелька = "";
	КонецЕсли;
	НастройкиИзменены = Истина;
	ПредставленияАктуальныПанелька = Ложь;
	HTMLНастройкиАктивнаяСтраница = "Главная";
	HTMLНастройкиАктивнаяКолонка = "";
	ВыбранныйТип = "Page";
КонецПроцедуры

// Сериализует значение в XML средствами XDTO.
&НаСервере
Функция ПолучитьЗначениеОформленияВXML(Знач Значение)
	ЗаписьXMLЗначения = Новый ЗаписьXML;
	ЗаписьXMLЗначения.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(ЗаписьXMLЗначения, Значение, "Значение", НазначениеТипаXML.Явное);
	Возврат ЗаписьXMLЗначения.Закрыть();
КонецФункции

// Читает типизированное значение из XML с корректным закрытием чтения.
&НаСервере
Функция ПолучитьЗначениеОформленияИзXML(Знач XMLСтрока, Знач ТипЗначения)
	Если ПустаяСтрока(XMLСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЧтениеXMLЗначения = Новый ЧтениеXML;
	ЧтениеXMLЗначения.УстановитьСтроку(XMLСтрока);
	Попытка
		Значение = СериализаторXDTO.ПрочитатьXML(ЧтениеXMLЗначения, ТипЗначения);
		ЧтениеXMLЗначения.Закрыть();
		Возврат Значение;
	Исключение
		ЧтениеXMLЗначения.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

// Читает прежний формат XML настроек для последующей миграции.


// Обрабатывает решение о текущих правках перед импортом.
//
// Параметры:
//  Ответ - Строка, КодВозвратаДиалога - save, replace либо отмена.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеПодтвержденияИмпортаПанелька(Ответ, Контекст) Экспорт
	Если Не ОбменНастроекРазрешенНаКлиентеПанелька("import") Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = "save" Тогда
		Если Не ПрименитьОбычныйРедактор() Тогда
			Возврат;
		КонецЕсли;
		Попытка
			СохранитьНастройкиВХранилище();
			Оповестить("Панелька_ОбновитьДашборд");
		Исключение
			СообщитьПользователюПанелька(ОписаниеОшибки());
			Возврат;
		КонецПопытки;
	ИначеЕсли Ответ <> "replace" Тогда
		Возврат;
	КонецЕсли;
	ОткрытьДиалогИмпортаПанелька();
КонецПроцедуры

// Открывает асинхронный диалог выбора XML настроек.
&НаКлиенте
Процедура ОткрытьДиалогИмпортаПанелька()
	Если Не ОбменНастроекРазрешенНаКлиентеПанелька("import") Тогда
		Возврат;
	КонецЕсли;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Загрузить настройки «Панельки»'");
	Диалог.Фильтр = НСтр("ru = 'Настройки XML (*.xml)|*.xml'");
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаИмпортаПанелька", ЭтотОбъект));
КонецПроцедуры

// Читает и импортирует выбранный файл настроек.
//
// Параметры:
//  Файлы - Неопределено, Массив из Строка - выбранные полные пути; используется первый файл.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораФайлаИмпортаПанелька(Файлы, Контекст) Экспорт
	Если Не ОбменНастроекРазрешенНаКлиентеПанелька("import") Тогда
		Возврат;
	КонецЕсли;
	Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(Файлы[0], КодировкаТекста.UTF8);
		ЗагрузитьОбъектыКонфигурацииИзXML(Документ.ПолучитьТекст());
		ОбновитьHTMLНастроекЕслиНужно();
		СообщитьПользователюПанелька(НСтр("ru = 'Настройки загружены в форму. Для записи в базу нажмите «Сохранить».'"));
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось загрузить настройки: %1'"), ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Записывает подготовленный XML в выбранный файл.
//
// Параметры:
//  Файлы - Неопределено, Массив из Строка - выбранный путь экспорта; используется первый файл.
//  ТекстXML - Строка - подготовленный XML настроек.
&НаКлиенте
Процедура ПослеВыбораФайлаЭкспортаПанелька(Файлы, ТекстXML) Экспорт
	Если Не ОбменНастроекРазрешенНаКлиентеПанелька("export") Тогда
		Возврат;
	КонецЕсли;
	Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(ТекстXML);
		Документ.Записать(Файлы[0], КодировкаТекста.UTF8);
		СообщитьПользователюПанелька(НСтр("ru = 'Настройки выгружены.'"));
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось выгрузить настройки: %1'"), ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ХранилищеНастроек

// Возвращает доступный модуль адаптера общего хранилища.
&НаСервере
Функция ПанелькаНастройкиПолучитьМодульХранилища()
	Обработка = РеквизитФормыВЗначение("Объект");
	МодульХранилища = Обработка.ПанелькаПолучитьМодульХранилища();
	Если МодульХранилища = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В базе отсутствует адаптер общего хранилища Панелька. Требуется подключение адаптера конфигурации.'");
	КонецЕсли;
	Возврат МодульХранилища;
КонецФункции

// Читает сохранённые настройки и регистрирует ошибку чтения.
&НаСервере
Функция ПанелькаНастройкиПрочитать()
	Если ПерсональнаяНастройкаПанелька Тогда
		Обработка = РеквизитФормыВЗначение("Объект");
		Профиль = Обработка.ПанелькаПрочитатьЛичныйПрофиль();
		СнимокХранилищаПанелька = Профиль.Ревизия;
		Возврат Профиль.Данные;
	КонецЕсли;
	Возврат ПанелькаОбщиеНастройкиПрочитать();
КонецФункции

// Общая панель остаётся в существующем хранилище конфигурации.
&НаСервере
Функция ПанелькаОбщиеНастройкиПрочитать()
	Попытка
		Если ПерсональнаяНастройкаПанелька Тогда
			Обработка = РеквизитФормыВЗначение("Объект");
			Возврат Обработка.ПанелькаПрочитатьОбщиеНастройки();
		КонецЕсли;
		МодульХранилища = ПанелькаНастройкиПолучитьМодульХранилища();
		Возврат МодульХранилища.ПрочитатьДанныеИзБезопасногоХранилища("Панелька_БНД");
	Исключение
		ЗарегистрироватьОшибкуИнтерфейсаНастроекПанелька("Чтение", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

// Проверяет снимок, сохраняет резерв и записывает новую версию настроек.
&НаСервере
Процедура ПанелькаНастройкиЗаписать(Знач Данные)
	ПроверитьПравоНастройкиПанелька();
	Если ПерсональнаяНастройкаПанелька Тогда
		ЗаписатьПерсональнуюПанельПанелька(Данные);
		Возврат;
	КонецЕсли;
	МодульХранилища = ПанелькаНастройкиПолучитьМодульХранилища();
	ТекущиеДанные = ПанелькаНастройкиПрочитать();
	Если ПолучитьЗначениеОформленияВXML(ТекущиеДанные) <> СнимокХранилищаПанелька Тогда
		ВызватьИсключение НСтр("ru = 'Настройки в базе изменились после открытия формы. Экспортируйте свои изменения и откройте настройки заново. Запись отменена.'");
	КонецЕсли;
	// При полном сбросе очищаем резерв тем же способом, что и основные настройки.
	// При обычном сохранении оставляем предыдущую подтверждённую версию.
	ДанныеРезерва = ?(Данные = Неопределено, Неопределено, ТекущиеДанные);
	МодульХранилища.ЗаписатьДанныеВБезопасноеХранилище("Панелька_БНД_Резерв", ДанныеРезерва);
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Вставить("РевизияПанелька", Строка(Новый УникальныйИдентификатор));
	КонецЕсли;
	Попытка
		МодульХранилища.ЗаписатьДанныеВБезопасноеХранилище("Панелька_БНД", Данные);
	Исключение
		ЗарегистрироватьОшибкуИнтерфейсаНастроекПанелька("Запись", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	СнимокХранилищаПанелька = ПолучитьЗначениеОформленияВXML(Данные);
КонецПроцедуры

#КонецОбласти

#Область ПредставлениеНавигационныхСсылок

// Подбирает системное представление вставленной ссылки.
&НаСервере
Функция ПредставлениеВставленногоОбъектаПанелька(Знач СсылкаТекст, Знач ПозицияДата)
	Возврат РеквизитФормыВЗначение("Объект").ПанелькаПредставлениеОбъектаДанных(СсылкаТекст, ПозицияДата);
КонецФункции

#КонецОбласти

#Область ОткрытыеОкна

// Собирает доступные открытые окна клиента как источники ссылок.
&НаКлиенте
Функция ПолучитьОткрытыеОкнаДляHTMLНастроек()
	Результат = Новый Массив;
	Для Каждого ТекущееОкно Из ПолучитьОкна() Цикл
		Если ТекущееОкно.Основное Тогда
			Продолжить;
		КонецЕсли;
		СсылкаОкна = ТекущееОкно.ПолучитьНавигационнуюСсылку();
		Если ПустаяСтрока(СсылкаОкна)
			Или СтрНайти(СсылкаОкна, "e1cib/") = 0
			Или СтрНайти(СсылкаОкна, "e1cib/app/Главная") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Представление = ТекущееОкно.Заголовок;
		Если ПустаяСтрока(Представление) Тогда
			Представление = СсылкаОкна;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Представление, Ссылка", Представление, СсылкаОкна));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПерсональныеНастройки

// Сохраняет персональную настройку интерфейса.
&НаСервереБезКонтекста
Процедура СохранитьПользовательскуюНастройкуHTMLПанелька(КлючНастройки, Значение)
	Попытка
		ХранилищеОбщихНастроек.Сохранить("Панелька_UI_Настройки", КлючНастройки, Значение);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Панелька.HTMLНастройки.СохранениеПользовательскойНастройки",
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Читает персональную настройку интерфейса со значением по умолчанию.
&НаСервереБезКонтекста
Функция ПолучитьПользовательскуюНастройкуHTMLПанелька(КлючНастройки, ЗначениеПоУмолчанию)
	Попытка
		ЗначениеНастройки = ХранилищеОбщихНастроек.Загрузить("Панелька_UI_Настройки", КлючНастройки);
		Возврат ?(ЗначениеНастройки = Неопределено, ЗначениеПоУмолчанию, ЗначениеНастройки);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ИсточникиДляHTML

// Формирует категории объектов метаданных.
&НаСервере
Функция ПолучитьГруппыМетаданныхHTML(КонтекстДоступа = Неопределено)
	Результат = Новый Массив;
	ДобавитьГруппуМетаданныхHTML(Результат, "Справочники", Метаданные.Справочники);
	ДобавитьГруппуМетаданныхHTML(Результат, "Документы", Метаданные.Документы);
	ДобавитьГруппуМетаданныхHTML(Результат, "Журналы документов", Метаданные.ЖурналыДокументов);
	ДобавитьГруппуМетаданныхHTML(Результат, "Отчеты", Метаданные.Отчеты);
	ДобавитьГруппуМетаданныхHTML(Результат, "Обработки", Метаданные.Обработки);
	ДобавитьГруппуМетаданныхHTML(Результат, "Планы видов характеристик", Метаданные.ПланыВидовХарактеристик);
	ДобавитьГруппуМетаданныхHTML(Результат, "Планы счетов", Метаданные.ПланыСчетов);
	ДобавитьГруппуМетаданныхHTML(Результат, "Планы видов расчета", Метаданные.ПланыВидовРасчета);
	ДобавитьГруппуМетаданныхHTML(Результат, "Планы обмена", Метаданные.ПланыОбмена);
	ДобавитьГруппуМетаданныхHTML(Результат, "Регистры сведений", Метаданные.РегистрыСведений);
	ДобавитьГруппуМетаданныхHTML(Результат, "Регистры накопления", Метаданные.РегистрыНакопления);
	ДобавитьГруппуМетаданныхHTML(Результат, "Регистры бухгалтерии", Метаданные.РегистрыБухгалтерии);
	ДобавитьГруппуМетаданныхHTML(Результат, "Регистры расчета", Метаданные.РегистрыРасчета);
	ДобавитьГруппуМетаданныхHTML(Результат, "Бизнес-процессы", Метаданные.БизнесПроцессы);
	ДобавитьГруппуМетаданныхHTML(Результат, "Задачи", Метаданные.Задачи);
	ДобавитьГруппуМетаданныхHTML(Результат, "Общие формы", Метаданные.ОбщиеФормы);
	ДобавитьГруппуМетаданныхHTML(Результат, "Константы", Метаданные.Константы);
	ДобавитьГруппуМетаданныхHTML(Результат, "Внешние источники данных", Метаданные.ВнешниеИсточникиДанных);
	Если ПерсональнаяНастройкаПанелька Тогда
		Политика = ПолитикаИсточниковРедактораПанелька(КонтекстДоступа);
		Категории = РеквизитФормыВЗначение("Объект").ПанелькаКатегорииМетаданныхЛичныхПанелей();
		Доступные = Новый Массив;
		Для Каждого Группа Из Результат Цикл
			Для Каждого Категория Из Категории Цикл
				Если Категория.Значение = Группа.Id И Политика[Категория.Ключ] Тогда
					Доступные.Добавить(Группа);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат Доступные;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Добавляет категорию метаданных в список доступных групп.
&НаСервереБезКонтекста
Процедура ДобавитьГруппуМетаданныхHTML(МассивГрупп, ИмяГруппы, КоллекцияМетаданных)
	Если КоллекцияМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если КоллекцияМетаданных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	МассивГрупп.Добавить(Новый Структура("Id, Name", ИмяГруппы, ИмяГруппы));
КонецПроцедуры

// Приводит выбранную категорию метаданных к допустимому значению.
&НаСервере
Процедура НормализоватьГруппуМетаданныхHTML(ГруппыМетаданных)
	Если HTMLНастройкиТипИсточника <> "metadata" Тогда
		Возврат;
	КонецЕсли;
	ТекущаяГруппаДоступна = Ложь;
	Для Каждого Группа Из ГруппыМетаданных Цикл
		Если Группа.Id = HTMLНастройкиКатегорияМетаданных Тогда
			ТекущаяГруппаДоступна = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ТекущаяГруппаДоступна Тогда
		Возврат;
	КонецЕсли;
	Если ГруппыМетаданных.Количество() > 0 Тогда
		HTMLНастройкиКатегорияМетаданных = ГруппыМетаданных[0].Id;
	Иначе
		HTMLНастройкиКатегорияМетаданных = "";
		HTMLНастройкиТипИсточника = "favorites";
	КонецЕсли;
КонецПроцедуры

// Различает ручную вставку и строки выбранного источника.
&НаСервере
Функция ОписаниеДобавленияИзHTMLПанелька(Действие, ПараметрыДействия, Знач Имя)
	Адрес = СокрЛП(ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "url", ""));
	Подсказка = ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "tip", "");
	Источник = "objects";
	Если Действие = "add_web" Тогда
		Если ПустаяСтрока(Адрес) Тогда
			ВызватьИсключение НСтр("ru = 'Вставьте ссылку.'");
		КонецЕсли;
		Источник = ?(Лев(Адрес, 6) = "e1cib/", "objects", "web");
		Если ПустаяСтрока(Имя) Тогда
			Если Источник = "objects" Тогда
				Обработка = РеквизитФормыВЗначение("Объект");
				Имя = Обработка.ПанелькаИмяНавигационнойСсылки(Адрес);
			Иначе
				Имя = Адрес;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли HTMLНастройкиТипИсточника = "catalog" Тогда
		СсылкаКаталога = НайтиСтрокуМодели(ТаблицаСсылок, "ИД", ПолучитьПараметрHTMLНастроек(ПараметрыДействия, "catalogId", ""));
		Если СсылкаКаталога = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Ссылка больше не существует в каталоге панели.'");
		КонецЕсли;
		Источник = СсылкаКаталога.Источник;
		Адрес = СсылкаКаталога.Ссылка;
		Имя = СсылкаКаталога.Наименование;
		Подсказка = СсылкаКаталога.Подсказка;
	ИначеЕсли HTMLНастройкиТипИсточника = "extra" Тогда
		Источник = "extra";
	КонецЕсли;
	Возврат ОписаниеДобавляемойСсылкиПанелька(Источник, Адрес, Имя, Подсказка, HTMLНастройкиАктивнаяКолонка);
КонецФункции

// Возвращает сохранённые ссылки для повторного размещения в редакторе.
&НаСервере
Функция КаталогИсточниковПанелька()
	Данные = Новый Массив;
	Для Каждого СсылкаКаталога Из ТаблицаСсылок Цикл
		ИсточникКаталога = Новый Структура;
		ИсточникКаталога.Вставить("Name", СсылкаКаталога.Наименование);
		ИсточникКаталога.Вставить("Url", СсылкаКаталога.Ссылка);
		ИсточникКаталога.Вставить("Tooltip", СсылкаКаталога.Подсказка);
		ИсточникКаталога.Вставить("Type", ПредставлениеИсточника(СсылкаКаталога.Источник));
		ИсточникКаталога.Вставить("Source", СсылкаКаталога.Источник);
		ИсточникКаталога.Вставить("Id", СсылкаКаталога.ИД);
		Данные.Добавить(ИсточникКаталога);
	КонецЦикла;
	Возврат Данные;
КонецФункции

// Собирает каталог источников для Web-интерфейса.
&НаСервере
Функция СформироватьИсточникиHTML(ОткрытыеОкна, КонтекстДоступа = Неопределено)
	Если HTMLНастройкиТипИсточника = "metadata" Тогда
		Возврат ПолучитьМетаданныеКатегорииHTML(HTMLНастройкиКатегорияМетаданных, КонтекстДоступа);
	ИначеЕсли HTMLНастройкиТипИсточника = "favorites" Тогда
		Возврат ПолучитьИзбранноеДляHTMLНастроек();
	ИначеЕсли HTMLНастройкиТипИсточника = "opened" Тогда
		Возврат ПолучитьОткрытыеОкнаКакИсточникиHTML(ОткрытыеОкна);
	ИначеЕсли HTMLНастройкиТипИсточника = "catalog" Тогда
		Возврат КаталогИсточниковПанелька();
	ИначеЕсли HTMLНастройкиТипИсточника = "standard" Тогда
		Возврат СтандартныеИсточникиПанелька(КонтекстДоступа);
	ИначеЕсли HTMLНастройкиТипИсточника = "extra"
		И ИсточникРедактораРазрешенПанелька("extra", ПолитикаИсточниковРедактораПанелька(КонтекстДоступа)) Тогда
		Возврат ДополнительныеИсточникиОбычнойФормы(КонтекстДоступа);
	КонецЕсли;
	Возврат Новый Массив;
КонецФункции

// Возвращает объекты выбранной категории метаданных.
&НаСервере
Функция ПолучитьМетаданныеКатегорииHTML(Категория, КонтекстДоступа = Неопределено)
	Результат = Новый Массив;
	Если Категория = "Внешние источники данных" Тогда
		Для Каждого ВнешнийИсточник Из Метаданные.ВнешниеИсточникиДанных Цикл
			Для Каждого ТаблицаИсточника Из ВнешнийИсточник.Таблицы Цикл
				Представление = ?(ПустаяСтрока(ТаблицаИсточника.Синоним), ТаблицаИсточника.Имя,
					ТаблицаИсточника.Синоним)
					+ " (" + ВнешнийИсточник.Имя + ")";
				Адрес = "e1cib/list/ВнешнийИсточникДанных." + ВнешнийИсточник.Имя + ".Таблица." + ТаблицаИсточника.Имя;
				ИсточникHTML = Новый Структура;
				ИсточникHTML.Вставить("Name", Представление);
				ИсточникHTML.Вставить("Url", Адрес);
				ИсточникHTML.Вставить("Tooltip", "");
				ИсточникHTML.Вставить("Type", Категория);
				Результат.Добавить(ИсточникHTML);
			КонецЦикла;
		КонецЦикла;
		Возврат ОтфильтроватьЛичныеИсточникиПанелька(Результат, КонтекстДоступа);
	КонецЕсли;
	Коллекция = Неопределено;
	Префикс = "";
	Если Категория = "Справочники" Тогда
		Коллекция = Метаданные.Справочники;
		Префикс = "e1cib/list/Справочник.";
	ИначеЕсли Категория = "Документы" Тогда
		Коллекция = Метаданные.Документы;
		Префикс = "e1cib/list/Документ.";
	ИначеЕсли Категория = "Журналы документов" Тогда
		Коллекция = Метаданные.ЖурналыДокументов;
		Префикс = "e1cib/list/ЖурналДокументов.";
	ИначеЕсли Категория = "Отчеты" Тогда
		Коллекция = Метаданные.Отчеты;
		Префикс = "e1cib/app/Отчет.";
	ИначеЕсли Категория = "Обработки" Тогда
		Коллекция = Метаданные.Обработки;
		Префикс = "e1cib/app/Обработка.";
	ИначеЕсли Категория = "Планы видов характеристик" Тогда
		Коллекция = Метаданные.ПланыВидовХарактеристик;
		Префикс = "e1cib/list/ПланВидовХарактеристик.";
	ИначеЕсли Категория = "Планы счетов" Тогда
		Коллекция = Метаданные.ПланыСчетов;
		Префикс = "e1cib/list/ПланСчетов.";
	ИначеЕсли Категория = "Планы видов расчета" Тогда
		Коллекция = Метаданные.ПланыВидовРасчета;
		Префикс = "e1cib/list/ПланВидовРасчета.";
	ИначеЕсли Категория = "Планы обмена" Тогда
		Коллекция = Метаданные.ПланыОбмена;
		Префикс = "e1cib/list/ПланОбмена.";
	ИначеЕсли Категория = "Регистры сведений" Тогда
		Коллекция = Метаданные.РегистрыСведений;
		Префикс = "e1cib/list/РегистрСведений.";
	ИначеЕсли Категория = "Регистры накопления" Тогда
		Коллекция = Метаданные.РегистрыНакопления;
		Префикс = "e1cib/list/РегистрНакопления.";
	ИначеЕсли Категория = "Регистры бухгалтерии" Тогда
		Коллекция = Метаданные.РегистрыБухгалтерии;
		Префикс = "e1cib/list/РегистрБухгалтерии.";
	ИначеЕсли Категория = "Регистры расчета" Тогда
		Коллекция = Метаданные.РегистрыРасчета;
		Префикс = "e1cib/list/РегистрРасчета.";
	ИначеЕсли Категория = "Бизнес-процессы" Тогда
		Коллекция = Метаданные.БизнесПроцессы;
		Префикс = "e1cib/list/БизнесПроцесс.";
	ИначеЕсли Категория = "Задачи" Тогда
		Коллекция = Метаданные.Задачи;
		Префикс = "e1cib/list/Задача.";
	ИначеЕсли Категория = "Общие формы" Тогда
		Коллекция = Метаданные.ОбщиеФормы;
		Префикс = "e1cib/app/ОбщаяФорма.";
	ИначеЕсли Категория = "Константы" Тогда
		Коллекция = Метаданные.Константы;
		Префикс = "e1cib/data/Константа.";
	КонецЕсли;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ОбработкаДоступа = РеквизитФормыВЗначение("Объект");
	Для Каждого ОбъектМетаданных Из Коллекция Цикл
		Если ПерсональнаяНастройкаПанелька И Не ОбработкаДоступа.ПанелькаМетаданныеДоступны(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Представление = ОбъектМетаданных.Синоним;
		Если ПустаяСтрока(Представление) Тогда
			Представление = ОбъектМетаданных.Имя;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Name", Представление);
		Элемент.Вставить("Url", Префикс + ОбъектМетаданных.Имя);
		Элемент.Вставить("Tooltip", "");
		Элемент.Вставить("Type", Категория);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает избранное с учётом выбранного фильтра.
&НаСервере
Функция ПолучитьИзбранноеДляHTMLНастроек()
	Результат = Новый Массив;
	СсылкиБезПредставления = Новый Массив;
	Попытка
		Избранное = ХранилищеСистемныхНастроек.Загрузить("Общее/ИзбранноеРаботыПользователя");
	Исключение
		ЗаписьЖурналаРегистрации(
			"Панелька.HTMLНастройки.Избранное",
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
	Если ТипЗнч(Избранное) <> Тип("ИзбранноеРаботыПользователя") Тогда
		Возврат Результат;
	КонецЕсли;
	ФильтрИзбранного = ПолучитьПользовательскуюНастройкуHTMLПанелька("ФильтрИзбранногоHTML", "all");
	Для Каждого ЭлементИзбранного Из Избранное Цикл
		Ссылка = СокрЛП(ЭлементИзбранного.НавигационнаяСсылка);
		Если ПустаяСтрока(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ЭтоКонкретныйОбъект = СтрНайти(Ссылка, "e1cib/data/") > 0;
		Если ФильтрИзбранного = "objects" И Не ЭтоКонкретныйОбъект Тогда
			Продолжить;
		ИначеЕсли ФильтрИзбранного = "lists" И ЭтоКонкретныйОбъект Тогда
			Продолжить;
		КонецЕсли;
		Представление = ЭлементИзбранного.Представление;
		Если ПустаяСтрока(Представление) Тогда
			СсылкиБезПредставления.Добавить(Ссылка);
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Name", Представление);
		Элемент.Вставить("Url", Ссылка);
		Элемент.Вставить("Tooltip", "");
		Элемент.Вставить("Type", ОпределитьТипСсылкиHTML("objects", Ссылка));
		Результат.Добавить(Элемент);
	КонецЦикла;
	Если СсылкиБезПредставления.Количество() > 0 Тогда
		ОбработкаПанелька = РеквизитФормыВЗначение("Объект");
		Представления = ОбработкаПанелька.ПанелькаПредставленияНавигационныхСсылок(СсылкиБезПредставления, Истина);
		Для Каждого Элемент Из Результат Цикл
			Если ПустаяСтрока(Элемент.Name) Тогда
				Элемент.Name = Представления[Элемент.Url];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Преобразует открытые окна в строки источников HTML.
&НаСервереБезКонтекста
Функция ПолучитьОткрытыеОкнаКакИсточникиHTML(ОткрытыеОкна)
	Результат = Новый Массив;
	Если ТипЗнч(ОткрытыеОкна) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ДанныеОкна Из ОткрытыеОкна Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Name", ДанныеОкна.Представление);
		Элемент.Вставить("Url", ДанныеОкна.Ссылка);
		Элемент.Вставить("Tooltip", "");
		Элемент.Вставить("Type", "Открытая вкладка");
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Определяет вид ссылки для HTML-представления.
&НаСервереБезКонтекста
Функция ОпределитьТипСсылкиHTML(Источник, Ссылка, ТипыДоп = Неопределено)
	Возврат КлассифицироватьСсылкуПанелька(Источник, Ссылка, ТипыДоп);
КонецФункции

// Проверяет наличие механизма дополнительных обработок в конфигурации.
&НаСервереБезКонтекста
Функция ЕстьДополнительныеОбработкиHTML()
	Возврат Метаданные.Справочники.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено
		Или Метаданные.Справочники.Найти("ВнешниеОбработки") <> Неопределено;
КонецФункции

#КонецОбласти

#Область КартинкиДляHTML

// Преобразует каждую именованную картинку только один раз за формирование HTML.
// Кэш передаётся явно и уничтожается после завершения формирования документа.
&НаСервереБезКонтекста
Функция ПолучитьКартинкуHTMLИзКэшаПанелька(ИмяКартинки, КэшКартинок)
	Если ПустаяСтрока(ИмяКартинки) Тогда
		Возврат "";
	КонецЕсли;
	ДанныеКартинки = КэшКартинок[ИмяКартинки];
	Если ДанныеКартинки = Неопределено Тогда
		ДанныеКартинки = ПолучитьDataURIКартинкиHTML(ИмяКартинки);
		КэшКартинок.Вставить(ИмяКартинки, ДанныеКартинки);
	КонецЕсли;
	Возврат ДанныеКартинки;
КонецФункции

// Кодирует картинку библиотеки в data URI для HTML.
&НаСервереБезКонтекста
Функция ПолучитьDataURIКартинкиHTML(ИмяИконкиИлиКартинка)
	Картинка = Неопределено;
	Если ТипЗнч(ИмяИконкиИлиКартинка) = Тип("Картинка") Тогда
		Картинка = ИмяИконкиИлиКартинка;
	ИначеЕсли ТипЗнч(ИмяИконкиИлиКартинка) = Тип("Строка")
		И ЗначениеЗаполнено(ИмяИконкиИлиКартинка) Тогда
		Попытка
			Картинка = БиблиотекаКартинок[ИмяИконкиИлиКартинка];
		Исключение
			Возврат "";
		КонецПопытки;
	Иначе
		Возврат "";
	КонецЕсли;
	Если Картинка = Неопределено Или Картинка.Вид = ВидКартинки.Пустая Тогда
		Возврат "";
	КонецЕсли;
	ДвоичныеДанные = Неопределено;
	ТипСодержимого = "image/png";
	Попытка
		КартинкаPNG = Картинка.Преобразовать(ФорматКартинки.PNG);
		ДвоичныеДанные = КартинкаPNG.ПолучитьДвоичныеДанные();
	Исключение
		// В режиме совместимости преобразование может быть недоступно.
	КонецПопытки;
	Если ДвоичныеДанные = Неопределено Тогда
		Попытка
			ДвоичныеДанные = Картинка.ПолучитьДвоичныеДанные();
			Если ДвоичныеДанные <> Неопределено Тогда
				ТипСодержимого = ТипСодержимогоКартинкиHTMLПанелька(ДвоичныеДанные);
			КонецЕсли;
		Исключение
			// При недоступных данных строим элемент без картинки.
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	Если ДвоичныеДанные <> Неопределено И Не ПустаяСтрока(ТипСодержимого) Тогда
		Возврат "data:" + ТипСодержимого + ";base64," + Base64Строка(ДвоичныеДанные);
	КонецЕсли;
	Возврат "";
КонецФункции

// Определяет MIME-тип выбранного варианта картинки по его двоичным данным.
//
// Параметры:
//  ДвоичныеДанныеКартинки - ДвоичныеДанные - данные одного варианта картинки.
//
// Возвращаемое значение:
//  Строка - MIME-тип для HTML; пустая строка для неизвестного или неподдерживаемого формата.
&НаСервереБезКонтекста
Функция ТипСодержимогоКартинкиHTMLПанелька(ДвоичныеДанныеКартинки)
	Попытка
		КартинкаВарианта = Новый Картинка(ДвоичныеДанныеКартинки);
		ФорматИзображения = КартинкаВарианта.Формат();
	Исключение
		// Неизвестные или поврежденные данные не передаем в HTML.
		Возврат "";
	КонецПопытки;
	Если ФорматИзображения = ФорматКартинки.PNG Тогда
		Возврат "image/png";
	ИначеЕсли ФорматИзображения = ФорматКартинки.JPEG Тогда
		Возврат "image/jpeg";
	ИначеЕсли ФорматИзображения = ФорматКартинки.GIF Тогда
		Возврат "image/gif";
	ИначеЕсли ФорматИзображения = ФорматКартинки.BMP Тогда
		Возврат "image/bmp";
	ИначеЕсли ФорматИзображения = ФорматКартинки.SVG Тогда
		Возврат "image/svg+xml";
	ИначеЕсли ФорматИзображения = ФорматКартинки.Icon Тогда
		Возврат "image/x-icon";
	КонецЕсли;
	Возврат "";
КонецФункции

// Формирует модель выбора картинки для HTML-редактора.
&НаСервере
Функция СформироватьВыборКартинкиHTML(КонтекстКартинки)
	Результат = Новый Структура;
	Результат.Вставить("Open", Ложь);
	Результат.Вставить("Kind", "");
	Результат.Вставить("ObjectName", "");
	Результат.Вставить("Current", "");
	Результат.Вставить("Items", Новый Массив);
	Если ТипЗнч(КонтекстКартинки) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	ВидОбъекта = "";
	ИмяОбъекта = "";
	КонтекстКартинки.Свойство("Kind", ВидОбъекта);
	КонтекстКартинки.Свойство("Name", ИмяОбъекта);
	Если ВидОбъекта <> "page" И ВидОбъекта <> "column" Тогда
		Возврат Результат;
	КонецЕсли;
	ТекущееИмяКартинки = "";
	Если ВидОбъекта = "page" Тогда
		Если ИмяОбъекта = "Главная" Тогда
			ТекущееИмяКартинки = ПолучитьИконкуСтраницыHTML("Главная");
		Иначе
			Для Каждого СтрСтраница Из ТаблицаСтраниц Цикл
				Если СтрСтраница.ИмяСтраницы = ИмяОбъекта Тогда
					ТекущееИмяКартинки = СтрСтраница.ИмяКартинки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Для Каждого СтрКолонка Из ТаблицаКолонок Цикл
			Если СтрКолонка.ИД = ИмяОбъекта Тогда
				ТекущееИмяКартинки = СтрКолонка.ИмяКартинки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат.Open = Истина;
	Результат.Kind = ВидОбъекта;
	Результат.ObjectName = ИмяОбъекта;
	Результат.Current = ТекущееИмяКартинки;
	// Первый элемент позволяет явно очистить картинку.
	ПустаяКартинка = Новый Структура;
	ПустаяКартинка.Вставить("Name", "");
	ПустаяКартинка.Вставить("Caption", "Без картинки");
	ПустаяКартинка.Вставить("Image", "");
	Результат.Items.Добавить(ПустаяКартинка);
	СписокКартинок = ПолучитьВсеКартинкиНаСервере();
	УжеДобавлены = Новый Соответствие;
	Для Каждого ЭлементСписка Из СписокКартинок Цикл
		ИмяКартинки = Строка(ЭлементСписка.Значение);
		Если ПустаяСтрока(ИмяКартинки) Или УжеДобавлены[ИмяКартинки] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавлены.Вставить(ИмяКартинки, Истина);
		ЭлементКартинки = Новый Структура;
		ЭлементКартинки.Вставить("Name", ИмяКартинки);
		ЭлементКартинки.Вставить("Caption", Строка(ЭлементСписка.Представление));
		ЭлементКартинки.Вставить("Image", ПолучитьDataURIКартинкиHTML(ИмяКартинки));
		Результат.Items.Добавить(ЭлементКартинки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает доступные картинки библиотеки.
&НаСервере
Функция ПолучитьВсеКартинкиНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПанелькаКартинкиДляВыбора();
КонецФункции

// Возвращает картинку выбранной страницы для HTML.
&НаСервере
Функция ПолучитьИконкуСтраницыHTML(ИмяСтраницы)
	Для Каждого СтрСтраница Из ТаблицаСтраниц Цикл
		Если СтрСтраница.ИмяСтраницы = ИмяСтраницы И ЗначениеЗаполнено(СтрСтраница.ИмяКартинки) Тогда
			Возврат СтрСтраница.ИмяКартинки;
		КонецЕсли;
	КонецЦикла;
	Если ИмяСтраницы = "Главная" Тогда
		Возврат "Избранное";
	ИначеЕсли ИмяСтраницы = "Стандартные инструменты" Тогда
		Возврат "Настройка";
	ИначеЕсли ИмяСтраницы = "Не распределено" Тогда
		Возврат "Папка";
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

#Область МостHTML

// Подключает периодическую проверку команд HTML-документа.
&НаКлиенте
Процедура ПодключитьМостHTMLНастроек()
	Если HTMLНастройкиМостПодключен Тогда
		Возврат;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПроверитьКомандуHTMLНастроек", 1, Ложь);
	HTMLНастройкиМостПодключен = Истина;
КонецПроцедуры

// Отключает наблюдатель HTML-команд.
&НаКлиенте
Процедура ОтключитьМостHTMLНастроек()
	Если Не HTMLНастройкиМостПодключен Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОтключитьОбработчикОжидания("ПроверитьКомандуHTMLНастроек");
	Исключение
	КонецПопытки;
	HTMLНастройкиМостПодключен = Ложь;
КонецПроцедуры

// Наблюдатель и внешние команды используют один приёмник с защитой по идентификатору.
&НаКлиенте
Процедура ПроверитьКомандуHTMLНастроек() Экспорт
	ПринятьОжидающуюКомандуHTMLПанелька();
КонецПроцедуры

// Синхронно выполняет ещё не принятую команду перед сохранением, закрытием и сменой режима.
// Возвращает Ложь при незавершённой/ошибочной команде или если сама команда уже выполнила переход.
&НаКлиенте
Функция СинхронизироватьКомандыHTMLПанелька()
	Если Не РежимHTMLНастроек Или ДопНастройкиОткрытыПанелька Тогда
		Возврат Истина;
	КонецЕсли;
	Если HTMLНастройкиВыполняетсяКомандаМоста = Истина Тогда
		// Вызов обработчика сохранения из уже принятой HTML-команды.
		Возврат Истина;
	КонецЕсли;
	HTMLНастройкиКомандаСинхронизирована = Ложь;
	Попытка
		СохранитьСостояниеОткрытогоHTMLПанелька();
		HTMLДокумент = Элементы.ПолеHTMLНастроек.Документ;
		Если HTMLДокумент = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Web-интерфейс ещё загружается.'");
		КонецЕсли;
		ЗаголовокДокумента = Строка(HTMLДокумент.title);
		Если ЗаголовокДокумента = "PANELKASETTINGS_PROCESSING" Тогда
			СообщитьПользователюПанелька(НСтр("ru = 'Дождитесь завершения команды Web-интерфейса и повторите действие.'"));
			Возврат Ложь;
		КонецЕсли;
		Если Лев(ЗаголовокДокумента, СтрДлина("PANELKASETTINGS|")) <> "PANELKASETTINGS|" Тогда
			ПринятьЛокальныеДопНастройкиHTMLПанелька();
			Возврат Истина;
		КонецЕсли;
		ЧастиКоманды = СтрРазделить(ЗаголовокДокумента, "|");
		Если ЧастиКоманды.Количество() < 3 Тогда
			ВызватьИсключение НСтр("ru = 'Некорректная команда Web-интерфейса.'");
		КонецЕсли;
		URLКоманды = ДекодироватьПараметрHTMLНастроек(ЧастиКоманды[2]);
		Если Не ПринятьОжидающуюКомандуHTMLПанелька() Тогда
			Возврат Ложь;
		КонецЕсли;
		HTMLНастройкиКомандаСинхронизирована = Истина;
		Для Каждого Действие Из СтрРазделить("save,save_close,import,export,switch_native,open_additional_settings,additional_close", ",") Цикл
			Если СтрНайти(URLКоманды, "panelkasettings://" + Действие + "?") > 0 Тогда
				// Команда уже выполнила сохранение/переход. Повторять внешнее действие нельзя.
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	Исключение
		ЗарегистрироватьОшибкуИнтерфейсаНастроекПанелька("СинхронизацияКомандHTML",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СообщитьПользователюПанелька(НСтр("ru = 'Не удалось согласовать изменения Web-интерфейса. Дождитесь загрузки формы и повторите действие.'"));
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Отмечает команду принятой до выполнения. Ошибка подтверждается отдельно и не запускает повтор.
&НаКлиенте
Функция ПринятьОжидающуюКомандуHTMLПанелька()
	Если Не РежимHTMLНастроек Или HTMLНастройкиВыполняетсяКомандаМоста = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	ПолеHTML = Элементы.Найти("ПолеHTMLНастроек");
	Если ПолеHTML = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		HTMLДокумент = ПолеHTML.Документ;
		Если HTMLДокумент = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		ЗаголовокДокумента = Строка(HTMLДокумент.title);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если Лев(ЗаголовокДокумента, СтрДлина("PANELKASETTINGS|")) <> "PANELKASETTINGS|" Тогда
		Возврат ЗаголовокДокумента <> "PANELKASETTINGS_PROCESSING";
	КонецЕсли;
	ЧастиКоманды = СтрРазделить(ЗаголовокДокумента, "|");
	Если ЧастиКоманды.Количество() < 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	ИдентификаторКоманды = ЧастиКоманды[1];
	Если HTMLНастройкиПоследняяКомандаМоста = ИдентификаторКоманды Тогда
		Возврат HTMLНастройкиОшибкаКомандыМоста <> Истина;
	КонецЕсли;
	URLКоманды = ДекодироватьПараметрHTMLНастроек(ЧастиКоманды[2]);
	Если ПустаяСтрока(URLКоманды) Тогда
		Возврат Ложь;
	КонецЕсли;
	HTMLНастройкиПоследняяКомандаМоста = ИдентификаторКоманды;
	HTMLНастройкиВыполняетсяКомандаМоста = Истина;
	HTMLНастройкиОшибкаКомандыМоста = Ложь;
	Попытка
		HTMLДокумент.title = "PANELKASETTINGS_PROCESSING";
		ВыполнитьКомандуHTMLНастроек(URLКоманды);
	Исключение
		HTMLНастройкиОшибкаКомандыМоста = Истина;
		ЗарегистрироватьОшибкуИнтерфейсаНастроекПанелька("ПриёмКомандыHTML",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СообщитьПользователюПанелька(НСтр("ru = 'Не удалось завершить команду Web-интерфейса. Изменения не сохранены. Обратитесь к администратору.'"));
	КонецПопытки;
	HTMLНастройкиВыполняетсяКомандаМоста = Ложь;
	Попытка
		HTMLДокумент.title = ?(HTMLНастройкиОшибкаКомандыМоста, "PANELKASETTINGS_ERROR", "PANELKASETTINGS_READY");
	Исключение
		// Новый документ уже создан. Команда принята и повторно не выполняется.
	КонецПопытки;
	Возврат Не HTMLНастройкиОшибкаКомандыМоста;
КонецФункции

// Состояние представления включает неподтверждённый ввод новой веб-ссылки, но не добавляет её в модель.
&НаКлиенте
Процедура СохранитьСостояниеОткрытогоHTMLПанелька()
	Если HTMLНастройкиКомандаСинхронизирована = Истина Тогда
		Возврат;
	КонецЕсли;
	Если Не РежимHTMLНастроек Тогда
		Возврат;
	КонецЕсли;
	ДокументHTML = Элементы.ПолеHTMLНастроек.Документ;
	Если ДокументHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПолеСостояния = ДокументHTML.getElementById("panelkaViewState");
	Если ПолеСостояния <> Неопределено Тогда
		СостояниеHTMLПанелька = Строка(ПолеСостояния.value);
	КонецЕсли;
КонецПроцедуры

// Не позволяет закрыть форму с введённой, но ещё не добавленной веб-ссылкой.
&НаКлиенте
Функция ЕстьЧерновикНовойВебСсылкиHTMLПанелька()
	Если HTMLНастройкиКомандаСинхронизирована <> Истина Тогда
		СохранитьСостояниеОткрытогоHTMLПанелька();
	КонецЕсли;
	Если ПустаяСтрока(СостояниеHTMLПанелька) Тогда
		Возврат Ложь;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СостояниеHTMLПанелька);
	Состояние = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Черновик = Неопределено;
	Если Не Состояние.Свойство("webDraft", Черновик) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Черновик) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("name,url,tip", ",") Цикл
		ЗначениеПоля = "";
		Если Черновик.Свойство(ИмяПоля, ЗначениеПоля) И Не ПустаяСтрока(ЗначениеПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Очищает только подтверждённый черновик; вызывается после успешного add_web.
&НаСервере
Процедура ОчиститьЧерновикНовойВебСсылкиHTMLПанелька()
	Если ПустаяСтрока(СостояниеHTMLПанелька) Тогда
		Возврат;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СостояниеHTMLПанелька);
	Состояние = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	ЧерновикВебСсылки = Новый Структура;
	ЧерновикВебСсылки.Вставить("open", Ложь);
	ЧерновикВебСсылки.Вставить("name", "");
	ЧерновикВебСсылки.Вставить("url", "");
	ЧерновикВебСсылки.Вставить("tip", "");
	Состояние.Вставить("webDraft", ЧерновикВебСсылки);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Состояние);
	СостояниеHTMLПанелька = Запись.Закрыть();
КонецПроцедуры

// Неожиданные ошибки клиентского протокола записываются без зависимости от БСП.
&НаСервере
Процедура ЗарегистрироватьОшибкуИнтерфейсаНастроекПанелька(Операция, Подробности)
	Попытка
		ЗаписьЖурналаРегистрации("Панелька.Настройки." + Операция, УровеньЖурналаРегистрации.Ошибка, , ,
			Лев(Подробности, 10000));
	Исключение
		// Отказ журнала не должен скрывать исходный результат операции.
	КонецПопытки;
КонецПроцедуры

// Разбирает параметры команды HTML в структуру.
&НаКлиенте
Функция РазобратьПараметрыHTMLНастроек(СтрокаПараметров)
	Результат = Новый Структура;
	Если ПустаяСтрока(СтрокаПараметров) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Параметр Из СтрРазделить(СтрокаПараметров, "&") Цикл
		ПозицияРавно = СтрНайти(Параметр, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = Лев(Параметр, ПозицияРавно - 1);
		Значение = Сред(Параметр, ПозицияРавно + 1);
		Результат.Вставить(Имя, ДекодироватьПараметрHTMLНастроек(Значение));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Декодирует переданный параметр HTML-команды.
&НаКлиенте
Функция ДекодироватьПараметрHTMLНастроек(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Base64 = СтрЗаменить(Значение, "-", "+");
	Base64 = СтрЗаменить(Base64, "_", "/");
	Base64 = СтрЗаменить(Base64, ".", "=");
	Попытка
		ДвоичныеДанные = Base64Значение(Base64);
		Возврат ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Возвращает параметр команды или значение по умолчанию.
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПараметрHTMLНастроек(ПараметрыКоманды, ИмяПараметра, ЗначениеПоУмолчанию)
	Значение = Неопределено;
	Если ПараметрыКоманды.Свойство(ИмяПараметра, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

#КонецОбласти

#Область ДиалогиДобавленияИсточников

// Сохраняет имя подключённого экземпляра обработки (в том числе назначенное WMS/БСП).
// Имя метаданных обработки не обязано совпадать с именем её подключения.
&НаКлиенте
Функция ИмяСоседнейФормыПанелька(ИмяСоседнейФормы)
	ПолноеИмя = ИмяФормы;
	Разделитель = ".Форма.";
	Позиция = СтрНайти(ПолноеИмя, Разделитель);
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось определить имя подключённой обработки Панелька: %1'"), ПолноеИмя);
	КонецЕсли;
	Возврат Лев(ПолноеИмя, Позиция + СтрДлина(Разделитель) - 1) + ИмяСоседнейФормы;
КонецФункции

// Открывает расширенный выбор объектов метаданных.
&НаКлиенте
Процедура КомандаДобавитьИзМетаданных(Команда)
	Если Не ИсточникРедактораРазрешенПанелька("metadata") Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Этот источник запрещён администратором.'"));
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("РежимОтображения", "Метаданные");
	ПараметрыФормы.Вставить("ПерсональнаяНастройкаПанелька", ПерсональнаяНастройкаПанелька);
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзДерева", ЭтотОбъект);
	ОткрытьФорму(ИмяСоседнейФормыПанелька("ВыборОбъектовМетаданных"), ПараметрыФормы, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Открывает отдельный выбор стандартных инструментов платформы.
&НаКлиенте
