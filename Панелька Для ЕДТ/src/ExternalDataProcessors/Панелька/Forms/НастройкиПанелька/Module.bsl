#КонецОбласти

#Область ЗакладкиБраузеров

// Читает поддерживаемые профили браузеров в Windows.
&НаКлиенте
Асинх Функция ПолучитьВсеЗакладкиБраузеров()
	МассивЗакладок = Новый Массив;
	Попытка
		WshShell = Новый COMОбъект("WScript.Shell");
		LocalAppData = WshShell.ExpandEnvironmentStrings("%LOCALAPPDATA%");
		AppData = WshShell.ExpandEnvironmentStrings("%APPDATA%");
	Исключение
		СообщитьПользователюПанелька(НСтр("ru = 'Нет доступа к WScript.Shell.'"));
		Возврат МассивЗакладок;
	КонецПопытки;
	Браузеры = Новый Соответствие;
	Браузеры.Вставить("Google Chrome", LocalAppData + "\Google\Chrome\User Data\Default\Bookmarks");
	Браузеры.Вставить("Yandex Browser", LocalAppData + "\Yandex\YandexBrowser\User Data\Default\Bookmarks");
	Браузеры.Вставить("Microsoft Edge", LocalAppData + "\Microsoft\Edge\User Data\Default\Bookmarks");
	Браузеры.Вставить("Opera", AppData + "\Opera Software\Opera Stable\Bookmarks");
	Браузеры.Вставить("Opera GX", AppData + "\Opera Software\Opera GX Stable\Bookmarks");
	Браузеры.Вставить("Brave", LocalAppData + "\BraveSoftware\Brave-Browser\User Data\Default\Bookmarks");
	Браузеры.Вставить("Vivaldi", LocalAppData + "\Vivaldi\User Data\Default\Bookmarks");
	Для Каждого КлючИЗначение Из Браузеры Цикл
		ФайлЗакладок = Новый Файл(КлючИЗначение.Значение);
		Если Ждать ФайлЗакладок.СуществуетАсинх() Тогда
			ПрочитатьЗакладкиChromium(КлючИЗначение.Значение, КлючИЗначение.Ключ, МассивЗакладок);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивЗакладок;
КонецФункции

// Читает файл закладок Chromium.
&НаКлиенте
Процедура ПрочитатьЗакладкиChromium(ПутьКФайлу, ИмяБраузера, МассивЗакладок, СтрогийРежим = Ложь)
#Если ВебКлиент Тогда
	Возврат;
#Иначе
	Чтение = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПутьКФайлу);
		СтруктураJSON = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		ОшибкаЧтения = ИнформацияОбОшибке();
		Если Чтение <> Неопределено Тогда
			Попытка
				Чтение.Закрыть();
			Исключение
				// Сохраняем исходную причину отказа чтения или разбора.
			КонецПопытки;
		КонецЕсли;
		ЗарегистрироватьОшибкуИнтерфейсаНастроекПанелька("ЧтениеЗакладок",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ОшибкаЧтения));
		Если СтрогийРежим Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось прочитать JSON закладок: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ОшибкаЧтения));
		КонецЕсли;
		Возврат;
	КонецПопытки;
	Если СтруктураJSON.Свойство("roots") Тогда
		Если СтруктураJSON.roots.Свойство("bookmark_bar") Тогда
			ИзвлечьСсылкиИзДерева(СтруктураJSON.roots.bookmark_bar, ИмяБраузера, "Панель закладок", МассивЗакладок);
		КонецЕсли;
		Если СтруктураJSON.roots.Свойство("other") Тогда
			ИзвлечьСсылкиИзДерева(СтруктураJSON.roots.other, ИмяБраузера, "Другие закладки", МассивЗакладок);
		КонецЕсли;
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

// Рекурсивно извлекает адреса из дерева закладок.
&НаКлиенте
Процедура ИзвлечьСсылкиИзДерева(Узел, ИмяБраузера, ПутьПапки, МассивЗакладок)
	Если ТипЗнч(Узел) = Тип("Структура") Тогда
		Если Узел.Свойство("children") Тогда
			НовыйПуть = ПутьПапки;
			Если Узел.Свойство("name") И ЗначениеЗаполнено(Узел.name) И Узел.name <> ПутьПапки Тогда
				НовыйПуть = ПутьПапки + ?(ПустаяСтрока(ПутьПапки), "", " \ ") + Узел.name;
			КонецЕсли;
			ИзвлечьСсылкиИзДерева(Узел.children, ИмяБраузера, НовыйПуть, МассивЗакладок);
		ИначеЕсли Узел.Свойство("type") И Узел.type = "url" Тогда
			Закладка = Новый Структура;
			Закладка.Вставить("Браузер", ИмяБраузера);
			Закладка.Вставить("Папка", ПутьПапки);
			Закладка.Вставить("Наименование", Узел.name);
			Закладка.Вставить("Ссылка", Узел.url);
			МассивЗакладок.Добавить(Закладка);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Узел) = Тип("Массив") Тогда
		Для Каждого Элемент Из Узел Цикл
			ИзвлечьСсылкиИзДерева(Элемент, ИмяБраузера, ПутьПапки, МассивЗакладок);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Запускает выбранный способ чтения закладок.
//
// Параметры:
//  Выбор - Неопределено, ЭлементСпискаЗначений - выбранный пункт; Неопределено при отмене.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Асинх Процедура ПослеВыбораСпособаЗакладокПанелька(Выбор, Контекст) Экспорт
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Выбор.Значение = "auto" Тогда
		Закладки = Ждать ПолучитьВсеЗакладкиБраузеров();
		ПоказатьИмпортируемыеЗакладкиПанелька(Закладки);
	Иначе
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.Заголовок = НСтр("ru = 'Выберите экспортированные закладки браузера'");
		Диалог.Фильтр = НСтр("ru = 'Закладки (*.html, *.htm, *.json)|*.html;*.htm;*.json|Все файлы|*.*'");
		Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаЗакладокПанелька", ЭтотОбъект));
	КонецЕсли;
КонецПроцедуры

// Читает выбранный файл закладок HTML или JSON.
//
// Параметры:
//  Файлы - Неопределено, Массив из Строка - выбранные полные пути; используется первый файл.
//  Контекст - Неопределено - дополнительные параметры оповещения не передаются и не используются.
&НаКлиенте
Процедура ПослеВыбораФайлаЗакладокПанелька(Файлы, Контекст) Экспорт
	Если Файлы = Неопределено Или Файлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(Файлы[0], КодировкаТекста.UTF8);
		Закладки = Новый Массив;
		Текст = Документ.ПолучитьТекст();
		Если Лев(СокрЛП(Текст), 1) = "{" Тогда
			ПрочитатьЗакладкиChromium(Файлы[0], "Файл закладок", Закладки, Истина);
		Иначе
			Закладки = ПрочитатьHTMLЗакладокПанелька(Текст);
		КонецЕсли;
		ПоказатьИмпортируемыеЗакладкиПанелька(Закладки);
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось загрузить закладки: %1'"), ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Открывает предварительный выбор импортируемых закладок.
&НаКлиенте
Процедура ПоказатьИмпортируемыеЗакладкиПанелька(Закладки)
	Если Закладки.Количество() = 0 Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'В файле не найдено закладок http / https.'"));
		Возврат;
	КонецЕсли;
	ПараметрыФормыВыбора = Новый Структура("РежимОтображения,ДанныеЗакладок", "ЗакладкиБраузеров", Закладки);
	ПараметрыФормыВыбора.Вставить("ПерсональнаяНастройкаПанелька", ПерсональнаяНастройкаПанелька);
	ОткрытьФорму(ИмяСоседнейФормыПанелька("ВыборОбъектовМетаданных"), ПараметрыФормыВыбора, ЭтотОбъект,,,,
		Новый ОписаниеОповещения("ПослеВыбораЗакладокБраузера", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Извлекает веб-ссылки из HTML-экспорта закладок.
&НаКлиенте
Функция ПрочитатьHTMLЗакладокПанелька(Текст)
	Результат = Новый Массив;
	Нижний = НРег(Текст);
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Начало = СтрНайти(Нижний, "<a ", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		КонецТега = СтрНайти(Текст, ">", НаправлениеПоиска.СНачала, Начало);
		КонецСсылки = СтрНайти(Нижний, "</a>", НаправлениеПоиска.СНачала, Начало);
		Если КонецТега = 0 Или КонецСсылки = 0 Тогда
			Прервать;
		КонецЕсли;
		Тег = Сред(Текст, Начало, КонецТега - Начало);
		Позиция = КонецСсылки + 4;
		Атрибут = СтрНайти(НРег(Тег), "href=");
		Если Атрибут = 0 Тогда
			Продолжить;
		КонецЕсли;
		Кавычка = Сред(Тег, Атрибут + 5, 1);
		Если Кавычка <> """" И Кавычка <> "'" Тогда
			Продолжить;
		КонецЕсли;
		КонецАдреса = СтрНайти(Тег, Кавычка, НаправлениеПоиска.СНачала, Атрибут + 6);
		Если КонецАдреса = 0 Тогда
			Продолжить;
		КонецЕсли;
		Адрес = ДекодироватьТекстЗакладкиПанелька(Сред(Тег, Атрибут + 6, КонецАдреса - Атрибут - 6));
		Если Лев(НРег(Адрес), 7) <> "http://" И Лев(НРег(Адрес), 8) <> "https://" Тогда
			Продолжить;
		КонецЕсли;
		Название = ДекодироватьТекстЗакладкиПанелька(Сред(Текст, КонецТега + 1, КонецСсылки - КонецТега - 1));
		Закладка = Новый Структура;
		Закладка.Вставить("Наименование", Название);
		Закладка.Вставить("Ссылка", Адрес);
		Закладка.Вставить("Браузер", "Файл закладок");
		Закладка.Вставить("Папка", "Импорт");
		Результат.Добавить(Закладка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Декодирует поддерживаемые HTML-сущности в тексте закладки.
&НаКлиенте
Функция ДекодироватьТекстЗакладкиПанелька(Текст)
	Текст = СтрЗаменить(Текст, "&quot;", """");
	Текст = СтрЗаменить(Текст, "&#39;", "'");
	Текст = СтрЗаменить(Текст, "&lt;", "<");
	Текст = СтрЗаменить(Текст, "&gt;", ">");
	Возврат СтрЗаменить(Текст, "&amp;", "&");
КонецФункции

#КонецОбласти

#Область КонтрольДоступа

// Проверяет платформенное право администрирования перед работой с общими настройками.
&НаСервере
Процедура ПроверитьПравоНастройкиПанелька()
	Если ПерсональнаяНастройкаПанелька Тогда
		Обработка = РеквизитФормыВЗначение("Объект");
		Обработка.ПанелькаПроверитьПравоЛичнойПанели();
		Возврат;
	КонецЕсли;
	// Проверка платформенного права не зависит от названий ролей конфигурации.
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru = 'Изменять общие настройки Панелька может только администратор информационной базы.'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ЧерновикИКонтекстHTML

// Читает несохранённый черновик из текущего HTML-документа.
&НаКлиенте
Функция ПрочитатьЧерновикHTMLПанелька()
	Если Не РежимHTMLНастроек Тогда
		Возврат "";
	КонецЕсли;
	ДокументHTML = Элементы.ПолеHTMLНастроек.Документ;
	Если ДокументHTML = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Web-интерфейс ещё загружается.'");
	КонецЕсли;
	ПолеЧерновика = ДокументHTML.getElementById("panelkaEditorDraft");
	Если ПолеЧерновика = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Редактор Web-интерфейса ещё не готов.'");
	КонецЕсли;
	Возврат Строка(ПолеЧерновика.value);
КонецФункции

// Применяет HTML-черновик и сообщает об ошибке без потери введённого текста.
&НаКлиенте
Функция ПрименитьЧерновикHTMLПанелька()
	Попытка
		Черновик = ПрочитатьЧерновикHTMLПанелька();
		Если Не ПустаяСтрока(Черновик) Тогда
			ПрименитьСтрокуЧерновикаHTMLПанелька(Черновик);
		КонецЕсли;
		Возврат Истина;
	Исключение
		HTMLНастройкиОшибкаКомандыМоста = Истина;
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Разбирает адрес черновика и передаёт его на сервер.
&НаКлиенте
Процедура ПрименитьСтрокуЧерновикаHTMLПанелька(Черновик)
	Вопрос = СтрНайти(Черновик, "?");
	Если Вопрос = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный черновик Web-интерфейса.'");
	КонецЕсли;
	ПараметрыЧерновика = РазобратьПараметрыHTMLНастроек(Сред(Черновик, Вопрос + 1));
	ПрименитьЧерновикHTMLНаСервереПанелька(ПараметрыЧерновика);
КонецПроцедуры

// Проверяет доступ и применяет свойства HTML-черновика к модели.
&НаСервере
Процедура ПрименитьЧерновикHTMLНаСервереПанелька(ПараметрыЧерновика)
	ПроверитьПравоНастройкиПанелька();
	Вид = ПолучитьПараметрHTMLНастроек(ПараметрыЧерновика, "kind", "");
	Если Вид = "Link" Тогда
		ВыполнитьДействиеМодели("apply_link_details", ПараметрыЧерновика);
	ИначеЕсли Вид = "Page" Или Вид = "Column" Тогда
		Таблица = ?(Вид = "Page", ТаблицаСтраниц, ТаблицаКолонок);
		Поле = ?(Вид = "Page", "ИмяСтраницы", "ИмяКолонки");
		СтрокаМодели = НайтиСтрокуМодели(Таблица, "ИД", ПолучитьПараметрHTMLНастроек(ПараметрыЧерновика, "id", ""));
		Если СтрокаМодели = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Редактируемый элемент больше не существует.'");
		КонецЕсли;
		Если ЭтоСистемныйИД(СтрокаМодели.ИД) Тогда
			Возврат;
		КонецЕсли;
		СтраницаИмя = ПолучитьПараметрHTMLНастроек(ПараметрыЧерновика, "page", "");
		ИзменитьСтруктуруМодели(?(Вид = "Page", "page", "column"), ?(Вид = "Column", СтрокаМодели.ИД,
			СтрокаМодели[Поле]),
			ПолучитьПараметрHTMLНастроек(ПараметрыЧерновика, "name", ""), СтраницаИмя);
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестный вид редактора Web-интерфейса.'");
	КонецЕсли;
КонецПроцедуры

// Согласует имена объектов команды с устойчивыми идентификаторами после переименования.
&НаСервере
Функция СогласоватьАдресаКомандыHTMLПанелька(ПараметрыКомандыHTML)
	Для Каждого Вид Из СтрРазделить("page,column", ",") Цикл
		ИД = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, Вид + "Id", "");
		Если ПустаяСтрока(ИД) Тогда
			Продолжить;
		КонецЕсли;
		Таблица = ?(Вид = "page", ТаблицаСтраниц, ТаблицаКолонок);
		Поле = ?(Вид = "page", "ИмяСтраницы", "ИмяКолонки");
		СтрокаМодели = НайтиСтрокуМодели(Таблица, "ИД", ИД);
		Если СтрокаМодели = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Элемент структуры больше не существует.'");
		КонецЕсли;
		ПараметрыКомандыHTML.Вставить(Вид, ?(Вид = "column", СтрокаМодели.ИД, СтрокаМодели[Поле]));
	КонецЦикла;
	Вид = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "kind", "");
	ИД = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "objectId", "");
	Если Не ПустаяСтрока(ИД) И (Вид = "page" Или Вид = "column") Тогда
		Таблица = ?(Вид = "page", ТаблицаСтраниц, ТаблицаКолонок);
		Поле = ?(Вид = "page", "ИмяСтраницы", "ИмяКолонки");
		СтрокаМодели = НайтиСтрокуМодели(Таблица, "ИД", ИД);
		Если СтрокаМодели = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Элемент структуры больше не существует.'");
		КонецЕсли;
		ПараметрыКомандыHTML.Вставить("name", ?(Вид = "column", СтрокаМодели.ИД, СтрокаМодели[Поле]));
		ПараметрыКомандыHTML.Вставить("old", ?(Вид = "column", СтрокаМодели.ИД, СтрокаМодели[Поле]));
	КонецЕсли;
	Возврат ПараметрыКомандыHTML;
КонецФункции

// Читает и ограничивает значение прокрутки из параметров HTML-команды.
&НаКлиенте
Функция ПрокруткаHTMLПанелька(ПараметрыКомандыHTML, Имя)
	Попытка
		Возврат Макс(0, Мин(10000000, Число(ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, Имя, "0"))));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Согласует серверный контекст с локальным выбором Web-интерфейса.
&НаСервере
Процедура ПринятьВыборHTMLПанелька(ПараметрыКомандыHTML)
	// Категория могла переключиться локально из кэша текущего HTML-документа.
	РежимИсточника = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "__sourceMode", "");
	Если РежимИсточника = "metadata" Тогда
		HTMLНастройкиТипИсточника = РежимИсточника;
		HTMLНастройкиКатегорияМетаданных = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML,
			"__metadataGroup", HTMLНастройкиКатегорияМетаданных);
	КонецЕсли;
	СтраницаИД = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "__activePageId", "");
	КолонкаИД = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "__activeColumnId", "");
	Страница = НайтиСтрокуМодели(ТаблицаСтраниц, "ИД", СтраницаИД);
	Колонка = НайтиСтрокуМодели(ТаблицаКолонок, "ИД", КолонкаИД);
	Если Страница <> Неопределено Тогда
		HTMLНастройкиАктивнаяСтраница = Страница.ИмяСтраницы;
	КонецЕсли;
	HTMLНастройкиАктивнаяКолонка = ?(Колонка = Неопределено, "", Колонка.ИД);
	Вид = ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML, "__selectedKind", "");
	Если Вид = "Link" Тогда
		Размещение = НайтиСтрокуМодели(ТаблицаРазмещений, "ИД", ПолучитьПараметрHTMLНастроек(ПараметрыКомандыHTML,
			"__placementId", ""));
		Если Размещение <> Неопределено Тогда
			ВыбранныйТип = "Link";
			ВыбранноеРазмещениеИД = Размещение.ИД;
			ВыбраннаяСсылкаИД = Размещение.ИДСсылки;
		КонецЕсли;
	ИначеЕсли Вид = "Page" Или Вид = "Column" Тогда
		ВыбранныйТип = Вид;
		ВыбраннаяСсылкаИД = "";
		ВыбранноеРазмещениеИД = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПроверкаМодели

// Предотвращает неоднозначное представление стандартных инструментов на отдельной вкладке.
&НаСервере
Процедура ПроверитьСтандартныеРазмещенияПанелька()
	Если Не СтандартныеНаОтдельнойВкладке Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Ссылка Из ТаблицаСсылок Цикл
		Если Ссылка.Источник <> "objects" Или Лев(Ссылка.Ссылка, 8) <> "sys_cmd:" Тогда
			Продолжить;
		КонецЕсли;
		Если ТаблицаРазмещений.НайтиСтроки(Новый Структура("ИДСсылки", Ссылка.ИД)).Количество() > 1 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'У стандартного инструмента «%1» несколько размещений. Оставьте одно или отключите отдельную вкладку стандартных инструментов: дашборд показывает на ней только одно представление.'"), Ссылка.Наименование);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ИдентификацияКолонок

// Возвращает название активной колонки для надписей интерфейса.
&НаКлиентеНаСервереБезКонтекста
Функция ИмяКолонкиПанелька(ТаблицаКолонок, HTMLНастройкиАктивнаяКолонка)
	Колонка = НайтиСтрокуМодели(ТаблицаКолонок, "ИмяКолонки", HTMLНастройкиАктивнаяКолонка);
	Возврат ?(Колонка = Неопределено, "", Колонка.ИмяКолонки);
КонецФункции

// Уникальность названия ограничена страницей. Идентификатор исключает текущую колонку.
&НаКлиентеНаСервереБезКонтекста
Функция НайтиКолонкуНаСтраницеПанелька(Колонки, СтраницаИД, Название, ИсключитьИД = "")
	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.ИДСтраницы = СтраницаИД И Колонка.ИД <> ИсключитьИД
			И НРег(СокрЛП(Колонка.ИмяКолонки)) = НРег(СокрЛП(Название)) Тогда
			Возврат Колонка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область ХранениеПерсональнойПанели

// Сравнение снимка не позволяет последовательно открытым редакторам затереть чужое сохранение.
&НаСервере
Процедура ЗаписатьПерсональнуюПанельПанелька(Данные)
	Обработка = РеквизитФормыВЗначение("Объект");
	КонтекстСохранения = Новый Структура;
	КонтекстСохранения.Вставить("СнимокВидимости", СнимокВидимостиЛичнойПанелиПанелька);
	КонтекстСохранения.Вставить("Заменить", ЗаменитьЛичнуюПанельПанелька);
	КонтекстСохранения.Вставить("ИсточникСоздания", ИсточникЛичнойПанелиПанелька);
	КонтекстСохранения.Вставить("РевизияОбщей", РевизияОбщейПанелиПанелька);
	Результат = Обработка.ПанелькаСохранитьЛичнуюПанель(Данные, СнимокХранилищаПанелька, КонтекстСохранения);
	// Основания редактора меняются только после успешного завершения всех проверок и записи.
	СнимокХранилищаПанелька = Результат.Профиль.Ревизия;
	СнимокВидимостиЛичнойПанелиПанелька = Результат.СнимокВидимости;
	ЗаменитьЛичнуюПанельПанелька = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаменыЛичнойПанелиПанелька(Ответ, Контекст) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьОбщуюВЛичнуюПанельПанелька();
	ОбновитьОбычнуюФорму();
	ОбновитьHTMLНастроекЕслиНужно();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОбщуюВЛичнуюПанельПанелька()
	Если Не ПерсональнаяНастройкаПанелька Тогда
		ВызватьИсключение НСтр("ru = 'Команда доступна только для персональной панели.'");
	КонецЕсли;
	ПроверитьПравоНастройкиПанелька();
	Обработка = РеквизитФормыВЗначение("Объект");
	Данные = ПанелькаОбщиеНастройкиПрочитать();
	ЗагрузитьМодельВФорму(Обработка.ПанелькаПодготовитьМодельРедактора(Данные));
	ЗаменитьЛичнуюПанельПанелька = Истина;
	ИсточникЛичнойПанелиПанелька = "common";
	РевизияОбщейПанелиПанелька = "";
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство("РевизияПанелька", РевизияОбщейПанелиПанелька);
	КонецЕсли;
	НастройкиИзменены = Истина;
КонецПроцедуры

#КонецОбласти

#Область ДоступностьЛичныхИсточников

&НаСервере
Функция ПолитикаИсточниковРедактораПанелька(КонтекстДоступа = Неопределено)
	Обработка = РеквизитФормыВЗначение("Объект");
	Если ПерсональнаяНастройкаПанелька Тогда
		Если КонтекстДоступа = Неопределено Тогда
			КонтекстДоступа = Обработка.ПанелькаКонтекстДоступаЛичнойПанели();
		КонецЕсли;
		Политика = Новый Структура;
		Для Каждого Параметр Из КонтекстДоступа.Политика Цикл
			Политика.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	Иначе
		Политика = Обработка.ПанелькаНоваяПолитикаИсточниковЛичныхПанелей();
	КонецЕсли;
	Политика.СтандартныеИнструменты = Политика.СтандартныеИнструменты
		И ПравоДоступа("ИнтерактивноеОткрытиеВнешнихОбработок", Метаданные);
	Политика.ЛокальныеФайлы = Политика.ЛокальныеФайлы И МаскиВнешнихФайловПанелька() <> "";
	Возврат Политика;
КонецФункции

&НаСервереБезКонтекста
Функция МаскиВнешнихФайловПанелька()
	Маски = Новый Массив;
	Если ПравоДоступа("ИнтерактивноеОткрытиеВнешнихОбработок", Метаданные) Тогда
		Маски.Добавить("*.epf");
	КонецЕсли;
	Если ПравоДоступа("ИнтерактивноеОткрытиеВнешнихОтчетов", Метаданные) Тогда
		Маски.Добавить("*.erf");
	КонецЕсли;
	Возврат СтрСоединить(Маски, ";");
КонецФункции

&НаСервере
Функция ИсточникРедактораРазрешенПанелька(Имя, Политика = Неопределено)
	Если Политика = Неопределено Тогда
		Политика = ПолитикаИсточниковРедактораПанелька();
	КонецЕсли;
	Если Имя = "files" Или Имя = "folder" Тогда
		Возврат Политика.ЛокальныеФайлы;
	КонецЕсли;
	Если Имя = "Стандартные инструменты" Или Имя = "standard" Тогда
		Возврат Политика.СтандартныеИнструменты;
	КонецЕсли;
	Если Не ПерсональнаяНастройкаПанелька Тогда
		Возврат Истина;
	КонецЕсли;
	Если Имя = "web" Или Имя = "browser" Тогда
		Возврат Политика.ВебСсылки;
	КонецЕсли;
	Если Имя = "extra" Или Имя = "Дополнительные отчёты и обработки" Тогда
		Возврат Политика.ДополнительныеОбработки;
	КонецЕсли;
	Если Имя = "Метаданные" Или Имя = "metadata" Или Имя = "Ещё источники" Тогда
		Категории = РеквизитФормыВЗначение("Объект").ПанелькаКатегорииМетаданныхЛичныхПанелей();
		Для Каждого Категория Из Категории Цикл
			Если Политика[Категория.Ключ] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Если Имя = "Ещё источники" Тогда
			Возврат Политика.ВебСсылки Или Политика.ЛокальныеФайлы Или Политика.ДополнительныеОбработки Или
				Политика.СтандартныеИнструменты;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция ПолучитьСписокИсточниковРедактораПанелька()
	Политика = ПолитикаИсточниковРедактораПанелька();
	Список = Новый СписокЗначений;
	Для Каждого Имя Из СтрРазделить("Метаданные,Стандартные инструменты,Избранное,Открытые окна,Каталог панели,Дополнительные отчёты и обработки,Ещё источники", ",") Цикл
		Если ИсточникРедактораРазрешенПанелька(Имя, Политика) Тогда
			Список.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;
КонецФункции

&НаСервере
Процедура УстановитьВыборКатегорийЛичныхПанелейПанелька(Выбраны)
	Если ПерсональнаяНастройкаПанелька Тогда
		ВызватьИсключение НСтр("ru = 'Политика источников доступна только в общих настройках.'");
	КонецЕсли;
	ПроверитьПравоНастройкиПанелька();
	Категории = РеквизитФормыВЗначение("Объект").ПанелькаКатегорииМетаданныхЛичныхПанелей();
	Для Каждого Категория Из Категории Цикл
		ЭтотОбъект["ЛичныеРазрешить" + Категория.Ключ] = Выбраны;
	КонецЦикла;
	НастройкиИзменены = Истина;
КонецПроцедуры

// Единая фильтрация для каталога, избранного и открытых окон обоих интерфейсов.
&НаСервере
Функция ОтфильтроватьЛичныеИсточникиПанелька(Источники, КонтекстДоступа = Неопределено)
	Если ПерсональнаяНастройкаПанелька Тогда
		Обработка = РеквизитФормыВЗначение("Объект");
		Если КонтекстДоступа = Неопределено Тогда
			КонтекстДоступа = Обработка.ПанелькаКонтекстДоступаЛичнойПанели();
		КонецЕсли;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Источник Из Источники Цикл
		ВидИсточника = "";
		Источник.Свойство("Source", ВидИсточника);
		Если Не ЕстьПравоДобавленияИнструментаПанелька(ВидИсточника, НРег(СокрЛП(Источник.Url))) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПерсональнаяНастройкаПанелька Или Обработка.ПанелькаСсылкаДоступнаЛично(
			Источник.Url, ВидИсточника, Неопределено, Неопределено, КонтекстДоступа) Тогда
			Результат.Добавить(Источник);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контекст действует только в пределах текущей пакетной операции.
&НаСервере
Функция ПолучитьКонтекстДоступаРедактораПанелька()
	Если Не ПерсональнаяНастройкаПанелька Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат РеквизитФормыВЗначение("Объект").ПанелькаКонтекстДоступаЛичнойПанели();
КонецФункции

#КонецОбласти

#Область АдминистрированиеПерсональныхПанелей

&НаКлиенте
Процедура ОткрытьЭкспортПерсональнойПанелиПанелька(Панель)
	Попытка
		ТекстXML = АдминПанелиЭкспортНаСервере(Панель.ИмяПользователя, Панель.Ревизия);
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = СтрШаблон(НСтр("ru = 'Экспорт панели пользователя «%1»'"), Панель.Пользователь);
	Диалог.Фильтр = НСтр("ru = 'Настройки XML (*.xml)|*.xml'");
	Диалог.Расширение = "xml";
	Диалог.ПолноеИмяФайла = "Персональная панель Панелька.xml";
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаЭкспортаПанелька", ЭтотОбъект, ТекстXML));
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьУдалениеПерсональнойПанелиПанелька(Панель)
	ПоказатьВопрос(Новый ОписаниеОповещения("АдминПанелиПослеПодтвержденияУдаления", ЭтотОбъект, Панель),
		СтрШаблон(НСтр("ru = 'Удалить персональную панель пользователя «%1»?%2Будет использоваться общая панель. Удаление выполняется сразу; восстановление не предусмотрено.'"), Панель.Пользователь, Символы.ПС),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
КонецПроцедуры

// Обновляет список панелей и доступность административных команд.
&НаКлиенте
Процедура ОбновитьСписокПерсональныхПанелейПанелька()
	ЗакрытьПросмотрПерсональнойПанелиПанелька();
	Попытка
		АдминПанелиОбновитьНаСервере();
	Исключение
		// Не оставляем устаревшие строки и команды после ошибки доступа/чтения.
		ПерсональныеПанелиАдминПанелька.Очистить();
		СостояниеСпискаПерсональныхПанелейПанелька = СтрШаблон(НСтр("ru = 'Не удалось обновить список. %1'"),
			ОписаниеОшибки());
	КонецПопытки;
	ОбновитьКомандыСпискаПерсональныхПанелейПанелька();
КонецПроцедуры

// Согласует административные команды с текущей строкой списка.
&НаКлиенте
Процедура ОбновитьКомандыСпискаПерсональныхПанелейПанелька()
	Выбрана = Элементы.СписокПерсональныхПанелейПанелька.ТекущиеДанные <> Неопределено;
	Элементы.АдминПанелиПросмотреть.Доступность = Выбрана;
	Элементы.АдминПанелиЭкспортировать.Доступность = Выбрана;
	Элементы.АдминПанелиУдалить.Доступность = Выбрана;
	ЗакрытьПросмотрПерсональнойПанелиПанелька();
КонецПроцедуры

// Закрывает просмотр чужой панели и очищает его данные.
&НаКлиенте
Процедура ЗакрытьПросмотрПерсональнойПанелиПанелька()
	Элементы.ГруппаПросмотраПерсональнойПанелиПанелька.Видимость = Ложь;
	СоставПерсональнойПанелиАдминПанелька.ПолучитьЭлементы().Очистить();
	ЗаголовокПросмотраПерсональнойПанелиПанелька = "";
КонецПроцедуры

&НаСервере
Процедура АдминПанелиОбновитьНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ПанелькаСписокПерсональныхПанелей();
	ЗначениеВРеквизитФормы(Результат.Панели, "ПерсональныеПанелиАдминПанелька");
	СостояниеСпискаПерсональныхПанелейПанелька = СтрШаблон(НСтр("ru = 'Сохранённых панелей: %1. Даты старых панелей могут быть неизвестны. Удаление выполняется сразу после подтверждения.'"), Строка(Результат.Панели.Количество()));
	Если Результат.Пропущено > 0 Тогда
		СостояниеСпискаПерсональныхПанелейПанелька = СтрШаблон(НСтр("ru = '%1 Не удалось прочитать панелей: %2. Их данные не изменены.'"), СостояниеСпискаПерсональныхПанелейПанелька, Строка(Результат.Пропущено));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция АдминПанелиВыбраннаяПанель()
	Стр = Элементы.СписокПерсональныхПанелейПанелька.ТекущиеДанные;
	Если Стр = Неопределено Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Выберите персональную панель в списке.'"));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("ИмяПользователя,Пользователь,Ревизия", Стр.ИмяПользователя, Стр.Пользователь, Стр.Ревизия);
КонецФункции

&НаСервере
Процедура АдминПанелиПросмотретьНаСервере(ИмяПользователя, Ревизия)
	Обработка = РеквизитФормыВЗначение("Объект");
	Состав = Обработка.ПанелькаАдминСоставПанели(ИмяПользователя, Ревизия);
	ЗначениеВРеквизитФормы(Состав, "СоставПерсональнойПанелиАдминПанелька");
КонецПроцедуры

&НаСервере
Функция АдминПанелиЭкспортНаСервере(ИмяПользователя, Ревизия)
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПанелькаАдминЭкспортПанели(ИмяПользователя, Ревизия);
КонецФункции

&НаКлиенте
Процедура АдминПанелиПослеПодтвержденияУдаления(Ответ, Панель) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		АдминПанелиУдалитьНаСервере(Панель.ИмяПользователя, Панель.Ревизия);
	Исключение
		СообщитьПользователюПанелька(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Если Панель.Свойство("Web") Тогда
		Попытка
			ПередатьДопНастройкиHTMLПанелька(ОтветДопНастроекHTMLПанелька("profiles"));
		Исключение
			СообщитьПользователюПанелька(ОписаниеОшибки());
		КонецПопытки;
	Иначе
		ОбновитьСписокПерсональныхПанелейПанелька();
	КонецЕсли;
	СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Персональная панель пользователя «%1» удалена.'"), Панель.Пользователь));
КонецПроцедуры

&НаСервере
Процедура АдминПанелиУдалитьНаСервере(ИмяПользователя, Ревизия)
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПанелькаАдминУдалитьПанель(ИмяПользователя, Ревизия);
КонецПроцедуры

#КонецОбласти

#КонецОбласти
