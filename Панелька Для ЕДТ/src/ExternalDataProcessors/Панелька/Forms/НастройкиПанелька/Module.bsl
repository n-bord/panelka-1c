// Обрабатывает выбор строки таблицы размещений.
&НаКлиенте
Процедура РазмещениеПриВыборе(Элемент)
	// Изменение отбора справа при работе в дереве не является выбором пользователя.
	Если ТекущийЭлемент <> Элементы.Размещения Тогда
		Возврат;
	КонецЕсли;
	Если МножественныйВыборПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Если ОбычныйИнтерфейсОбновляется Тогда
		Возврат;
	КонецЕсли;
	Стр = Элемент.ТекущиеДанные;
	Если Стр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИдентификаторРазмещения = Стр.ИД;
	Если ИдентификаторРазмещения = ВыбранноеРазмещениеИД Тогда
		Возврат;
	КонецЕсли;
	Если Не ПрименитьОбычныйРедактор() Тогда
		ОбычныйИнтерфейсОбновляется = Истина;
		СинхронизироватьВыборРазмещения();
		ОбычныйИнтерфейсОбновляется = Ложь;
		Возврат;
	КонецЕсли;
	ВыбранноеРазмещениеИД = ИдентификаторРазмещения;
	СогласоватьВыборСРазмещением();
	ОбновитьОбычнуюФорму();
КонецПроцедуры

