	Если Не ПрименитьОбычныйРедактор() Тогда
		Возврат;
	КонецЕсли;
	Контекст = Новый Структура("Вид,Имя", ВыбранныйТип, ?(ВыбранныйТип = "Page", HTMLНастройкиАктивнаяСтраница,
		HTMLНастройкиАктивнаяКолонка));
	ТаблицаСтруктуры = ?(Контекст.Вид = "Page", ТаблицаСтраниц, ТаблицаКолонок);
	Поле = ?(Контекст.Вид = "Page", "ИмяСтраницы", "ИмяКолонки");
	СтрокаСтруктуры = НайтиСтрокуМодели(ТаблицаСтруктуры, Поле, Контекст.Имя);
	Если СтрокаСтруктуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыВыбора = Новый Структура("ТекущееИмя", СтрокаСтруктуры.ИмяКартинки);
	ОткрытьФорму(ИмяСоседнейФормыПанелька("ВыборКартинкиПанелька"), ПараметрыВыбора, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеВыбораКартинкиV3", ЭтотОбъект, Контекст),
