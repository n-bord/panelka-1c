#Область ОбработчикиСобытийФормы

// Настраивает внешний вид формы выбора и заполняет дерево объектов.
// Неключевые параметры формы объявлены без ограничения типа в XML.
// Фактические типы передаваемых значений и значения по умолчанию:
//  РежимОтображения - Строка, Неопределено - Метаданные по умолчанию; также ДопОбработкиБСП,
//   СтандартныеИнструменты, ЗакладкиБраузеров, Избранное, ОткрытыеВкладки, ВыборРолей или ВыборКолонок.
//  ОткрытыеОкна - СписокЗначений, Неопределено - ссылки и представления открытых окон;
//   при отсутствии в режиме ОткрытыеВкладки дерево остаётся пустым.
//  РежимФильтра - Строка, Неопределено - ТолькоОбъекты, БезОбъектов или Все;
//   отсутствие параметра в режиме Избранное означает отбор всех ссылок.
//  ДанныеЗакладок - Массив из Структура, Неопределено - закладки с полями Браузер, Папка,
//   Наименование и Ссылка; при отсутствии в режиме ЗакладкиБраузеров дерево остаётся пустым.
//  ТекущиеВыбранные - Строка, Неопределено - имена ролей или колонок через запятую;
//   при отсутствии ни одна строка режимов ВыборРолей и ВыборКолонок не отмечена.
//  ДоступныеКолонки - Массив из Строка, Неопределено - имена колонок для режима ВыборКолонок;
//   при отсутствии список колонок пуст.
//  ПерсональнаяНастройкаПанелька - Булево, Неопределено - применять политику личной панели к ссылкам;
//   отсутствие параметра и Неопределено означают Ложь. Роли и колонки не фильтруются этой политикой.
//
// Параметры:
//  Отказ - Булево - признак отмены стандартной обработки.
//  СтандартнаяОбработка - Булево - признак выполнения стандартной обработки.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РежимВыбораПанелька = "Метаданные";
	Если Параметры.РежимОтображения <> Неопределено Тогда
		РежимВыбораПанелька = Параметры.РежимОтображения;
	КонецЕсли;
	РежимОтображения = РежимВыбораПанелька;
	Если РежимОтображения = "ДопОбработкиБСП" Тогда
		Заголовок = НСтр("ru = 'Выберите доп. отчеты и обработки (Панелька)'");
	ИначеЕсли РежимОтображения = "СтандартныеИнструменты" Тогда
		Заголовок = НСтр("ru = 'Выберите стандартные инструменты (Панелька)'");
	ИначеЕсли РежимОтображения = "ЗакладкиБраузеров" Тогда
		Заголовок = НСтр("ru = 'Выберите веб-ссылку (Панелька)'");
	ИначеЕсли РежимОтображения = "Избранное" Тогда
		Заголовок = НСтр("ru = 'Выберите объект из избранного (Панелька)'");
	ИначеЕсли РежимОтображения = "ОткрытыеВкладки" Тогда
		Заголовок = НСтр("ru = 'Выберите открытую вкладку (Панелька)'");
	ИначеЕсли РежимОтображения = "ВыборРолей" Тогда
		Заголовок = НСтр("ru = 'Отметьте роли доступа (Панелька)'");
	ИначеЕсли РежимОтображения = "ВыборКолонок" Тогда
		Заголовок = НСтр("ru = 'Отметьте колонки (Панелька)'");
	Иначе
		Заголовок = НСтр("ru = 'Выберите объект системы (Панелька)'");
	КонецЕсли;
	Если РежимОтображения = "ВыборРолей" Или РежимОтображения = "ВыборКолонок" Тогда
		Элементы.ДеревоОбъектов.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	КонецЕсли;
	ЗаполнитьДеревоНаСервере();
	ПереместитьДопОбъектыВКонецДерева();
КонецПроцедуры

// Раскрывает необходимые уровни дерева после открытия формы.
//
// Параметры:
//  Отказ - Булево - признак отмены стандартной обработки.
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	РежимОтображения = РежимВыбораПанелька;
	Если РежимОтображения <> "Метаданные" Тогда
		Для Каждого Эл Из ДеревоОбъектов.ПолучитьЭлементы() Цикл
			Элементы.ДеревоОбъектов.Развернуть(Эл.ПолучитьИдентификатор(), Истина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОбъектов

// Обрабатывает изменение пометки строки и синхронизирует дочерние и родительские строки.
//
// Параметры:
//  Элемент - ПолеФормы - поле пометки строки дерева, вызвавшее событие.
&НаКлиенте
Процедура ДеревоОбъектовПометкаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДеревоОбъектов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ЭтоГруппа Тогда
		УстановитьПометкуПодчиненных(ТекущиеДанные, ТекущиеДанные.Пометка);
	КонецЕсли;
	ОбновитьПометкуРодителя(ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Собирает отмеченные строки дерева и возвращает результат вызывающей форме.
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
&НаКлиенте
Процедура КомандаВыбрать(Команда)
	МассивВыбранных = Новый Массив;
	СобратьОтмеченныеСтроки(ДеревоОбъектов.ПолучитьЭлементы(), МассивВыбранных);
	Если МассивВыбранных.Количество() = 0
		И РежимВыбораПанелька <> "ВыборРолей" И РежимВыбораПанелька <> "ВыборКолонок" Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Вы не выбрали ни одного объекта.'"));
		Возврат;
	КонецЕсли;
	Закрыть(МассивВыбранных);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение пользователю через платформенный объект без зависимости от БСП.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения, включая переводы строк и локализованные подписи.
&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователюПанелька(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
КонецПроцедуры

#Область ПостроениеДерева

// Формирует дерево выбора в зависимости от переданного режима.
&НаСервере
Процедура ЗаполнитьДеревоНаСервере()
	ДеревоЗнач = РеквизитФормыВЗначение("ДеревоОбъектов");
	ДеревоЗнач.Строки.Очистить();
	РежимОтображения = РежимВыбораПанелька;
	ЛичныйВыбор = ЭтоЛичныйВыборПанелька();
	КонтекстДоступа = Неопределено;
	Если ЛичныйВыбор И РежимОтображения <> "ВыборРолей" И РежимОтображения <> "ВыборКолонок" Тогда
		КонтекстДоступа = РеквизитФормыВЗначение("Объект").ПанелькаКонтекстДоступаЛичнойПанели();
	КонецЕсли;
	Если РежимОтображения = "ОткрытыеВкладки" Тогда
		Если Параметры.ОткрытыеОкна <> Неопределено Тогда
			ДобавитьСгруппированныеСсылки(ДеревоЗнач, Параметры.ОткрытыеОкна);
		КонецЕсли;
	ИначеЕсли РежимОтображения = "Избранное" Тогда
		РежимФильтра = Параметры.РежимФильтра;
		Если РежимФильтра = Неопределено Тогда
			РежимФильтра = "";
		КонецЕсли;
		ДобавитьСгруппированноеИзбранное(ДеревоЗнач, РежимФильтра);
	ИначеЕсли РежимОтображения = "ЗакладкиБраузеров" Тогда
		Если Параметры.ДанныеЗакладок <> Неопределено Тогда
			СгруппироватьЗакладкиВДерево(ДеревоЗнач, Параметры.ДанныеЗакладок);
		КонецЕсли;
	ИначеЕсли РежимОтображения = "ДопОбработкиБСП" Тогда
		ЗаполнитьДеревоДопОбработок(ДеревоЗнач, КонтекстДоступа);
	ИначеЕсли РежимОтображения = "СтандартныеИнструменты" Тогда
		ДобавитьВеткуПлатформы(ДеревоЗнач);
	ИначеЕсли РежимОтображения = "ВыборРолей" Тогда
		ЗаполнитьДеревоРолей(ДеревоЗнач);
	ИначеЕсли РежимОтображения = "ВыборКолонок" Тогда
		ЗаполнитьДеревоКолонок(ДеревоЗнач);
	ИначеЕсли РежимОтображения = "Метаданные" Тогда
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.Справочники, "Справочники", "e1cib/list/Справочник.",
			БиблиотекаКартинок.Справочник);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.Документы, "Документы", "e1cib/list/Документ.",
			БиблиотекаКартинок.Документ);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.ЖурналыДокументов, "Журналы документов",
			"e1cib/list/ЖурналДокументов.", БиблиотекаКартинок.ЖурналДокументов);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.Отчеты, "Отчеты", "e1cib/app/Отчет.", БиблиотекаКартинок.Отчет);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.Обработки, "Обработки", "e1cib/app/Обработка.",
			БиблиотекаКартинок.Обработка);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.ПланыВидовХарактеристик, "Планы видов характеристик",
			"e1cib/list/ПланВидовХарактеристик.", БиблиотекаКартинок.ПланВидовХарактеристик);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.ПланыСчетов, "Планы счетов", "e1cib/list/ПланСчетов.",
			БиблиотекаКартинок.ПланСчетов);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.ПланыВидовРасчета, "Планы видов расчета",
			"e1cib/list/ПланВидовРасчета.", БиблиотекаКартинок.ПланВидовРасчета);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.ПланыОбмена, "Планы обмена", "e1cib/list/ПланОбмена.",
			БиблиотекаКартинок.ПланОбмена);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.РегистрыСведений, "Регистры сведений",
			"e1cib/list/РегистрСведений.", БиблиотекаКартинок.РегистрСведений);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.РегистрыНакопления, "Регистры накопления",
			"e1cib/list/РегистрНакопления.", БиблиотекаКартинок.РегистрНакопления);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.РегистрыБухгалтерии, "Регистры бухгалтерии",
			"e1cib/list/РегистрБухгалтерии.", БиблиотекаКартинок.РегистрБухгалтерии);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.РегистрыРасчета, "Регистры расчета",
			"e1cib/list/РегистрРасчета.", БиблиотекаКартинок.РегистрРасчета);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.БизнесПроцессы, "Бизнес-процессы",
			"e1cib/list/БизнесПроцесс.", БиблиотекаКартинок.БизнесПроцесс);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.Задачи, "Задачи", "e1cib/list/Задача.",
			БиблиотекаКартинок.Задача);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.ОбщиеФормы, "Общие формы", "e1cib/app/ОбщаяФорма.",
			БиблиотекаКартинок.Форма);
		ДобавитьВеткуМетаданных(ДеревоЗнач, Метаданные.Константы, "Константы", "e1cib/data/Константа.",
			БиблиотекаКартинок.Константа);
		ДобавитьВеткуВИД(ДеревоЗнач);
		ДобавитьВеткуПлатформы(ДеревоЗнач);
	КонецЕсли;
	ЛичныйВыбор = ЭтоЛичныйВыборПанелька();
	Если ЛичныйВыбор И РежимОтображения <> "ВыборРолей" И РежимОтображения <> "ВыборКолонок" Тогда
		Обработка = РеквизитФормыВЗначение("Объект");
		ОтфильтроватьДеревоЛичногоВыбораПанелька(ДеревоЗнач.Строки, Обработка,
			КонтекстДоступа.Политика, КонтекстДоступа.ДоступныеДополнительные, КонтекстДоступа);
	КонецЕсли;
	ДеревоЗнач.Строки.Сортировать("Представление Возр");
	МассивКУдалению = Новый Массив;
	Для Каждого Стр Из ДеревоЗнач.Строки Цикл
		Если Стр.Строки.Количество() = 0 Тогда
			МассивКУдалению.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Эл Из МассивКУдалению Цикл
		ДеревоЗнач.Строки.Удалить(Эл);
	КонецЦикла;
	ЗначениеВДанныеФормы(ДеревоЗнач, ДеревоОбъектов);
КонецПроцедуры

// Заполняет дерево ролей конфигурации и расширений с учетом текущего выбора.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
&НаСервере
Процедура ЗаполнитьДеревоРолей(ДеревоЗнач)
	ТекущиеВыбранные = Параметры.ТекущиеВыбранные;
	МассивТекущих = СтрРазделить(?(ЗначениеЗаполнено(ТекущиеВыбранные), ТекущиеВыбранные, ""), ",");
	Для Индекс = 0 По МассивТекущих.ВГраница() Цикл
		МассивТекущих[Индекс] = СокрЛП(МассивТекущих[Индекс]);
	КонецЦикла;
	ВеткаКонфа = ДеревоЗнач.Строки.Добавить();
	ВеткаКонфа.Представление = "Роли конфигурации";
	ВеткаКонфа.ЭтоГруппа = Истина;
	Попытка
		ВеткаКонфа.Картинка = БиблиотекаКартинок.Пользователи;
	Исключение
	КонецПопытки;
	ВеткаРасширения = ДеревоЗнач.Строки.Добавить();
	ВеткаРасширения.Представление = "Роли расширений";
	ВеткаРасширения.ЭтоГруппа = Истина;
	Попытка
		ВеткаРасширения.Картинка = БиблиотекаКартинок.Пользователи;
	Исключение
	КонецПопытки;
	ХотяБыОдинПомеченКонфа = Ложь;
	ВсеПомеченыКонфа = Истина;
	ХотяБыОдинПомеченРасш = Ложь;
	ВсеПомеченыРасш = Истина;
	Для Каждого Роль Из Метаданные.Роли Цикл
		ЭтоРасширение = Ложь;
		ОбъектРасширения = Неопределено;
		Попытка
			ОбъектРасширения = Роль.РасширениеКонфигурации();
			ЭтоРасширение = (ОбъектРасширения <> Неопределено);
		Исключение
		КонецПопытки;
		ЦелеваяВетка = ?(ЭтоРасширение, ВеткаРасширения, ВеткаКонфа);
		НовСтр = ЦелеваяВетка.Строки.Добавить();
		НовСтр.Представление = ?(ЗначениеЗаполнено(Роль.Синоним), Роль.Синоним, Роль.Имя);
		Если ЭтоРасширение И ОбъектРасширения <> Неопределено Тогда
			НовСтр.Представление = НовСтр.Представление + " [" + ОбъектРасширения.Имя + "]";
		КонецЕсли;
		НовСтр.СсылкаНаОбъект = Роль.Имя;
		НовСтр.ЭтоГруппа = Ложь;
		Попытка
			НовСтр.Картинка = БиблиотекаКартинок.Пользователь;
		Исключение
		КонецПопытки;
		Если МассивТекущих.Найти(Роль.Имя) <> Неопределено Тогда
			НовСтр.Пометка = Истина;
			Если ЭтоРасширение Тогда
				ХотяБыОдинПомеченРасш = Истина;
			Иначе
				ХотяБыОдинПомеченКонфа = Истина;
			КонецЕсли;
		Иначе
			Если ЭтоРасширение Тогда
				ВсеПомеченыРасш = Ложь;
			Иначе
				ВсеПомеченыКонфа = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ВеткаКонфа.Пометка = ВсеПомеченыКонфа И ВеткаКонфа.Строки.Количество() > 0;
	ВеткаКонфа.ЕстьВыбранные = ХотяБыОдинПомеченКонфа;
	ВеткаКонфа.Строки.Сортировать("Представление Возр");
	ВеткаРасширения.Пометка = ВсеПомеченыРасш И ВеткаРасширения.Строки.Количество() > 0;
	ВеткаРасширения.ЕстьВыбранные = ХотяБыОдинПомеченРасш;
	ВеткаРасширения.Строки.Сортировать("Представление Возр");
	Если ВеткаРасширения.Строки.Количество() = 0 Тогда
		ДеревоЗнач.Строки.Удалить(ВеткаРасширения);
	КонецЕсли;
	Если ВеткаКонфа.Строки.Количество() = 0 Тогда
		ДеревоЗнач.Строки.Удалить(ВеткаКонфа);
	КонецЕсли;
КонецПроцедуры

// Формирует дерево доступных колонок панели для массового выбора.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
&НаСервере
Процедура ЗаполнитьДеревоКолонок(ДеревоЗнач)
	ТекущиеВыбранные = Параметры.ТекущиеВыбранные;
	ДоступныеКолонки = Новый Массив;
	Если Параметры.ДоступныеКолонки <> Неопределено Тогда
		ДоступныеКолонки = Параметры.ДоступныеКолонки;
	КонецЕсли;
	МассивТекущих = СтрРазделить(?(ЗначениеЗаполнено(ТекущиеВыбранные), ТекущиеВыбранные, ""), ",");
	Для Индекс = 0 По МассивТекущих.ВГраница() Цикл
		МассивТекущих[Индекс] = СокрЛП(МассивТекущих[Индекс]);
	КонецЦикла;
	Ветка = ДеревоЗнач.Строки.Добавить();
	Ветка.Представление = "Доступные колонки дашборда";
	Ветка.ЭтоГруппа = Истина;
	Попытка
		Ветка.Картинка = БиблиотекаКартинок.Реквизит;
	Исключение
	КонецПопытки;
	ВсеПомечены = Истина;
	ХотяБыОдинПомечен = Ложь;
	Для Каждого ИмяКолонки Из ДоступныеКолонки Цикл
		НовСтр = Ветка.Строки.Добавить();
		НовСтр.Представление = ИмяКолонки;
		НовСтр.СсылкаНаОбъект = ИмяКолонки;
		НовСтр.ЭтоГруппа = Ложь;
		Попытка
			НовСтр.Картинка = БиблиотекаКартинок.Реквизит;
		Исключение
		КонецПопытки;
		Если МассивТекущих.Найти(ИмяКолонки) <> Неопределено Тогда
			НовСтр.Пометка = Истина;
			ХотяБыОдинПомечен = Истина;
		Иначе
			ВсеПомечены = Ложь;
		КонецЕсли;
	КонецЦикла;
	Ветка.Пометка = ВсеПомечены И Ветка.Строки.Количество() > 0;
	Ветка.ЕстьВыбранные = ХотяБыОдинПомечен;
	Ветка.Строки.Сортировать("Представление Возр");
КонецПроцедуры

// Формирует дерево доступных дополнительных отчетов и обработок.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
//  КонтекстДоступа - Неопределено, Структура - контекст ПанелькаКонтекстДоступаЛичнойПанели; действует в одном серверном вызове.
&НаСервере
Процедура ЗаполнитьДеревоДопОбработок(ДеревоЗнач, КонтекстДоступа = Неопределено)
	Обработка = РеквизитФормыВЗначение("Объект");
	Доступные = Обработка.ПанелькаДоступныеДополнительныеИнструменты(ЭтоЛичныйВыборПанелька(), КонтекстДоступа);
	Если КонтекстДоступа <> Неопределено Тогда
		// Уже полученный список одновременно служит индексом проверки, без повторного запроса.
		КонтекстДоступа.ДоступныеДополнительные = Новый Соответствие;
		Для Каждого Инструмент Из Доступные.Источники Цикл
			Ключ = Обработка.ПанелькаКлючДополнительнойСсылки(Инструмент.Url);
			Если Не ПустаяСтрока(Ключ) Тогда
				КонтекстДоступа.ДоступныеДополнительные.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Сообщение Из Доступные.Сообщения Цикл
		СообщитьПользователюПанелька(Сообщение);
	КонецЦикла;
	КэшУзлов = Новый Соответствие;
	Для Каждого Инструмент Из Доступные.Источники Цикл
		Родитель = ДеревоЗнач;
		КлючПапки = Инструмент.Catalog + "|" + Инструмент.Folder;
		Если Не ПустаяСтрока(Инструмент.Folder) Тогда
			Папка = КэшУзлов.Получить(КлючПапки);
			Если Папка = Неопределено Тогда
				Папка = ДеревоЗнач.Строки.Добавить();
				Папка.Представление = Инструмент.Folder;
				Папка.ЭтоГруппа = Истина;
				Папка.Картинка = БиблиотекаКартинок.Папка;
				КэшУзлов.Вставить(КлючПапки, Папка);
			КонецЕсли;
			Родитель = Папка;
		КонецЕсли;
		ИмяВида = ?(Инструмент.Type = "Тип не определён", "Прочие", Инструмент.Type);
		КлючВида = КлючПапки + "|" + ИмяВида;
		УзелВида = КэшУзлов.Получить(КлючВида);
		Если УзелВида = Неопределено Тогда
			УзелВида = Родитель.Строки.Добавить();
			УзелВида.Представление = ИмяВида;
			УзелВида.ЭтоГруппа = Истина;
			УзелВида.Картинка = ?(Инструмент.Type = "Дополнительные отчеты", БиблиотекаКартинок.Отчет,
				БиблиотекаКартинок.Обработка);
			КэшУзлов.Вставить(КлючВида, УзелВида);
		КонецЕсли;
		Узел = УзелВида.Строки.Добавить();
		Узел.Представление = Инструмент.Name;
		Узел.СсылкаНаОбъект = Инструмент.Url;
		Узел.ЭтоГруппа = Ложь;
		Узел.Картинка = УзелВида.Картинка;
		Узел.Отключена = Инструмент.Disabled;
		Узел.Подсказка = Инструмент.Tooltip;
	КонецЦикла;
КонецПроцедуры

// Перестраивает порядок ветвей дерева, перенося дополнительные объекты в конец.
&НаСервере
Процедура ПереместитьДопОбъектыВКонецДерева()
	СтрокиДерева = ДеревоОбъектов.ПолучитьЭлементы();
	ИндексОбработок = -1;
	Для Индекс = 0 По СтрокиДерева.Количество() - 1 Цикл
		Если СтрокиДерева[Индекс].Представление = "Дополнительные обработки" Тогда
			ИндексОбработок = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИндексОбработок >= 0 Тогда
		СтрокиДерева.Сдвинуть(ИндексОбработок, СтрокиДерева.Количество() - 1 - ИндексОбработок);
	КонецЕсли;
	ИндексОтчетов = -1;
	Для Индекс = 0 По СтрокиДерева.Количество() - 1 Цикл
		Если СтрокиДерева[Индекс].Представление = "Дополнительные отчеты" Тогда
			ИндексОтчетов = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ИндексОтчетов >= 0 Тогда
		СтрокиДерева.Сдвинуть(ИндексОтчетов, СтрокиДерева.Количество() - 1 - ИндексОтчетов);
	КонецЕсли;
КонецПроцедуры

// Группирует импортированные закладки браузеров по браузеру и папкам.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
//  МассивЗакладок - Массив из Структура - подготовленные закладки:
//   * Браузер - Строка - имя браузера.
//   * Папка - Строка - путь папки закладки.
//   * Наименование - Строка - подпись закладки.
//   * Ссылка - Строка - URL закладки.
&НаСервере
Процедура СгруппироватьЗакладкиВДерево(ДеревоЗнач, МассивЗакладок)
	ВеткиБраузеров = Новый Соответствие;
	ВеткиПапок = Новый Соответствие;
	Для Каждого Закладка Из МассивЗакладок Цикл
		КлючБраузера = Закладка.Браузер;
		СтрокаБраузера = ВеткиБраузеров[КлючБраузера];
		Если СтрокаБраузера = Неопределено Тогда
			СтрокаБраузера = ДеревоЗнач.Строки.Добавить();
			СтрокаБраузера.Представление = Закладка.Браузер;
			СтрокаБраузера.ЭтоГруппа = Истина;
			Попытка
				СтрокаБраузера.Картинка = БиблиотекаКартинок.ВнешнийИсточникДанных;
			Исключение
				СтрокаБраузера.Картинка = БиблиотекаКартинок.Папка;
			КонецПопытки;
			ВеткиБраузеров.Вставить(КлючБраузера, СтрокаБраузера);
		КонецЕсли;
		КлючПапки = КлючБраузера + "|" + Закладка.Папка;
		СтрокаПапки = ВеткиПапок[КлючПапки];
		Если СтрокаПапки = Неопределено Тогда
			СтрокаПапки = СтрокаБраузера.Строки.Добавить();
			СтрокаПапки.Представление = Закладка.Папка;
			СтрокаПапки.ЭтоГруппа = Истина;
			СтрокаПапки.Картинка = БиблиотекаКартинок.Папка;
			ВеткиПапок.Вставить(КлючПапки, СтрокаПапки);
		КонецЕсли;
		НовСсылка = СтрокаПапки.Строки.Добавить();
		НовСсылка.Представление = Закладка.Наименование;
		НовСсылка.СсылкаНаОбъект = Закладка.Ссылка;
		НовСсылка.ЭтоГруппа = Ложь;
		НовСсылка.Картинка = БиблиотекаКартинок.ГеографическаяСхема;
	КонецЦикла;
КонецПроцедуры

// Добавляет список навигационных ссылок в дерево с группировкой.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
//  СписокЗначений - СписокЗначений из ЭлементСпискаЗначений - открытые окна:
//   * Значение - Строка - навигационная ссылка.
&НаСервере
Процедура ДобавитьСгруппированныеСсылки(ДеревоЗнач, СписокЗначений)
	Группы = Новый Соответствие;
	ОбъектФормы = Объект;
	Для Каждого Эл Из СписокЗначений Цикл
		ИмяГруппы = "";
		ИмяПодгруппы = "";
		Иконка = Неопределено;
		ОпределитьГруппыИИконку(Эл.Значение, ИмяГруппы, ИмяПодгруппы, Иконка, ОбъектФормы);
		СтруктураГруппы = Группы[ИмяГруппы];
		Если СтруктураГруппы = Неопределено Тогда
			СтруктураГруппы = Новый Структура("Иконка, Элементы, Подгруппы", Иконка, Новый Массив, Новый Соответствие);
			Группы.Вставить(ИмяГруппы, СтруктураГруппы);
		КонецЕсли;
		Если ПустаяСтрока(ИмяПодгруппы) Тогда
			СтруктураГруппы.Элементы.Добавить(Новый Структура("Представление, Ссылка", Эл.Представление, Эл.Значение));
		Иначе
			МассивПодгруппы = СтруктураГруппы.Подгруппы[ИмяПодгруппы];
			Если МассивПодгруппы = Неопределено Тогда
				МассивПодгруппы = Новый Массив;
				СтруктураГруппы.Подгруппы.Вставить(ИмяПодгруппы, МассивПодгруппы);
			КонецЕсли;
			МассивПодгруппы.Добавить(Новый Структура("Представление, Ссылка", Эл.Представление, Эл.Значение));
		КонецЕсли;
	КонецЦикла;
	ПостроитьВеткиИзГрупп(ДеревоЗнач, Группы);
КонецПроцедуры

// Формирует дерево из системного избранного с выбранным режимом фильтрации.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
//  РежимФильтра - Строка - режим отбора избранного.
&НаСервере
Процедура ДобавитьСгруппированноеИзбранное(ДеревоЗнач, РежимФильтра)
	Избранное = Неопределено;
	Попытка
		Избранное = ХранилищеСистемныхНастроек.Загрузить("Общее/ИзбранноеРаботыПользователя");
	Исключение
		ЗаписьЖурналаРегистрации(
			"ЕдиноеМеню.ЗагрузкаИзбранного",
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки()
			);
		Возврат;
	КонецПопытки;
	Если ТипЗнч(Избранное) <> Тип("ИзбранноеРаботыПользователя") Тогда
		Возврат;
	КонецЕсли;
	ПодготовленноеИзбранное = Новый Массив;
	СсылкиБезПредставления = Новый Массив;
	Для Каждого Элемент Из Избранное Цикл
		СсылкаТекст = СокрЛП(Элемент.НавигационнаяСсылка);
		Если ПустаяСтрока(СсылкаТекст) Тогда
			Продолжить;
		КонецЕсли;
		ЭтоКонкретныйОбъект = СтрНайти(СсылкаТекст, "e1cib/data/") > 0;
		Если РежимФильтра = "ТолькоОбъекты" И Не ЭтоКонкретныйОбъект Тогда
			Продолжить;
		ИначеЕсли РежимФильтра = "БезОбъектов" И ЭтоКонкретныйОбъект Тогда
			Продолжить;
		КонецЕсли;
		ПодготовленноеИзбранное.Добавить(Новый Структура("Ссылка, Представление", СсылкаТекст, Элемент.Представление));
		Если ЭтоКонкретныйОбъект И (ПустаяСтрока(Элемент.Представление)
			Или СтрНайти(Элемент.Представление, "<Объект не найден>") > 0) Тогда
			СсылкиБезПредставления.Добавить(СсылкаТекст);
		КонецЕсли;
	КонецЦикла;
	ПредставленияСсылок = ПолучитьПредставленияОбъектовДанныхПанелька(СсылкиБезПредставления);
	Группы = Новый Соответствие;
	ОбъектФормы = Объект;
	Для Каждого Элемент Из ПодготовленноеИзбранное Цикл
		СсылкаТекст = Элемент.Ссылка;
		ПредставлениеОбъекта = Элемент.Представление;
		Если ПустаяСтрока(ПредставлениеОбъекта) Или СтрНайти(ПредставлениеОбъекта, "<Объект не найден>") > 0 Тогда
			Если СтрНайти(СсылкаТекст, "e1cib/data/") > 0 Тогда
				ПредставлениеОбъекта = ПредставленияСсылок[СсылкаТекст];
			Иначе
				ПредставлениеОбъекта = ПолучитьИмяДляСсылкиПанелька(СсылкаТекст);
			КонецЕсли;
		КонецЕсли;
		ИмяГруппы = "";
		ИмяПодгруппы = "";
		Иконка = Неопределено;
		ОпределитьГруппыИИконку(СсылкаТекст, ИмяГруппы, ИмяПодгруппы, Иконка, ОбъектФормы);
		СтруктураГруппы = Группы[ИмяГруппы];
		Если СтруктураГруппы = Неопределено Тогда
			СтруктураГруппы = Новый Структура(
				"Иконка, Элементы, Подгруппы",
				Иконка,
				Новый Массив,
				Новый Соответствие
				);
			Группы.Вставить(ИмяГруппы, СтруктураГруппы);
		КонецЕсли;
		ДанныеЭлемента = Новый Структура(
			"Представление, Ссылка",
			ПредставлениеОбъекта,
			СсылкаТекст
			);
		Если ПустаяСтрока(ИмяПодгруппы) Тогда
			СтруктураГруппы.Элементы.Добавить(ДанныеЭлемента);
		Иначе
			МассивПодгруппы = СтруктураГруппы.Подгруппы[ИмяПодгруппы];
			Если МассивПодгруппы = Неопределено Тогда
				МассивПодгруппы = Новый Массив;
				СтруктураГруппы.Подгруппы.Вставить(ИмяПодгруппы, МассивПодгруппы);
			КонецЕсли;
			МассивПодгруппы.Добавить(ДанныеЭлемента);
		КонецЕсли;
	КонецЦикла;
	ПостроитьВеткиИзГрупп(ДеревоЗнач, Группы);
КонецПроцедуры

// Создает ветви дерева из подготовленной структуры групп.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
//  Группы - Соответствие из КлючИЗначение - подготовленные группы:
//   * Ключ - Строка - имя группы.
//   * Значение - Структура - данные группы:
//   ** Иконка - Картинка - картинка группы.
//   ** Элементы - Массив из Структура - ссылки без подгруппы:
//   *** Представление - Строка - подпись ссылки.
//   *** Ссылка - Строка - навигационный адрес.
//   ** Подгруппы - Соответствие из КлючИЗначение - ссылки по подгруппам:
//   *** Ключ - Строка - имя подгруппы.
//   *** Значение - Массив из Структура - ссылки подгруппы:
//   **** Представление - Строка - подпись ссылки.
//   **** Ссылка - Строка - навигационный адрес.
&НаСервере
Процедура ПостроитьВеткиИзГрупп(ДеревоЗнач, Группы)
	Для Каждого КлючЗначение Из Группы Цикл
		ИмяГруппы = КлючЗначение.Ключ;
		ДанныеГруппы = КлючЗначение.Значение;
		ОбщееКоличество = ДанныеГруппы.Элементы.Количество();
		Для Каждого ПГ Из ДанныеГруппы.Подгруппы Цикл
			ОбщееКоличество = ОбщееКоличество + ПГ.Значение.Количество();
		КонецЦикла;
		Ветка = ДеревоЗнач.Строки.Добавить();
		Ветка.Представление = ИмяГруппы + " (" + ОбщееКоличество + ")";
		Ветка.ЭтоГруппа = Истина;
		Ветка.Картинка = ДанныеГруппы.Иконка;
		Для Каждого Эл Из ДанныеГруппы.Элементы Цикл
			НовСтр = Ветка.Строки.Добавить();
			НовСтр.Представление = Эл.Представление;
			НовСтр.СсылкаНаОбъект = Эл.Ссылка;
			НовСтр.ЭтоГруппа = Ложь;
			НовСтр.Картинка = ДанныеГруппы.Иконка;
		КонецЦикла;
		Для Каждого КЗПодгруппы Из ДанныеГруппы.Подгруппы Цикл
			ИмяПодгруппы = КЗПодгруппы.Ключ;
			МассивПодгруппы = КЗПодгруппы.Значение;
			ВеткаПГ = Ветка.Строки.Добавить();
			ВеткаПГ.Представление = ИмяПодгруппы + " (элементы: " + МассивПодгруппы.Количество() + ")";
			ВеткаПГ.ЭтоГруппа = Истина;
			ВеткаПГ.Картинка = БиблиотекаКартинок.Папка;
			Для Каждого ЭлПГ Из МассивПодгруппы Цикл
				НовСтрПГ = ВеткаПГ.Строки.Добавить();
				НовСтрПГ.Представление = ЭлПГ.Представление;
				НовСтрПГ.СсылкаНаОбъект = ЭлПГ.Ссылка;
				НовСтрПГ.ЭтоГруппа = Ложь;
				НовСтрПГ.Картинка = ДанныеГруппы.Иконка;
			КонецЦикла;
			ВеткаПГ.Строки.Сортировать("Представление Возр");
		КонецЦикла;
		Ветка.Строки.Сортировать("ЭтоГруппа Убыв, Представление Возр");
	КонецЦикла;
КонецПроцедуры

// Получает читаемое представление объекта по навигационной ссылке без обращения к модулю объекта обработки.
//
// Параметры:
//  СсылкаТекст - Строка - текст навигационной ссылки.
//
// Возвращаемое значение:
//  Строка - представление объекта или исходная ссылка при невозможности определить подпись.
&НаСервере
Функция ПолучитьИмяДляСсылкиПанелька(Знач СсылкаТекст)
	ПозицияДата = СтрНайти(СсылкаТекст, "e1cib/data/");
	Если ПозицияДата > 0 Тогда
		Возврат ИзвлечьПредставлениеОбъектаДанныхПанелька(СсылкаТекст, ПозицияДата);
	КонецЕсли;
	ПозицияТочки = СтрНайти(СсылкаТекст, ".");
	Если ПозицияТочки > 0 Тогда
		ПозицияВопроса = СтрНайти(СсылкаТекст, "?");
		Если ПозицияВопроса = 0 Тогда
			ПозицияВопроса = СтрДлина(СсылкаТекст) + 1;
		КонецЕсли;
		Возврат РазбитьКэмелКейсПанелька(Сред(СсылкаТекст, ПозицияТочки + 1, ПозицияВопроса - ПозицияТочки - 1));
	КонецЕсли;
	Возврат СсылкаТекст;
КонецФункции

// Получает представление объекта данных из навигационной ссылки e1cib/data.
//
// Параметры:
//  СсылкаТекст - Строка - текст навигационной ссылки.
//  ПозицияДата - Число - позиция сегмента e1cib/data/.
//
// Возвращаемое значение:
//  Строка - представление объекта или исходная ссылка при невозможности определить подпись.
&НаСервере
Функция ИзвлечьПредставлениеОбъектаДанныхПанелька(Знач СсылкаТекст, Знач ПозицияДата)
	Если ПозицияДата <= 0 Тогда
		Возврат СсылкаТекст;
	КонецЕсли;
	СсылкиОбъектов = Новый Массив;
	СсылкиОбъектов.Добавить(СсылкаТекст);
	Представления = ПолучитьПредставленияОбъектовДанныхПанелька(СсылкиОбъектов);
	Возврат Представления[СсылкаТекст];
КонецФункции

// Получает представления уникальных ссылок одним запросом на каждый тип метаданных.
//
// Параметры:
//  СсылкиОбъектов - Массив из Строка - навигационные ссылки объектов без сохраненного представления.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - исходная навигационная ссылка.
//   * Значение - Строка - доступное представление или исходная ссылка при отсутствии данных.
&НаСервере
Функция ПолучитьПредставленияОбъектовДанныхПанелька(СсылкиОбъектов)
	Возврат РеквизитФормыВЗначение("Объект").ПанелькаПредставленияНавигационныхСсылок(СсылкиОбъектов);
КонецФункции

// Преобразует техническое имя объекта в читаемое представление с пробелами.
//
// Параметры:
//  Текст - Строка - техническое имя объекта.
//
// Возвращаемое значение:
//  Строка - текст с пробелами перед переходом к заглавной букве.
&НаСервере
Функция РазбитьКэмелКейсПанелька(Знач Текст)
	Возврат РеквизитФормыВЗначение("Объект").ПанелькаРазбитьКэмелКейс(Текст);
КонецФункции

// Определяет группу, подгруппу и картинку для объекта по его ссылке.
//
// Параметры:
//  СсылкаТекст - Строка - текст навигационной ссылки.
//  ИмяГруппы - Строка - имя группы.
//  ИмяПодгруппы - Строка - имя подгруппы.
//  Иконка - Картинка - картинка объекта.
//  ОбъектФормы - ДанныеФормыСтруктура - реквизит объекта формы; сохранен для совместимости и не используется.
&НаСервере
Процедура ОпределитьГруппыИИконку(Знач СсылкаТекст, ИмяГруппы, ИмяПодгруппы, Иконка, ОбъектФормы)
	ИмяГруппы = "Прочее";
	ИмяПодгруппы = "";
	Иконка = БиблиотекаКартинок.Свойства;
	СсылкаТекстДляПоискаГруппы = "";
	ПозицияДата = СтрНайти(СсылкаТекст, "e1cib/data/");
	Если ПозицияДата > 0 Тогда
		Остаток = Сред(СсылкаТекст, ПозицияДата + 11);
		ПозицияВопроса = СтрНайти(Остаток, "?");
		Если ПозицияВопроса > 0 Тогда
			ТипОбъектаСтрокой = Лев(Остаток, ПозицияВопроса - 1);
			Слеши = СтрРазделить(ТипОбъектаСтрокой, ".");
			Если Слеши.Количество() > 1 Тогда
				Класс = Слеши[0];
				ИмяОбъекта = Слеши[1];
				ИмяПодгруппы = РазбитьКэмелКейсПанелька(ИмяОбъекта);
				СсылкаТекстДляПоискаГруппы = Класс + ".";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	СсылкаДляПроверки = ?(ПустаяСтрока(ИмяПодгруппы), СсылкаТекст, СсылкаТекстДляПоискаГруппы);
	Если СтрНайти(СсылкаДляПроверки, "Справочник.") > 0 Тогда
		ИмяГруппы = "Справочники";
		Иконка = БиблиотекаКартинок.Справочник;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "Документ.") > 0 Тогда
		ИмяГруппы = "Документы";
		Иконка = БиблиотекаКартинок.Документ;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "ЖурналДокументов.") > 0 Тогда
		ИмяГруппы = "Журналы документов";
		Иконка = БиблиотекаКартинок.ЖурналДокументов;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "Отчет.") > 0 Тогда
		ИмяГруппы = "Отчеты";
		Иконка = БиблиотекаКартинок.Отчет;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "Обработка.") > 0 Тогда
		ИмяГруппы = "Обработки";
		Иконка = БиблиотекаКартинок.Обработка;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "ПланВидовХарактеристик.") > 0 Тогда
		ИмяГруппы = "Планы видов характеристик";
		Иконка = БиблиотекаКартинок.ПланВидовХарактеристик;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "ПланСчетов.") > 0 Тогда
		ИмяГруппы = "Планы счетов";
		Иконка = БиблиотекаКартинок.ПланСчетов;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "ПланВидовРасчета.") > 0 Тогда
		ИмяГруппы = "Планы видов расчета";
		Иконка = БиблиотекаКартинок.ПланВидовРасчета;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "ПланОбмена.") > 0 Тогда
		ИмяГруппы = "Планы обмена";
		Иконка = БиблиотекаКартинок.ПланОбмена;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "РегистрСведений.") > 0 Тогда
		ИмяГруппы = "Регистры сведений";
		Иконка = БиблиотекаКартинок.РегистрСведений;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "РегистрНакопления.") > 0 Тогда
		ИмяГруппы = "Регистры накопления";
		Иконка = БиблиотекаКартинок.РегистрНакопления;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "РегистрБухгалтерии.") > 0 Тогда
		ИмяГруппы = "Регистры бухгалтерии";
		Иконка = БиблиотекаКартинок.РегистрБухгалтерии;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "РегистрРасчета.") > 0 Тогда
		ИмяГруппы = "Регистры расчета";
		Иконка = БиблиотекаКартинок.РегистрРасчета;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "БизнесПроцесс.") > 0 Тогда
		ИмяГруппы = "Бизнес-процессы";
		Иконка = БиблиотекаКартинок.БизнесПроцесс;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "Задача.") > 0 Тогда
		ИмяГруппы = "Задачи";
		Иконка = БиблиотекаКартинок.Задача;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "Константа.") > 0 Тогда
		ИмяГруппы = "Константы";
		Иконка = БиблиотекаКартинок.Константа;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "ОбщаяФорма.") > 0 Тогда
		ИмяГруппы = "Общие формы";
		Иконка = БиблиотекаКартинок.Форма;
	ИначеЕсли СтрНайти(СсылкаДляПроверки, "ВнешнийИсточникДанных.") > 0 Тогда
		ИмяГруппы = "Внешние источники данных";
		Попытка
			Иконка = БиблиотекаКартинок.ВнешнийИсточникДанных;
		Исключение
			Иконка = БиблиотекаКартинок.Таблица;
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Добавляет в дерево ветвь объектов указанного вида метаданных.
//
// Параметры:
//  Дерево - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
//  КоллекцияМетаданных - КоллекцияОбъектовМетаданных из ОбъектМетаданных - объекты метаданных одного вида.
//  СинонимГруппы - Строка - представление группы.
//  ПрефиксСсылки - Строка - префикс навигационной ссылки.
//  Иконка - Картинка - картинка объекта.
&НаСервере
Процедура ДобавитьВеткуМетаданных(Дерево, КоллекцияМетаданных, СинонимГруппы, ПрефиксСсылки, Иконка)
	Если КоллекцияМетаданных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ветка = Дерево.Строки.Добавить();
	Ветка.Представление = СинонимГруппы + " (" + КоллекцияМетаданных.Количество() + ")";
	Ветка.ЭтоГруппа = Истина;
	Ветка.Картинка = Иконка;
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		НовСтр = Ветка.Строки.Добавить();
		НовСтр.Представление = ?(ЗначениеЗаполнено(ОбъектМетаданных.Синоним), ОбъектМетаданных.Синоним, ОбъектМетаданных.Имя);
		НовСтр.СсылкаНаОбъект = ПрефиксСсылки + ОбъектМетаданных.Имя;
		НовСтр.ЭтоГруппа = Ложь;
		НовСтр.Картинка = Иконка;
	КонецЦикла;
	Ветка.Строки.Сортировать("Представление Возр");
КонецПроцедуры

// Добавляет в дерево таблицы внешних источников данных.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
&НаСервере
Процедура ДобавитьВеткуВИД(ДеревоЗнач)
	Ветка = Неопределено;
	Попытка
		Если Метаданные.ВнешниеИсточникиДанных.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		Ветка = ДеревоЗнач.Строки.Добавить();
		Ветка.ЭтоГруппа = Истина;
		Попытка
			Ветка.Картинка = БиблиотекаКартинок.ВнешнийИсточникДанных;
		Исключение
			Ветка.Картинка = БиблиотекаКартинок.Таблица;
		КонецПопытки;
		Счетчик = 0;
		Для Каждого ВИД Из Метаданные.ВнешниеИсточникиДанных Цикл
			Для Каждого Таблица Из ВИД.Таблицы Цикл
				НовСтр = Ветка.Строки.Добавить();
				НовСтр.Представление = ?(ЗначениеЗаполнено(Таблица.Синоним), Таблица.Синоним, Таблица.Имя) + " (" +
					ВИД.Имя + ")";
				НовСтр.СсылкаНаОбъект = "e1cib/list/ВнешнийИсточникДанных." + ВИД.Имя + ".Таблица." + Таблица.Имя;
				НовСтр.ЭтоГруппа = Ложь;
				НовСтр.Картинка = Ветка.Картинка;
				Счетчик = Счетчик + 1;
			КонецЦикла;
		КонецЦикла;
		Ветка.Представление = "Внешние источники данных (" + Счетчик + ")";
		Ветка.Строки.Сортировать("Представление Возр");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если Ветка <> Неопределено Тогда
			ДеревоЗнач.Строки.Удалить(Ветка);
		КонецЕсли;
		Попытка
			ЗаписьЖурналаРегистрации("Панелька.ВнешниеИсточникиДанных", УровеньЖурналаРегистрации.Ошибка,,,
				ТекстОшибки);
		Исключение
			// Отказ журнала не должен прерывать выбор остальных объектов.
		КонецПопытки;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр(
			"ru = 'Не удалось загрузить внешние источники данных. Остальные объекты доступны для выбора.'");
		Сообщение.Сообщить();
	КонецПопытки;
КонецПроцедуры

// Добавляет в дерево системные платформенные команды и объекты.
//
// Параметры:
//  ДеревоЗнач - ДеревоЗначений - изменяемое дерево выбора с колонками Представление, СсылкаНаОбъект, ЭтоГруппа и Картинка.
&НаСервере
Процедура ДобавитьВеткуПлатформы(ДеревоЗнач)
	Если Не ПравоДоступа("ИнтерактивноеОткрытиеВнешнихОбработок", Метаданные) Тогда
		Возврат;
	КонецЕсли;
	Ветка = ДеревоЗнач.Строки.Добавить();
	Ветка.ЭтоГруппа = Истина;
	Ветка.Картинка = БиблиотекаКартинок.Обработка;
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	РезультатЧтения = ОбъектОбработки.ПанелькаПрочитатьСистемныеИнструменты();
	Для Каждого Инструмент Из РезультатЧтения.Инструменты Цикл
		НоваяСтрока = Ветка.Строки.Добавить();
		НоваяСтрока.Представление = Инструмент.Наименование;
		НоваяСтрока.СсылкаНаОбъект = Инструмент.Ссылка;
		НоваяСтрока.ЭтоГруппа = Ложь;
		НоваяСтрока.Картинка = Ветка.Картинка;
	КонецЦикла;
	Ветка.Представление = СтрШаблон(НСтр("ru = 'Стандартные инструменты (%1)'"), Ветка.Строки.Количество());
	Если РезультатЧтения.НеполныйСписок Тогда
		Ветка.Представление = Ветка.Представление + НСтр("ru = ' — список неполный'");
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Часть стандартных инструментов не удалось прочитать. Доступные записи показаны. Обратитесь к администратору.'");
		Сообщение.Сообщить();
	КонецЕсли;
	Ветка.Строки.Сортировать("Представление Возр");
КонецПроцедуры

#КонецОбласти

#Область РаботаСГалочками

// Устанавливает указанную пометку для всех дочерних строк.
//
// Параметры:
//  РодительскаяСтрока - ДанныеФормыЭлементДерева - строка дерева выбора на клиенте.
//  Флаг - Булево - требуемое состояние пометки.
&НаКлиенте
Процедура УстановитьПометкуПодчиненных(РодительскаяСтрока, Знач Флаг)
	РодительскаяСтрока.ЕстьВыбранные = Флаг;
	Для Каждого ПодчиненнаяСтрока Из РодительскаяСтрока.ПолучитьЭлементы() Цикл
		ПодчиненнаяСтрока.Пометка = Флаг;
		Если ПодчиненнаяСтрока.ЭтоГруппа Тогда
			УстановитьПометкуПодчиненных(ПодчиненнаяСтрока, Флаг);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Пересчитывает пометку и состояние выбора родительской строки.
//
// Параметры:
//  СтрокаДерева - ДанныеФормыЭлементДерева - строка дерева выбора на клиенте.
&НаКлиенте
Процедура ОбновитьПометкуРодителя(СтрокаДерева)
	Родитель = СтрокаДерева.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭлементыРодителя = Родитель.ПолучитьЭлементы();
	ВсеПомечены = ЭлементыРодителя.Количество() > 0;
	ХотяБыОдинПомечен = Ложь;
	Для Каждого ПодчиненнаяСтрока Из ЭлементыРодителя Цикл
		Если ПодчиненнаяСтрока.Пометка ИЛИ ПодчиненнаяСтрока.ЕстьВыбранные Тогда
			ХотяБыОдинПомечен = Истина;
		КонецЕсли;
		Если Не ПодчиненнаяСтрока.Пометка Тогда
			ВсеПомечены = Ложь;
		КонецЕсли;
	КонецЦикла;
	Родитель.Пометка = ВсеПомечены;
	Родитель.ЕстьВыбранные = ХотяБыОдинПомечен;
	ОбновитьПометкуРодителя(Родитель);
КонецПроцедуры

#КонецОбласти

#Область ПередачаДанных

// Рекурсивно собирает отмеченные строки дерева выбора.
//
// Параметры:
//  ЭлементыДерева - ДанныеФормыКоллекцияЭлементовДерева из ДанныеФормыЭлементДерева - строки текущего уровня дерева выбора.
//  МассивВыбранных - Массив из Структура - выходные выбранные строки:
//   * Представление - Строка - подпись объекта.
//   * Ссылка - Строка - адрес объекта или имя роли.
//   * Подсказка - Строка - пояснение выбранной строки.
&НаКлиенте
Процедура СобратьОтмеченныеСтроки(ЭлементыДерева, МассивВыбранных)
	Для Каждого Эл Из ЭлементыДерева Цикл
		Если Эл.Пометка И Не Эл.ЭтоГруппа Тогда
			ТекстПодсказки = "";
			Попытка
				Если ЗначениеЗаполнено(Эл.Подсказка) Тогда
					ТекстПодсказки = Эл.Подсказка;
				КонецЕсли;
			Исключение
			КонецПопытки;
			ДанныеОбъекта = Новый Структура("Представление, Ссылка, Подсказка", Эл.Представление,
				Эл.СсылкаНаОбъект, ТекстПодсказки);
			МассивВыбранных.Добавить(ДанныеОбъекта);
		КонецЕсли;
		ЭлементыДочерние = Эл.ПолучитьЭлементы();
		Если ЭлементыДочерние.Количество() > 0 Тогда
			СобратьОтмеченныеСтроки(ЭлементыДочерние, МассивВыбранных);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ЛичныйВыбор

// Удаляет недоступные ссылки и пустые группы до передачи дерева клиенту.
&НаСервере
Процедура ОтфильтроватьДеревоЛичногоВыбораПанелька(СтрокиДерева, Обработка, Политика,
	ДоступныеДополнительные, КонтекстДоступа = Неопределено)
	КУдалению = Новый Массив;
	Для Каждого Узел Из СтрокиДерева Цикл
		Если Узел.ЭтоГруппа Тогда
			ОтфильтроватьДеревоЛичногоВыбораПанелька(Узел.Строки, Обработка, Политика,
				ДоступныеДополнительные, КонтекстДоступа);
			Если Узел.Строки.Количество() = 0 Тогда
				КУдалению.Добавить(Узел);
			Иначе
				ПозицияСчетчика = СтрНайти(Узел.Представление, " (");
				Если ПозицияСчетчика > 0 Тогда
					Узел.Представление = Лев(Узел.Представление, ПозицияСчетчика - 1)
						+ " (" + Строка(Узел.Строки.Количество()) + ")";
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Не Обработка.ПанелькаСсылкаДоступнаЛично(Узел.СсылкаНаОбъект, "", Политика,
			ДоступныеДополнительные, КонтекстДоступа) Тогда
			КУдалению.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Узел Из КУдалению Цикл
		СтрокиДерева.Удалить(Узел);
	КонецЦикла;
КонецПроцедуры

// Необязательный параметр формы может отсутствовать или содержать Неопределено.
// Результат всегда Булево, независимо от режима дерева и способа открытия.
&НаСервере
Функция ЭтоЛичныйВыборПанелька()
	ЗначениеПараметра = Параметры.ПерсональнаяНастройкаПанелька;
	Если ЗначениеПараметра = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(ЗначениеПараметра) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный параметр персонального выбора. Ожидалось значение Булево.'");
	КонецЕсли;
	Возврат ЗначениеПараметра;
КонецФункции

#КонецОбласти

#КонецОбласти
