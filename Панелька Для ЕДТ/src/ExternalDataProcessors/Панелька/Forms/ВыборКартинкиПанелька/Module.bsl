#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекущаяКартинка = Параметры.ТекущееИмя;
	Если ТипЗнч(ТекущаяКартинка) <> Тип("Строка") Тогда
		ТекущаяКартинка = "";
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Каталог = Обработка.ПанелькаКартинкиДляВыбора(Ложь);
	АдресКаталога = ПоместитьВоВременноеХранилище(Каталог, УникальныйИдентификатор);
	ОбновитьСписокКартинокНаСервере("");
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ОтключитьОбработчикОжидания("ПрименитьПоискКартинок");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПоискаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ОтключитьОбработчикОжидания("ПрименитьПоискКартинок");
	ПодключитьОбработчикОжидания("ПрименитьПоискКартинок", 0.3, Истина);
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	ОтключитьОбработчикОжидания("ПрименитьПоискКартинок");
	ПрименитьПоискКартинок();
КонецПроцедуры

// Очистка сразу возвращает весь каталог, даже пока поле остаётся активным.
&НаКлиенте
Процедура СтрокаПоискаОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОтключитьОбработчикОжидания("ПрименитьПоискКартинок");
	СтрокаПоиска = "";
	Элемент.ОбновитьТекстРедактирования();
	ОбновитьСписокКартинокНаСервере("");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаКартинок

&НаКлиенте
Процедура ТаблицаКартинокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЗавершитьВыборКартинки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьКартинку(Команда)
	ЗавершитьВыборКартинки();
КонецПроцедуры

&НаКлиенте
Процедура БезКартинки(Команда)
	Закрыть(Новый Структура("Значение", ""));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик ожидания читает редактируемый текст, не требуя ухода из поля.
&НаКлиенте
Процедура ПрименитьПоискКартинок() Экспорт
	ТекстПоиска = СтрокаПоиска;
	Если ТекущийЭлемент = Элементы.СтрокаПоиска Тогда
		ТекстПоиска = Элементы.СтрокаПоиска.ТекстРедактирования;
	КонецЕсли;
	ОбновитьСписокКартинокНаСервере(ТекстПоиска);
КонецПроцедуры

// Отмена окна возвращает Неопределено; пустое имя — явный выбор «Без картинки».
&НаКлиенте
Процедура ЗавершитьВыборКартинки()
	ДанныеСтроки = Элементы.ТаблицаКартинок.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Закрыть(Новый Структура("Значение", ДанныеСтроки.Имя));
КонецПроцедуры

// Каталог имён загружается один раз на окно. Изображения — только для результатов поиска.
// Параметры:
//  Поиск - Строка - часть названия или технического имени картинки.
&НаСервере
Процедура ОбновитьСписокКартинокНаСервере(Знач Поиск)
	СтрокаПоиска = Поиск;
	Фильтр = НРег(СокрЛП(Поиск));
	Каталог = ПолучитьИзВременногоХранилища(АдресКаталога);
	Если ТипЗнч(Каталог) <> Тип("СписокЗначений") Тогда
		ВызватьИсключение НСтр("ru = 'Список картинок устарел. Откройте выбор заново.'");
	КонецЕсли;
	ТаблицаКартинок.Очистить();
	Найдено = 0;
	УжеДобавлены = Новый Соответствие;
	Для Каждого ЭлементКаталога Из Каталог Цикл
		ИмяКартинки = Строка(ЭлементКаталога.Значение);
		Название = Строка(ЭлементКаталога.Представление);
		Если УжеДобавлены[ИмяКартинки] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавлены.Вставить(ИмяКартинки, Истина);
		Если Не ПустаяСтрока(Фильтр) И СтрНайти(НРег(Название + " " + ИмяКартинки), Фильтр) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Найдено + 1;
		СтрокаКартинки = ТаблицаКартинок.Добавить();
		СтрокаКартинки.Имя = ИмяКартинки;
		СтрокаКартинки.Название = Название;
		СтрокаКартинки.Текущая = (ИмяКартинки = ТекущаяКартинка);
		Попытка
			СтрокаКартинки.Картинка = БиблиотекаКартинок[ИмяКартинки];
		Исключение
			// Недоступное изображение не мешает выбору по имени.
			СтрокаКартинки.Название = Название + " " + НСтр("ru = '(изображение недоступно)'");
		КонецПопытки;
	КонецЦикла;
	ИнформацияОПоиске = СтрШаблон(НСтр("ru = 'Найдено: %1. Показано: %2.'"), Найдено, ТаблицаКартинок.Количество());
КонецПроцедуры

#КонецОбласти
