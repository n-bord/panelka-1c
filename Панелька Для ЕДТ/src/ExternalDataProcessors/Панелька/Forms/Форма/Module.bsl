&НаКлиенте
Процедура КонтекстСкопироватьПутьКПапкеКоманда(Команда)
	СкопироватьДанныеЭлементаПанелька("copy_dir");
КонецПроцедуры

// Открывает форму настроек «Панельки».
// Параметры:
//  Команда - КомандаФормы - команда формы.
&НаКлиенте
Процедура НастройкиПанелька(Команда)
	ОткрытьОбщиеНастройкиПанелиПанелька();
КонецПроцедуры

&НаКлиенте
Процедура ДиагностикаПанелиПанелька(Команда)
	Варианты = Новый СписокЗначений;
	Варианты.Добавить("toggle", ?(ДиагностикаПанелька, "Выключить диагностику", "Включить диагностику и обновить панель"));
	Варианты.Добавить("report",НСтр("ru = 'Показать последний замер'"));
	Варианты.Добавить("exchange",НСтр("ru = 'Замер обмена без перестроения'"));
	Варианты.Добавить("refresh",НСтр("ru = 'Обновить с замером'"));
	Варианты.Добавить("full",НСтр("ru = 'Полное построение с замером'"));
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораДиагностикиПанелька", ЭтотОбъект), Варианты,
		Элементы.ПерсональнаяНастройкаПанелиПанелька);
КонецПроцедуры

&НаКлиенте
Процедура ПерсональнаяНастройкаПанелиПанелька(Команда)
	ОткрытьНастройкиЛичнойПанелиПанелька();
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьПанельПанелька(Команда)
	ПереключитьАктивнуюПанельПанелька();
КонецПроцедуры

// Единая точка входа в настройки; общая панель доступна администратору.
&НаКлиенте
Процедура МенюНастроекПанелька(Команда)
	Варианты = ВариантыНастройкиПанелька();
	Если Варианты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Варианты.Количество() = 1 Тогда
		ОткрытьВыбранныеНастройкиПанелька(Варианты[0].Значение);
		Возврат;
	КонецЕсли;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораНастройкиПанелька", ЭтотОбъект),
		Варианты, Элементы.ПерсональнаяНастройкаПанелиПанелька);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение пользователю через платформенный объект без зависимости от БСП.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения, включая переводы строк и локализованные подписи.
&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователюПанелька(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
КонецПроцедуры

#Область УправлениеОбновлением

// Объединяет ожидающие запросы; фактическое построение читает последнее состояние формы.
//
// Параметры:
//  ПринудительноПолное - Булево - запросить полное перестроение панели.
//  Немедленно - Булево - выполнить обновление без ожидания очереди.
//  НуженСбросФокуса - Булево - снять фокус с динамических элементов перед перестроением.
&НаКлиенте
Процедура ОбновитьИнтерфейсДашборда(Знач ПринудительноПолное = Ложь, Знач Немедленно = Ложь,
	Знач НуженСбросФокуса = Ложь)
	Если ФормаЗакрываетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Если ВерсияЗапросовОбновленияПанелька = Неопределено Тогда
		ВерсияЗапросовОбновленияПанелька = 0;
	КонецЕсли;
	ВерсияЗапросовОбновленияПанелька = ВерсияЗапросовОбновленияПанелька + 1;
	Если ЧислоОжидающихЗапросовПанелька = Неопределено Тогда
		ЧислоОжидающихЗапросовПанелька = 0;
	КонецЕсли;
	ЧислоОжидающихЗапросовПанелька = ЧислоОжидающихЗапросовПанелька + 1;
	ОбновлениеЗапрошеноПанелька = Истина;
	Если ПринудительноПолное Тогда
		ПолноеОбновлениеЗапрошеноПанелька = Истина;
	КонецЕсли;
	Если НуженСбросФокуса Тогда
		СбросФокусаЗапрошенПанелька = Истина;
	КонецЕсли;
	Если ОбновлениеВыполняетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Если Немедленно Тогда
		ОтменитьОжиданиеОбновленияПанелька();
		ОтложенноеОбновлениеДашборда();
	Иначе
		ЗапланироватьОбновлениеПанелька();
	КонецЕсли;
КонецПроцедуры

// Поддерживает только один одноразовый обработчик ожидания.
&НаКлиенте
Процедура ЗапланироватьОбновлениеПанелька()
	Если ФормаЗакрываетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	ОтменитьОжиданиеОбновленияПанелька();
	Задержка = 0.1;
	Если СбросФокусаЗапрошенПанелька = Истина Тогда
		Задержка = 0.2;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ОтложенноеОбновлениеДашборда", Задержка, Истина);
	ОжиданиеОбновленияПанелька = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьОжиданиеОбновленияПанелька()
	Если ОжиданиеОбновленияПанелька = Истина Тогда
		ОтключитьОбработчикОжидания("ОтложенноеОбновлениеДашборда");
		ОжиданиеОбновленияПанелька = Ложь;
	КонецЕсли;
КонецПроцедуры

// Потребляет один накопленный запрос; новые запросы не сбрасываются при завершении.
&НаКлиенте
Процедура ОтложенноеОбновлениеДашборда() Экспорт
	ОжиданиеОбновленияПанелька = Ложь;
	Если ФормаЗакрываетсяПанелька = Истина Или ОбновлениеЗапрошеноПанелька <> Истина Тогда
		Возврат;
	КонецЕсли;
	Если ОбновлениеВыполняетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Полное = ПолноеОбновлениеЗапрошеноПанелька = Истина;
	СброситьФокус = СбросФокусаЗапрошенПанелька = Истина;
	ЗапросовВПакете = ЧислоОжидающихЗапросовПанелька;
	// Очищаем только потреблённый пакет, ДО вызова сервера.
	ОбновлениеЗапрошеноПанелька = Ложь;
	ПолноеОбновлениеЗапрошеноПанелька = Ложь;
	СбросФокусаЗапрошенПанелька = Ложь;
	ЧислоОжидающихЗапросовПанелька = 0;
	ОбновлениеВыполняетсяПанелька = Истина;
	Если Не РежимHTTP Тогда
		НачатьЗагрузкуВОкнеПанелька(Полное, СброситьФокус, ЗапросовВПакете);
		Возврат;
	КонецЕсли;
	Попытка
		Если СброситьФокус Тогда
			СброситьФокусПередОбновлениемПанелька();
		КонецЕсли;
		ВыполнитьОбновлениеДашбордаПанелька(Полное);
		Если ДиагностикаПанелька Тогда
			ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Запросов в выполненном пакете обновления: " +
				Строка(ЗапросовВПакете) + Символы.ПС;
		КонецЕсли;
	Исключение
		ОбновлениеВыполняетсяПанелька = Ложь;
		Если ОбновлениеЗапрошеноПанелька = Истина Тогда
			ЗапланироватьОбновлениеПанелька();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ОбновлениеВыполняетсяПанелька = Ложь;
	Если ОбновлениеЗапрошеноПанелька = Истина Тогда
		ЗапланироватьОбновлениеПанелька();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуВОкнеПанелька(Знач Полное, Знач СброситьФокус, Знач ЗапросовВПакете)
	НачалоЗагрузкиПанелька = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ПараметрыЗагрузкиПанелька = Новый Структура;
	ПараметрыЗагрузкиПанелька.Вставить("Полное", Полное);
	ПараметрыЗагрузкиПанелька.Вставить("Фокус", СброситьФокус);
	ПараметрыЗагрузкиПанелька.Вставить("Запросов", ЗапросовВПакете);
	ПараметрыЗагрузкиПанелька.Вставить("Этап", 0);
	ПараметрыЗагрузкиПанелька.Вставить("ОтчетКлиента", "");
	Попытка
		ОкноЗагрузкиПанелька = ОткрытьФорму(ИмяСоседнейФормыПанелька("ОкноЗагрузкиПанелька"), , ,
			Строка(Новый УникальныйИдентификатор), , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ОкноЗагрузкиПанелька.УстановитьПродолжение(Новый ОписаниеОповещения("ПродолжитьЗагрузкуПанелька", ЭтотОбъект));
		ОкноЗагрузкиПанелька.ОбновитьПрогресс(0, 9, "Подготавливаем окно");
	Исключение
		ОбновлениеВыполняетсяПанелька = Ложь;
		ПараметрыЗагрузкиПанелька = Неопределено;
		Если ОбновлениеЗапрошеноПанелька = Истина Тогда
			ЗапланироватьОбновлениеПанелька();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Каждый такт выполняет следующий реальный этап и возвращает управление окну.
// Параметры:
//  Результат - Произвольный - результат клиентского оповещения; не используется.
//  ДополнительныеПараметры - Произвольный - дополнительные параметры оповещения; не используются.
&НаКлиенте
Процедура ПродолжитьЗагрузкуПанелька(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	Если ПараметрыЗагрузкиПанелька = Неопределено Или ФормаЗакрываетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ПараметрыЗагрузкиПанелька.Свойство("Завершено") Тогда
			ЗавершитьОкноЗагрузкиПанелька();
			ПроверитьДоступностьВнешнихФайловНаКлиенте();
			Возврат;
		КонецЕсли;
		Названия = СтрРазделить("Подготавливаем окно|Читаем настройки панели|Проверяем типы обработок|Подготавливаем ссылки|Проверяем доступность ссылок|Готовим избранное и страницы|Рассчитываем размещение колонок|Строим страницы, колонки и ссылки|Применяем поиск и завершаем оформление", "|");
		Этап = ПараметрыЗагрузкиПанелька.Этап + 1;
		Начало = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		ПовторноеИспользование = Ложь;
		Если Этап = 1 Тогда
			ПоколениеЗагрузкиПанелька = ?(ПоколениеЗагрузкиПанелька = Неопределено, 1, ПоколениеЗагрузкиПанелька + 1);
			Если ПараметрыЗагрузкиПанелька.Фокус Тогда
				СброситьФокусПередОбновлениемПанелька();
			КонецЕсли;
			Ширина = 1920;
			Высота = 1080;
			Попытка
				Экраны = ПолучитьИнформациюЭкрановКлиента();
				Если Экраны.Количество() > 0 Тогда
					Ширина = Экраны[0].Ширина;
					Высота = Экраны[0].Высота;
				КонецЕсли;
			Исключение
				Ширина = 1920;
				Высота = 1080;
			КонецПопытки;
			ПараметрыЗагрузкиПанелька.Вставить("Ширина", Ширина);
			ПараметрыЗагрузкиПанелька.Вставить("Высота", Высота);
		ИначеЕсли Этап = 2 Тогда
			ФормаПодготовки = НачатьПодготовкуПоЭтапамПанелька(ПараметрыЗагрузкиПанелька.Ширина, ПараметрыЗагрузкиПанелька.Высота,
				ПараметрыЗагрузкиПанелька.Полное Или ЕстьОшибкиВнешнихФайловПанелька = Истина);
			ПараметрыЗагрузкиПанелька.Вставить("Форма", ФормаПодготовки);
		ИначеЕсли Этап = 5 Тогда
			ПовторноеИспользование = ПроверитьПодготовкуПоЭтапамПанелька();
		ИначеЕсли Этап = 8 Тогда
			ПостроитьПодготовленнуюПанельПанелька();
		ИначеЕсли Этап = 9 Тогда
			ПрименитьПоискСЗаданнымТекстом(СтрокаПоиска);
		Иначе
			ПодготовитьЭтапБезКонтекстаПанелька(АдресПостроенияПанелька, ПараметрыЗагрузкиПанелька.Форма, Этап);
		КонецЕсли;
		ДобавитьЭтапДиагностикиПанелькаЗначение(ПараметрыЗагрузкиПанелька.ОтчетКлиента,
			"Клиент: этап " + Строка(Этап) + " — " + Названия[Этап - 1], Начало);
		Если ПовторноеИспользование Тогда
			// Подготовленная панель уже существует; этапы нового построения не требуются.
			Этап = 8;
		КонецЕсли;
		ПараметрыЗагрузкиПанелька.Этап = Этап;
		Если Этап < 9 Тогда
			ТекстЭтапа = Названия[Этап];
			Если ПовторноеИспользование Тогда
				ТекстЭтапа = "Используем готовую панель. Применяем поиск";
			КонецЕсли;
			ОкноЗагрузкиПанелька.ОбновитьПрогресс(Этап, 9, ТекстЭтапа);
		Иначе
			ОкноЗагрузкиПанелька.ОбновитьПрогресс(9, 9, "Панель готова");
			Если ДиагностикаПанелька Тогда
				ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + ПараметрыЗагрузкиПанелька.ОтчетКлиента
					+ "Загрузка в текущем экземпляре формы: " + Строка(ПоколениеЗагрузкиПанелька) + Символы.ПС
					+ "Запросов в выполненном пакете обновления: " + Строка(ПараметрыЗагрузкиПанелька.Запросов) + Символы.ПС;
			КонецЕсли;
			ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
				"Клиент: загрузка с девятью этапами (включая обмен и интервалы окна)", НачалоЗагрузкиПанелька);
			ПараметрыЗагрузкиПанелька.Вставить("Завершено", Истина);
		КонецЕсли;
		ОкноЗагрузкиПанелька.ЗапланироватьПродолжение();
	Исключение
		Попытка
			Если ТипЗнч(Этап) = Тип("Число") И Этап < 8 Тогда
				СброситьПорционноеПостроениеПанелька();
			Иначе
				ОтменитьПостроениеНаСервереПанелька();
			КонецЕсли;
		Исключение
			АдресПостроенияПанелька = "";
		КонецПопытки;
		ЗавершитьОкноЗагрузкиПанелька();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОкноЗагрузкиПанелька()
	Если ОкноЗагрузкиПанелька <> Неопределено Тогда
		Попытка
			НачалоЗакрытия = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
			ОкноЗагрузкиПанелька.Завершить();
			ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Клиент: закрытие окна загрузки", НачалоЗакрытия);
		Исключение
			УстановитьСостояниеЗагрузкиПанелька(Ложь);
		КонецПопытки;
		ОкноЗагрузкиПанелька = Неопределено;
	КонецЕсли;
	ПараметрыЗагрузкиПанелька = Неопределено;
	ОбновлениеВыполняетсяПанелька = Ложь;
	Если ОбновлениеЗапрошеноПанелька = Истина И ФормаЗакрываетсяПанелька <> Истина Тогда
		ЗапланироватьОбновлениеПанелька();
	КонецЕсли;
КонецПроцедуры

// Первый серверный шаг читает профиль один раз. Старое дерево остаётся доступным до построения.
&НаСервере
Функция НачатьПодготовкуПоЭтапамПанелька(Знач Ширина, Знач Высота, Знач Полное)
	СброситьПорционноеПостроениеПанелька();
	ГотовоКолонокПанелька = 0;
	ВсегоКолонокПанелька = 0;
	Элементы.КолонкиПанелька.Видимость = Истина;
	HTMLДашборд = "";
	Начало = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = ПолучитьНастройкиДашборда(Обработка);
	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("Версия", 1);
	КонтекстЗапуска.Вставить("Форма", Строка(УникальныйИдентификатор));
	КонтекстЗапуска.Вставить("Личная", ИспользуетсяЛичнаяПанельПанелька);
	КонтекстЗапуска.Вставить("Ревизия", РевизияЛичногоПрофиляВКонтекстеПанелька);
	ПрежнийАдрес = АдресКонтекстаЗапускаПанелька;
	АдресКонтекстаЗапускаПанелька = ПоместитьВоВременноеХранилище(
		Новый ХранилищеЗначения(КонтекстЗапуска), УникальныйИдентификатор);
	Если Не ПустаяСтрока(ПрежнийАдрес) Тогда
		УдалитьИзВременногоХранилища(ПрежнийАдрес);
	КонецЕсли;
	Состояние = Новый Структура;
	Состояние.Вставить("Версия", 3);
	Состояние.Вставить("Форма", Строка(УникальныйИдентификатор));
	Состояние.Вставить("Этап", 2);
	Состояние.Вставить("Настройки", Настройки);
	Состояние.Вставить("Ширина", Ширина);
	Состояние.Вставить("Высота", Высота);
	Состояние.Вставить("Полное", Полное);
	Состояние.Вставить("КолонкиПанелька", КолонкиПанелька);
	Состояние.Вставить("Диагностика", ДиагностикаПанелька);
	Состояние.Вставить("Отчет", "");
	ТекущаяСтраница = "";
	Вкладки = Элементы.Найти("Вкладки");
	Если Вкладки <> Неопределено И Вкладки.ТекущаяСтраница <> Неопределено Тогда
		ТекущаяСтраница = Вкладки.ТекущаяСтраница.Заголовок;
	КонецЕсли;
	Состояние.Вставить("ТекущаяСтраница", ТекущаяСтраница);
	ОтчетДиагностикиПанелька = "";
	Если ДиагностикаПанелька Тогда
		Состояние.Отчет = "Панелька: Обычный интерфейс" + Символы.ПС + "Диагностика: native-progress-9" + Символы.ПС
			+ "Время в мс. Клиентские интервалы включают обмен; вложенные интервалы не суммировать." + Символы.ПС;
		ДобавитьЭтапДиагностикиПанелькаЗначение(Состояние.Отчет, "Сервер: чтение настроек", Начало);
		ОтчетДиагностикиПанелька = Состояние.Отчет;
	КонецЕсли;
	АдресПостроенияПанелька = ПоместитьВоВременноеХранилище(Новый ХранилищеЗначения(Состояние), УникальныйИдентификатор);
	Возврат Состояние.Форма;
КонецФункции

// Эти шаги передают только адрес, идентификатор формы и номер этапа.
// Данные основной формы между клиентом и сервером не передаются.
&НаСервереБезКонтекста
Процедура ПодготовитьЭтапБезКонтекстаПанелька(Знач Адрес, Знач Форма, Знач НомерЭтапа)
	// Явные локальные имена не связываются с общими модулями конфигурации.
	Перем Состояние, Начало, ПанелькаМетрикиЭтапа, Контекст, Пара, Готовое;
	Если НомерЭтапа <> 3 И НомерЭтапа <> 4 И НомерЭтапа <> 6 И НомерЭтапа <> 7 Тогда
		ВызватьИсключение "Неизвестный этап подготовки панели.";
	КонецЕсли;
	Состояние = ПрочитатьЭтапПодготовкиПанелька(Адрес, Форма, НомерЭтапа - 1);
	Начало = ЧасыДиагностикиПанелька(Состояние.Диагностика);
	Если НомерЭтапа = 3 Тогда
		Состояние.Вставить("Виды", ПолучитьВидыДопОбработокПанелька(Состояние.Настройки.ДанныеДопОбработок));
	ИначеЕсли НомерЭтапа = 4 Тогда
		Состояние.Вставить("Данные", СформироватьДанныеДашборда(Состояние.Настройки, Состояние.Виды));
	ИначеЕсли НомерЭтапа = 6 Тогда
		Состояние.Вставить("Избранное", ПолучитьСсылкиСистемногоИзбранного());
		Состояние.Вставить("Структура", СформироватьСтруктуруСтраниц(
			Состояние.Настройки.ДанныеСтраниц, Состояние.Настройки.ДанныеКолонок));
	Иначе
		ПанелькаМетрикиЭтапа = РассчитатьМетрикиДашборда(Состояние.Данные, Состояние.Структура, Состояние.Настройки);
		Контекст = Новый Структура;
		Контекст.Вставить("ШиринаМонитора", Состояние.Ширина);
		Контекст.Вставить("ВысотаЭкрана", Состояние.Высота);
		Контекст.Вставить("КэшСтатусовМД", Состояние.КэшСтатусов);
		Контекст.Вставить("СуффиксОтрисовки", СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
		Контекст.Вставить("Данные", Состояние.Данные);
		Контекст.Вставить("СсылкиИзбранного", Состояние.Избранное);
		Для Каждого Пара Из Состояние.Настройки Цикл
			Контекст.Вставить(Пара.Ключ, Пара.Значение);
		КонецЦикла;
		Для Каждого Пара Из Состояние.Структура Цикл
			Контекст.Вставить(Пара.Ключ, Пара.Значение);
		КонецЦикла;
		Для Каждого Пара Из ПанелькаМетрикиЭтапа Цикл
			Контекст.Вставить(Пара.Ключ, Пара.Значение);
		КонецЦикла;
		Контекст.Вставить("КолонкиПанелька", Состояние.КолонкиПанелька);
		Контекст.Вставить("ТекущаяСтраницаПанелька", Состояние.ТекущаяСтраница);
		Если Состояние.Диагностика Тогда
			ДобавитьЭтапДиагностикиПанелькаЗначение(Состояние.Отчет, "Сервер: расчёт размещения", Начало);
		КонецЕсли;
		Готовое = Новый Структура;
		Готовое.Вставить("Версия", 2);
		Готовое.Вставить("Форма", Состояние.Форма);
		Готовое.Вставить("Контекст", Контекст);
		Готовое.Вставить("Подпись", Состояние.Подпись);
		Готовое.Вставить("ОтчетДиагностики", Состояние.Отчет);
		ПоместитьВоВременноеХранилище(Новый ХранилищеЗначения(Готовое), Адрес);
		Возврат;
	КонецЕсли;
	СохранитьЭтапПодготовкиПанелька(Адрес, Состояние, НомерЭтапа, Начало);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьЭтапПодготовкиПанелька(Знач Адрес, Знач Форма, Знач Этап)
	Обертка = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(Обертка) <> Тип("ХранилищеЗначения") Тогда
		ВызватьИсключение "Данные подготовки панели устарели. Обновите панель.";
	КонецЕсли;
	Состояние = Обертка.Получить();
	Если ТипЗнч(Состояние) <> Тип("Структура") Тогда
		ВызватьИсключение "Некорректные данные подготовки панели.";
	КонецЕсли;
	Если Не Состояние.Свойство("Версия") Или Не Состояние.Свойство("Форма") Или Не Состояние.Свойство("Этап") Тогда
		ВызватьИсключение "Некорректный формат подготовки панели.";
	КонецЕсли;
	Если Состояние.Версия <> 3 Или Состояние.Форма <> Форма Или Состояние.Этап <> Этап Тогда
		ВызватьИсключение "Нарушен порядок подготовки панели. Обновите панель.";
	КонецЕсли;
	Возврат Состояние;
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьЭтапПодготовкиПанелька(Знач Адрес, Состояние, Знач Этап, Знач НачалоЭтапа)
	Если Состояние.Диагностика Тогда
		Названия = СтрРазделить("Подготовка типов обработок|Подготовка ссылок|Проверка доступности|Избранное и структура страниц", "|");
		Индекс = ?(Этап = 6, 3, Этап - 3);
		ДобавитьЭтапДиагностикиПанелькаЗначение(Состояние.Отчет, "Сервер: " + Названия[Индекс], НачалоЭтапа);
	КонецЕсли;
	Состояние.Этап = Этап;
	ПоместитьВоВременноеХранилище(Новый ХранилищеЗначения(Состояние), Адрес);
КонецПроцедуры

&НаСервере
Функция ПроверитьПодготовкуПоЭтапамПанелька()
	Состояние = ПрочитатьЭтапПодготовкиПанелька(АдресПостроенияПанелька, Строка(УникальныйИдентификатор), 4);
	Начало = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	Кэш = Новый Соответствие;
	ЗаполнитьКэшСтатусовДопОбработок(Состояние.Настройки.ДанныеДопОбработок, Кэш);
	Состояние.Вставить("КэшСтатусов", Кэш);
	Причина = "полное построение";
	Подпись = ПодписьОбычнойПанелиПанелька(Состояние.Настройки, Состояние.Данные, Кэш,
		Состояние.Ширина, Состояние.Высота, Причина, Состояние.КолонкиПанелька);
	Состояние.Вставить("Подпись", Подпись);
	Повторить = Ложь;
	Если Не Состояние.Полное И Не ПустаяСтрока(Подпись) Тогда
		Повторить = ПроверитьСнимокОбычнойПанелиПанелька(Подпись, Причина);
	ИначеЕсли Состояние.Полное Тогда
		Причина = "принудительное полное построение";
	КонецЕсли;
	Если Повторить Тогда
		ОбновитьИзбранноеОбычнойПанелиПанелька(ПолучитьСсылкиСистемногоИзбранного());
		Если Состояние.Диагностика Тогда
			ДобавитьЭтапДиагностикиПанелькаЗначение(Состояние.Отчет, "Сервер: повторное использование панели", Начало);
			ОтчетДиагностикиПанелька = Состояние.Отчет + "Построение: повторное использование существующих элементов" + Символы.ПС;
		КонецЕсли;
		СброситьПорционноеПостроениеПанелька();
		Возврат Истина;
	КонецЕсли;
	Если Состояние.Диагностика Тогда
		Состояние.Отчет = Состояние.Отчет + "Построение: полное; причина: " + Причина + Символы.ПС;
	КонецЕсли;
	СохранитьЭтапПодготовкиПанелька(АдресПостроенияПанелька, Состояние, 5, Начало);
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ПостроитьПодготовленнуюПанельПанелька()
	Обертка = ПолучитьИзВременногоХранилища(АдресПостроенияПанелька);
	Если ТипЗнч(Обертка) <> Тип("ХранилищеЗначения") Тогда
		ВызватьИсключение "Данные загрузки панели устарели. Обновите панель.";
	КонецЕсли;
	Состояние = Обертка.Получить();
	Если Состояние.Версия <> 2 Или Состояние.Форма <> Строка(УникальныйИдентификатор) Тогда
		ВызватьИсключение "Данные загрузки принадлежат другой панели.";
	КонецЕсли;
	ОтчетДиагностикиПанелька = Состояние.ОтчетДиагностики;
	// Снимок аннулируется перед первым изменением дерева, а не во время подготовки данных.
	СброситьСнимокОбычнойПанелиПанелька();
	Если Состояние.Контекст.Данные.Количество() = 0 Тогда
		ПодготовитьФормуКПерерисовке();
		ПоказатьЗаглушкуПустыхНастроек(Состояние.Контекст.ПользовательАдминистратор);
		Элементы.ПолеHTMLДашборда.Видимость = Ложь;
		Если Элементы.Найти("Вкладки") <> Неопределено Тогда
			Элементы.Вкладки.Видимость = Ложь;
		КонецЕсли;
		Если Элементы.Найти("Навигация") <> Неопределено Тогда
			Элементы.Навигация.Видимость = Истина;
		КонецЕсли;
		Если Элементы.Найти("НастройкиПанелька") <> Неопределено Тогда
			Элементы.НастройкиПанелька.Видимость = Ложь;
		КонецЕсли;
		ГотовоКолонокПанелька = 0;
		ВсегоКолонокПанелька = 0;
		СброситьПорционноеПостроениеПанелька();
	Иначе
		ПродолжитьПостроениеНаСервереПанелька();
	КонецЕсли;
КонецПроцедуры

// Сохраняет подготовленные данные до единственного построения всего дерева формы.
// Элементы формы и объект обработки в хранилище не попадают.
&НаСервере
Процедура ПодготовитьПорционноеПостроениеПанелька(Контекст, Знач Подпись)
	СохраненныйКонтекст = Новый Структура;
	Для Каждого Пара Из Контекст Цикл
		Если Пара.Ключ <> "ОбъектОбработки" Тогда
			СохраненныйКонтекст.Вставить(Пара.Ключ, Пара.Значение);
		КонецЕсли;
	КонецЦикла;
	ВсегоКолонокПанелька = Контекст.МассивКолонок.Количество();
	Состояние = Новый Структура;
	Состояние.Вставить("Версия", 2);
	Состояние.Вставить("Форма", Строка(УникальныйИдентификатор));
	Состояние.Вставить("Контекст", СохраненныйКонтекст);
	Состояние.Вставить("Подпись", Подпись);
	АдресПостроенияПанелька = ПоместитьВоВременноеХранилище(Новый ХранилищеЗначения(Состояние), УникальныйИдентификатор);
КонецПроцедуры

// Второй и последний серверный шаг. Вся форма меняется одним пакетом.
&НаСервере
Процедура ПродолжитьПостроениеНаСервереПанелька()
	НачалоПостроения = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	Обертка = ПолучитьИзВременногоХранилища(АдресПостроенияПанелька);
	Если ТипЗнч(Обертка) <> Тип("ХранилищеЗначения") Тогда
		ВызватьИсключение "Данные загрузки панели устарели. Обновите панель.";
	КонецЕсли;
	Состояние = Обертка.Получить();
	Если Состояние.Версия <> 2 Или Состояние.Форма <> Строка(УникальныйИдентификатор) Тогда
		ВызватьИсключение "Данные загрузки принадлежат другой панели.";
	КонецЕсли;
	Контекст = Состояние.Контекст;
	ПодготовитьФормуКПерерисовке();
	Элементы.ПолеHTMLДашборда.Видимость = Ложь;
	Если Элементы.Найти("Вкладки") <> Неопределено Тогда
		Элементы.Вкладки.Видимость = Истина;
	КонецЕсли;
	Если Элементы.Найти("Навигация") <> Неопределено Тогда
		Элементы.Навигация.Видимость = Истина;
	КонецЕсли;
	Если Элементы.Найти("НастройкиПанелька") <> Неопределено Тогда
		Элементы.НастройкиПанелька.Видимость = Ложь;
	КонецЕсли;
	СоздатьКаркасСтраниц(Контекст);
	СоздатьКонтейнерыКатегорий(Контекст);
	ОтрисоватьСсылкиДашборда(Контекст);
	ВсегоКолонокПанелька = Контекст.ВнутренниеФизКолонки.Количество();
	ГотовоКолонокПанелька = ВсегоКолонокПанелька;
	Если ДиагностикаПанелька Тогда
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + ПредставлениеЗамеровСсылокПанелька(Контекст.ЗамерыСсылок)
			+ "Размещений: " + Строка(Контекст.Данные.Количество()) + "; колонок: " + Строка(ВсегоКолонокПанелька) + Символы.ПС;
	КонецЕсли;
	Если Не ПустаяСтрока(Состояние.Подпись) Тогда
		СохранитьСнимокОбычнойПанелиПанелька(Состояние.Подпись);
	КонецЕсли;
	СброситьПорционноеПостроениеПанелька();
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
		"Сервер: построение всей панели", НачалоПостроения);
КонецПроцедуры

&НаСервере
Процедура СброситьПорционноеПостроениеПанелька()
	Если Не ПустаяСтрока(АдресПостроенияПанелька) Тогда
		УдалитьИзВременногоХранилища(АдресПостроенияПанелька);
		АдресПостроенияПанелька = "";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОтменитьПостроениеНаСервереПанелька()
	СброситьПорционноеПостроениеПанелька();
	СброситьСнимокОбычнойПанелиПанелька();
КонецПроцедуры

// Показывает штатное состояние без процентов и без дополнительных серверных вызовов.
// Параметры:
//  Показывать - Булево - показать начало построения или вернуть системное состояние.
// Возвращаемое значение:
//  Булево - состояние удалось установить.
&НаКлиенте
Функция УстановитьСостояниеЗагрузкиПанелька(Знач Показывать)
	Попытка
		Если Показывать Тогда
			Состояние(НСтр("ru = 'Загрузка панели…'"), , НСтр("ru = 'Пожалуйста, подождите.'"));
		Иначе
			Состояние();
		КонецЕсли;
		Возврат Истина;
	Исключение
		// Вспомогательное оформление не должно прерывать загрузку или подменять её ошибку.
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Сохраняет прежний сброс фокуса перед обновлением из формы настроек.
&НаКлиенте
Процедура СброситьФокусПередОбновлениемПанелька()
	Попытка
		Если Элементы.НастройкиПанелька.Видимость Тогда
			ТекущийЭлемент = Элементы.НастройкиПанелька;
		ИначеЕсли Элементы.Найти("СтрокаПоиска") <> Неопределено Тогда
			ТекущийЭлемент = Элементы.СтрокаПоиска;
		КонецЕсли;
	Исключение
		// Форма может ещё не предоставлять доступный элемент фокуса; загрузка продолжится без переноса.
	КонецПопытки;
КонецПроцедуры

// Определяет параметры экрана клиента и запускает перестроение интерфейса панели.
&НаКлиенте
Процедура ВыполнитьОбновлениеДашбордаПанелька(Знач ПринудительноПолное = Ложь)
	ПоколениеЗагрузкиПанелька = ?(ПоколениеЗагрузкиПанелька = Неопределено, 1, ПоколениеЗагрузкиПанелька + 1);
	НачалоЗагрузкиПанелька = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ОтчетКлиентскихЭтапов = "";
	НачалоПолученияЭкрана = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ШиринаМонитора = 1920;
	ВысотаЭкрана = 1080;
	Попытка
		ИнфоЭкранов = ПолучитьИнформациюЭкрановКлиента();
		Если ИнфоЭкранов.Количество() > 0 Тогда
			ШиринаМонитора = ИнфоЭкранов[0].Ширина;
			ВысотаЭкрана = ИнфоЭкранов[0].Высота;
		КонецЕсли;
	Исключение
		// Если сведения об экране недоступны, используем размеры по умолчанию, заданные выше.
	КонецПопытки;
	// Локальный текст сохраняется до возврата: сервер начинает новый общий отчёт.
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетКлиентскихЭтапов, "Клиент: получение параметров экрана",
		НачалоПолученияЭкрана);
	НачалоВызоваСервера = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	НужноПолноеПостроение = ПринудительноПолное Или (ЕстьОшибкиВнешнихФайловПанелька = Истина);
	ЗагрузитьОбъектыКонфигурацииНаСервере(ШиринаМонитора, ВысотаЭкрана, НужноПолноеПостроение);
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетКлиентскихЭтапов,
		"Клиент: серверный вызов загрузки (включая обмен и обработку результата)", НачалоВызоваСервера);
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
		"Клиент: получение экрана и серверная загрузка (включая обмен)", НачалоЗагрузкиПанелька);
	Если ДиагностикаПанелька Тогда
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + ОтчетКлиентскихЭтапов
			+ "Загрузка в текущем экземпляре формы: " + Строка(ПоколениеЗагрузкиПанелька)
			+ ?(ПоколениеЗагрузкиПанелька = 1, " (первичная)", " (повторная)") + Символы.ПС;
	КонецЕсли;
	// В Web-интерфейсе проверка файлов запускается по сигналу готовности документа.
	Если Не РежимHTTP Тогда
		ПрименитьПоискСЗаданнымТекстом(СтрокаПоиска);
		ПроверитьДоступностьВнешнихФайловНаКлиенте();
	КонецЕсли;
КонецПроцедуры

// Читает настройки панели, подготавливает данные и динамически строит элементы интерфейса.
// Параметры:
//  ШиринаМонитора - Число - ширина экрана клиента.
//  ВысотаЭкрана   - Число - высота экрана клиента.
//  ПринудительноПолное - Булево - выполнить полное построение независимо от снимка.
//  ПорционноеПостроение - Булево - вернуть каркас и выполнить подготовку и построение двумя этапами.
&НаСервере
Процедура ЗагрузитьОбъектыКонфигурацииНаСервере(Знач ШиринаМонитора, Знач ВысотаЭкрана,
	Знач ПринудительноПолное, Знач ПорционноеПостроение = Ложь)
	СброситьПорционноеПостроениеПанелька();
	ГотовоКолонокПанелька = 0;
	ВсегоКолонокПанелька = 0;
	Элементы.КолонкиПанелька.Видимость = Не РежимHTTP;
	НачалоСервернойЗагрузки = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ОтчетДиагностикиПанелька = "";
	Если ДиагностикаПанелька Тогда
		ОтчетДиагностикиПанелька = "Панелька: " + ?(РежимHTTP, "Web-интерфейс", "Обычный интерфейс") + Символы.ПС
			+ "Диагностика: native-progress-2" + Символы.ПС
			+ "Время в мс. Клиентские интервалы включают сервер и обмен; вложенные интервалы не суммировать."
			+ Символы.ПС + "html_loaded — сигнал документа, не измерение окончательной отрисовки платформой." +
			Символы.ПС;
	КонецЕсли;
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	// В обычном режиме прежний HTML не используется; Web-построение создаёт его заново.
	Если Не РежимHTTP Тогда
		HTMLДашборд = "";
	КонецЕсли;
	ПанелькаОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Получение объекта обработки", НачалоЭтапа);
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ПанелькаНастройкиДашборда = ПолучитьНастройкиДашборда(ПанелькаОбъектОбработки);
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Чтение и преобразование настроек", НачалоЭтапа);
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ПанелькаВидыДопОбработок = ПолучитьВидыДопОбработокПанелька(ПанелькаНастройкиДашборда.ДанныеДопОбработок);
	ПанелькаДанныеДашборда = СформироватьДанныеДашборда(ПанелькаНастройкиДашборда, ПанелькаВидыДопОбработок);
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Подготовка ссылок", НачалоЭтапа);
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	// Серверный контекст относится к конкретному построению и не задается клиентским флагом.
	// ХранилищеЗначения не передается в тонкий клиент; наружу выходит только адрес.
	КонтекстЗапуска = Новый Структура;
	КонтекстЗапуска.Вставить("Версия", 1);
	КонтекстЗапуска.Вставить("Форма", Строка(УникальныйИдентификатор));
	КонтекстЗапуска.Вставить("Личная", ИспользуетсяЛичнаяПанельПанелька);
	КонтекстЗапуска.Вставить("Ревизия", РевизияЛичногоПрофиляВКонтекстеПанелька);
	ПрежнийАдресКонтекста = АдресКонтекстаЗапускаПанелька;
	АдресКонтекстаЗапускаПанелька = ПоместитьВоВременноеХранилище(
		Новый ХранилищеЗначения(КонтекстЗапуска), УникальныйИдентификатор);
	Если Не ПустаяСтрока(ПрежнийАдресКонтекста) Тогда
		УдалитьИзВременногоХранилища(ПрежнийАдресКонтекста);
	КонецЕсли;
	ПанелькаКэшСтатусовМД = Новый Соответствие;
	ЗаполнитьКэшСтатусовДопОбработок(ПанелькаНастройкиДашборда.ДанныеДопОбработок, ПанелькаКэшСтатусовМД);
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Проверка дополнительных обработок", НачалоЭтапа);
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ПодписьПанели = "";
	ПричинаПостроения = "Web-интерфейс";
	Если Не РежимHTTP Тогда
		НачалоПроверкиСнимка = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		ПодписьПанели = ПодписьОбычнойПанелиПанелька(ПанелькаНастройкиДашборда, ПанелькаДанныеДашборда,
			ПанелькаКэшСтатусовМД, ШиринаМонитора, ВысотаЭкрана, ПричинаПостроения, КолонкиПанелька);
		МожноПовторить = Ложь;
		Если Не ПринудительноПолное И Не ПустаяСтрока(ПодписьПанели) Тогда
			МожноПовторить = ПроверитьСнимокОбычнойПанелиПанелька(ПодписьПанели, ПричинаПостроения);
		ИначеЕсли ПринудительноПолное Тогда
			ПричинаПостроения = "принудительный полный замер";
		КонецЕсли;
		ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
			"Сервер: Проверка повторного использования и статусов", НачалоПроверкиСнимка);
		Если МожноПовторить Тогда
			НачалоОбновленияИзбранного = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
			ОбновленоКнопок = ОбновитьИзбранноеОбычнойПанелиПанелька(ПолучитьСсылкиСистемногоИзбранного());
			ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Точечное обновление избранного",
				НачалоОбновленияИзбранного);
			Если ДиагностикаПанелька Тогда
				ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька +
					"Построение: повторное использование существующих элементов" + Символы.ПС
					+ "Новых элементов: 0; новых команд: 0; обновлено кнопок избранного: " + Строка(ОбновленоКнопок) +
					Символы.ПС
					+ "Размещений: " + Строка(ПанелькаДанныеДашборда.Количество()) + "; строк соответствий: " +
					Строка(ТаблицаСоответствияОбъектов.Количество()) + Символы.ПС;
			КонецЕсли;
			ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
				"Сервер: вся процедура загрузки (включает этапы выше)", НачалоСервернойЗагрузки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// Снимок становится недействительным ДО удаления элементов: сбой построения не оставит ложного попадания.
	СброситьСнимокОбычнойПанелиПанелька();
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	// Запоминаем вкладку до удаления её динамических дочерних элементов.
	ТекущаяСтраницаПанелька = "";
	ГруппаСтраницыПанелька = Элементы.Найти("Вкладки");
	Если ГруппаСтраницыПанелька <> Неопределено И ГруппаСтраницыПанелька.ТекущаяСтраница <> Неопределено Тогда
		ТекущаяСтраницаПанелька = ГруппаСтраницыПанелька.ТекущаяСтраница.Заголовок;
	КонецЕсли;
	Если Не ПорционноеПостроение Или ПанелькаДанныеДашборда.Количество() = 0 Тогда
		ПодготовитьФормуКПерерисовке();
	КонецЕсли;
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Подготовка формы", НачалоЭтапа);
	Если ДиагностикаПанелька Тогда
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Построение: полное; причина: " + ПричинаПостроения + Символы.ПС;
	КонецЕсли;
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	// Выбираем заглушку для текущего режима интерфейса.
	Если ПанелькаДанныеДашборда.Количество() = 0 Тогда
		Если РежимHTTP Тогда
			// В режиме HTTP мы не прерываем процедуру Возвратом.
			Если Элементы.Найти("ГруппаЗаглушкаПустыхНастроек") <> Неопределено Тогда
				Элементы.ГруппаЗаглушкаПустыхНастроек.Видимость = Ложь;
			КонецЕсли;
		Иначе
			// Включаем навигацию (тумблер, строку поиска), если переключились из HTTP
			Если Элементы.Найти("Навигация") <> Неопределено Тогда
				Элементы.Навигация.Видимость = Истина;
			КонецЕсли;
			// Настройки показываем только если есть права
			Если Элементы.Найти("НастройкиПанелька") <> Неопределено Тогда
				Элементы.НастройкиПанелька.Видимость = Ложь;
			КонецЕсли;
			// Для обычного интерфейса показываем нативную заглушку и прерываем отрисовку
			ПоказатьЗаглушкуПустыхНастроек(ПанелькаНастройкиДашборда.ПользовательАдминистратор);
			Если Элементы.Найти("ПолеHTMLДашборда") <> Неопределено Тогда
				Элементы.ПолеHTMLДашборда.Видимость = Ложь;
			КонецЕсли;
			Если Элементы.Найти("Вкладки") <> Неопределено Тогда
				Элементы.Вкладки.Видимость = Ложь;
			КонецЕсли;
			ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: пустая панель", НачалоЭтапа);
			Если ДиагностикаПанелька Тогда
				ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Размещений: 0" + Символы.ПС;
			КонецЕсли;
			ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
				"Сервер: вся процедура загрузки (включает этапы выше)", НачалоСервернойЗагрузки);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// ---------------------------------------------------------
	ПанелькаСсылкиИзбранного = ПолучитьСсылкиСистемногоИзбранного();
	ПанелькаСтруктураСтраниц = СформироватьСтруктуруСтраниц(
		ПанелькаНастройкиДашборда.ДанныеСтраниц,
		ПанелькаНастройкиДашборда.ДанныеКолонок);
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Избранное и структура страниц", НачалоЭтапа);
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ПанелькаМетрикиДашборда = РассчитатьМетрикиДашборда(
		ПанелькаДанныеДашборда,
		ПанелькаСтруктураСтраниц,
		ПанелькаНастройкиДашборда);
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: Расчёт размещения и сортировка", НачалоЭтапа);
	НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ПанелькаКонтекстОтрисовки = Новый Структура;
	ПанелькаКонтекстОтрисовки.Вставить("ШиринаМонитора", ШиринаМонитора);
	ПанелькаКонтекстОтрисовки.Вставить("ВысотаЭкрана", ВысотаЭкрана);
	ПанелькаКонтекстОтрисовки.Вставить("ОбъектОбработки", ПанелькаОбъектОбработки);
	ПанелькаКонтекстОтрисовки.Вставить("КэшСтатусовМД", ПанелькаКэшСтатусовМД);
	ПанелькаКонтекстОтрисовки.Вставить("СуффиксОтрисовки", СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", ""));
	ПанелькаКонтекстОтрисовки.Вставить("Данные", ПанелькаДанныеДашборда);
	ПанелькаКонтекстОтрисовки.Вставить("СсылкиИзбранного", ПанелькаСсылкиИзбранного);
	// Настройки дашборда.
	Для Каждого Элемент Из ПанелькаНастройкиДашборда Цикл
		ПанелькаКонтекстОтрисовки.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	// Структура страниц.
	Для Каждого Элемент Из ПанелькаСтруктураСтраниц Цикл
		ПанелькаКонтекстОтрисовки.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	// Рассчитанные метрики.
	Для Каждого Элемент Из ПанелькаМетрикиДашборда Цикл
		ПанелькаКонтекстОтрисовки.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	ПанелькаКонтекстОтрисовки.Вставить("КолонкиПанелька", КолонкиПанелька);
	ПанелькаКонтекстОтрисовки.Вставить("ТекущаяСтраницаПанелька", ТекущаяСтраницаПанелька);
	Если ПорционноеПостроение И Не РежимHTTP Тогда
		ПодготовитьПорционноеПостроениеПанелька(ПанелькаКонтекстОтрисовки, ПодписьПанели);
		ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
			"Сервер: подготовка данных панели", НачалоСервернойЗагрузки);
		Возврат;
	КонецЕсли;
	// РАЗДЕЛЕНИЕ ИНТЕРФЕЙСОВ: Выбор механизма отрисовки
	Если РежимHTTP Тогда
		// Полностью скрываем штатную навигацию 1С
		Если Элементы.Найти("Навигация") <> Неопределено Тогда
			Элементы.Навигация.Видимость = Ложь;
		КонецЕсли;
		Если Элементы.Найти("Вкладки") <> Неопределено Тогда
			Элементы.Вкладки.Видимость = Ложь;
		КонецЕсли;
		Если Элементы.Найти("ГруппаЗаглушкаПустыхНастроек") <> Неопределено Тогда
			Элементы.ГруппаЗаглушкаПустыхНастроек.Видимость = Ложь;
		КонецЕсли;
		Элементы.ПолеHTMLДашборда.Видимость = Истина;
		НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		СформироватьHTMLДашборда(ПанелькаКонтекстОтрисовки);
		ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
			"Сервер: Web-данные, статусы ссылок, картинки и HTML", НачалоЭтапа);
	Иначе
		// Включаем штатную навигацию обратно
		Если Элементы.Найти("Навигация") <> Неопределено Тогда
			Элементы.Навигация.Видимость = Истина;
		КонецЕсли;
		Если Элементы.Найти("НастройкиПанелька") <> Неопределено Тогда
			Элементы.НастройкиПанелька.Видимость = Ложь;
		КонецЕсли;
		Если Элементы.Найти("Вкладки") <> Неопределено Тогда
			Элементы.Вкладки.Видимость = Истина;
		КонецЕсли;
		Элементы.ПолеHTMLДашборда.Видимость = Ложь;
		// Штатная отрисовка 1С
		НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		СоздатьКаркасСтраниц(ПанелькаКонтекстОтрисовки);
		ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: каркас страниц", НачалоЭтапа);
		НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		СоздатьКонтейнерыКатегорий(ПанелькаКонтекстОтрисовки);
		ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: контейнеры категорий", НачалоЭтапа);
		НачалоЭтапа = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		ОтрисоватьСсылкиДашборда(ПанелькаКонтекстОтрисовки);
		ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: ссылки, статусы и завершающее оформление",
			НачалоЭтапа);
		Если ДиагностикаПанелька Тогда
			ЗамерыСсылок = Неопределено;
			Если ПанелькаКонтекстОтрисовки.Свойство("ЗамерыСсылок", ЗамерыСсылок) Тогда
				ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + ПредставлениеЗамеровСсылокПанелька(ЗамерыСсылок);
			Иначе
				ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Детализация ссылок: данные не получены." + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Не РежимHTTP И Не ПустаяСтрока(ПодписьПанели) Тогда
		СохранитьСнимокОбычнойПанелиПанелька(ПодписьПанели);
	КонецЕсли;
	Если ДиагностикаПанелька Тогда
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Размещений: " + Строка(ПанелькаДанныеДашборда.Количество())
			+ "; колонок: " + Строка(ПанелькаСтруктураСтраниц.МассивКолонок.Количество()) + Символы.ПС;
	КонецЕсли;
	Если ДиагностикаПанелька Тогда
		ДлинаСоответствий = 0;
		Для Каждого СтрокаСоответствия Из ТаблицаСоответствияОбъектов Цикл
			ДлинаСоответствий = ДлинаСоответствий + СтрДлина(СтрокаСоответствия.ИмяЭлемента) +
				СтрДлина(СтрокаСоответствия.Ссылка);
		КонецЦикла;
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Данные формы: строк соответствий " +
			Строка(ТаблицаСоответствияОбъектов.Количество())
			+ "; символов в именах и ссылках " + Строка(ДлинаСоответствий)
			+ "; символов HTML " + Строка(СтрДлина(HTMLДашборд)) + Символы.ПС
			+ "Символы — объём строк, не размер сетевого обмена. Элементы формы в него не включены." + Символы.ПС;
	КонецЕсли;
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Сервер: вся процедура загрузки (включает этапы выше)",
		НачалоСервернойЗагрузки);
КонецПроцедуры

#КонецОбласти

#Область ЧтениеИПодготовкаДанных

// Читает глобальные настройки Панелька из безопасного хранилища БСП.
// Возвращаемое значение:
//  Произвольный - сохраненные настройки или Неопределено.
&НаСервере
Функция ПанелькаПрочитатьНастройкиДашборда()
	ИспользуетсяЛичнаяПанельПанелька = Ложь;
	ЕстьЛичнаяПанельВКонтекстеПанелька = Ложь;
	РевизияЛичногоПрофиляВКонтекстеПанелька = "";
	ПерсональнаяПанельРазрешенаПанелька = РеквизитФормыВЗначение("Объект").ПанелькаРазрешенаПерсональнаяПанель();
	Элементы.ПереключитьПанельПанелька.Видимость = ПерсональнаяПанельРазрешенаПанелька И
		ПравоДоступа("СохранениеДанныхПользователя", Метаданные);
	Элементы.ПерсональнаяНастройкаПанелиПанелька.Видимость = Элементы.ПереключитьПанельПанелька.Видимость;
	Элементы.БлокНастройкиФормыПанелька.Видимость = Не РежимHTTP;
	Элементы.БлокНастройкиПанелиПанелька.Видимость = Элементы.ПерсональнаяНастройкаПанелиПанелька.Видимость Или
		Элементы.ОбщаяНастройкаВГруппеПанелька.Видимость;
	Элементы.НастройкаФормыПанелька.Видимость = Элементы.БлокНастройкиФормыПанелька.Видимость Или
		Элементы.БлокНастройкиПанелиПанелька.Видимость;
	Если ПерсональнаяПанельРазрешенаПанелька И ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		Обработка = РеквизитФормыВЗначение("Объект");
		Попытка
			Профиль = Обработка.ПанелькаПрочитатьЛичныйПрофиль();
			ЕстьЛичнаяПанельВКонтекстеПанелька = Профиль.Данные <> Неопределено;
			Если Профиль.Активна И Профиль.Данные <> Неопределено Тогда
				ИспользуетсяЛичнаяПанельПанелька = Истина;
				РевизияЛичногоПрофиляВКонтекстеПанелька = Профиль.Ревизия;
				КонтекстДоступа = Обработка.ПанелькаКонтекстДоступаЛичнойПанели();
				Обработка.ПанелькаПроверитьМодель(Профиль.Данные);
				ВидимаяМодель = Обработка.ПанелькаЛичнаяВидимаяМодель(Профиль.Данные, КонтекстДоступа);
				Если Не КонтекстДоступа.Политика.СтандартныеИнструменты Тогда
					ВидимаяМодель.СтандартныеНаОтдельнойВкладке = Ложь;
				КонецЕсли;
				Возврат ВидимаяМодель;
			КонецЕсли;
		Исключение
			ИспользуетсяЛичнаяПанельПанелька = Ложь;
			ЕстьЛичнаяПанельВКонтекстеПанелька = Ложь;
			ЗаписатьОшибкуПанелька("ЧтениеЛичногоПрофиля", ИнформацияОбОшибке());
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Персональная панель не загружена. Показана общая панель. %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;
	Возврат РеквизитФормыВЗначение("Объект").ПанелькаПрочитатьОбщиеНастройки();
КонецФункции

// Загружает настройки «Панельки» и формирует структуру параметров отображения.
//
// Параметры:
//  ОбъектОбработки - ВнешняяОбработка.Панелька - серверный экземпляр Панелька; имя подключенного экземпляра может назначаться WMS или БСП.
//
// Возвращаемое значение:
//  Структура - параметры отображения и таблицы сохраненных настроек.
&НаСервере
Функция ПолучитьНастройкиДашборда(Знач ОбъектОбработки)
	ДанныеХранилища = ОбъектОбработки.ПанелькаПредставлениеДляДашборда(ПанелькаПрочитатьНастройкиДашборда());
	ДанныеОбъектов = Неопределено;
	ДанныеВнешнихФайлов = Неопределено;
	ДанныеКолонок = Неопределено;
	ДанныеСтраниц = Неопределено;
	ДанныеВебСсылок = Неопределено;
	ДанныеДопОбработок = Неопределено;
	ГруппироватьПоТипу = Истина;
	НеРаспределенныеНаОтдельнойВкладке = Ложь;
	СтандартныеНаОтдельнойВкладке = Ложь;
	ШрифтКолонки = Новый Шрифт(, 13, Истина, Ложь);
	ЦветКолонки = Новый Цвет();
	ШрифтГруппировки = Новый Шрифт(, 9, Ложь, Ложь);
	ЦветГруппировки = WebЦвета.ТемноСерый;
	РежимПодсказок = ОтображениеПодсказки.ОтображатьСнизу;
	ПользовательАдминистратор = ПользовательИмеетПраваАдмина();
	Если ТипЗнч(ДанныеХранилища) = Тип("Структура") Тогда
		ДанныеХранилища.Свойство("Ссылки", ДанныеОбъектов);
		ДанныеХранилища.Свойство("ВнешниеФайлы", ДанныеВнешнихФайлов);
		ДанныеХранилища.Свойство("Колонки", ДанныеКолонок);
		ДанныеХранилища.Свойство("Страницы", ДанныеСтраниц);
		ДанныеХранилища.Свойство("ВебСсылки", ДанныеВебСсылок);
		ДанныеХранилища.Свойство("ДопОбработки", ДанныеДопОбработок);
		ДанныеХранилища.Свойство("Группировать", ГруппироватьПоТипу);
		ДанныеХранилища.Свойство("НеРаспределенныеНаОтдельнойВкладке", НеРаспределенныеНаОтдельнойВкладке);
		ДанныеХранилища.Свойство("СтандартныеНаОтдельнойВкладке", СтандартныеНаОтдельнойВкладке);
		ВремШрифт = Неопределено;
		ВремЦвет = Неопределено;
		Если ДанныеХранилища.Свойство("ШрифтКолонки", ВремШрифт) И ТипЗнч(ВремШрифт) = Тип("Шрифт") Тогда
			ШрифтКолонки = ВремШрифт;
		КонецЕсли;
		Если ДанныеХранилища.Свойство("ЦветКолонки", ВремЦвет) И ТипЗнч(ВремЦвет) = Тип("Цвет") Тогда
			ЦветКолонки = ВремЦвет;
		КонецЕсли;
		Если ДанныеХранилища.Свойство("ШрифтГруппировки", ВремШрифт) И ТипЗнч(ВремШрифт) = Тип("Шрифт") Тогда
			ШрифтГруппировки = ВремШрифт;
		КонецЕсли;
		Если ДанныеХранилища.Свойство("ЦветГруппировки", ВремЦвет) И ТипЗнч(ВремЦвет) = Тип("Цвет") Тогда
			ЦветГруппировки = ВремЦвет;
		КонецЕсли;
		ВремРежим = "";
		Если ДанныеХранилища.Свойство("РежимОтображенияПодсказок", ВремРежим) Тогда
			Если ВремРежим = "Всплывающая" Тогда
				РежимПодсказок = ОтображениеПодсказки.Всплывающая;
			ИначеЕсли ВремРежим = "Кнопка" Тогда
				РежимПодсказок = ОтображениеПодсказки.Кнопка;
			ИначеЕсли ВремРежим = "Нет" Тогда
				РежимПодсказок = ОтображениеПодсказки.Нет;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Настройки = Новый Структура;
	Настройки.Вставить("ДанныеХранилища", ДанныеХранилища);
	Настройки.Вставить("ДанныеОбъектов", ДанныеОбъектов);
	Настройки.Вставить("ДанныеВнешнихФайлов", ДанныеВнешнихФайлов);
	Настройки.Вставить("ДанныеКолонок", ДанныеКолонок);
	Настройки.Вставить("ДанныеСтраниц", ДанныеСтраниц);
	Настройки.Вставить("ДанныеВебСсылок", ДанныеВебСсылок);
	Настройки.Вставить("ДанныеДопОбработок", ДанныеДопОбработок);
	Настройки.Вставить("ГруппироватьПоТипу", ГруппироватьПоТипу);
	Настройки.Вставить("НеРаспределенныеНаОтдельнойВкладке", НеРаспределенныеНаОтдельнойВкладке);
	Настройки.Вставить("СтандартныеНаОтдельнойВкладке", СтандартныеНаОтдельнойВкладке);
	Настройки.Вставить("ШрифтКолонки", ШрифтКолонки);
	Настройки.Вставить("ЦветКолонки", ЦветКолонки);
	Настройки.Вставить("ШрифтГруппировки", ШрифтГруппировки);
	Настройки.Вставить("ЦветГруппировки", ЦветГруппировки);
	Настройки.Вставить("РежимПодсказок", РежимПодсказок);
	Настройки.Вставить("ПользовательАдминистратор", ПользовательАдминистратор);
	Возврат Настройки;
КонецФункции

// Возвращает сохраненную позицию ссылки в визуальном порядке панели.
// Если ссылка отсутствует в списке порядка, возвращается большое значение,
// после чего сохраняется прежняя алфавитная сортировка как резервный вариант.


// Возвращает адрес интерфейса из сохраненного адреса и технического источника.
// Префиксы совпадают с адаптацией таблиц; служат для выбора исходной строки перед повторной проверкой прав.
&НаКлиентеНаСервереБезКонтекста
Функция АдресСсылкиДашбордаПанелька(Адрес, Источник)
	Если Источник = "web" Тогда
		Возврат "web_link:" + Адрес;
	ИначеЕсли Источник = "files" Тогда
		Возврат "ext_file:" + Адрес;
	КонецЕсли;
	Возврат Адрес;
КонецФункции

// Преобразует сохраненные источники панели в единую таблицу данных для отрисовки.
// Параметры:
//  Настройки - Структура - адаптированные таблицы источников и порядок ссылок панели.
//  ВидыДопОбработок - Неопределено, Соответствие из Строка - виды по типизированным ссылкам;
//   отсутствие значения сохраняет прежнее чтение реквизита.
&НаСервереБезКонтекста
Функция СформироватьДанныеДашборда(Настройки, ВидыДопОбработок = Неопределено)
	ДанныеОбъектов = Настройки.ДанныеОбъектов;
	ДанныеВнешнихФайлов = Настройки.ДанныеВнешнихФайлов;
	ДанныеВебСсылок = Настройки.ДанныеВебСсылок;
	ДанныеДопОбработок = Настройки.ДанныеДопОбработок;
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("Подсказка", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("Колонка", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("ТипОбъекта", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("Вкладка", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("ПорядокГруппы", Новый ОписаниеТипов("Число"));
	Данные.Колонки.Добавить("Источник", Новый ОписаниеТипов("Строка"));
	Если ТипЗнч(ДанныеОбъектов) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Стр Из ДанныеОбъектов Цикл
			КолонкиМассив = Новый Массив;
			КолонкиМассив.Добавить(Стр.Колонка);
			Если КолонкиМассив.Количество() = 0 Тогда
				КолонкиМассив.Добавить("");
			КонецЕсли;
			Для Каждого ИмяКол Из КолонкиМассив Цикл
				НовСтр = Данные.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, Стр);
				НовСтр.Колонка = СокрЛП(ИмяКол);
				НовСтр.Порядок = Стр.Порядок;
				НовСтр.Источник = "objects";
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(ДанныеВнешнихФайлов) = Тип("ТаблицаЗначений") Тогда
		ЕстьПодск = (ДанныеВнешнихФайлов.Колонки.Найти("Подсказка") <> Неопределено);
		Для Каждого Стр Из ДанныеВнешнихФайлов Цикл
			КолонкиМассив = Новый Массив;
			КолонкиМассив.Добавить(Стр.Колонка);
			Если КолонкиМассив.Количество() = 0 Тогда
				КолонкиМассив.Добавить("");
			КонецЕсли;
			Для Каждого ИмяКол Из КолонкиМассив Цикл
				НовСтр = Данные.Добавить();
				НовСтр.Ссылка = АдресСсылкиДашбордаПанелька(Стр.Путь, "files");
				НовСтр.Наименование = Стр.Наименование;
				НовСтр.Колонка = СокрЛП(ИмяКол);
				НовСтр.Порядок = Стр.Порядок;
				НовСтр.Источник = "files";
				Если ЕстьПодск И ЗначениеЗаполнено(Стр.Подсказка) Тогда
					НовСтр.Подсказка = Стр.Подсказка;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(ДанныеВебСсылок) = Тип("ТаблицаЗначений") Тогда
		ЕстьПодск = (ДанныеВебСсылок.Колонки.Найти("Подсказка") <> Неопределено);
		Для Каждого Стр Из ДанныеВебСсылок Цикл
			КолонкиМассив = Новый Массив;
			КолонкиМассив.Добавить(Стр.Колонка);
			Если КолонкиМассив.Количество() = 0 Тогда
				КолонкиМассив.Добавить("");
			КонецЕсли;
			Для Каждого ИмяКол Из КолонкиМассив Цикл
				НовСтр = Данные.Добавить();
				НовСтр.Ссылка = АдресСсылкиДашбордаПанелька(Стр.Ссылка, "web");
				НовСтр.Наименование = Стр.Наименование;
				НовСтр.Колонка = СокрЛП(ИмяКол);
				НовСтр.Порядок = Стр.Порядок;
				НовСтр.Источник = "web";
				Если ЕстьПодск И ЗначениеЗаполнено(Стр.Подсказка) Тогда
					НовСтр.Подсказка = Стр.Подсказка;
				КонецЕсли;
				НовСтр.ТипОбъекта = "Веб-ссылки";
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(ДанныеДопОбработок) = Тип("ТаблицаЗначений") Тогда
		ЕстьПодск = (ДанныеДопОбработок.Колонки.Найти("Подсказка") <> Неопределено);
		КэшВидов = Новый Соответствие;
		Для Каждого Стр Из ДанныеДопОбработок Цикл
			КолонкиМассив = Новый Массив;
			КолонкиМассив.Добавить(Стр.Колонка);
			Если КолонкиМассив.Количество() = 0 Тогда
				КолонкиМассив.Добавить("");
			КонецЕсли;
			ТипДопОбъекта = "Дополнительные обработки";
			ПозицияRef = СтрНайти(Стр.Ссылка, "?ref=");
			ПозицияСпр = СтрНайти(Стр.Ссылка, "Справочник.");
			Если ПозицияRef > 0 И ПозицияСпр > 0 Тогда
				ИмяСпр = Сред(Стр.Ссылка, ПозицияСпр + 11, ПозицияRef - ПозицияСпр - 11);
				Если Метаданные.Справочники.Найти(ИмяСпр) <> Неопределено Тогда
					УИДСтрокаRaw = Сред(Стр.Ссылка, ПозицияRef + 5, 32);
					УИДСтрока = Сред(УИДСтрокаRaw, 25, 8) + "-" + Сред(УИДСтрокаRaw, 21, 4) + "-" +
						Сред(УИДСтрокаRaw, 17, 4) + "-" + Сред(УИДСтрокаRaw, 1, 4) + "-" + Сред(УИДСтрокаRaw, 5, 12);
					Попытка
						УИД = Новый УникальныйИдентификатор(УИДСтрока);
						ФизическаяСсылка = Справочники[ИмяСпр].ПолучитьСсылку(УИД);
						КэшированныйВид = КэшВидов[ФизическаяСсылка];
						Если КэшированныйВид = Неопределено Тогда
							Если ТипЗнч(ВидыДопОбработок) = Тип("Соответствие") Тогда
								КэшированныйВид = ВидыДопОбработок[ФизическаяСсылка];
							КонецЕсли;
							Если КэшированныйВид = Неопределено Тогда
								Если ИмяСпр = "ВнешниеОбработки" Тогда
									КэшированныйВид = Строка(ФизическаяСсылка.ТипОбработки);
								Иначе
									КэшированныйВид = Строка(ФизическаяСсылка.Вид);
								КонецЕсли;
							КонецЕсли;
							КэшВидов.Вставить(ФизическаяСсылка, КэшированныйВид);
						КонецЕсли;
						Если СтрНайти(НРег(КэшированныйВид), "отчет") > 0 Тогда
							ТипДопОбъекта = "Дополнительные отчеты";
						КонецЕсли;
					Исключение
						// Если вид недоступен, сохраняем исходную категорию; статус ссылки проверяется отдельно.
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			Для Каждого ИмяКол Из КолонкиМассив Цикл
				НовСтр = Данные.Добавить();
				НовСтр.Ссылка = Стр.Ссылка;
				НовСтр.Наименование = Стр.Наименование;
				НовСтр.Колонка = СокрЛП(ИмяКол);
				НовСтр.Порядок = Стр.Порядок;
				НовСтр.Источник = "extra";
				Если ЕстьПодск И ЗначениеЗаполнено(Стр.Подсказка) Тогда
					НовСтр.Подсказка = Стр.Подсказка;
				КонецЕсли;
				НовСтр.ТипОбъекта = ТипДопОбъекта;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Возврат Данные;
КонецФункции

// Подготавливает страницы и логические колонки панели с учетом ролей доступа.
//
// Параметры:
//  ДанныеСтраниц - Неопределено, ТаблицаЗначений - страницы сохраненных настроек; читаются ИмяСтраницы, необязательные ИмяКартинки и РолиДоступа.
//  ДанныеКолонок - Неопределено, ТаблицаЗначений - колонки сохраненных настроек; ИмяКолонки и необязательные Страница, ОтдельнаяВкладка, ИмяКартинки, ЗаголовокКолонки.
//
// Возвращаемое значение:
//  Структура - разрешенная структура страниц:
//  * МассивКолонок - Массив из Строка - идентификаторы или прежние имена колонок.
//  * МассивСтраниц - Массив из Строка - отображаемые страницы.
//  * НастройкиКолонокСтраница - Соответствие из КлючИЗначение - назначение колонок:
//  ** Ключ - Строка - колонка.
//  ** Значение - Строка - имя страницы.
//  * ЗаголовкиКолонок - Соответствие из КлючИЗначение - подписи колонок:
//  ** Ключ - Строка - колонка.
//  ** Значение - Строка - подпись.
//  * ИконкиСтраниц - Соответствие из КлючИЗначение - картинки страниц:
//  ** Ключ - Строка - страница.
//  ** Значение - Строка - имя картинки.
//  * ИконкиКолонок - Соответствие из КлючИЗначение - картинки колонок:
//  ** Ключ - Строка - колонка.
//  ** Значение - Строка - имя картинки.
//  * ЗапрещенныеСтраницы - Соответствие из КлючИЗначение - страницы, скрытые по ролям:
//  ** Ключ - Строка - страница.
//  ** Значение - Булево - Истина для запрещенной страницы.
&НаСервереБезКонтекста
Функция СформироватьСтруктуруСтраниц(Знач ДанныеСтраниц, Знач ДанныеКолонок)
	МассивКолонок = Новый Массив;
	МассивСтраниц = Новый Массив;
	МассивСтраниц.Добавить("Главная");
	НастройкиКолонокСтраница = Новый Соответствие;
	ЗаголовкиКолонок = Новый Соответствие;
	ИконкиСтраниц = Новый Соответствие;
	ИконкиКолонок = Новый Соответствие;
	ЗапрещенныеСтраницы = Новый Соответствие;
	Если ТипЗнч(ДанныеСтраниц) = Тип("ТаблицаЗначений") Тогда
		ЕстьИконки = (ДанныеСтраниц.Колонки.Найти("ИмяКартинки") <> Неопределено);
		ЕстьРоли = (ДанныеСтраниц.Колонки.Найти("РолиДоступа") <> Неопределено);
		Для Каждого Стр Из ДанныеСтраниц Цикл
			Если Не ЗначениеЗаполнено(Стр.ИмяСтраницы) Тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьРоли И ЗначениеЗаполнено(Стр.РолиДоступа) И Стр.ИмяСтраницы <> "Главная" Тогда
				ДоступРазрешен = Ложь;
				Если ПользовательИмеетПраваАдмина() Тогда
					ДоступРазрешен = Истина;
				Иначе
					МассивРолей = СтрРазделить(Стр.РолиДоступа, ",");
					Для Каждого ИмяРоли Из МассивРолей Цикл
						Если РольДоступна(СокрЛП(ИмяРоли)) Тогда
							ДоступРазрешен = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если Не ДоступРазрешен Тогда
					ЗапрещенныеСтраницы.Вставить(Стр.ИмяСтраницы, Истина);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если МассивСтраниц.Найти(Стр.ИмяСтраницы) = Неопределено Тогда
				МассивСтраниц.Добавить(Стр.ИмяСтраницы);
			КонецЕсли;
			Если ЕстьИконки И ЗначениеЗаполнено(Стр.ИмяКартинки) Тогда
				ИконкиСтраниц.Вставить(Стр.ИмяСтраницы, Стр.ИмяКартинки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ТипЗнч(ДанныеКолонок) = Тип("ТаблицаЗначений") Тогда
		ЕстьСтр = (ДанныеКолонок.Колонки.Найти("Страница") <> Неопределено);
		ЕстьФлаг = (ДанныеКолонок.Колонки.Найти("ОтдельнаяВкладка") <> Неопределено);
		ЕстьКартинкаКол = (ДанныеКолонок.Колонки.Найти("ИмяКартинки") <> Неопределено);
		Для Каждого СтрКолонка Из ДанныеКолонок Цикл
			Если ЗначениеЗаполнено(СтрКолонка.ИмяКолонки) Тогда
				ИмяНазн = "Главная";
				Если ЕстьСтр И ЗначениеЗаполнено(СтрКолонка.Страница) Тогда
					ИмяНазн = СтрКолонка.Страница;
				ИначеЕсли ЕстьФлаг И СтрКолонка.ОтдельнаяВкладка Тогда
					ИмяНазн = СтрКолонка.ИмяКолонки;
				КонецЕсли;
				Если МассивСтраниц.Найти(ИмяНазн) = Неопределено И ИмяНазн <> "Главная" Тогда
					Продолжить;
				КонецЕсли;
				МассивКолонок.Добавить(СтрКолонка.ИмяКолонки);
				ЗаголовокКолонки = СтрКолонка.ИмяКолонки;
				Если ДанныеКолонок.Колонки.Найти("ЗаголовокКолонки") <> Неопределено Тогда
					ЗаголовокКолонки = СтрКолонка.ЗаголовокКолонки;
				КонецЕсли;
				ЗаголовкиКолонок.Вставить(СтрКолонка.ИмяКолонки, ЗаголовокКолонки);
				НастройкиКолонокСтраница.Вставить(СтрКолонка.ИмяКолонки, ИмяНазн);
				Если ЕстьКартинкаКол И ЗначениеЗаполнено(СтрКолонка.ИмяКартинки) Тогда
					ИконкиКолонок.Вставить(СтрКолонка.ИмяКолонки, СтрКолонка.ИмяКартинки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("МассивКолонок", МассивКолонок);
	Результат.Вставить("МассивСтраниц", МассивСтраниц);
	Результат.Вставить("НастройкиКолонокСтраница", НастройкиКолонокСтраница);
	Результат.Вставить("ЗаголовкиКолонок", ЗаголовкиКолонок);
	Результат.Вставить("ИконкиСтраниц", ИконкиСтраниц);
	Результат.Вставить("ИконкиКолонок", ИконкиКолонок);
	Результат.Вставить("ЗапрещенныеСтраницы", ЗапрещенныеСтраницы);
	Возврат Результат;
КонецФункции

// Сохраняет пользовательскую настройку панели в хранилище.
// Параметры:
//  КлючНастройки - Строка - Идентификатор настройки.
//  Значение      - Произвольный - Сохраняемое значение.
&НаСервереБезКонтекста
Процедура СохранитьПользовательскуюНастройкуПанелька(КлючНастройки, Значение)
	ХранилищеОбщихНастроек.Сохранить("Панелька_UI_Настройки", КлючНастройки, Значение);
КонецПроцедуры

// Получает пользовательскую настройку панели из хранилища.
// Параметры:
//  КлючНастройки      - Строка - Идентификатор настройки.
//  ЗначениеПоУмолчанию- Произвольный - Значение, возвращаемое, если настройка не найдена.
// Возвращаемое значение:
//  Произвольный - Значение настройки или значение по умолчанию.
&НаСервереБезКонтекста
Функция ПолучитьПользовательскуюНастройкуПанелька(КлючНастройки, ЗначениеПоУмолчанию)
	Рез = ХранилищеОбщихНастроек.Загрузить("Панелька_UI_Настройки", КлючНастройки);
	Возврат ?(Рез = Неопределено, ЗначениеПоУмолчанию, Рез);
КонецФункции

// Проверяет версию схемы настроек перед чтением модели.
// Параметры:
//  Данные - Произвольный - прочитанные настройки.
// Возвращаемое значение:
//  Булево - Истина для структуры с ВерсияСхемы = 3.


#КонецОбласти

#Область ПроверкаСсылокИПрав

// Нормализует ссылку дополнительного инструмента единым способом для запуска и разбора.
//
// Параметры:
//  Адрес - Произвольный - проверяемое значение; принимается только строковая ссылка на поддерживаемый справочник.
//
// Возвращаемое значение:
//  Строка - нормализованная ссылка без оболочки web_link; пустая строка для остальных значений.
&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьСсылкуДополнительногоИнструментаПанелька(Адрес)
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Нижний = НРег(СокрЛП(Адрес));
	Если Лев(Нижний, 9) = "web_link:" Тогда
		Возврат НормализоватьСсылкуДополнительногоИнструментаПанелька(Сред(Нижний, 10));
	КонецЕсли;
	Путь = СтрРазделить(Нижний, "?")[0];
	Если Путь = "e1cib/data/справочник.внешниеобработки" Тогда
		Имя = "ВнешниеОбработки";
	ИначеЕсли Путь = "e1cib/data/справочник.дополнительныеотчетыиобработки" Тогда
		Имя = "ДополнительныеОтчетыИОбработки";
	Иначе
		Возврат "";
	КонецЕсли;
	// Для подключения из параметров используется только hex-идентификатор ref.
	Возврат "e1cib/data/Справочник." + Имя + Сред(Нижний, СтрДлина(Путь) + 1);
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьСсылкуДопОбработкиПанелька(Знач НавигационнаяСсылка)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ИмяСправочника", "");
	Результат.Вставить("Идентификатор", Неопределено);
	Результат.Вставить("Ошибка", "Некорректная ссылка дополнительного отчёта или обработки.");
	Если ТипЗнч(НавигационнаяСсылка) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;
	НавигационнаяСсылка = НормализоватьСсылкуДополнительногоИнструментаПанелька(НавигационнаяСсылка);
	Префикс = "e1cib/data/Справочник.";
	Если Лев(НавигационнаяСсылка, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Результат;
	КонецЕсли;
	ПозицияВопроса = СтрНайти(НавигационнаяСсылка, "?");
	Если ПозицияВопроса <= СтрДлина(Префикс) Тогда
		Возврат Результат;
	КонецЕсли;
	ИмяСправочника = Сред(НавигационнаяСсылка, СтрДлина(Префикс) + 1,
		ПозицияВопроса - СтрДлина(Префикс) - 1);
	Если ИмяСправочника <> "ДополнительныеОтчетыИОбработки" И ИмяСправочника <> "ВнешниеОбработки" Тогда
		Возврат Результат;
	КонецЕсли;
	СтрокаRef = "";
	НайденRef = Ложь;
	Для Каждого ПараметрСсылки Из СтрРазделить(Сред(НавигационнаяСсылка, ПозицияВопроса + 1), "&") Цикл
		Если Лев(ПараметрСсылки, 4) = "ref=" Тогда
			Если НайденRef Тогда
				Возврат Результат;
			КонецЕсли;
			НайденRef = Истина;
			СтрокаRef = Сред(ПараметрСсылки, 5);
		КонецЕсли;
	КонецЦикла;
	// В некоторых базах ref включает идентификатор таблицы перед двоеточием.
	ПозицияДвоеточия = СтрНайти(СтрокаRef, ":");
	Если ПозицияДвоеточия > 0 Тогда
		СтрокаRef = Сред(СтрокаRef, ПозицияДвоеточия + 1);
	КонецЕсли;
	Если СтрДлина(СтрокаRef) <> 32 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Индекс = 1 По 32 Цикл
		Если СтрНайти("0123456789abcdef", НРег(Сред(СтрокаRef, Индекс, 1))) = 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	// Порядок байтов ref отличается от текстового представления UUID.
	СтрокаИдентификатора = Сред(СтрокаRef, 25, 8) + "-" + Сред(СтрокаRef, 21, 4)
		+ "-" + Сред(СтрокаRef, 17, 4) + "-" + Сред(СтрокаRef, 1, 4) + "-" + Сред(СтрокаRef, 5, 12);
	Попытка
		Результат.Идентификатор = Новый УникальныйИдентификатор(СтрокаИдентификатора);
	Исключение
		// Некорректный идентификатор — ошибка входных данных, подключение не выполняется.
		Возврат Результат;
	КонецПопытки;
	Результат.ИмяСправочника = ИмяСправочника;
	Результат.Успех = Истина;
	Результат.Ошибка = "";
	Возврат Результат;
КонецФункции

// Определяет наличие у текущего пользователя административных прав.
// Возвращаемое значение:
//  Булево - результат выполнения функции.
&НаСервереБезКонтекста
Функция ПользовательИмеетПраваАдмина()
	// То же право, которое сервер проверяет при записи общих настроек Панелька.
	Возврат ПравоДоступа("Администрирование", Метаданные);
КонецФункции

// Скрывает технический адрес дополнительного инструмента во всех состояниях обычного интерфейса.
&НаКлиентеНаСервереБезКонтекста
Функция ПодсказкаСостоянияСсылкиПанелька(Текст, Адрес, Источник, Администратор)
	Если Не Администратор Тогда
		Если Источник = "extra" Или Не ПустаяСтрока(НормализоватьСсылкуДополнительногоИнструментаПанелька(Адрес)) Тогда
			Возврат Текст + ".";
		КонецЕсли;
	КонецЕсли;
	Возврат Текст + ": " + Адрес;
КонецФункции

// Проверяет состояние ссылки 1С и возвращает унифицированный статус.
&НаСервереБезКонтекста
Функция ПроверитьСтатусСсылки1С(Знач СсылкаТекст, КэшСтатусов)
	Если ПустаяСтрока(СсылкаТекст) Тогда
		Возврат "Ошибка";
	КонецЕсли;
	Если СтрНайти(СсылкаТекст, "e1c://") = 1 Тогда
		Возврат "ОК";
	КонецЕсли;
	Если СтрНайти(СсылкаТекст, "e1cib/") <> 1 Тогда
		Возврат "ОК";
	КонецЕсли;
	СтрокаПути = СсылкаТекст;
	ПозицияВопроса = СтрНайти(СтрокаПути, "?");
	Если ПозицияВопроса > 0 Тогда
		СтрокаПути = Лев(СтрокаПути, ПозицияВопроса - 1);
	КонецЕсли;
	ОстатокПути = Сред(СтрокаПути, 7);
	ПозицияСлеша = СтрНайти(ОстатокПути, "/");
	Если ПозицияСлеша = 0 Тогда
		Возврат "Ошибка";
	КонецЕсли;
	ТипСсылки = Лев(ОстатокПути, ПозицияСлеша - 1);
	ПутьОбъекта = Сред(ОстатокПути, ПозицияСлеша + 1);
	Если ПустаяСтрока(ПутьОбъекта) Тогда
		Возврат "Ошибка";
	КонецЕсли;
	СтатусИзКэша = КэшСтатусов[СсылкаТекст];
	Если СтатусИзКэша <> Неопределено Тогда
		Возврат СтатусИзКэша;
	КонецЕсли;
	Попытка
		ИмяОбъектаМД = ПутьОбъекта;
		// Извлекаем чистые имена метаданных из ссылок
		Если ТипСсылки = "command" Тогда
			ИмяОбъектаМД = ИзвлечьИмяОбъектаДляСсылкиКоманды(ПутьОбъекта);
		ИначеЕсли ТипСсылки = "form" Тогда
			ИмяОбъектаМД = ИзвлечьИмяОбъектаДляСсылкиФормы(ПутьОбъекта);
		КонецЕсли;
		Если ПустаяСтрока(ИмяОбъектаМД) Тогда
			Статус = "НеНайден";
		Иначе
			ОбъектМД = Метаданные.НайтиПоПолномуИмени(ИмяОбъектаМД);
			Если ОбъектМД = Неопределено Тогда
				// Для app/data отсутствие имени метаданных ещё не доказывает недоступность перехода.
				Статус = ?((ТипСсылки = "app" ИЛИ ТипСсылки = "data"), "ОК", "НеНайден");
			Иначе
				Статус = ОпределитьСтатусДоступаОбъектаМД(ОбъектМД);
				// Проверка прав (Чтение/Использование)
			КонецЕсли;
		КонецЕсли;
	Исключение
		Статус = "Ошибка";
	КонецПопытки;
	КэшСтатусов.Вставить(СсылкаТекст, Статус);
	Возврат Статус;
КонецФункции

// Извлекает полное имя объекта метаданных-владельца из ссылки на команду.
&НаСервереБезКонтекста
Функция ИзвлечьИмяОбъектаДляСсылкиКоманды(Знач ПутьОбъекта)
	МаркерКоманды = ".Команда.";
	ПозицияМаркера = СтрНайти(ПутьОбъекта, МаркерКоманды);
	Если ПозицияМаркера = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПутьОбъекта, ПозицияМаркера - 1);
КонецФункции

// Жесткая проверка прав доступа для отчетов, обработок и других объектов
&НаСервереБезКонтекста
Функция ОпределитьСтатусДоступаОбъектаМД(Знач ОбъектМД)
	Если ОбъектМД = Неопределено Тогда
		Возврат "НеНайден";
	КонецЕсли;
	Попытка
		ИмяПолное = ОбъектМД.ПолноеИмя();
		ПозицияТочки = СтрНайти(ИмяПолное, ".");
		Если ПозицияТочки = 0 Тогда
			Возврат "ОК";
		КонецЕсли;
		ИмяКласса = Лев(ИмяПолное, ПозицияТочки - 1);
		Если ИмяКласса = "Отчет" Или ИмяКласса = "Обработка" Тогда
			Возврат ?(ПравоДоступа("Использование", ОбъектМД), "ОК", "НетПрав");
		ИначеЕсли ИмяКласса = "ОбщаяФорма" Тогда
			Возврат "ОК";
		Иначе
			ЕстьПрава = Ложь;
			Если ПравоДоступа("Чтение", ОбъектМД) Или ПравоДоступа("Просмотр", ОбъектМД) Тогда
				ЕстьПрава = Истина;
			КонецЕсли;
			Возврат ?(ЕстьПрава, "ОК", "НетПрав");
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуПанелька("ПроверкаПравМетаданных", ИнформацияОбОшибке());
		Возврат "Ошибка";
	КонецПопытки;
КонецФункции

// Извлекает полное имя объекта метаданных-владельца из ссылки на форму.
&НаСервереБезКонтекста
Функция ИзвлечьИмяОбъектаДляСсылкиФормы(Знач ПутьОбъекта)
	МаркерФормы = ".Форма.";
	ПозицияМаркера = СтрНайти(ПутьОбъекта, МаркерФормы);
	Если ПозицияМаркера = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПутьОбъекта, ПозицияМаркера - 1);
КонецФункции

// Пакетно получает статусы дополнительных обработок для построения панели.
//
// Параметры:
//  ДанныеДопОбработок - ТаблицаЗначений - строки с навигационными ссылками.
//  КэшСтатусов - Соответствие из КлючИЗначение - статусы по исходным адресам:
//   * Ключ - Строка - исходная навигационная ссылка.
//   * Значение - Строка - ОК, Удален, НеНайден, Недоступен или Ошибка.
&НаСервереБезКонтекста
Процедура ЗаполнитьКэшСтатусовДопОбработок(Знач ДанныеДопОбработок, КэшСтатусов)
	Если ТипЗнч(ДанныеДопОбработок) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	ЗаданияЗапросов = Новый Соответствие;
	Для Каждого СтрокаДопОбработки Из ДанныеДопОбработок Цикл
		СсылкаТекст = СтрокаДопОбработки.Ссылка;
		Если ПустаяСтрока(СсылкаТекст) Тогда
			Продолжить;
		КонецЕсли;
		Разбор = РазобратьСсылкуДопОбработкиПанелька(СсылкаТекст);
		Если Не Разбор.Успех Тогда
			КэшСтатусов.Вставить(СсылкаТекст, "Ошибка");
			Продолжить;
		КонецЕсли;
		ИмяСправочника = Разбор.ИмяСправочника;
		Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
			КэшСтатусов.Вставить(СсылкаТекст, "НеНайден");
			Продолжить;
		КонецЕсли;
		Попытка
			СсылкаДоп = Справочники[ИмяСправочника].ПолучитьСсылку(Разбор.Идентификатор);
			КлючСсылки = Строка(СсылкаДоп.УникальныйИдентификатор());
			Задание = ЗаданияЗапросов[ИмяСправочника];
			Если Задание = Неопределено Тогда
				Задание = Новый Структура;
				Задание.Вставить("Ссылки", Новый Массив);
				Задание.Вставить("ИсточникиПоСсылкам", Новый Соответствие);
				ЗаданияЗапросов.Вставить(ИмяСправочника, Задание);
			КонецЕсли;
			Источники = Задание.ИсточникиПоСсылкам[КлючСсылки];
			Если Источники = Неопределено Тогда
				Задание.Ссылки.Добавить(СсылкаДоп);
				Источники = Новый Массив;
				Задание.ИсточникиПоСсылкам.Вставить(КлючСсылки, Источники);
			КонецЕсли;
			Источники.Добавить(СсылкаТекст);
		Исключение
			КэшСтатусов.Вставить(СсылкаТекст, "Ошибка");
		КонецПопытки;
	КонецЦикла;
	Для Каждого ЭлементЗадания Из ЗаданияЗапросов Цикл
		ИмяСправочника = ЭлементЗадания.Ключ;
		Задание = ЭлементЗадания.Значение;
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
                |    Ссылка,
                |    ПометкаУдаления
                |ИЗ
                |    Справочник." + ИмяСправочника + "
                |ГДЕ
                |    Ссылка В (&Ссылки)";
			Запрос.УстановитьПараметр("Ссылки", Задание.Ссылки);
			//@skip-check query-in-loop
			РезультатЗапроса = Запрос.Выполнить();
			СтатусыПоСсылкам = Новый Соответствие;
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				КлючСсылки = Строка(Выборка.Ссылка.УникальныйИдентификатор());
				СтатусыПоСсылкам.Вставить(
					КлючСсылки,
					?(Выборка.ПометкаУдаления, "Удален", "ОК")
					);
			КонецЦикла;
			Для Каждого Источник Из Задание.ИсточникиПоСсылкам Цикл
				КлючСсылки = Источник.Ключ;
				Статус = СтатусыПоСсылкам[КлючСсылки];
				Если Статус = Неопределено Тогда
					Статус = "Недоступен";
				КонецЕсли;
				Для Каждого СсылкаТекст Из Источник.Значение Цикл
					КэшСтатусов.Вставить(СсылкаТекст, Статус);
				КонецЦикла;
			КонецЦикла;
		Исключение
			ЗаписатьОшибкуПанелька("ПроверкаСтатусовИнструментов", ИнформацияОбОшибке());
			Для Каждого Источник Из Задание.ИсточникиПоСсылкам Цикл
				Для Каждого СсылкаТекст Из Источник.Значение Цикл
					КэшСтатусов.Вставить(СсылкаТекст, "Ошибка");
				КонецЦикла;
			КонецЦикла;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Пакетно читает только виды доступных дополнительных инструментов текущего построения.
// При отсутствии результата прежнее чтение реквизита остаётся резервным путём.
// Параметры:
//  ДанныеДопОбработок - ТаблицаЗначений, Неопределено - строки с навигационными ссылками.
// Возвращаемое значение:
//  Соответствие из Строка - виды по типизированным ссылкам текущего построения.
&НаСервереБезКонтекста
Функция ПолучитьВидыДопОбработокПанелька(Знач ДанныеДопОбработок)
	Виды = Новый Соответствие;
	Если ТипЗнч(ДанныеДопОбработок) <> Тип("ТаблицаЗначений") Тогда
		Возврат Виды;
	КонецЕсли;
	Задания = Новый Соответствие;
	Для Каждого Стр Из ДанныеДопОбработок Цикл
		Разбор = РазобратьСсылкуДопОбработкиПанелька(Стр.Ссылка);
		Если Не Разбор.Успех Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ИмяСправочника = Разбор.ИмяСправочника;
			Если ИмяСправочника <> "ВнешниеОбработки" И ИмяСправочника <> "ДополнительныеОтчетыИОбработки" Тогда
				Продолжить;
			КонецЕсли;
			ИмяПоля = ?(ИмяСправочника = "ВнешниеОбработки", "ТипОбработки", "Вид");
			МД = Метаданные.Справочники.Найти(ИмяСправочника);
			Если МД = Неопределено Или МД.Реквизиты.Найти(ИмяПоля) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Разбор.Идентификатор);
			Ссылки = Задания[ИмяСправочника];
			Если Ссылки = Неопределено Тогда
				Ссылки = Новый Соответствие;
				Задания.Вставить(ИмяСправочника, Ссылки);
			КонецЕсли;
			Ссылки.Вставить(Ссылка, Истина);
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	// Разбор допускает только два фиксированных справочника. Запросов не больше двух.
	Для Каждого Задание Из Задания Цикл
		// Для небольшого набора сохраняем прежний путь без дополнительного запроса.
		Если Задание.Значение.Количество() < 8 Тогда
			Продолжить;
		КонецЕсли;
		ИмяСправочника = Задание.Ключ;
		ИмяПоля = ?(ИмяСправочника = "ВнешниеОбработки", "ТипОбработки", "Вид");
		Ссылки = Новый Массив;
		Для Каждого Пара Из Задание.Значение Цикл
			Ссылки.Добавить(Пара.Ключ);
		КонецЦикла;
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка, " + ИмяПоля + " КАК ВидИнструмента
				|ИЗ Справочник." + ИмяСправочника + "
				|ГДЕ Ссылка В (&Ссылки)";
			Запрос.УстановитьПараметр("Ссылки", Ссылки);
			//@skip-check query-in-loop
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Виды.Вставить(Выборка.Ссылка, Строка(Выборка.ВидИнструмента));
			КонецЦикла;
		Исключение
			// Отказ запроса не меняет статусы/права: используется прежнее чтение реквизита.
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Виды;
КонецФункции


// Возвращает ранее рассчитанный статус дополнительной обработки.
//
// Параметры:
//  СсылкаТекст - Строка - навигационная ссылка.
//  КэшСтатусов - Соответствие из КлючИЗначение - статусы по исходным адресам:
//   * Ключ - Строка - исходная навигационная ссылка.
//   * Значение - Строка - ОК, Удален, НеНайден, Недоступен или Ошибка.
//
// Возвращаемое значение:
//  Строка - ранее рассчитанный статус; НеНайден при отсутствии адреса в индексе.
&НаСервереБезКонтекста
Функция ПроверитьСтатусДопОбработки(Знач СсылкаТекст, КэшСтатусов)
	СтатусИзКэша = КэшСтатусов[СсылкаТекст];
	Если СтатусИзКэша = Неопределено Тогда
		Возврат "НеНайден";
	КонецЕсли;
	Возврат СтатусИзКэша;
КонецФункции

#КонецОбласти

#Область ПовторноеИспользованиеОбычнойПанели

// Сравниваемый снимок входных данных, размеров и актуальных статусов.
//
// Параметры:
//  Настройки - Структура - параметры отображения панели.
//  Данные - ТаблицаЗначений - подготовленные строки отображения; читается поле Ссылка.
//  КэшСтатусов - Соответствие из КлючИЗначение - актуальные статусы ссылок:
//   * Ключ - Строка - исходный адрес.
//   * Значение - Строка - статус ссылки.
//  Ширина - Число - ширина клиентской области.
//  Высота - Число - высота клиентской области.
//  Причина - Строка - выходное пояснение отказа от повторного использования.
// РежимКолонок - Строка - локальный выбор числа колонок: Авто, 4, 6 или 8.
//
// Возвращаемое значение:
//  Строка - сериализованная подпись входных данных либо пустая строка при полном перестроении.
&НаСервереБезКонтекста
Функция ПодписьОбычнойПанелиПанелька(Настройки, Данные, КэшСтатусов, Знач Ширина, Знач Высота, Причина,
	Знач РежимКолонок = "Авто")
	Если Данные.Количество() = 0 Тогда
		Причина = "пустая панель";
		Возврат "";
	КонецЕсли;
	Статусы = Новый Массив;
	Для Каждого Стр Из Данные Цикл
		Если ПустаяСтрока(Стр.Ссылка) Тогда
			Статусы.Добавить("Пустая");
			Продолжить;
		КонецЕсли;
		Если Лев(Стр.Ссылка, 9) = "ext_file:" Тогда
			// Доступность локального пути проверяется на клиенте при каждой загрузке.
			Статус = СтатусПраваОткрытияЛокальногоФайлаПанелька(Прав(СокрЛП(Стр.Ссылка), 4));
			Статусы.Добавить(?(Статус = "ОК", "ПроверяетсяНаКлиенте", Статус));
			Продолжить;
		КонецЕсли;
		ЭтоСистемнаяКоманда = Лев(Стр.Ссылка, 8) = "sys_cmd:";
		ЭтоВебСсылка = Лев(Стр.Ссылка, 9) = "web_link:";
		ЭтоДопОбработка = СтрНайти(Стр.Ссылка, "e1cib/data/Справочник.ДополнительныеОтчетыИОбработки") > 0
			Или СтрНайти(Стр.Ссылка, "e1cib/data/Справочник.ВнешниеОбработки") > 0;
		КорректнаяСсылка = ЭтоСистемнаяКоманда Или ЭтоВебСсылка Или ЭтоДопОбработка
			Или СтрНайти(Стр.Ссылка, "e1cib/") > 0 Или СтрНайти(Стр.Ссылка, "e1c://") > 0;
		Статус = ?(КорректнаяСсылка, "ОК", "Некорректная");
		Если ЭтоСистемнаяКоманда Тогда
			Статус = СтатусПраваОткрытияЛокальногоФайлаПанелька(".epf");
		ИначеЕсли КорректнаяСсылка И Не ЭтоВебСсылка Тогда
			Если ЭтоДопОбработка Тогда
				Статус = ПроверитьСтатусДопОбработки(Стр.Ссылка, КэшСтатусов);
			Иначе
				Статус = ПроверитьСтатусСсылки1С(Стр.Ссылка, КэшСтатусов);
			КонецЕсли;
		КонецЕсли;
		Статусы.Добавить(Статус);
	КонецЦикла;
	Попытка
		ДанныеПодписи = Новый Структура;
		ДанныеПодписи.Вставить("Версия", 1);
		ДанныеПодписи.Вставить("КолонкиПанелька", РежимКолонок);
		ДанныеПодписи.Вставить("Настройки", Настройки);
		ДанныеПодписи.Вставить("Данные", Данные);
		ДанныеПодписи.Вставить("Ширина", Ширина);
		ДанныеПодписи.Вставить("Высота", Высота);
		ДанныеПодписи.Вставить("Статусы", Статусы);
		Возврат ЗначениеВСтрокуВнутр(ДанныеПодписи);
	Исключение
		Причина = "невозможно подготовить снимок входных данных";
		Возврат "";
	КонецПопытки;
КонецФункции

// Проверяет серверный снимок и наличие прежних элементов до любых изменений формы.
//
// Параметры:
//  Подпись - Строка - новая подпись входных данных.
//  Причина - Строка - выходное пояснение причины полного перестроения.
//
// Возвращаемое значение:
//  Булево - снимок актуален и прежние элементы формы можно сохранить.
&НаСервере
Функция ПроверитьСнимокОбычнойПанелиПанелька(Знач Подпись, Причина)
	Причина = "нет успешного предыдущего построения";
	Если ПустаяСтрока(АдресСнимкаПанелиПанелька) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Снимок = ПолучитьИзВременногоХранилища(АдресСнимкаПанелиПанелька);
		Если ТипЗнч(Снимок) <> Тип("Структура") Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Снимок.Подпись <> Подпись Тогда
			Причина = "изменились настройки, данные, размеры или статусы";
			Возврат Ложь;
		КонецЕсли;
		Причина = "изменилось соответствие ссылок или отсутствуют элементы";
		Если Снимок.Соответствия.Количество() <> ТаблицаСоответствияОбъектов.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Индекс = 0 По Снимок.Соответствия.Количество() - 1 Цикл
			ПрежняяСтрока = Снимок.Соответствия[Индекс];
			ТекущаяСтрока = ТаблицаСоответствияОбъектов[Индекс];
			Если ПрежняяСтрока.ИмяЭлемента <> ТекущаяСтрока.ИмяЭлемента Или
				ПрежняяСтрока.Ссылка <> ТекущаяСтрока.Ссылка Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ИмяЭлемента Из Снимок.ИменаЭлементов Цикл
			Если Элементы.Найти(ИмяЭлемента) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Возврат Истина;
	Исключение
		Причина = "снимок недоступен или несовместим";
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Инвалидирует снимок перед перестроением, переиспользуя тот же адрес хранилища.
&НаСервере
Процедура СброситьСнимокОбычнойПанелиПанелька()
	Если ПустаяСтрока(АдресСнимкаПанелиПанелька) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПоместитьВоВременноеХранилище(Неопределено, АдресСнимкаПанелиПанелька);
	Исключение
		АдресСнимкаПанелиПанелька = "";
	КонецПопытки;
КонецПроцедуры

// Сохраняет снимок только после успешного полного построения.
//
// Параметры:
//  Подпись - Строка - подпись успешно построенной обычной панели.
&НаСервере
Процедура СохранитьСнимокОбычнойПанелиПанелька(Знач Подпись)
	Попытка
		ИменаЭлементов = Новый Массив;
		Для Каждого Элемент Из Элементы Цикл
			ИменаЭлементов.Добавить(Элемент.Имя);
		КонецЦикла;
		Снимок = Новый Структура("Подпись,Соответствия,ИменаЭлементов", Подпись,
			ТаблицаСоответствияОбъектов.Выгрузить(), ИменаЭлементов);
		Если ПустаяСтрока(АдресСнимкаПанелиПанелька) Тогда
			АдресСнимкаПанелиПанелька = ПоместитьВоВременноеХранилище(Снимок, УникальныйИдентификатор);
		Иначе
			ПоместитьВоВременноеХранилище(Снимок, АдресСнимкаПанелиПанелька);
		КонецЕсли;
	Исключение
		АдресСнимкаПанелиПанелька = "";
		Если ДиагностикаПанелька Тогда
			ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Снимок не сохранён; следующее обновление будет полным." +
				Символы.ПС;
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ПостроениеОбычногоИнтерфейса

// Подготавливает форму к повторной отрисовке «Панельки».
&НаСервере
Процедура ПодготовитьФормуКПерерисовке()
	ОчиститьДинамическиеГруппыОбъектов();
	УдалитьДинамическиеКомандыИзбранного();
	ТаблицаСоответствияОбъектов.Очистить();
КонецПроцедуры

// Показывает заглушку при отсутствии настроенных элементов панели для обычного интерфейса.
// Параметры:
//  ПользовательАдминистратор - Булево - признак наличия административных прав.
&НаСервере
Процедура ПоказатьЗаглушкуПустыхНастроек(Знач ПользовательАдминистратор)
	ГруппаЗаглушка = Элементы.Найти("ГруппаЗаглушкаПустыхНастроек");
	Если ГруппаЗаглушка = Неопределено Тогда
		ГруппаЗаглушка = Элементы.Добавить("ГруппаЗаглушкаПустыхНастроек", Тип("ГруппаФормы"), ЭтотОбъект);
		ГруппаЗаглушка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаЗаглушка.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаЗаглушка.ОтображатьЗаголовок = Ложь;
		ГруппаЗаглушка.РастягиватьПоГоризонтали = Истина;
		ГруппаЗаглушка.РастягиватьПоВертикали = Истина;
		Заглушка = Элементы.Добавить("ЗаглушкаПустыхНастроек", Тип("ДекорацияФормы"), ГруппаЗаглушка);
		Заглушка.Вид = ВидДекорацииФормы.Надпись;
		Заглушка.Шрифт = Новый Шрифт(, 14, Истина);
		Заглушка.ЦветТекста = WebЦвета.Серый;
		Заглушка.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
		Заглушка.ВертикальноеПоложение = ВертикальноеПоложениеЭлемента.Центр;
	КонецЕсли;
	Заглушка = Элементы.ЗаглушкаПустыхНастроек;
	Заглушка.Заголовок = ?(
		ПользовательАдминистратор,
		"Панелька еще не настроена." + Символы.ПС + "Откройте «Настройки → Настроить общую панель».",
		"В панель пока не добавлены ссылки."
		);
	Если ИспользуетсяЛичнаяПанельПанелька Тогда
		Заглушка.Заголовок = НСтр("ru = 'В вашей панели пока нет ссылок. Добавьте их через «Персональная настройка».'");
	КонецЕсли;
	ГруппаЗаглушка.Видимость = Истина;
КонецПроцедуры

// Рассчитывает вес категорий, распределение данных по страницам и порядок отрисовки.
//
// Параметры:
//  Данные - ТаблицаЗначений - изменяемые строки отображения; вычисляются ТипОбъекта, Вкладка, ПорядокГруппы.
//  СтруктураСтраниц - Структура - результат СформироватьСтруктуруСтраниц.
//  Настройки - Структура - параметры группировки, системных вкладок и подсказок.
//
// Возвращаемое значение:
//  Структура - результаты расчета; исходная таблица изменяется:
//  * Данные - ТаблицаЗначений - дополненные и отсортированные строки отображения.
//  * МассивКолонок - Массив из Строка - колонки с учетом системных категорий.
//  * МассивСтраниц - Массив из Строка - используемые страницы.
//  * ВесаКатегорий - Соответствие из КлючИЗначение - веса категорий:
//  ** Ключ - Строка - категория или колонка.
//  ** Значение - Число - вычисленный вес.
&НаСервереБезКонтекста
Функция РассчитатьМетрикиДашборда(Данные, СтруктураСтраниц, Настройки)
	МассивКолонок = СтруктураСтраниц.МассивКолонок;
	МассивСтраниц = СтруктураСтраниц.МассивСтраниц;
	НастройкиКолонокСтраница = СтруктураСтраниц.НастройкиКолонокСтраница;
	ЗапрещенныеСтраницы = СтруктураСтраниц.ЗапрещенныеСтраницы;
	НеРаспределенныеНаОтдельнойВкладке = Настройки.НеРаспределенныеНаОтдельнойВкладке;
	СтандартныеНаОтдельнойВкладке = Настройки.СтандартныеНаОтдельнойВкладке;
	ГруппироватьПоТипу = Настройки.ГруппироватьПоТипу;
	РежимПодсказок = Настройки.РежимПодсказок;
	// =========================================================================================
	// === СБОР МЕТРИК: ЧЕСТНЫЙ ВЕС КАЖДОЙ КАТЕГОРИИ И РАСПРЕДЕЛЕНИЕ СТРАНИЦ ===
	// =========================================================================================
	ВесаКатегорий = Новый Соответствие;
	УчтенныеТипы = Новый Соответствие;
	ИндексКолонокМетрик = Новый Соответствие;
	Для Каждого КолонкаДляИндекса Из МассивКолонок Цикл
		ИндексКолонокМетрик.Вставить(КолонкаДляИндекса, Истина);
	КонецЦикла;
	ИндексСтраницМетрик = Новый Соответствие;
	Для Каждого СтраницаДляИндекса Из МассивСтраниц Цикл
		ИндексСтраницМетрик.Вставить(СтраницаДляИндекса, Истина);
	КонецЦикла;
	Для Каждого Стр Из Данные Цикл
		Если Не ЗначениеЗаполнено(Стр.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Если ИндексКолонокМетрик[Стр.Колонка] = Неопределено И Стр.Колонка <> "-" И
			Стр.Колонка <> "Не распределено" И Стр.Колонка <> "Стандартные инструменты" И
			Не ПустаяСтрока(Стр.Колонка) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Стр.ТипОбъекта) Тогда
			Стр.ТипОбъекта = ПолучитьТипОбъектаИзСсылки(Стр.Ссылка);
		КонецЕсли;
		Если СтандартныеНаОтдельнойВкладке И Стр.ТипОбъекта = "Стандартные инструменты" Тогда
			Если ЗапрещенныеСтраницы["Стандартные инструменты"] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Стр.Колонка = "Стандартные инструменты";
			Если ИндексКолонокМетрик["Стандартные инструменты"] = Неопределено Тогда
				МассивКолонок.Добавить("Стандартные инструменты");
				ИндексКолонокМетрик.Вставить("Стандартные инструменты", Истина);
				НастройкиКолонокСтраница.Вставить("Стандартные инструменты", "Стандартные инструменты");
				Если ИндексСтраницМетрик["Стандартные инструменты"] = Неопределено Тогда
					МассивСтраниц.Добавить("Стандартные инструменты");
					ИндексСтраницМетрик.Вставить("Стандартные инструменты", Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Стр.Колонка) Тогда
			Если НеРаспределенныеНаОтдельнойВкладке И ЗапрещенныеСтраницы["Не распределено"] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Стр.Колонка = "Не распределено";
			Если ИндексКолонокМетрик["Не распределено"] = Неопределено Тогда
				МассивКолонок.Добавить("Не распределено");
				ИндексКолонокМетрик.Вставить("Не распределено", Истина);
				НастройкиКолонокСтраница.Вставить("Не распределено", ?(НеРаспределенныеНаОтдельнойВкладке,
					"Не распределено", "Главная"));
				Если НеРаспределенныеНаОтдельнойВкладке И ИндексСтраницМетрик["Не распределено"] = Неопределено Тогда
					МассивСтраниц.Добавить("Не распределено");
					ИндексСтраницМетрик.Вставить("Не распределено", Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ТекВкладкаОпред = НастройкиКолонокСтраница[Стр.Колонка];
		Если Не ЗначениеЗаполнено(ТекВкладкаОпред) Или ИндексСтраницМетрик[ТекВкладкаОпред] = Неопределено Тогда
			ТекВкладкаОпред = "Главная";
		КонецЕсли;
		Стр.Вкладка = ТекВкладкаОпред;
		ВесСтр = 1.0;
		ТекстДляДлины = ?(ЗначениеЗаполнено(Стр.Наименование), Стр.Наименование, Стр.Ссылка);
		Если СтрДлина(ТекстДляДлины) > 35 Тогда
			ВесСтр = 1.4;
		КонецЕсли;
		Если РежимПодсказок = ОтображениеПодсказки.ОтображатьСнизу И ЗначениеЗаполнено(Стр.Подсказка) Тогда
			ВесСтр = ВесСтр + 1.1;
		КонецЕсли;
		ТекВесКат = ВесаКатегорий[Стр.Колонка];
		ВесаКатегорий.Вставить(Стр.Колонка, ?(ТекВесКат = Неопределено, 0, ТекВесКат) + ВесСтр);
		Если ГруппироватьПоТипу И ЗначениеЗаполнено(Стр.ТипОбъекта) Тогда
			КлючТипа = Стр.Колонка + "|" + Стр.ТипОбъекта;
			Если УчтенныеТипы[КлючТипа] = Неопределено Тогда
				УчтенныеТипы.Вставить(КлючТипа, Истина);
				ВесаКатегорий.Вставить(Стр.Колонка, ВесаКатегорий[Стр.Колонка] + 2.5);
				// Вес подзаголовка типа
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// При включенной группировке тип объекта должен оставаться единым блоком.
	// Порядок блоков определяется первой ссылкой типа в пользовательском порядке,
	// а внутри блока сохраняется ручной порядок ссылок.
	Если ГруппироватьПоТипу Тогда
		МинимальныйПорядокГрупп = Новый Соответствие;
		Для Каждого СтрДанных Из Данные Цикл
			КлючГруппы = СтрДанных.Вкладка + "|" + СтрДанных.Колонка + "|" + СтрДанных.ТипОбъекта;
			ТекущийМинимум = МинимальныйПорядокГрупп[КлючГруппы];
			Если ТекущийМинимум = Неопределено Или СтрДанных.Порядок < ТекущийМинимум Тогда
				МинимальныйПорядокГрупп.Вставить(КлючГруппы, СтрДанных.Порядок);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрДанных Из Данные Цикл
			КлючГруппы = СтрДанных.Вкладка + "|" + СтрДанных.Колонка + "|" + СтрДанных.ТипОбъекта;
			СтрДанных.ПорядокГруппы = МинимальныйПорядокГрупп[КлючГруппы];
		КонецЦикла;
		Данные.Сортировать("Вкладка Возр, Колонка Возр, ПорядокГруппы Возр, Порядок Возр, Наименование Возр");
	Иначе
		Для Каждого СтрДанных Из Данные Цикл
			СтрДанных.ПорядокГруппы = 0;
		КонецЦикла;
		Данные.Сортировать("Вкладка Возр, Колонка Возр, Порядок Возр, Наименование Возр");
	КонецЕсли;
	ИспользуемыеСтраницы = Новый Соответствие;
	Для Каждого КлючЗначение Из ВесаКатегорий Цикл
		Если КлючЗначение.Значение > 0 Тогда
			ЦелСтр = НастройкиКолонокСтраница[КлючЗначение.Ключ];
			Если ЗначениеЗаполнено(ЦелСтр) Тогда
				ИспользуемыеСтраницы.Вставить(ЦелСтр, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	МассивАктивныхСтраниц = Новый Массив;
	МассивАктивныхСтраниц.Добавить("Главная");
	Для Каждого ИмяСтр Из МассивСтраниц Цикл
		Если ИспользуемыеСтраницы[ИмяСтр] <> Неопределено И ИмяСтр <> "Главная" Тогда
			МассивАктивныхСтраниц.Добавить(ИмяСтр);
		КонецЕсли;
	КонецЦикла;
	МассивСтраниц = МассивАктивныхСтраниц;
	Результат = Новый Структура;
	Результат.Вставить("Данные", Данные);
	Результат.Вставить("МассивКолонок", МассивКолонок);
	Результат.Вставить("МассивСтраниц", МассивСтраниц);
	Результат.Вставить("ВесаКатегорий", ВесаКатегорий);
	Возврат Результат;
КонецФункции

// Создает физический каркас страниц панели и распределяет по ним физические колонки.
// Параметры:
//  Контекст - Структура - контекст построения панели.
&НаСервере
Процедура СоздатьКаркасСтраниц(Контекст)
	СуффиксОтрисовки = Контекст.СуффиксОтрисовки;
	МассивСтраниц = Контекст.МассивСтраниц;
	ИконкиСтраниц = Контекст.ИконкиСтраниц;
	// Full HD — ориентир для шести компактных колонок. Это бюджет экрана,
	// а не измерение рабочей области: рассчитанный ряд сохраняет горизонтальное направление.
	ЛимитКолонок = 6;
	БюджетШирины = 160;
	ШиринаЭкрана = 1920;
	Если Не Контекст.Свойство("ШиринаМонитора", ШиринаЭкрана) Тогда
		ШиринаЭкрана = 1920;
	КонецЕсли;
	Если ШиринаЭкрана > 0 Тогда
		ЛимитКолонок = Макс(2, Мин(8, Цел(ШиринаЭкрана / 320)));
		Если ШиринаЭкрана >= 2048 Тогда
			ЛимитКолонок = 8;
		КонецЕсли;
		БюджетШирины = Макс(48, Мин(320, Цел(160 * ШиринаЭкрана / 1920)));
	КонецЕсли;
	Если Контекст.Свойство("КолонкиПанелька") Тогда
		Если Контекст.КолонкиПанелька = "4" Или Контекст.КолонкиПанелька = "6" Или Контекст.КолонкиПанелька = "8" Тогда
			ЛимитКолонок = Число(Контекст.КолонкиПанелька);
			БюджетШирины = 160;
		КонецЕсли;
	КонецЕсли;
	МаксимумСсылок = Новый Соответствие;
	Для Каждого СтрокаСсылки Из Контекст.Данные Цикл
		Если Не ЗначениеЗаполнено(СтрокаСсылки.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		КоличествоСсылок = МаксимумСсылок[СтрокаСсылки.Колонка];
		МаксимумСсылок.Вставить(СтрокаСсылки.Колонка, ?(КоличествоСсылок = Неопределено, 0, КоличествоСсылок) + 1);
	КонецЦикла;
	// Метрики модели включают заголовки типов. Удалённый дубль не должен
	// увеличивать число полос на границе порога деления.
	ВесаПланирования = Новый Соответствие;
	Для Каждого ПараВеса Из Контекст.ВесаКатегорий Цикл
		ВесаПланирования.Вставить(ПараВеса.Ключ, ПараВеса.Значение);
	КонецЦикла;
	ГруппироватьПоТипу = Ложь;
	Контекст.Свойство("ГруппироватьПоТипу", ГруппироватьПоТипу);
	Если ГруппироватьПоТипу Тогда
		УчтенныеДубли = Новый Соответствие;
		Для Каждого СтрокаСсылки Из Контекст.Данные Цикл
			Если Не ЗначениеЗаполнено(СтрокаСсылки.Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			КлючТипа = СтрокаСсылки.Колонка + "|" + СтрокаСсылки.ТипОбъекта;
			Если УчтенныеДубли[КлючТипа] = Неопределено И ЗначениеЗаполнено(СтрокаСсылки.ТипОбъекта)
				И НРег(СокрЛП(СтрокаСсылки.ТипОбъекта)) = НРег(СокрЛП(ЗаголовокКолонкиПанелька(Контекст, СтрокаСсылки.Колонка))) Тогда
				ВесКатегории = ВесаПланирования[СтрокаСсылки.Колонка];
				Если ВесКатегории <> Неопределено Тогда
					ВесаПланирования.Вставить(СтрокаСсылки.Колонка, Макс(0, ВесКатегории - 2.5));
				КонецЕсли;
				УчтенныеДубли.Вставить(КлючТипа, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	КатегорииСтраниц = Новый Соответствие;
	Для Каждого ИмяКолонки Из Контекст.МассивКолонок Цикл
		Вес = Контекст.ВесаКатегорий[ИмяКолонки];
		// У пустой колонки нет веса, поэтому она не занимает место на панели.
		Если Вес = Неопределено Или Вес <= 0 Тогда
			Продолжить;
		КонецЕсли;
		СтраницаКолонки = Контекст.НастройкиКолонокСтраница[ИмяКолонки];
		Если Не ЗначениеЗаполнено(СтраницаКолонки) Тогда
			СтраницаКолонки = "Главная";
		КонецЕсли;
		Если МассивСтраниц.Найти(СтраницаКолонки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КатегорииВкладки = КатегорииСтраниц[СтраницаКолонки];
		Если КатегорииВкладки = Неопределено Тогда
			КатегорииВкладки = Новый Массив;
			КатегорииСтраниц.Вставить(СтраницаКолонки, КатегорииВкладки);
		КонецЕсли;
		КатегорииВкладки.Добавить(ИмяКолонки);
	КонецЦикла;
	// Сначала рассчитываем все страницы без создания элементов формы.
	ПланыСтраниц = Новый Соответствие;
	ЧислоПолосКатегорий = Новый Соответствие;
	ШириныСсылокСтраниц = Новый Соответствие;
	Для Каждого ИмяСтраницы Из МассивСтраниц Цикл
		КатегорииВкладки = КатегорииСтраниц[ИмяСтраницы];
		Если КатегорииВкладки = Неопределено Тогда
			КатегорииВкладки = Новый Массив;
		КонецЕсли;
		ПланСтраницы = РассчитатьПланСтраницыПанелька(КатегорииВкладки, ВесаПланирования, ЛимитКолонок, МаксимумСсылок, БюджетШирины);
		ПланыСтраниц.Вставить(ИмяСтраницы, ПланСтраницы);
		ШириныСсылокСтраниц.Вставить(ИмяСтраницы, ПланСтраницы.МаксШиринаСсылки);
		Для Каждого ПолосыКатегории Из ПланСтраницы.ПолосыКатегорий Цикл
			ЧислоПолосКатегорий.Вставить(ПолосыКатегории.Ключ, ПолосыКатегории.Значение);
		КонецЦикла;
	КонецЦикла;
	ГруппаСтраницы = Элементы.Найти("Вкладки");
	Если ГруппаСтраницы = Неопределено Тогда
		ГруппаСтраницы = Элементы.Добавить("Вкладки", Тип("ГруппаФормы"), ЭтотОбъект);
		ГруппаСтраницы.Вид = ВидГруппыФормы.Страницы;
	КонецЕсли;
	ИмяТекущейСтраницы = "";
	Контекст.Свойство("ТекущаяСтраницаПанелька", ИмяТекущейСтраницы);
	Если МассивСтраниц.Найти(ИмяТекущейСтраницы) = Неопределено И МассивСтраниц.Количество() > 0 Тогда
		ИмяТекущейСтраницы = МассивСтраниц[0];
	КонецЕсли;
	ТекущаяГруппаСтраницы = Неопределено;
	ФизКолонкиСтраниц = Новый Соответствие;
	ВысотыСтраниц = Новый Соответствие;
	РастягиватьСтраницы = Новый Соответствие;
	НомерСтраницы = 0;
	Для Каждого ИмяСтраницы Из МассивСтраниц Цикл
		НомерСтраницы = НомерСтраницы + 1;
		// Пользовательские названия могут совпасть после удаления специальных символов.
		ИмяЭлементаСтраницы = "Страница_" + Формат(НомерСтраницы, "ЧГ=0;ЧДЦ=0") + "_" + СуффиксОтрисовки;
		Если ИмяСтраницы = "Главная" Тогда
			ИмяЭлементаСтраницы = "СтраницаОсновнаяСсылки_" + СуффиксОтрисовки;
		КонецЕсли;
		СтраницаФормы = Элементы.Найти(ИмяЭлементаСтраницы);
		Если СтраницаФормы = Неопределено Тогда
			СтраницаФормы = Элементы.Добавить(ИмяЭлементаСтраницы, Тип("ГруппаФормы"), ГруппаСтраницы);
			СтраницаФормы.Вид = ВидГруппыФормы.Страница;
			СтраницаФормы.Заголовок = ИмяСтраницы;
			СтраницаФормы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			ИмяИконки = ИконкиСтраниц[ИмяСтраницы];
			Если Не ЗначениеЗаполнено(ИмяИконки) Тогда
				Если ИмяСтраницы = "Главная" Тогда
					ИмяИконки = "Избранное";
				ИначеЕсли ИмяСтраницы = "Стандартные инструменты" Тогда
					ИмяИконки = "Настройка";
				ИначеЕсли ИмяСтраницы = "Не распределено" Тогда
					ИмяИконки = "Папка";
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(ИмяИконки) Тогда
				Попытка
					СтраницаФормы.Картинка = БиблиотекаКартинок[ИмяИконки];
				Исключение
					// Недоступная в этой конфигурации картинка не препятствует построению страницы.
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		ПланСтраницы = ПланыСтраниц[ИмяСтраницы];
		КоличествоПолос = Макс(1, ПланСтраницы.КоличествоПолос);
		РастягиватьСтраницу = ПланСтраницы.РастягиватьСтраницу;
		РастягиватьСтраницы.Вставить(ИмяСтраницы, РастягиватьСтраницу);
		СтраницаФормы.РастягиватьПоГоризонтали = РастягиватьСтраницу;
		СтраницаФормы.ГоризонтальноеПоложениеВГруппе = ?(РастягиватьСтраницу, ГоризонтальноеПоложениеЭлемента.Авто, ГоризонтальноеПоложениеЭлемента.Лево);
		ФизКолы = Новый Массив;
		СоздатьРядыКолонокПанелька(СтраницаФормы, ИмяЭлементаСтраницы, КоличествоПолос, ПланСтраницы.КолонокВРяду, ФизКолы);
		Если ИмяСтраницы = ИмяТекущейСтраницы Тогда
			ТекущаяГруппаСтраницы = СтраницаФормы;
		КонецЕсли;
		Высоты = Новый Массив;
		Пока Высоты.Количество() < КоличествоПолос Цикл
			Высоты.Добавить(0);
		КонецЦикла;
		ФизКолонкиСтраниц.Вставить(ИмяСтраницы, ФизКолы);
		ВысотыСтраниц.Вставить(ИмяСтраницы, Высоты);
	КонецЦикла;
	Если ТекущаяГруппаСтраницы <> Неопределено Тогда
		ГруппаСтраницы.ТекущаяСтраница = ТекущаяГруппаСтраницы;
	КонецЕсли;
	Контекст.Вставить("ПланыСтраницПанелька", ПланыСтраниц);
	Контекст.Вставить("ШириныСсылокСтраницПанелька", ШириныСсылокСтраниц);
	Контекст.Вставить("ЧислоПолосКатегорий", ЧислоПолосКатегорий);
	Контекст.Вставить("РастягиватьСтраницы", РастягиватьСтраницы);
	Контекст.Вставить("ГруппаСтраницы", ГруппаСтраницы);
	Контекст.Вставить("ФизКолонкиСтраниц", ФизКолонкиСтраниц);
	Контекст.Вставить("ВысотыСтраниц", ВысотыСтраниц);
	Контекст.Вставить("МаксСлотовШирины", 6);
	Контекст.Вставить("МаксШиринаСсылки", 42);
	Контекст.Вставить("ВесНаПолосу", 24);
КонецПроцедуры

// Планирует страницу целиком: минимальное полезное число полос при заданном пределе.
// Расчётная высота выражена в весах ссылок и заголовков, а не в пикселях окна.
// Параметры:
//  Категории - Массив из Строка - сохранённый порядок категорий страницы.
//  Веса - Соответствие из КлючИЗначение - расчётная высота категорий:
//   * Ключ - Строка - категория.
//   * Значение - Число - вес ссылок, подсказок и заголовков.
//  Лимит - Число - верхний предел дополнительных полос; исходные категории сохраняются.
//  МаксимумСсылок - Соответствие из КлючИЗначение - число отображаемых ссылок:
//   * Ключ - Строка - категория.
//   * Значение - Число - число ссылок.
//  БюджетШирины - Число - суммарная ширина надписей ряда в символьных единицах.
// Возвращаемое значение:
//  Структура - план до создания элементов формы:
//   * ПолосыКатегорий - Соответствие из КлючИЗначение - число полос категории:
//    ** Ключ - Строка - категория.
//    ** Значение - Число - число полос.
//   * КоличествоПолос - Число - суммарное число полос.
//   * ЦелевойВес - Число - целевая расчётная высота.
//   * МаксимальнаяВысота - Число - самая высокая расчётная полоса.
//   * СредняяВысота - Число - средняя расчётная высота.
//   * МаксШиринаСсылки - Число - максимальная ширина текста в символах.
//   * МаксШиринаЗаголовка - Число - максимальная ширина заголовка в символах.
//   * РастягиватьСтраницу - Булево - использование ширины страницы.
//   * КолонокВРяду - Число - максимум независимых колонок одного ряда.
&НаСервереБезКонтекста
Функция РассчитатьПланСтраницыПанелька(Категории, Веса, Лимит, МаксимумСсылок, БюджетШирины = 160)
	СуммарныйВес = 0;
	ЗаполненныхКатегорий = 0;
	Вместимости = Новый Соответствие;
	Для Каждого Категория Из Категории Цикл
		Вес = Веса[Категория];
		Вес = ?(Вес = Неопределено, 0, Макс(0, Вес));
		СуммарныйВес = СуммарныйВес + Вес;
		Если Вес > 0 Тогда
			ЗаполненныхКатегорий = ЗаполненныхКатегорий + 1;
		КонецЕсли;
		КоличествоСсылок = МаксимумСсылок[Категория];
		КоличествоСсылок = ?(КоличествоСсылок = Неопределено, 0, КоличествоСсылок);
		// Не планируем больше одной полосы на каждые три ссылки.
		Вместимости.Вставить(Категория, Макс(1, Цел(КоличествоСсылок / 3)));
	КонецЦикла;
	КоличествоКатегорий = Категории.Количество();
	ЦелевойВес = 24;
	Если ЗаполненныхКатегорий > 1 Тогда
		// Общая нагрузка страницы допускает немного более высокие полосы,
		// чтобы не дробить большую категорию ради двух коротких соседей.
		ЦелевойВес = Число(Макс(24, Мин(36, 1.25 * СуммарныйВес / ЗаполненныхКатегорий)));
	КонецЕсли;
	План = РаспределитьПолосыПоЛимитуПанелька(Категории, Веса, Макс(КоличествоКатегорий, Лимит), ЦелевойВес, Вместимости);
	КоличествоПолос = 0;
	МаксимальнаяВысота = 0;
	Для Каждого Категория Из Категории Цикл
		КоличествоПолос = КоличествоПолос + План[Категория];
		Вес = Веса[Категория];
		МаксимальнаяВысота = Число(Макс(МаксимальнаяВысота, ?(Вес = Неопределено, 0, Вес) / План[Категория]));
	КонецЦикла;
	КолонокВРяду = Число(Макс(1, Мин(КоличествоПолос, Лимит)));
	МаксШиринаСсылки = Число(Макс(16, Мин(42, Цел(БюджетШирины / КолонокВРяду))));
	МаксШиринаЗаголовка = Число(?(КоличествоПолос < 4, МаксШиринаСсылки, Мин(24, МаксШиринаСсылки)));
	// Рабочая область использует ширину окна; сами колонки всегда компактны.
	РастягиватьСтраницу = Истина;
	Результат = Новый Структура;
	Результат.Вставить("ПолосыКатегорий", План);
	Результат.Вставить("КоличествоПолос", КоличествоПолос);
	Результат.Вставить("КолонокВРяду", КолонокВРяду);
	Результат.Вставить("ЦелевойВес", ЦелевойВес);
	Результат.Вставить("МаксимальнаяВысота", МаксимальнаяВысота);
	Результат.Вставить("СредняяВысота", СуммарныйВес / Макс(1, КоличествоПолос));
	Результат.Вставить("МаксШиринаСсылки", МаксШиринаСсылки);
	Результат.Вставить("МаксШиринаЗаголовка", МаксШиринаЗаголовка);
	Результат.Вставить("РастягиватьСтраницу", РастягиватьСтраницу);
	РастяжениеКатегорий = Новый Соответствие;
	Для Каждого Категория Из Категории Цикл
		РастяжениеКатегорий.Вставить(Категория, Ложь);
	КонецЦикла;
	Результат.Вставить("РастяжениеКатегорий", РастяжениеКатегорий);
	Возврат Результат;
КонецФункции


// Распределяет заданный бюджет полос между категориями в сохранённом порядке.
// Параметры:
//  Категории - Массив из Строка - категории одной страницы.
//  Веса - Соответствие из КлючИЗначение - расчётные веса категорий:
//   * Ключ - Строка - имя категории.
//   * Значение - Число - расчётный вес категории.
//  Лимит - Число - выбранный бюджет полос страницы.
//  ЦелевойВес - Число - желательная нагрузка одной полосы, 0 без порога остановки.
//  МаксимумСсылок - Соответствие из КлючИЗначение - предел числа непустых полос:
//   * Ключ - Строка - категория.
//   * Значение - Число - число отображаемых ссылок; Неопределено без ограничения.
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - план; пустые категории сохраняют одну полосу:
//   * Ключ - Строка - имя категории.
//   * Значение - Число - число полос.
&НаСервереБезКонтекста
Функция РаспределитьПолосыПоЛимитуПанелька(Категории, Веса, Лимит, ЦелевойВес, МаксимумСсылок = Неопределено)
	План = Новый Соответствие;
	Для Каждого Категория Из Категории Цикл
		План.Вставить(Категория, 1);
	КонецЦикла;
	ВсегоПолос = Категории.Количество();
	Пока ВсегоПолос < Лимит Цикл
		ЛучшаяКатегория = Неопределено;
		НаибольшаяВысота = ЦелевойВес;
		Для Каждого Категория Из Категории Цикл
			Если МаксимумСсылок <> Неопределено Тогда
				Вместимость = МаксимумСсылок[Категория];
				Если Вместимость = Неопределено Или План[Категория] >= Вместимость Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Вес = Веса[Категория];
			Вес = ?(Вес = Неопределено, 0, Вес);
			Высота = Вес / План[Категория];
			Если Высота > НаибольшаяВысота Тогда
				ЛучшаяКатегория = Категория;
				НаибольшаяВысота = Высота;
			КонецЕсли;
		КонецЦикла;
		Если ЛучшаяКатегория = Неопределено Тогда
			Прервать;
		КонецЕсли;
		План.Вставить(ЛучшаяКатегория, План[ЛучшаяКатегория] + 1);
		ВсегоПолос = ВсегоПолос + 1;
	КонецЦикла;
	Возврат План;
КонецФункции



// Создаёт устойчивые горизонтальные ряды в пределах рассчитанного бюджета.
// Повторная компоновка клиента не меняет направление всего ряда на вертикальное.
// Параметры:
//  Родитель - ГруппаФормы - страница.
//  ОсноваИмени - Строка - основа уникального имени.
//  ВсегоПолос - Число - число непустых полос и сохранённых пустых категорий.
//  КолонокВРяду - Число - выбранный предел колонок одного ряда.
//  ФизКолы - Массив из ГруппаФормы - созданные полосы в сохранённом порядке.
&НаСервере
Процедура СоздатьРядыКолонокПанелька(Родитель, ОсноваИмени, ВсегоПолос, КолонокВРяду, ФизКолы)
	ИндексПолосы = 0;
	НомерРяда = 0;
	Пока ИндексПолосы < ВсегоПолос Цикл
		НомерРяда = НомерРяда + 1;
		ИмяРяда = ОсноваИмени + "_Ряд_" + Строка(НомерРяда);
		Ряд = Элементы.Добавить(ИмяРяда, Тип("ГруппаФормы"), Родитель);
		Ряд.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Ряд.ОтображатьЗаголовок = Ложь;
		Ряд.Отображение = ОтображениеОбычнойГруппы.Нет;
		Ряд.Объединенная = Истина;
		Ряд.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		Ряд.РастягиватьПоГоризонтали = Истина;
		Ряд.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
		Ряд.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
		Ряд.Ширина = 0;
		Ряд.РастягиватьПоВертикали = Ложь;
		Ряд.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
		КонецРяда = Мин(ВсегоПолос, ИндексПолосы + КолонокВРяду);
		// Число колонок и рядов рассчитано заранее; штатное IfPossible здесь схлопывало весь ряд.
		СоздатьПолосыОбычнойПанелиПанелька(Ряд, ИмяРяда + "_Колонки", КонецРяда - ИндексПолосы, ФизКолы);
		// Единственный растягиваемый элемент ряда находится после всех колонок.
		// Поиск уже пропускает элементы с суффиксом _Пружина.
		Пружина = Элементы.Добавить(ИмяРяда + "_Пружина", Тип("ДекорацияФормы"), Ряд);
		Пружина.Вид = ВидДекорацииФормы.Надпись;
		Пружина.Заголовок = " ";
		Пружина.Ширина = 1;
		Пружина.Высота = 1;
		Пружина.РастягиватьПоГоризонтали = Истина;
		Пружина.РастягиватьПоВертикали = Ложь;
		ИндексПолосы = КонецРяда;
	КонецЦикла;
КонецПроцедуры


// Создаёт компактные независимые колонки одного ряда без вложенных ветвей 2+4.
// Параметры:
//  Родитель - ГруппаФормы - внешний ряд с растягиваемым остатком справа.
//  ОсноваИмени - Строка - уникальное имя содержимого ряда.
//  КоличествоПолос - Число - положительное число полос в этом ряду.
//  ФизКолы - Массив из ГруппаФормы - все созданные полосы в сохранённом порядке.
&НаСервере
Процедура СоздатьПолосыОбычнойПанелиПанелька(Родитель, ОсноваИмени, КоличествоПолос, ФизКолы)
	Содержимое = Элементы.Добавить(ОсноваИмени + "_Содержимое", Тип("ГруппаФормы"), Родитель);
	Содержимое.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Содержимое.ОтображатьЗаголовок = Ложь;
	Содержимое.Отображение = ОтображениеОбычнойГруппы.Нет;
	Содержимое.Объединенная = Истина;
	Содержимое.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Содержимое.РастягиватьПоГоризонтали = Ложь;
	Содержимое.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
	Содержимое.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
	Содержимое.Ширина = 0;
	Содержимое.РастягиватьПоВертикали = Ложь;
	Содержимое.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
	Для НомерПолосы = 1 По КоличествоПолос Цикл
		Группа = Элементы.Добавить(ОсноваИмени + "_Полоса_" + Строка(НомерПолосы) + "_Адаптив", Тип("ГруппаФормы"), Содержимое);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.ОтображатьЗаголовок = Ложь;
		Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
		Группа.Объединенная = Истина;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		Группа.РастягиватьПоГоризонтали = Ложь;
		Группа.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
		Группа.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
		Группа.Ширина = 0;
		Группа.РастягиватьПоВертикали = Ложь;
		Группа.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
		ФизКолы.Добавить(Группа);
	КонецЦикла;
КонецПроцедуры


// Создаёт независимые физические полосы категорий в общей сетке страницы.
// Параметры:
//  Контекст - Структура - контекст построения панели.
&НаСервере
Процедура СоздатьКонтейнерыКатегорий(Контекст)
	СуффиксОтрисовки = Контекст.СуффиксОтрисовки;
	ШрифтКолонки = Контекст.ШрифтКолонки;
	ЦветКолонки = Контекст.ЦветКолонки;
	ИконкиКолонок = Контекст.ИконкиКолонок;
	СледующиеПолосыСтраниц = Новый Соответствие;
	ВнутренниеФизКолонки = Новый Соответствие;
	СостоянияКатегорий = Новый Соответствие;
	НомерКолонки = 0;
	Для Каждого ИмяКолонки Из Контекст.МассивКолонок Цикл
		ВнутрКол = Контекст.ЧислоПолосКатегорий[ИмяКолонки];
		Если ВнутрКол = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЦелеваяСтраница = Контекст.НастройкиКолонокСтраница[ИмяКолонки];
		Если Не ЗначениеЗаполнено(ЦелеваяСтраница) Тогда
			ЦелеваяСтраница = "Главная";
		КонецЕсли;
		ВесКатегории = Контекст.ВесаКатегорий[ИмяКолонки];
		ВесКатегории = ?(ВесКатегории = Неопределено, 0, ВесКатегории);
		СостоянияКатегорий.Вставить(ИмяКолонки,
			Новый Структура("ТекИндекс, ТекВысота, ОптЛимит", 0, 0, ВесКатегории / ВнутрКол + 2.5));
		РастягиватьКолонку = Контекст.ПланыСтраницПанелька[ЦелеваяСтраница].РастяжениеКатегорий[ИмяКолонки];
		ФизКолыСтраницы = Контекст.ФизКолонкиСтраниц[ЦелеваяСтраница];
		НачалоПолос = СледующиеПолосыСтраниц[ЦелеваяСтраница];
		Если НачалоПолос = Неопределено Тогда
			НачалоПолос = 0;
		КонецЕсли;
		ВнутрФизКолы = Новый Массив;
		НомерКолонки = НомерКолонки + 1;
		// Импортированные ИД также могут совпасть после нормализации имени элемента.
		ОсноваГруппы = "ГруппаКолонка_" + Формат(НомерКолонки, "ЧГ=0;ЧДЦ=0") + "_" + СуффиксОтрисовки;
		Для ИндексЧасти = 0 По ВнутрКол - 1 Цикл
			ИмяГруппыДляФормы = ОсноваГруппы;
			Если ИндексЧасти > 0 Тогда
				ИмяГруппыДляФормы = ОсноваГруппы + "_Полоса_" + Строка(ИндексЧасти + 1);
			КонецЕсли;
			НоваяГруппа = Элементы.Добавить(ИмяГруппыДляФормы, Тип("ГруппаФормы"), ФизКолыСтраницы[НачалоПолос + ИндексЧасти]);
			НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			НоваяГруппа.РастягиватьПоГоризонтали = РастягиватьКолонку;
			НоваяГруппа.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
			НоваяГруппа.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
			НоваяГруппа.Ширина = 0;
			НоваяГруппа.РастягиватьПоВертикали = Ложь;
			НоваяГруппа.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
			НоваяГруппа.ОтображатьЗаголовок = Ложь;
			// Поиск проверяет заголовок группы, в том числе у полос без собственной шапки.
			НоваяГруппа.Заголовок = ЗаголовокКолонкиПанелька(Контекст, ИмяКолонки);
			Если ИндексЧасти = 0 Тогда
				ШапкаКолонки = НоваяГруппа;
				ИмяИконкиКол = ИконкиКолонок[ИмяКолонки];
				Если ЗначениеЗаполнено(ИмяИконкиКол) Тогда
					ШапкаКолонки = Элементы.Добавить(ИмяГруппыДляФормы + "_Шапка", Тип("ГруппаФормы"), НоваяГруппа);
					ШапкаКолонки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
					ШапкаКолонки.ОтображатьЗаголовок = Ложь;
					ШапкаКолонки.РастягиватьПоГоризонтали = Ложь;
					ШапкаКолонки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
					ИконкаКол = Элементы.Добавить(ИмяГруппыДляФормы + "_Иконка", Тип("ДекорацияФормы"), ШапкаКолонки);
					ИконкаКол.Вид = ВидДекорацииФормы.Картинка;
					ИконкаКол.РазмерКартинки = РазмерКартинки.Пропорционально;
					ИконкаКол.Высота = 1;
					ИконкаКол.Ширина = 2;
					Попытка
						ИконкаКол.Картинка = БиблиотекаКартинок[ИмяИконкиКол];
					Исключение
						// Недоступная в этой конфигурации картинка не препятствует построению колонки.
					КонецПопытки;
				КонецЕсли;
				ТекстКол = Элементы.Добавить(ИмяГруппыДляФормы + "_Текст", Тип("ДекорацияФормы"), ШапкаКолонки);
				ТекстКол.Вид = ВидДекорацииФормы.Надпись;
				ТекстКол.РастягиватьПоГоризонтали = Ложь;
				ТекстКол.МаксимальнаяШирина = Контекст.ПланыСтраницПанелька[ЦелеваяСтраница].МаксШиринаЗаголовка;
				ТекстКол.АвтоМаксимальнаяШирина = Ложь;
				ТекстКол.Заголовок = ЗаголовокКолонкиПанелька(Контекст, ИмяКолонки);
				ТекстКол.Шрифт = ШрифтКолонки;
				ТекстКол.ЦветТекста = ЦветКолонки;
			Иначе
				ПустаяШапка = Элементы.Добавить(ИмяГруппыДляФормы + "_ПустаяШапка", Тип("ДекорацияФормы"), НоваяГруппа);
				ПустаяШапка.Вид = ВидДекорацииФормы.Надпись;
				ПустаяШапка.Заголовок = " ";
				ПустаяШапка.Шрифт = ШрифтКолонки;
				ПустаяШапка.Высота = 1;
				ПустаяШапка.Ширина = 1;
				ПустаяШапка.РастягиватьПоГоризонтали = Ложь;
				ПустаяШапка.РастягиватьПоВертикали = Ложь;
			КонецЕсли;
			ИмяКонтейнера = СформироватьБезопасноеИмяЭлементаПанелька(ИмяГруппыДляФормы + "_Контейнер", "");
			КонтейнерТипов = Элементы.Добавить(ИмяКонтейнера, Тип("ГруппаФормы"), НоваяГруппа);
			КонтейнерТипов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			КонтейнерТипов.ОтображатьЗаголовок = Ложь;
			КонтейнерТипов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			КонтейнерТипов.РастягиватьПоГоризонтали = РастягиватьКолонку;
			КонтейнерТипов.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
			КонтейнерТипов.ГоризонтальноеПоложениеПодчиненных = ГоризонтальноеПоложениеЭлемента.Лево;
			КонтейнерТипов.Ширина = 0;
			КонтейнерТипов.РастягиватьПоВертикали = Ложь;
			КонтейнерТипов.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Верх;
			ВнутрФизКолы.Добавить(КонтейнерТипов);
		КонецЦикла;
		СледующиеПолосыСтраниц.Вставить(ЦелеваяСтраница, НачалоПолос + ВнутрКол);
		ВнутренниеФизКолонки.Вставить(ИмяКолонки, ВнутрФизКолы);
	КонецЦикла;
	Контекст.Вставить("ВнутренниеФизКолонки", ВнутренниеФизКолонки);
	Контекст.Вставить("СостоянияКатегорий", СостоянияКатегорий);
КонецПроцедуры

// Создает ссылки, их группы типов и контекстные меню внутри подготовленных категорий.
// Параметры:
//  Контекст - Структура - контекст построения панели.
&НаСервере
Процедура ОтрисоватьСсылкиДашборда(Контекст)
	Диаг = НовыеЗамерыСсылокПанелька();
	// Кэш живёт только в пределах одного построения обычной панели.
	КэшКартинокМеню = Новый Соответствие;
	КонтекстМеню = Новый Структура("Диаг,КэшКартинокМеню,ПользовательАдминистратор",
		Диаг, КэшКартинокМеню, Контекст.ПользовательАдминистратор);
	Данные = Контекст.Данные;
	ВнутренниеФизКолонки = Контекст.ВнутренниеФизКолонки;
	СостоянияКатегорий = Контекст.СостоянияКатегорий;
	ГруппироватьПоТипу = Контекст.ГруппироватьПоТипу;
	РежимПодсказок = Контекст.РежимПодсказок;
	СуффиксОтрисовки = Контекст.СуффиксОтрисовки;
	МаксШиринаСсылки = Контекст.МаксШиринаСсылки;
	ШириныСсылокСтраниц = Неопределено;
	Контекст.Свойство("ШириныСсылокСтраницПанелька", ШириныСсылокСтраниц);
	// Остатки нужны для равномерного заполнения и защиты от пустых продолжений.
	ОстаткиСсылок = Новый Соответствие;
	ОстаткиВесов = Новый Соответствие;
	ПоследниеТипыРазмещения = Новый Соответствие;
	Для Каждого СтрПодсчета Из Данные Цикл
		Если Не ЗначениеЗаполнено(СтрПодсчета.Ссылка) Или ВнутренниеФизКолонки[СтрПодсчета.Колонка] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЧислоОсталось = ОстаткиСсылок[СтрПодсчета.Колонка];
		ОстаткиСсылок.Вставить(СтрПодсчета.Колонка, ?(ЧислоОсталось = Неопределено, 0, ЧислоОсталось) + 1);
		ТекстПодсчета = ?(ЗначениеЗаполнено(СтрПодсчета.Наименование), СтрПодсчета.Наименование, СтрПодсчета.Ссылка);
		ВесПодсчета = ?(СтрДлина(ТекстПодсчета) > 35, 1.4, 1);
		Если РежимПодсказок = ОтображениеПодсказки.ОтображатьСнизу И ЗначениеЗаполнено(СтрПодсчета.Подсказка) Тогда
			ВесПодсчета = ВесПодсчета + 1.1;
		КонецЕсли;
		Если ГруппироватьПоТипу И ЗначениеЗаполнено(СтрПодсчета.ТипОбъекта) И ПоследниеТипыРазмещения[СтрПодсчета.Колонка] <> СтрПодсчета.ТипОбъекта
			И НРег(СокрЛП(СтрПодсчета.ТипОбъекта)) <> НРег(СокрЛП(ЗаголовокКолонкиПанелька(Контекст, СтрПодсчета.Колонка))) Тогда
			ВесПодсчета = ВесПодсчета + 2.5;
			ПоследниеТипыРазмещения.Вставить(СтрПодсчета.Колонка, СтрПодсчета.ТипОбъекта);
		КонецЕсли;
		ВесОстался = ОстаткиВесов[СтрПодсчета.Колонка];
		ОстаткиВесов.Вставить(СтрПодсчета.Колонка, ?(ВесОстался = Неопределено, 0, ВесОстался) + ВесПодсчета);
	КонецЦикла;
	ПоследниеТипыРазмещения = Новый Соответствие;
	// === ГЛАВНЫЙ ЦИКЛ ОТРИСОВКИ ССЫЛОК ВНУТРИ БЛОКОВ ===
	ТекКолонка = "";
	ТекТип = "";
	УникальныйСчетчик = 1;
	РодительТипа = Неопределено;
	Для Каждого Стр Из Данные Цикл
		Если Не ЗначениеЗаполнено(Стр.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		УникальныйСчетчик = УникальныйСчетчик + 1;
		СуффиксСсылки = Формат(УникальныйСчетчик, "ЧГ=0;ЧДЦ=0");
		ВнутрФизКолы = ВнутренниеФизКолонки[Стр.Колонка];
		Состояние = СостоянияКатегорий[Стр.Колонка];
		Если ВнутрФизКолы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ДиагностикаПанелька Тогда
			СтартЧасти = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		КонецЕсли;
		Если ШириныСсылокСтраниц <> Неопределено Тогда
			ШиринаСтраницы = ШириныСсылокСтраниц[Стр.Вкладка];
			МаксШиринаСсылки = ?(ШиринаСтраницы = Неопределено, Контекст.МаксШиринаСсылки, ШиринаСтраницы);
		КонецЕсли;
		ВесСтр = 1.0;
		ТекстДляДлины = ?(ЗначениеЗаполнено(Стр.Наименование), Стр.Наименование, Стр.Ссылка);
		Если СтрДлина(ТекстДляДлины) > 35 Тогда
			ВесСтр = 1.4;
		КонецЕсли;
		Если РежимПодсказок = ОтображениеПодсказки.ОтображатьСнизу И ЗначениеЗаполнено(Стр.Подсказка) Тогда
			ВесСтр = ВесСтр + 1.1;
		КонецЕсли;
		Если ТекКолонка <> Стр.Колонка Тогда
			ТекКолонка = Стр.Колонка;
			ТекТип = "";
			РодительТипа = Неопределено;
		КонецЕсли;
		ВесРазмещения = ВесСтр;
		Если ГруппироватьПоТипу И ЗначениеЗаполнено(Стр.ТипОбъекта) И ПоследниеТипыРазмещения[Стр.Колонка] <> Стр.ТипОбъекта
			И НРег(СокрЛП(Стр.ТипОбъекта)) <> НРег(СокрЛП(ЗаголовокКолонкиПанелька(Контекст, Стр.Колонка))) Тогда
			ВесРазмещения = ВесРазмещения + 2.5;
			ПоследниеТипыРазмещения.Вставить(Стр.Колонка, Стр.ТипОбъекта);
		КонецЕсли;
		ЧислоОсталось = ОстаткиСсылок[Стр.Колонка];
		ВесОстался = ОстаткиВесов[Стр.Колонка];
		СвободныхПолос = ВнутрФизКолы.Количество() - Состояние.ТекИндекс;
		ЕстьШапкаТипа = ГруппироватьПоТипу И ЗначениеЗаполнено(Стр.ТипОбъекта)
			И НРег(СокрЛП(Стр.ТипОбъекта)) <> НРег(СокрЛП(ЗаголовокКолонкиПанелька(Контекст, Стр.Колонка)));
		Состояние.ОптЛимит = (Состояние.ТекВысота + ВесОстался) / СвободныхПолос + ?(ЕстьШапкаТипа, 2.5, 0);
		// Резервируем минимум одну ссылку каждой следующей полосе.

		Если Состояние.ТекВысота > 0 И (Состояние.ТекВысота + ВесРазмещения > Состояние.ОптЛимит Или ЧислоОсталось < СвободныхПолос) И
			Состояние.ТекИндекс < (ВнутрФизКолы.Количество() - 1) Тогда
			Состояние.ТекИндекс = Состояние.ТекИндекс + 1;
			Состояние.ТекВысота = 0;
			ТекТип = "";
		КонецЕсли;
		ОстаткиСсылок.Вставить(Стр.Колонка, ЧислоОсталось - 1);
		ОстаткиВесов.Вставить(Стр.Колонка, ВесОстался - ВесРазмещения);
		РодительОтрисовки = ВнутрФизКолы[Состояние.ТекИндекс];
		Если ДиагностикаПанелька Тогда
			НакопитьЗамерОтрисовкиПанелька(Диаг, "Размещение", СтартЧасти);
		КонецЕсли;
		Если ДиагностикаПанелька Тогда
			СтартЧасти = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		КонецЕсли;
		// ПЕРЕКЛЮЧЕНИЕ ТИПА ОБЪЕКТА
		Если ГруппироватьПоТипу И ЗначениеЗаполнено(Стр.ТипОбъекта) И ТекТип <> Стр.ТипОбъекта Тогда
			ТекТип = Стр.ТипОбъекта;
			РодительТипа = СоздатьГруппуТипаСсылокПанелька(Стр, Контекст, РодительОтрисовки, Состояние,
				СуффиксСсылки, МаксШиринаСсылки, Диаг);
		КонецЕсли;
		// Компактная строка удерживает штатную кнопку подсказки рядом с надписью.
		РодительДляСсылки = ?(ГруппироватьПоТипу И ЗначениеЗаполнено(Стр.ТипОбъекта), РодительТипа, РодительОтрисовки);
		ИмяЭлемента = "ОбъектСсылка_" + СуффиксСсылки + "_" + СуффиксОтрисовки;
		НовыйЭлемент = СоздатьЭлементСсылкиПанелька(ИмяЭлемента, РодительДляСсылки, МаксШиринаСсылки, Диаг);

		Состояние.ТекВысота = Состояние.ТекВысота + ВесСтр;
		Если ДиагностикаПанелька Тогда
			НакопитьЗамерОтрисовкиПанелька(Диаг, "Элементы", СтартЧасти);
		КонецЕсли;
		Если ДиагностикаПанелька Тогда
			СтартЧасти = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		КонецЕсли;
		ОписаниеСсылки = ОписаниеСсылкиДляОтрисовкиПанелька(Стр, Контекст);
		КорректнаяСсылка = ОписаниеСсылки.КорректнаяСсылка;
		СтатусСсылки = ОписаниеСсылки.СтатусСсылки;
		Если ДиагностикаПанелька Тогда
			НакопитьЗамерОтрисовкиПанелька(Диаг, "Статусы", СтартЧасти);
		КонецЕсли;
		Если ДиагностикаПанелька Тогда
			СтартЧасти = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		КонецЕсли;
		Если КорректнаяСсылка И СтатусСсылки = "ОК" Тогда
			ОформитьАктивнуюСсылкуПанелька(НовыйЭлемент, ИмяЭлемента, Стр, ОписаниеСсылки, Контекст);
			Если ДиагностикаПанелька Тогда
				НакопитьЗамерОтрисовкиПанелька(Диаг, "Свойства", СтартЧасти);
			КонецЕсли;
			Если ДиагностикаПанелька Тогда
				СтартЧасти = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
			КонецЕсли;
			СоздатьКонтекстноеМенюСсылкиПанелька(НовыйЭлемент, Стр, ОписаниеСсылки, КонтекстМеню);
			Если ДиагностикаПанелька Тогда
				НакопитьЗамерОтрисовкиПанелька(Диаг, "Меню", СтартЧасти);
			КонецЕсли;
		Иначе
			ОформитьНедоступнуюСсылкуПанелька(НовыйЭлемент, Стр, ОписаниеСсылки, Контекст);
		КонецЕсли;
		Если Не (КорректнаяСсылка И СтатусСсылки = "ОК") Тогда
			Если ДиагностикаПанелька Тогда
				НакопитьЗамерОтрисовкиПанелька(Диаг, "Свойства", СтартЧасти);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ДиагностикаПанелька Тогда
		Контекст.Вставить("ЗамерыСсылок", Диаг);
	КонецЕсли;
КонецПроцедуры


// Создает счетчики одного построения обычной панели.
&НаСервере
Функция НовыеЗамерыСсылокПанелька()
	Диаг = Новый Структура;
	Диаг.Вставить("Размещение", 0);
	Диаг.Вставить("Элементы", 0);
	Диаг.Вставить("Статусы", 0);
	Диаг.Вставить("Свойства", 0);
	Диаг.Вставить("Меню", 0);
	Диаг.Вставить("Избранное", 0);
	Диаг.Вставить("ЧислоЭлементов", 0);
	Диаг.Вставить("ЧислоКоманд", 0);
	Диаг.Вставить("ДобавлениеЭлементовМеню", 0);
	Диаг.Вставить("ПривязкаКомандМеню", 0);
	Диаг.Вставить("ЗаголовкиМеню", 0);
	Диаг.Вставить("КартинкиМеню", 0);
	Диаг.Вставить("ПолучениеКартинокМеню", 0);
	Диаг.Вставить("ПрисваиваниеКартинокМеню", 0);
	Диаг.Вставить("ЧислоЗагруженныхКартинокМеню", 0);
	Диаг.Вставить("ЧислоПрисваиванийКартинокМеню", 0);
	Возврат Диаг;
КонецФункции


// Создает контейнер типа и необязательный заголовок, учитывая высоту заголовка.
&НаСервере
Функция СоздатьГруппуТипаСсылокПанелька(Стр, Контекст, РодительОтрисовки, Состояние, СуффиксСсылки,
	МаксШиринаСсылки, Диаг)
	ТекТип = Стр.ТипОбъекта;
	СуффиксОтрисовки = Контекст.СуффиксОтрисовки;
	ШрифтГруппировки = Контекст.ШрифтГруппировки;
	ЦветГруппировки = Контекст.ЦветГруппировки;
	ИмяГруппыТипа = СформироватьБезопасноеИмяЭлементаПанелька("ГрТип_", ТекТип) + "_" + СуффиксСсылки +
		"_" + СуффиксОтрисовки;
	РодительТипа = Элементы.Добавить(ИмяГруппыТипа, Тип("ГруппаФормы"), РодительОтрисовки);
	Если ДиагностикаПанелька Тогда
		Диаг.ЧислоЭлементов = Диаг.ЧислоЭлементов + 1;
	КонецЕсли;
	РодительТипа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	РодительТипа.ОтображатьЗаголовок = Ложь;
	РодительТипа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	РодительТипа.РастягиватьПоГоризонтали = Ложь;
	Если НРег(СокрЛП(ТекТип)) <> НРег(СокрЛП(ЗаголовокКолонкиПанелька(Контекст, Стр.Колонка))) Тогда
		ШапкаТипа = Элементы.Добавить(ИмяГруппыТипа + "_Шапка", Тип("ГруппаФормы"), РодительТипа);
		Если ДиагностикаПанелька Тогда
			Диаг.ЧислоЭлементов = Диаг.ЧислоЭлементов + 1;
		КонецЕсли;
		ШапкаТипа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ШапкаТипа.ОтображатьЗаголовок = Ложь;
		ШапкаТипа.РастягиватьПоГоризонтали = Ложь;
		ШапкаТипа.Отображение = ОтображениеОбычнойГруппы.Нет;
		ШапкаТипа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
		КартинкаТипа = ПолучитьКартинкуДляТипаПанелька(ТекТип);
		Если ТекТип = "Веб-ссылки" Тогда
			КартинкаТипа = БиблиотекаКартинок.ГеографическаяСхема;
		ИначеЕсли ТекТип = "Дополнительные отчеты" Тогда
			КартинкаТипа = БиблиотекаКартинок.Отчет;
		ИначеЕсли ТекТип = "Дополнительные обработки" Тогда
			КартинкаТипа = БиблиотекаКартинок.Обработка;
		КонецЕсли;
		ИконкаТипа = Элементы.Добавить(ИмяГруппыТипа + "_Иконка", Тип("ДекорацияФормы"), ШапкаТипа);
		Если ДиагностикаПанелька Тогда
			Диаг.ЧислоЭлементов = Диаг.ЧислоЭлементов + 1;
		КонецЕсли;
		ИконкаТипа.Вид = ВидДекорацииФормы.Картинка;
		ИконкаТипа.Картинка = КартинкаТипа;
		ТекстТипа = Элементы.Добавить(ИмяГруппыТипа + "_ТекстЗаголовка", Тип("ДекорацияФормы"), ШапкаТипа);
		Если ДиагностикаПанелька Тогда
			Диаг.ЧислоЭлементов = Диаг.ЧислоЭлементов + 1;
		КонецЕсли;
		ТекстТипа.Вид = ВидДекорацииФормы.Надпись;
		ТекстТипа.РастягиватьПоГоризонтали = Ложь;
		ТекстТипа.МаксимальнаяШирина = МаксШиринаСсылки;
		ТекстТипа.АвтоМаксимальнаяШирина = Ложь;
		ТекстТипа.Заголовок = ТекТип;
		ТекстТипа.Шрифт = ШрифтГруппировки;
		ТекстТипа.ЦветТекста = ЦветГруппировки;
		Состояние.ТекВысота = Состояние.ТекВысота + 2.5;
	КонецЕсли;
	Возврат РодительТипа;
КонецФункции


// Создает компактную строку ссылки и надпись внутри нее.
&НаСервере
Функция СоздатьЭлементСсылкиПанелька(ИмяЭлемента, РодительДляСсылки, МаксШиринаСсылки, Диаг)
	ГруппаСсылки = Элементы.Добавить("ГрСсылка_" + ИмяЭлемента, Тип("ГруппаФормы"), РодительДляСсылки);
	Если ДиагностикаПанелька Тогда
		Диаг.ЧислоЭлементов = Диаг.ЧислоЭлементов + 1;
	КонецЕсли;
	ГруппаСсылки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСсылки.ОтображатьЗаголовок = Ложь;
	ГруппаСсылки.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаСсылки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаСсылки.РастягиватьПоГоризонтали = Ложь;
	ГруппаСсылки.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
	ГруппаСсылки.РастягиватьПоВертикали = Ложь;
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ГруппаСсылки);
	Если ДиагностикаПанелька Тогда
		Диаг.ЧислоЭлементов = Диаг.ЧислоЭлементов + 1;
	КонецЕсли;
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
	НовыйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
	НовыйЭлемент.МаксимальнаяШирина = МаксШиринаСсылки;
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.Высота = 0;
	Возврат НовыйЭлемент;
КонецФункции


// Определяет вид, избранность, текст и доступность ссылки с общим кэшем проверки.
&НаСервере
Функция ОписаниеСсылкиДляОтрисовкиПанелька(Стр, Контекст)
	СсылкиИзбранного = Контекст.СсылкиИзбранного;
	КэшСтатусовМД = Контекст.КэшСтатусовМД;
	ЭтоВИзбранном = СсылкиИзбранного[НРег(СокрЛП(Стр.Ссылка))] <> Неопределено;
	ЭтоСистемнаяКоманда = (Лев(Стр.Ссылка, 8) = "sys_cmd:");
	ЭтоВнешнийФайл = (Лев(Стр.Ссылка, 9) = "ext_file:");
	ЭтоВебСсылка = (Лев(Стр.Ссылка, 9) = "web_link:");
	ЭтоДопОбработка = (СтрНайти(Стр.Ссылка,
		"e1cib/data/Справочник.ДополнительныеОтчетыИОбработки") > 0) ИЛИ (СтрНайти(Стр.Ссылка,
		"e1cib/data/Справочник.ВнешниеОбработки") > 0);
	КорректнаяСсылка = ЭтоСистемнаяКоманда Или ЭтоВнешнийФайл Или ЭтоВебСсылка Или ЭтоДопОбработка Или
		(СтрНайти(Стр.Ссылка, "e1cib/") > 0 Или СтрНайти(Стр.Ссылка, "e1c://") > 0);
	ЭтоСсылкаНаДанные = (СтрНайти(Стр.Ссылка, "e1cib/data/") > 0);
	ТекстСсылки = ?(ЗначениеЗаполнено(Стр.Наименование), Стр.Наименование, Стр.Ссылка);
	СтатусСсылки = "ОК";
	Если ЭтоВнешнийФайл Тогда
		СтатусСсылки = СтатусПраваОткрытияЛокальногоФайлаПанелька(Прав(СокрЛП(Стр.Ссылка), 4));
	ИначеЕсли ЭтоСистемнаяКоманда Тогда
		СтатусСсылки = СтатусПраваОткрытияЛокальногоФайлаПанелька(".epf");
	ИначеЕсли КорректнаяСсылка И Не ЭтоВебСсылка Тогда
		Если ЭтоДопОбработка Тогда
			СтатусСсылки = ПроверитьСтатусДопОбработки(Стр.Ссылка, КэшСтатусовМД);
		Иначе
			СтатусСсылки = ПроверитьСтатусСсылки1С(Стр.Ссылка, КэшСтатусовМД);
		КонецЕсли;
	КонецЕсли;
	Описание = Новый Структура;
	Описание.Вставить("ЭтоВИзбранном", ЭтоВИзбранном);
	Описание.Вставить("ЭтоСистемнаяКоманда", ЭтоСистемнаяКоманда);
	Описание.Вставить("ЭтоВнешнийФайл", ЭтоВнешнийФайл);
	Описание.Вставить("ЭтоВебСсылка", ЭтоВебСсылка);
	Описание.Вставить("ЭтоДопОбработка", ЭтоДопОбработка);
	Описание.Вставить("КорректнаяСсылка", КорректнаяСсылка);
	Описание.Вставить("ЭтоСсылкаНаДанные", ЭтоСсылкаНаДанные);
	Описание.Вставить("ТекстСсылки", ТекстСсылки);
	Описание.Вставить("СтатусСсылки", СтатусСсылки);
	Возврат Описание;
КонецФункции


// Настраивает подпись, подсказку, действие и привязку активной ссылки.
&НаСервере
Процедура ОформитьАктивнуюСсылкуПанелька(НовыйЭлемент, ИмяЭлемента, Стр, ОписаниеСсылки, Контекст)
	НовыйЭлемент.Заголовок = ОписаниеСсылки.ТекстСсылки;
	Если ЗначениеЗаполнено(Стр.Подсказка) Тогда
		НовыйЭлемент.Подсказка = Стр.Подсказка;
		НовыйЭлемент.ОтображениеПодсказки = Контекст.РежимПодсказок;
	Иначе
		НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
	КонецЕсли;
	НовыйЭлемент.Гиперссылка = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "ОткрытьОбъектКонфигурации");
	НоваяСтр = ТаблицаСоответствияОбъектов.Добавить();
	НоваяСтр.ИмяЭлемента = ИмяЭлемента;
	НоваяСтр.Ссылка = Стр.Ссылка;
КонецПроцедуры


// Добавляет открытие в новом окне для поддерживающих его видов ссылок.
&НаСервере
Процедура ДобавитьОткрытиеВНовомОкнеПанелька(НовыйЭлемент, ОписаниеСсылки, КонтекстМеню)
	ИмяЭлемента = НовыйЭлемент.Имя;
	Диаг = КонтекстМеню.Диаг;
