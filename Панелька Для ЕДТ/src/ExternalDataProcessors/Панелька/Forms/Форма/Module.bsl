#Область ОписаниеПеременных

// Состояние профиля только в текущем серверном вызове построения.
&НаСервере
Перем ЕстьЛичнаяПанельВКонтекстеПанелька;

&НаСервере
Перем РевизияЛичногоПрофиляВКонтекстеПанелька;

// Клиентское состояние очереди и поколений загрузки. Не сохраняется в настройках.
&НаКлиенте
Перем ВерсияЗапросовОбновленияПанелька;

&НаКлиенте
Перем ЧислоОжидающихЗапросовПанелька;

&НаКлиенте
Перем ОбновлениеЗапрошеноПанелька;

&НаКлиенте
Перем ПолноеОбновлениеЗапрошеноПанелька;

&НаКлиенте
Перем СбросФокусаЗапрошенПанелька;

&НаКлиенте
Перем ОбновлениеВыполняетсяПанелька;

&НаКлиенте
Перем ОжиданиеОбновленияПанелька;

&НаКлиенте
Перем ФормаЗакрываетсяПанелька;

&НаКлиенте
Перем НачалоЗагрузкиПанелька;

&НаКлиенте
Перем ПоколениеЗагрузкиПанелька;

&НаКлиенте
Перем ПоколениеПроверкиФайловПанелька;

// Красное оформление файла сбрасывается только полным построением.
&НаКлиенте
Перем ЕстьОшибкиВнешнихФайловПанелька;

&НаКлиенте
Перем ОкноЗагрузкиПанелька;
&НаКлиенте
Перем ПараметрыЗагрузкиПанелька;

#КонецОбласти

#Область ОбработчикиСобытийФормы

// Настраивает начальное состояние основной формы и видимость административных элементов.
// Параметры:
//  Отказ - Булево - признак отмены стандартной обработки.
//  СтандартнаяОбработка - Булево - признак выполнения стандартной обработки.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КолонкиПанелька = "Авто";
	Элементы.НастройкиПанелька.Видимость = Ложь;
	Элементы.ПерсональнаяНастройкаПанелиПанелька.Доступность = ПравоДоступа("СохранениеДанныхПользователя", Метаданные);
	Элементы.ПереключитьПанельПанелька.Доступность = Элементы.ПерсональнаяНастройкаПанелиПанелька.Доступность;
	Элементы.ОбщаяНастройкаВГруппеПанелька.Видимость = ПользовательИмеетПраваАдмина();
	// --- ПАМЯТЬ РЕЖИМА ИНТЕРФЕЙСА ---
	Попытка
		СохраненныйРежим = ПолучитьПользовательскуюНастройкуПанелька("РежимHTTP", Неопределено);
		Если СохраненныйРежим <> Неопределено Тогда
			РежимHTTP = СохраненныйРежим;
		Иначе
			РежимHTTP = Истина;
			// По умолчанию используется Web-интерфейс
		КонецЕсли;
	Исключение
		РежимHTTP = Истина;
		ЗаписатьОшибкуПанелька("ЧтениеРежимаИнтерфейса", ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры

// Инициирует построение интерфейса «Панельки» при открытии формы.
// Параметры:
//  Отказ - Булево - признак отмены стандартной обработки.
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьИнтерфейсДашборда(Ложь, Истина);
КонецПроцедуры

// Обрабатывает уведомление о необходимости обновления «Панельки».
// Параметры:
//  ИмяСобытия - Строка - имя события уведомления.
//  Параметр - Произвольный - дополнительный параметр события.
//  Источник - Произвольный - источник уведомления.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Панелька_ОбновитьДашборд" Тогда
		ОбновитьИнтерфейсДашборда(Ложь, Ложь, Истина);
	КонецЕсли;
КонецПроцедуры

// Отменяет очередь и делает устаревшими незавершённые проверки файлов.
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	ФормаЗакрываетсяПанелька = Истина;
	ОтменитьОжиданиеОбновленияПанелька();
	ОбновлениеЗапрошеноПанелька = Ложь;
	ПолноеОбновлениеЗапрошеноПанелька = Ложь;
	СбросФокусаЗапрошенПанелька = Ложь;
	ЧислоОжидающихЗапросовПанелька = 0;
	Если ОкноЗагрузкиПанелька <> Неопределено Тогда
		ЗавершитьОкноЗагрузкиПанелька();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Запускает отложенное применение фильтра при изменении текста поиска.
//
// Параметры:
//  Элемент - ПолеФормы - элемент, вызвавший событие.
//  Текст - Строка - текст, введенный пользователем.
//  СтандартнаяОбработка - Булево - признак выполнения стандартной обработки.
&НаКлиенте
Процедура СтрокаПоискаИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ОтключитьОбработчикОжидания("ПрименитьПоискНаГлавной");
	ПодключитьОбработчикОжидания("ПрименитьПоискНаГлавной", 0.3, Истина);
КонецПроцедуры

// Очищает поисковую строку и сбрасывает фильтр панели.
//
// Параметры:
//  Элемент - ПолеФормы - элемент, вызвавший событие.
//  СтандартнаяОбработка - Булево - признак выполнения стандартной обработки.
&НаКлиенте
Процедура СтрокаПоискаОчистка(Элемент, СтандартнаяОбработка)
	ОтключитьОбработчикОжидания("ПрименитьПоискНаГлавной");
	СтрокаПоиска = "";
	ПрименитьПоискСЗаданнымТекстом("");
КонецПроцедуры

// Перестраивает обычную панель после выбора количества колонок для текущего окна.
// Параметры:
//  Элемент - ПолеФормы - переключатель количества колонок.
&НаКлиенте
Процедура КолонкиПанелькаПриИзменении(Элемент)
	Если КолонкиПанелька <> "4" И КолонкиПанелька <> "6" И КолонкиПанелька <> "8" Тогда
		КолонкиПанелька = "Авто";
	КонецЕсли;
	ОбновитьИнтерфейсДашборда(Истина);
КонецПроцедуры


// Обработчик переключателя режима интерфейса (Обычный / Web).
//
// Параметры:
//  Элемент - ПолеФормы - элемент, вызвавший событие.
&НаКлиенте
Процедура РежимHTTPПриИзменении(Элемент)
	СохранитьПользовательскуюНастройкуПанелька("РежимHTTP", РежимHTTP);
	ОбновитьИнтерфейсДашборда();
КонецПроцедуры

// Перехватывает клики из HTML через безопасный мост параметров (panelka://).
//
// Параметры:
//  Элемент - ПолеФормы - элемент, вызвавший событие.
//  ДанныеСобытия - Произвольный - объект события встроенного HTML-документа с полем Href; конкретный DOM-тип зависит от реализации браузера.
//  СтандартнаяОбработка - Булево - Флаг стандартной обработки (отменяется для перехвата).
&НаКлиенте
Процедура ПолеHTMLДашбордаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	URL = ДанныеСобытия.Href;
	Если ТипЗнч(URL) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	Если Лев(URL, СтрДлина("panelka://")) = "panelka://" Тогда
		СтандартнаяОбработка = Ложь;
		СообщениеWeb = РазобратьКомандуWebПанелька(URL);
		Если Не СообщениеWeb.Успех Тогда
			СообщитьПользователюПанелька(СообщениеWeb.Ошибка);
			Возврат;
		КонецЕсли;
		Действие = СообщениеWeb.Действие;
		СсылкаНаОбъект = СообщениеWeb.Ссылка;
		КрасивоеИмя = СообщениеWeb.Представление;
		// --- СИГНАЛ ГОТОВНОСТИ ---
		Если Действие = "html_loaded" Тогда
			ПроверитьДоступностьВнешнихФайловНаКлиенте();
			Возврат;
		КонецЕсли;
		// --- СОХРАНЕНИЕ СОСТОЯНИЯ ФРОНТЕНДА ---
		Если Действие = "save_tab" Тогда
			СохранитьПользовательскуюНастройкуПанелька("Вкладка", СсылкаНаОбъект);
			Возврат;
		ИначеЕсли Действие = "save_theme" Тогда
			СохранитьПользовательскуюНастройкуПанелька("Тема", (СсылкаНаОбъект = "true"));
			Возврат;
		ИначеЕсли Действие = "switch_mode" Тогда
			РежимHTTP = Ложь;
			СохранитьПользовательскуюНастройкуПанелька("РежимHTTP", Ложь);
			ОбновитьИнтерфейсДашборда();
			Возврат;
		ИначеЕсли Действие = "personal_settings" Тогда
			ОткрытьНастройкиЛичнойПанелиПанелька();
		ИначеЕсли Действие = "personal_create_common" Или Действие = "personal_create_empty" Тогда
			ОткрытьПерсональныйРедакторПанелька(Действие = "personal_create_empty");
			Возврат;
		ИначеЕсли Действие = "personal_switch" Тогда
			ПереключитьАктивнуюПанельПанелька();
		ИначеЕсли Действие = "open_settings" Тогда
			ОткрытьОбщиеНастройкиПанелиПанелька();
			Возврат;
		КонецЕсли;
		// --- ДЕЙСТВИЯ СО ССЫЛКАМИ И КОНТЕКСТНОЕ МЕНЮ ---
		Если Действие = "open" Тогда
			ЗапуститьЭлементПрямоПоСсылке(СсылкаНаОбъект, Ложь);
		ИначеЕсли Действие = "open_new" Тогда
			ЗапуститьЭлементПрямоПоСсылке(СсылкаНаОбъект, Истина);
		ИначеЕсли Действие = "open_card" Тогда
			ОткрытьКарточкуПоСсылкеПанелька(СсылкаНаОбъект);
		ИначеЕсли Действие = "copy_name" ИЛИ Действие = "copy_text" Тогда
			СкопироватьТекстВБуферНадежно(КрасивоеИмя);
		ИначеЕсли Действие = "copy_url" Или Действие = "copy_ext_url"
			Или Действие = "copy_file" Или Действие = "copy_dir" Тогда
			ТекстДляКопирования = ПолучитьТекстСсылкиДляКопированияПанелька(СсылкаНаОбъект, Действие);
			СкопироватьТекстВБуферНадежно(ТекстДляКопирования);
		ИначеЕсли Действие = "add_fav" Или Действие = "remove_fav" Тогда
			РезультатИзбранного = ИзменитьИзбранноеНаСервереПанелька(СсылкаНаОбъект, Действие = "add_fav", КрасивоеИмя);
			Если Не РезультатИзбранного.Успех Тогда
				СообщитьПользователюПанелька(РезультатИзбранного.Ошибка);
				Возврат;
			КонецЕсли;
			Попытка
				ОкноДокумента = ПолучитьОкноWebДашбордаПанелька();
				ОкноДокумента.setFavoriteUI(СсылкаНаОбъект, РезультатИзбранного.ВИзбранном);
			Исключение
				// Запись уже успешна; перестраиваем документ, если его окно недоступно.
				ОбновитьИнтерфейсДашборда();
			КонецПопытки;
			СообщитьПользователюПанелька(?(РезультатИзбранного.ВИзбранном, "Объект добавлен в избранное.", "Объект удален из избранного."));
			ПодключитьОбработчикОжидания("АсинхронноОбновитьСистемноеИзбранное", 0.1, Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Возвращаем фактическое состояние до завершения переключения или отмены выбора.
&НаКлиенте
Процедура ЛичнаяПанельПриИзмененииПанелька(Элемент)
	ИспользуетсяЛичнаяПанельПанелька = Не ИспользуетсяЛичнаяПанельПанелька;
	ПереключитьАктивнуюПанельПанелька();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Переключает избранное общей командой с неизменной привязкой кнопки.
// Параметры:
//  Команда - КомандаФормы - общая команда контекстного меню.
&НаКлиенте
Процедура КомандаИзменитьИзбранноеПанелька(Команда)
	ИмяЭлемента = ПолучитьИмяЭлементаИзКомандыИзбранного(Команда, "Панелька_ИзменитьИзбранное_");
	Если ПустаяСтрока(ИмяЭлемента) Тогда
		Возврат;
	КонецЕсли;
	ЭлементСсылки = Элементы.Найти(ИмяЭлемента);
	Если ЭлементСсылки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ссылка = НайтиСсылкуОбъектаПоИмени(ИмяЭлемента);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Результат = ПереключитьИзбранноеПанелькаНаСервере(Ссылка, Строка(ЭлементСсылки.Заголовок));
	Если Результат.Успех Тогда
		ОбновитьКнопкиИзбранногоПанелька(Ссылка, Результат.ВИзбранном);
		СообщитьПользователюПанелька(?(Результат.ВИзбранном, "Объект добавлен в избранное.", "Объект удален из избранного."));
		ПодключитьОбработчикОжидания("АсинхронноОбновитьСистемноеИзбранное", 0.1, Истина);
	Иначе
		СообщитьПользователюПанелька(Результат.Ошибка);
	КонецЕсли;
КонецПроцедуры

// Открывает текущий элемент панели в новом окне.
// Параметры:
//  Команда - КомандаФормы - команда формы.
&НаКлиенте
Асинх Процедура КомандаОткрытьВНовомОкне(Команда)
	ТекЭлемент = ТекущийЭлемент;
	Если ТекЭлемент = Неопределено Или ТипЗнч(ТекЭлемент) <> Тип("ДекорацияФормы") Тогда
		Возврат;
	КонецЕсли;
	ЗапуститьЭлементПоИмени(ТекЭлемент.Имя, Истина);
КонецПроцедуры

// Открывает карточку справочного объекта для текущего элемента.
// Параметры:
//  Команда - КомандаФормы - команда формы.
&НаКлиенте
Процедура КомандаОткрытьКарточкуСправочника(Команда)
	ТекЭлемент = ТекущийЭлемент;
	Если ТекЭлемент = Неопределено Или ТипЗнч(ТекЭлемент) <> Тип("ДекорацияФормы") Тогда
		Возврат;
	КонецЕсли;
	СсылкаНаОбъект = НайтиСсылкуОбъектаПоИмени(ТекЭлемент.Имя);
	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	ОткрытьКарточкуПоСсылкеПанелька(СсылкаНаОбъект);
КонецПроцедуры

// Копирует название текущего элемента панели.
// Параметры:
//  Команда - КомандаФормы - команда формы.
