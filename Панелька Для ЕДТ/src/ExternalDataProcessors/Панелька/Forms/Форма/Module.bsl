// Собирает меню в исходном порядке: открытие, копирование, избранное.
&НаСервере
Процедура СоздатьКонтекстноеМенюСсылкиПанелька(НовыйЭлемент, Стр, ОписаниеСсылки, КонтекстМеню)
	ДобавитьОткрытиеВНовомОкнеПанелька(НовыйЭлемент, ОписаниеСсылки, КонтекстМеню);
	Если ОписаниеСсылки.ЭтоВебСсылка Тогда
		ДобавитьМенюВебСсылкиПанелька(НовыйЭлемент, Стр, КонтекстМеню);
	ИначеЕсли ОписаниеСсылки.ЭтоВнешнийФайл Тогда
		ДобавитьМенюВнешнегоФайлаПанелька(НовыйЭлемент, Стр, КонтекстМеню);
	ИначеЕсли ОписаниеСсылки.ЭтоДопОбработка Тогда
		ДобавитьМенюДопОбработкиПанелька(НовыйЭлемент, Стр, ОписаниеСсылки, КонтекстМеню);
	ИначеЕсли Не ОписаниеСсылки.ЭтоСистемнаяКоманда Тогда
		ДобавитьМенюСсылки1СПанелька(НовыйЭлемент, Стр, ОписаниеСсылки, КонтекстМеню);
	КонецЕсли;
КонецПроцедуры


// Показывает установленный статус недоступности и безопасное пояснение.
&НаСервере
Процедура ОформитьНедоступнуюСсылкуПанелька(НовыйЭлемент, Стр, ОписаниеСсылки, Контекст)
	КорректнаяСсылка = ОписаниеСсылки.КорректнаяСсылка;
	СтатусСсылки = ОписаниеСсылки.СтатусСсылки;
	ТекстСсылки = ОписаниеСсылки.ТекстСсылки;
	РежимПодсказок = Контекст.РежимПодсказок;
	ПользовательАдминистратор = Контекст.ПользовательАдминистратор;
	Если КорректнаяСсылка И СтатусСсылки = "НетПрав" Тогда
		НовыйЭлемент.Гиперссылка = Ложь;
		НовыйЭлемент.ЦветТекста = WebЦвета.Красный;
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '[НЕТ ПРАВ] %1'"), ТекстСсылки);
		НовыйЭлемент.Подсказка = ПодсказкаСостоянияСсылкиПанелька("У вас недостаточно прав", Стр.Ссылка,
			Стр.Источник, ПользовательАдминистратор);
		Если РежимПодсказок = ОтображениеПодсказки.Нет Тогда
			НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		КонецЕсли;
	ИначеЕсли КорректнаяСсылка И СтатусСсылки = "Удален" Тогда
		НовыйЭлемент.Гиперссылка = Ложь;
		НовыйЭлемент.ЦветТекста = WebЦвета.Красный;
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '[УДАЛЕНО] %1'"), ТекстСсылки);
		НовыйЭлемент.Подсказка = ПодсказкаСостоянияСсылкиПанелька("Объект помечен на удаление", Стр.Ссылка,
			Стр.Источник, ПользовательАдминистратор);
		Если РежимПодсказок = ОтображениеПодсказки.Нет Тогда
			НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		КонецЕсли;
	ИначеЕсли КорректнаяСсылка И (СтатусСсылки = "Недоступен" Или СтатусСсылки = "Ошибка") Тогда
		НовыйЭлемент.Гиперссылка = Ложь;
		НовыйЭлемент.ЦветТекста = WebЦвета.Красный;
		НовыйЭлемент.Заголовок = СтрШаблон(?(СтатусСсылки = "Недоступен",
			НСтр("ru = '[НЕДОСТУПЕН] %1'"), НСтр("ru = '[ОШИБКА ПРОВЕРКИ] %1'")), ТекстСсылки);
		НовыйЭлемент.Подсказка = ?(СтатусСсылки = "Недоступен",
			НСтр("ru = 'Объект недоступен или отсутствует. Обновите Панелька либо обратитесь к администратору.'"),
			НСтр("ru = 'Не удалось проверить доступность объекта. Обновите Панелька либо обратитесь к администратору.'"));
		Если РежимПодсказок = ОтображениеПодсказки.Нет Тогда
			НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		КонецЕсли;
	ИначеЕсли КорректнаяСсылка И СтатусСсылки = "НеНайден" Тогда
		НовыйЭлемент.Гиперссылка = Ложь;
		НовыйЭлемент.ЦветТекста = WebЦвета.Красный;
		НовыйЭлемент.Заголовок = СтрШаблон(НСтр("ru = '[НЕ НАЙДЕНО] %1'"), ТекстСсылки);
		НовыйЭлемент.Подсказка = ПодсказкаСостоянияСсылкиПанелька("Объект не найден", Стр.Ссылка, Стр.Источник,
			ПользовательАдминистратор);
		Если РежимПодсказок = ОтображениеПодсказки.Нет Тогда
			НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		КонецЕсли;
	Иначе
		НовыйЭлемент.Гиперссылка = Ложь;
		НовыйЭлемент.ЦветТекста = WebЦвета.Красный;
		НовыйЭлемент.Заголовок = ТекстСсылки;
		НовыйЭлемент.Подсказка = ПодсказкаСостоянияСсылкиПанелька("Ссылка некорректна", Стр.Ссылка, Стр.Источник,
			ПользовательАдминистратор);
		НовыйЭлемент.ОтображениеПодсказки = ?(РежимПодсказок = ОтображениеПодсказки.Нет,
			ОтображениеПодсказки.ОтображатьСнизу, РежимПодсказок);
	КонецЕсли;
КонецПроцедуры


// Удаляет ранее созданные динамические группы и элементы панели.
&НаСервере
Процедура ОчиститьДинамическиеГруппыОбъектов()
	МассивУдаления = Новый Массив;
	ГруппаСтраницы = Элементы.Найти("Вкладки");
	Если ГруппаСтраницы <> Неопределено Тогда
		// Тотальная зачистка подчиненных элементов
		Для Каждого Подчиненный Из ГруппаСтраницы.ПодчиненныеЭлементы Цикл
			МассивУдаления.Добавить(Подчиненный);
		КонецЦикла;
	КонецЕсли;
	Заглушка = Элементы.Найти("ГруппаЗаглушкаПустыхНастроек");
	Если Заглушка <> Неопределено Тогда
		МассивУдаления.Добавить(Заглушка);
	КонецЕсли;
	Для Каждого Элемент Из МассивУдаления Цикл
		Элементы.Удалить(Элемент);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область КонтекстноеМеню

// Копирует данные текущего элемента по явно заданному виду копирования.
// Параметры:
//  ДействиеКопирования - Строка - copy_name, copy_tip, copy_internal, copy_ext_url, copy_file или copy_dir.
&НаКлиенте
Процедура СкопироватьДанныеЭлементаПанелька(ДействиеКопирования)
	ТекЭлемент = ТекущийЭлемент;
	Если ТекЭлемент = Неопределено Или ТипЗнч(ТекЭлемент) <> Тип("ДекорацияФормы") Тогда
		Возврат;
	КонецЕсли;
	ТекстДляБуфера = "";
	Если ДействиеКопирования = "copy_name" Тогда
		ТекстДляБуфера = ТекЭлемент.Заголовок;
	ИначеЕсли ДействиеКопирования = "copy_tip" Тогда
		ТекстДляБуфера = ТекЭлемент.Подсказка;
	Иначе
		СсылкаНаОбъект = НайтиСсылкуОбъектаПоИмени(ТекЭлемент.Имя);
		Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
			Возврат;
		КонецЕсли;
		ТекстДляБуфера = ПолучитьТекстСсылкиДляКопированияПанелька(СсылкаНаОбъект, ДействиеКопирования);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстДляБуфера) Тогда
		СкопироватьТекстВБуферНадежно(ТекстДляБуфера);
	КонецЕсли;
КонецПроцедуры

// Удаляет ранее созданные программные команды избранного перед очередной перестройкой панели.
&НаСервере
Процедура УдалитьДинамическиеКомандыИзбранного()
	ПрефиксыКоманд = Новый Массив;
	ПрефиксыКоманд.Добавить("Панелька_ДобавитьВИзбранное_");
	ПрефиксыКоманд.Добавить("Панелька_УдалитьИзИзбранного_");
	ПрефиксыКоманд.Добавить("Панелька_ИзменитьИзбранное_");
	КомандыКУдалению = Новый Массив;
	Для Каждого Команда Из Команды Цикл
		Для Каждого Префикс Из ПрефиксыКоманд Цикл
			Если Лев(Команда.Имя, СтрДлина(Префикс)) = Префикс Тогда
				КомандыКУдалению.Добавить(Команда);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Команда Из КомандыКУдалению Цикл
		Команды.Удалить(Команда);
	КонецЦикла;
КонецПроцедуры

// Создает кнопку избранного, использующую общие команды формы.
//
// Параметры:
//  ИмяЭлемента - Строка - имя элемента панели, к которому относится контекстное меню.
//  Ссылка - Строка - навигационная ссылка объекта.
//  ЗаголовокДобавления - Строка - текст команды добавления.
//  ЗаголовокУдаления - Строка - текст команды удаления.
//  ЭтоВИзбранном - Булево - признак наличия ссылки в системном избранном.
//  КонтекстноеМеню - ГруппаФормы - контекстное меню элемента панели.
//  Диаг - Структура - накопленные замеры создания меню.
//  КэшКартинокМеню - Соответствие из КлючИЗначение - картинки текущего построения:
//   * Ключ - Строка - имя картинки библиотеки.
//   * Значение - Картинка - ранее полученная картинка.
&НаСервере
Процедура ДобавитьКомандыИзбранногоДляЭлемента(Знач ИмяЭлемента, Знач Ссылка, Знач ЗаголовокДобавления,
	Знач ЗаголовокУдаления, Знач ЭтоВИзбранном, Знач КонтекстноеМеню, Диаг, КэшКартинокМеню)
	КнопкаИзбранного = ДобавитьЭлементМенюПанелька(ИмяЭлемента + "_КмдИзбранное", Тип("КнопкаФормы"), КонтекстноеМеню, Диаг);
	Если ДиагностикаПанелька Тогда
		НачалоСвойстваМеню = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	КонецЕсли;
	КнопкаИзбранного.ИмяКоманды = "КонтекстИзменитьИзбранное";
	Если ДиагностикаПанелька Тогда
		НакопитьЗамерОтрисовкиПанелька(Диаг, "ПривязкаКомандМеню", НачалоСвойстваМеню);
	КонецЕсли;
	Если ДиагностикаПанелька Тогда
		НачалоСвойстваМеню = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	КонецЕсли;
	КнопкаИзбранного.Заголовок = ?(ЭтоВИзбранном, ЗаголовокУдаления, ЗаголовокДобавления);
	Если ДиагностикаПанелька Тогда
		НакопитьЗамерОтрисовкиПанелька(Диаг, "ЗаголовкиМеню", НачалоСвойстваМеню);
	КонецЕсли;
	Если ДиагностикаПанелька Тогда
		НачалоСвойстваМеню = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	КонецЕсли;
	КартинкаМеню = ПолучитьКартинкуМенюПанелька(?(ЭтоВИзбранном, "Удалить", "Избранное"), КэшКартинокМеню, Диаг,
		ДиагностикаПанелька);
	Если ДиагностикаПанелька Тогда
		НачалоПрисваиванияКартинки = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	КонецЕсли;
	КнопкаИзбранного.Картинка = КартинкаМеню;
	Если ДиагностикаПанелька Тогда
		НакопитьЗамерОтрисовкиПанелька(Диаг, "ПрисваиваниеКартинокМеню", НачалоПрисваиванияКартинки);
	КонецЕсли;
	Если ДиагностикаПанелька Тогда
		Диаг.ЧислоПрисваиванийКартинокМеню = Диаг.ЧислоПрисваиванийКартинокМеню + 1;
	КонецЕсли;
	Если ДиагностикаПанелька Тогда
		НакопитьЗамерОтрисовкиПанелька(Диаг, "КартинкиМеню", НачалоСвойстваМеню);
	КонецЕсли;
КонецПроцедуры

// Определяет элемент вызова общей команды избранного или прежней динамической команды.
// Параметры:
//  Команда - КомандаФормы - выполненная команда.
//  Префикс - Строка - префикс имени команды.
// Возвращаемое значение:
//  Строка - имя элемента панели или пустая строка.
&НаКлиенте
Функция ПолучитьИмяЭлементаИзКомандыИзбранного(Команда, Знач Префикс)
	Если Команда = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Команда) <> Тип("КомандаФормы") Тогда
		Возврат "";
	КонецЕсли;
	Если Команда.Имя = "КонтекстИзменитьИзбранное" Тогда
		ЭлементВызова = ТекущийЭлемент;
		Если ЭлементВызова = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Если ТипЗнч(ЭлементВызова) = Тип("ДекорацияФормы") Тогда
			ИмяЭлемента = ЭлементВызова.Имя;
		ИначеЕсли ТипЗнч(ЭлементВызова) = Тип("КнопкаФормы") Тогда
			Суффикс = "_КмдИзбранное";
			Если Прав(ЭлементВызова.Имя, СтрДлина(Суффикс)) <> Суффикс Тогда
				Возврат "";
			КонецЕсли;
			ИмяЭлемента = Лев(ЭлементВызова.Имя, СтрДлина(ЭлементВызова.Имя) - СтрДлина(Суффикс));
		Иначе
			Возврат "";
		КонецЕсли;
		Кнопка = Элементы.Найти(ИмяЭлемента + "_КмдИзбранное");
		Если Кнопка = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Если Кнопка.ИмяКоманды <> Команда.Имя Или Не Кнопка.Доступность Тогда
			Возврат "";
		КонецЕсли;
		Возврат ИмяЭлемента;
	КонецЕсли;
	ОбщийПрефикс = "Панелька_ИзменитьИзбранное_";
	Если Лев(Команда.Имя, СтрДлина(ОбщийПрефикс)) = ОбщийПрефикс Тогда
		Возврат Сред(Команда.Имя, СтрДлина(ОбщийПрефикс) + 1);
	КонецЕсли;
	Если Лев(Команда.Имя, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Команда.Имя, СтрДлина(Префикс) + 1);
КонецФункции

// Создаёт элемент меню и отдельно измеряет добавление в коллекцию формы.
// Параметры:
//  Имя - Строка - уникальное имя элемента.
//  ТипЭлемента - Тип - тип элемента формы.
//  Родитель - ГруппаФормы - меню или подменю.
//  Диаг - Структура - накопленные замеры текущей отрисовки.
// Возвращаемое значение:
//  КнопкаФормы, ГруппаФормы - созданный элемент меню.
&НаСервере
Функция ДобавитьЭлементМенюПанелька(Знач Имя, Знач ТипЭлемента, Родитель, Диаг)
	Если Не ДиагностикаПанелька Тогда
		Возврат Элементы.Добавить(Имя, ТипЭлемента, Родитель);
	КонецЕсли;
	Начало = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	НовыйЭлемент = Элементы.Добавить(Имя, ТипЭлемента, Родитель);
	НакопитьЗамерОтрисовкиПанелька(Диаг, "ДобавлениеЭлементовМеню", Начало);
	Возврат НовыйЭлемент;
КонецФункции

// Возвращает картинку меню, обращаясь к библиотеке один раз на ключ за построение.
//
// Параметры:
//  ИмяКартинки - Строка - имя стандартной картинки, использованное прежним кодом.
//  Кэш - Соответствие из КлючИЗначение - картинки текущего построения:
//   * Ключ - Строка - имя картинки библиотеки.
//   * Значение - Картинка - ранее полученная картинка.
//  Диаг - Структура - накопленные замеры отрисовки.
//  Измерять - Булево - включена ли диагностика.
//
// Возвращаемое значение:
//  Картинка - картинка контекстного меню.
&НаСервереБезКонтекста
Функция ПолучитьКартинкуМенюПанелька(Знач ИмяКартинки, Кэш, Диаг, Знач Измерять)
	КартинкаМеню = Кэш[ИмяКартинки];
	Если КартинкаМеню = Неопределено Тогда
		НачалоПолучения = ЧасыДиагностикиПанелька(Измерять);
		КартинкаМеню = БиблиотекаКартинок[ИмяКартинки];
		НакопитьЗамерОтрисовкиПанелька(Диаг, "ПолучениеКартинокМеню", НачалоПолучения);
		Кэш.Вставить(ИмяКартинки, КартинкаМеню);
		Если Измерять Тогда
			Диаг.ЧислоЗагруженныхКартинокМеню = Диаг.ЧислоЗагруженныхКартинокМеню + 1;
		КонецЕсли;
	КонецЕсли;
	Возврат КартинкаМеню;
КонецФункции

#КонецОбласти

#Область Избранное

// Меняет только отличающиеся подписи и картинки избранного, сохраняя меню и команды.
//
// Параметры:
//  СсылкиИзбранного - Соответствие из КлючИЗначение - актуальное системное избранное:
//   * Ключ - Строка - адрес в нижнем регистре без крайних пробелов.
//   * Значение - Булево - Истина для избранной ссылки.
//
// Возвращаемое значение:
//  Число - количество измененных кнопок.
&НаСервере
Функция ОбновитьИзбранноеОбычнойПанелиПанелька(СсылкиИзбранного)
	Количество = 0;
	КэшКартинок = Новый Соответствие;
	Для Каждого Стр Из ТаблицаСоответствияОбъектов Цикл
		Кнопка = Элементы.Найти(Стр.ИмяЭлемента + "_КмдИзбранное");
		Если Кнопка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЭтоВИзбранном = СсылкиИзбранного[НРег(СокрЛП(Стр.Ссылка))] <> Неопределено;
		Если ЭтоВИзбранном Тогда
			Заголовок = ЗаголовокИзбранногоПанелька(Стр.Ссылка, Истина);
			ИмяКартинки = "Удалить";
		Иначе
			Заголовок = ЗаголовокИзбранногоПанелька(Стр.Ссылка, Ложь);
			ИмяКартинки = "Избранное";
		КонецЕсли;
		Если Кнопка.Заголовок = Заголовок Тогда
			Продолжить;
		КонецЕсли;
		Картинка = КэшКартинок[ИмяКартинки];
		Если Картинка = Неопределено Тогда
			Картинка = БиблиотекаКартинок[ИмяКартинки];
			КэшКартинок.Вставить(ИмяКартинки, Картинка);
		КонецЕсли;
		Кнопка.Заголовок = Заголовок;
		Кнопка.Картинка = Картинка;
		Количество = Количество + 1;
	КонецЦикла;
	Возврат Количество;
КонецФункции

// Загружает системное избранное пользователя для определения состояния пунктов контекстного меню.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - системное избранное:
//  * Ключ - Строка - адрес в нижнем регистре без крайних пробелов.
//  * Значение - Булево - Истина для избранной ссылки.
&НаСервереБезКонтекста
Функция ПолучитьСсылкиСистемногоИзбранного()
	// Считываем текущее системное избранное для определения доступности
	// пунктов контекстного меню. Визуальный индикатор избранного на панели
	// специально не выводится.
	СсылкиИзбранного = Новый Соответствие;
	Попытка
		ИзбранноеПользователя = ХранилищеСистемныхНастроек.Загрузить("Общее/ИзбранноеРаботыПользователя");
		Если ТипЗнч(ИзбранноеПользователя) = Тип("ИзбранноеРаботыПользователя") Тогда
			Для Каждого Эл Из ИзбранноеПользователя Цикл
				Если ТипЗнч(Эл.НавигационнаяСсылка) = Тип("Строка") И Не ПустаяСтрока(Эл.НавигационнаяСсылка) Тогда
					СсылкиИзбранного.Вставить(НРег(СокрЛП(Эл.НавигационнаяСсылка)), Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(
			"Панелька.ЗагрузкаИзбранного",
			УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки()
			);
	КонецПопытки;
	Возврат СсылкиИзбранного;
КонецФункции

// Переключает избранное по актуальному состоянию хранилища.
// Параметры:
//  Ссылка - Строка - навигационная ссылка.
//  Представление - Строка - подпись при добавлении.
// Возвращаемое значение:
//  Структура - результат УстановитьИзбранноеПанелька: Успех, ВИзбранном, Ошибка.
&НаСервереБезКонтекста
Функция ПереключитьИзбранноеПанелькаНаСервере(Знач Ссылка, Знач Представление)
	Попытка
		Избранное = ХранилищеСистемныхНастроек.Загрузить("Общее/ИзбранноеРаботыПользователя");
		ТребуемоеСостояние = ИндексСсылкиВИзбранномПанелька(Избранное, Ссылка) < 0;
		Возврат УстановитьИзбранноеПанелька(Ссылка, Представление, ТребуемоеСостояние);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗаписатьОшибкуПанелька("ЧтениеИзбранного", Ошибка);
		Возврат Новый Структура("Успех,ВИзбранном,Ошибка", Ложь, Ложь,
			"Не удалось прочитать избранное: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка));
	КонецПопытки;
КонецФункции

// Устанавливает требуемое состояние избранного для обоих интерфейсов.
// Повторная установка уже достигнутого состояния считается успешной.
// Параметры:
//  Ссылка - Строка - навигационная ссылка.
//  Представление - Строка - подпись при добавлении.
//  ТребуемоеСостояние - Булево - Истина для добавления, Ложь для удаления.
// Возвращаемое значение:
//  Структура - Успех (Булево), ВИзбранном (Булево), Ошибка (Строка).
//    ВИзбранном подтверждено перечитыванием только при Успех = Истина.
&НаСервереБезКонтекста
Функция УстановитьИзбранноеПанелька(Знач Ссылка, Знач Представление, Знач ТребуемоеСостояние)
	Результат = Новый Структура("Успех,ВИзбранном,Ошибка", Ложь, Ложь, "");
	Если ТипЗнч(Ссылка) <> Тип("Строка") Или ТипЗнч(ТребуемоеСостояние) <> Тип("Булево") Тогда
		Результат.Ошибка = "Некорректные параметры изменения избранного.";
		Возврат Результат;
	КонецЕсли;
	Ссылка = СокрЛП(Ссылка);
	Если ПустаяСтрока(Ссылка) Тогда
		Результат.Ошибка = "Не задана ссылка для изменения избранного.";
		Возврат Результат;
	КонецЕсли;
	Попытка
		Избранное = ХранилищеСистемныхНастроек.Загрузить("Общее/ИзбранноеРаботыПользователя");
		Если ТипЗнч(Избранное) <> Тип("ИзбранноеРаботыПользователя") Тогда
			Избранное = Новый ИзбранноеРаботыПользователя;
		КонецЕсли;
		ИндексЭлемента = ИндексСсылкиВИзбранномПанелька(Избранное, Ссылка);
		Результат.ВИзбранном = ИндексЭлемента >= 0;
		Если Результат.ВИзбранном <> ТребуемоеСостояние Тогда
			Если ТребуемоеСостояние Тогда
				НовыйЭлемент = Новый ЭлементИзбранногоРаботыПользователя;
				НовыйЭлемент.НавигационнаяСсылка = Ссылка;
				НовыйЭлемент.Представление = ?(ПустаяСтрока(Представление), Ссылка, Представление);
				Избранное.Вставить(0, НовыйЭлемент);
			Иначе
				// Удаляем также возможные дубли, оставшиеся от прежних версий.
				Пока ИндексЭлемента >= 0 Цикл
					Избранное.Удалить(ИндексЭлемента);
					ИндексЭлемента = ИндексСсылкиВИзбранномПанелька(Избранное, Ссылка);
				КонецЦикла;
			КонецЕсли;
			ХранилищеСистемныхНастроек.Сохранить("Общее/ИзбранноеРаботыПользователя", "", Избранное);
		КонецЕсли;
		ПроверенноеИзбранное = ХранилищеСистемныхНастроек.Загрузить("Общее/ИзбранноеРаботыПользователя");
		Результат.ВИзбранном = ИндексСсылкиВИзбранномПанелька(ПроверенноеИзбранное, Ссылка) >= 0;
		Результат.Успех = (Результат.ВИзбранном = ТребуемоеСостояние);
		Если Не Результат.Успех Тогда
			Результат.Ошибка = "Изменение избранного не подтверждено. Проверьте право сохранения данных пользователя.";
		КонецЕсли;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗаписатьОшибкуПанелька("ИзменениеИзбранного", Ошибка);
		Результат.Ошибка = "Не удалось изменить избранное: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка);
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Ищет ссылку по тем же правилам сравнения, что используются при построении панели.
// Параметры:
//  Избранное - ИзбранноеРаботыПользователя, Неопределено - содержимое хранилища.
//  Ссылка - Строка - искомая навигационная ссылка.
// Возвращаемое значение:
//  Число - индекс первого совпадения или -1.
&НаСервереБезКонтекста
Функция ИндексСсылкиВИзбранномПанелька(Избранное, Знач Ссылка)
	Если ТипЗнч(Избранное) <> Тип("ИзбранноеРаботыПользователя") Тогда
		Возврат -1;
	КонецЕсли;
	НормализованнаяСсылка = НРег(СокрЛП(Ссылка));
	Индекс = 0;
	Для Каждого ЭлементИзбранного Из Избранное Цикл
		Если НРег(СокрЛП(ЭлементИзбранного.НавигационнаяСсылка)) = НормализованнаяСсылка Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат -1;
КонецФункции

// Возвращает подпись кнопки из данных ссылки и состояния, независимо от прежнего текста.
// Параметры:
//  Ссылка - Строка - навигационная ссылка.
//  ЭтоВИзбранном - Булево - текущее состояние.
// Возвращаемое значение:
//  Строка - заголовок действия с избранным.
&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокИзбранногоПанелька(Знач Ссылка, Знач ЭтоВИзбранном)
	ЭтоДопОбработка = СтрНайти(Ссылка, "e1cib/data/Справочник.ДополнительныеОтчетыИОбработки") = 1
		Или СтрНайти(Ссылка, "e1cib/data/Справочник.ВнешниеОбработки") = 1;
	Если ЭтоВИзбранном Тогда
		Возврат ?(ЭтоДопОбработка, "Удалить объект из избранного", "Удалить из избранного");
	КонецЕсли;
	Возврат ?(ЭтоДопОбработка, "Добавить объект в избранное", "Добавить в избранное");
КонецФункции

// Синхронизирует кнопку избранного во всех размещениях изменённой ссылки.
// Параметры:
//  Ссылка - Строка - навигационная ссылка после успешной записи.
//  ЭтоВИзбранном - Булево - новое состояние системного избранного.
&НаКлиенте
Процедура ОбновитьКнопкиИзбранногоПанелька(Знач Ссылка, Знач ЭтоВИзбранном)
	НормализованнаяСсылка = НРег(СокрЛП(Ссылка));
	Для Каждого СтрокаОбъекта Из ТаблицаСоответствияОбъектов Цикл
		Если НРег(СокрЛП(СтрокаОбъекта.Ссылка)) <> НормализованнаяСсылка Тогда
			Продолжить;
		КонецЕсли;
		Кнопка = Элементы.Найти(СтрокаОбъекта.ИмяЭлемента + "_КмдИзбранное");
		Если Кнопка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Кнопка.Заголовок = ЗаголовокИзбранногоПанелька(СтрокаОбъекта.Ссылка, ЭтоВИзбранном);
		Кнопка.Картинка = ?(ЭтоВИзбранном, БиблиотекаКартинок.Удалить, БиблиотекаКартинок.Избранное);
	КонецЦикла;
КонецПроцедуры

// Обновляет системный интерфейс 1С после изменения избранного; панель не перестраивает.
// Вызывается асинхронно (через обработчик ожидания), чтобы избежать потери контекста формы.
&НаКлиенте
Процедура АсинхронноОбновитьСистемноеИзбранное() Экспорт
	Если ФормаЗакрываетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	// Принудительно обновляем платформенный пользовательский интерфейс.
	// Это необходимо, чтобы обновилась системная звездочка избранного.
	ОбновитьИнтерфейс();
КонецПроцедуры

// Совместимый вход Web-интерфейса для общей операции избранного.
// Параметры:
//  СсылкаСтрока - Строка - навигационная ссылка.
//  Добавить - Булево - требуемое состояние.
//  КрасивоеИмя - Строка - подпись при добавлении.
// Возвращаемое значение:
//  Структура - результат УстановитьИзбранноеПанелька: Успех, ВИзбранном, Ошибка.
&НаСервереБезКонтекста
Функция ИзменитьИзбранноеНаСервереПанелька(Знач СсылкаСтрока, Знач Добавить, Знач КрасивоеИмя)
	Возврат УстановитьИзбранноеПанелька(СсылкаСтрока, КрасивоеИмя, Добавить);
КонецФункции

#КонецОбласти

#Область ПереходыИЗапускОбъектов

// Открывает объект конфигурации, связанный с выбранным элементом панели.
//
// Параметры:
//  Элемент - ДекорацияФормы - элемент, вызвавший событие.
&НаКлиенте
Асинх Процедура ОткрытьОбъектКонфигурации(Элемент)
	ЗапуститьЭлементПоИмени(Элемент.Имя, Ложь);
КонецПроцедуры

// Подготавливает ссылку или файловый путь для копирования одинаково в обоих интерфейсах.
// Параметры:
//  Ссылка - Строка - адрес элемента панели с техническим префиксом источника.
//  ДействиеКопирования - Строка - copy_internal, copy_url, copy_ext_url, copy_file, copy_dir.
//  АдресБазы - Строка - внешний адрес базы; пустой при недоступности его получения.
// Возвращаемое значение:
//  Строка - текст для буфера; пустая строка для неподдерживаемого действия.
&НаКлиентеНаСервереБезКонтекста
Функция ТекстКопированияСсылкиПанелька(Знач Ссылка, Знач ДействиеКопирования, Знач АдресБазы)
	Если ДействиеКопирования = "copy_internal" Тогда
		Возврат Ссылка;
	КонецЕсли;
	Если ДействиеКопирования = "copy_file" Или ДействиеКопирования = "copy_dir" Тогда
		Если Лев(Ссылка, 9) <> "ext_file:" Тогда
			Возврат "";
		КонецЕсли;
		ПутьФайла = Сред(Ссылка, 10);
		Если ДействиеКопирования = "copy_file" Тогда
			Возврат ПутьФайла;
		КонецЕсли;
		ПозицияРазделителя = Макс(СтрНайти(ПутьФайла, "\", НаправлениеПоиска.СКонца),
			СтрНайти(ПутьФайла, "/", НаправлениеПоиска.СКонца));
		Возврат ?(ПозицияРазделителя > 0, Лев(ПутьФайла, ПозицияРазделителя), ПутьФайла);
	КонецЕсли;
	Если ДействиеКопирования <> "copy_url" И ДействиеКопирования <> "copy_ext_url" Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Ссылка, 9) = "web_link:" Или Лев(Ссылка, 9) = "ext_file:" Тогда
		Возврат Сред(Ссылка, 10);
	КонецЕсли;
	// Внешняя ссылка уже содержит адрес базы; повторно добавлять его нельзя.
	Если Лев(НРег(Ссылка), 6) = "e1c://" Или Лев(НРег(Ссылка), 7) = "http://"
		Или Лев(НРег(Ссылка), 8) = "https://" Тогда
		Возврат Ссылка;
	КонецЕсли;
	Если ПустаяСтрока(АдресБазы) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Возврат АдресБазы + "#" + Ссылка;
КонецФункции

// Получает внешний адрес базы только для соответствующего вида копирования.
// Параметры:
//  Ссылка - Строка - адрес элемента панели.
//  ДействиеКопирования - Строка - действие из протокола копирования.
// Возвращаемое значение:
//  Строка - текст, подготовленный ТекстКопированияСсылкиПанелька.
&НаКлиенте
Функция ПолучитьТекстСсылкиДляКопированияПанелька(Знач Ссылка, Знач ДействиеКопирования)
	Если Не РазрешенДоступКАдресуДополнительногоИнструментаПанелька(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	АдресБазыДляКопирования = "";
	Если (ДействиеКопирования = "copy_url" Или ДействиеКопирования = "copy_ext_url")
		И Лев(Ссылка, 6) = "e1cib/" Тогда
		Попытка
			АдресБазыДляКопирования = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
		Исключение
			// Сохраняем возможность скопировать внутреннюю ссылку при недоступности адреса базы.
			ЗаписатьДиагностикуКлиентаПанелька("Получение внешней ссылки", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	Возврат ТекстКопированияСсылкиПанелька(Ссылка, ДействиеКопирования, АдресБазыДляКопирования);
КонецФункции

// Проверяет право именно на карточку/копирование адреса, независимо от режима панели.
// Разрешение источника в персональной панели само по себе не открывает карточку.
&НаСервере
Функция РазрешенДоступКАдресуДополнительногоИнструментаПанелька(Ссылка)
	Обработка = РеквизитФормыВЗначение("Объект");
	Если Обработка.ПанелькаЭтоДополнительнаяСсылка(Ссылка)
		Или Не ПустаяСтрока(Обработка.ПанелькаКлючДополнительнойСсылки(Ссылка)) Тогда
		Возврат ПользовательИмеетПраваАдмина();
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Открывает именно карточку записи, без запуска содержащегося в ней файла.
// Параметры:
//  СсылкаКарточки - Строка - навигационная ссылка на запись справочника.
&НаКлиенте
Процедура ОткрытьКарточкуПоСсылкеПанелька(Знач СсылкаКарточки)
	Если Лев(НРег(СокрЛП(СсылкаКарточки)), 11) <> "e1cib/data/" Тогда
		Возврат;
	КонецЕсли;
	Если Не РазрешенДоступКАдресуДополнительногоИнструментаПанелька(СсылкаКарточки) Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Доступен запуск дополнительного инструмента; его карточку может открывать только администратор.'"));
		Возврат;
	КонецЕсли;
	Если Не РазрешенЗапускЛичнойСсылкиПанелька(СсылкаКарточки) Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Эта ссылка недоступна по текущим правам или настройкам. Обновите Панелька.'"));
		Возврат;
	КонецЕсли;
	Попытка
		ПерейтиПоНавигационнойСсылке(СсылкаКарточки);
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось открыть карточку: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
КонецПроцедуры

// Запускает выбранный элемент формы панели (Для обычного интерфейса).
&НаКлиенте
Асинх Процедура ЗапуститьЭлементПоИмени(ИмяЭлемента, ВНовомОкне)
	МассивСтрок = ТаблицаСоответствияОбъектов.НайтиСтроки(Новый Структура("ИмяЭлемента", ИмяЭлемента));
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	// Передаем найденную ссылку в универсальный обработчик
	ЗапуститьЭлементПрямоПоСсылке(МассивСтрок[0].Ссылка, ВНовомОкне);
КонецПроцедуры

// Универсальный запуск объекта по навигационной ссылке (Единый код для Штатного и Web-интерфейса).
&НаКлиенте
Асинх Процедура ЗапуститьЭлементПрямоПоСсылке(Знач СсылкаНаОбъект, Знач ВНовомОкне)
	Если ПустаяСтрока(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	СсылкаНаОбъект = СокрЛП(СсылкаНаОбъект);
	Если Не РазрешенЗапускЛичнойСсылкиПанелька(СсылкаНаОбъект) Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Эта ссылка недоступна по текущим правам или настройкам. Обновите Панелька.'"));
		Возврат;
	КонецЕсли;
	// 1. Системные команды v8res://
	Если Лев(СсылкаНаОбъект, 8) = "sys_cmd:" Тогда
		ИмяКоманды = Сред(СсылкаНаОбъект, 9);
		ОткрытьСистемнуюКомандуНаКлиенте(ИмяКоманды, ВНовомОкне);
		Возврат;
	КонецЕсли;
	// 2. Дополнительные обработки (БСП и WMS)
	СсылкаДополнительногоИнструмента = НормализоватьСсылкуДополнительногоИнструментаПанелька(СсылкаНаОбъект);
	Если Не ПустаяСтрока(СсылкаДополнительногоИнструмента) Тогда
		ЗапуститьДопОбработкуНапрямую(СсылкаДополнительногоИнструмента, ВНовомОкне, СсылкаНаОбъект);
		Возврат;
	КонецЕсли;
	// 3. Файлы подключаются только как внешние инструменты 1С.
	Если Лев(СсылкаНаОбъект, 9) = "ext_file:" Тогда
		Путь = СокрЛП(Сред(СсылкаНаОбъект, 10));
		Расширение = НРег(Прав(Путь, 4));
		Если Расширение <> ".epf" И Расширение <> ".erf" Тогда
			СообщитьПользователюПанелька(НСтр("ru = 'Поддерживаются только внешние обработки EPF и отчёты ERF.'"));
			Возврат;
		КонецЕсли;
		ЗапуститьЛокальнуюВнешнююОбработку(Путь, ВНовомОкне);
		Возврат;
	КонецЕсли;
	// 4. Веб-ссылки
	Если Лев(СсылкаНаОбъект, 9) = "web_link:" Тогда
		ЧистыйURL = СокрЛП(Сред(СсылкаНаОбъект, 10));
		НижнийURL = НРег(ЧистыйURL);
		Если Лев(НижнийURL, 7) <> "http://" И Лев(НижнийURL, 8) <> "https://"
			И Лев(НижнийURL, 6) <> "ftp://" И Лев(НижнийURL, 7) <> "mailto:" Тогда
			СообщитьПользователюПанелька(НСтр("ru = 'Недопустимый адрес веб-ссылки.'"));
			Возврат;
		КонецЕсли;
		Попытка
			ПерейтиПоНавигационнойСсылке(ЧистыйURL);
		Исключение
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось открыть веб-ссылку: %1'"), ОписаниеОшибки()));
		КонецПопытки;
		Возврат;
	КонецЕсли;
	Если Лев(НРег(СсылкаНаОбъект), 6) <> "e1cib/" Тогда
		СообщитьПользователюПанелька(НСтр("ru = 'Недопустимый адрес ссылки.'"));
		Возврат;
	КонецЕсли;
	// 5. ПЕРЕХВАТ КОНСТАНТ (Открываем красивое окно формы константы)
	Если СтрНайти(СсылкаНаОбъект, "e1cib/data/Константа.") > 0 Тогда
		ИмяКонстанты = Сред(СсылкаНаОбъект, 22);
		ПозВопроса = СтрНайти(ИмяКонстанты, "?");
		Если ПозВопроса > 0 Тогда
			ИмяКонстанты = Лев(ИмяКонстанты, ПозВопроса - 1);
		КонецЕсли;
		УспешноОткрыто = Ложь;
		МассивИменФорм = Новый Массив;
		МассивИменФорм.Добавить("ФормаКонстант");
		МассивИменФорм.Добавить("ФормаЗначения");
		МассивИменФорм.Добавить("Форма");
		Для Каждого ИмяФормыКонстанты Из МассивИменФорм Цикл
			Попытка
				ОткрытьФорму("Константа." + ИмяКонстанты + "." + ИмяФормыКонстанты, , ЭтотОбъект, ИмяКонстанты, , , ,
					РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				УспешноОткрыто = Истина;
				Прервать;
			Исключение
				// Имена форм констант зависят от конфигурации; после перебора используем навигационную ссылку.
			КонецПопытки;
		КонецЦикла;
		Если УспешноОткрыто Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	// 6. Стандартные ссылки 1С (Для всего остального)
	Если ВНовомОкне Тогда
		ОткрытьСтандартнуюСсылкуВНовомОкне(СсылкаНаОбъект);
	Иначе
		Попытка
			ПерейтиПоНавигационнойСсылке(СсылкаНаОбъект);
		Исключение
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось открыть объект: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Запускает локальную внешнюю обработку или отчет с учетом режима нового окна.
// Параметры:
//  ПутьКФайлу - Строка - путь к локальному файлу.
//  ВНовомОкне - Булево - признак открытия в отдельном окне.
&НаКлиенте
Асинх Процедура ЗапуститьЛокальнуюВнешнююОбработку(ПутьКФайлу, Знач ВНовомОкне = Ложь)
	АдресРазрешения = АдресКонтекстаЗапускаПанелька;
	ОчиститьСообщения();
	Попытка
		ФайлОбъект = Новый Файл(ПутьКФайлу);
		Если Не Ждать ФайлОбъект.СуществуетАсинх() Тогда
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Файл не найден: %1'"), ПутьКФайлу));
			Возврат;
		КонецЕсли;
		ДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);
		АдресВХ = ПоместитьВоВременноеХранилище(ДанныеФайла);
		Рез = ПодключитьЛокальныйФайлНаСервере(АдресВХ, ФайлОбъект.Расширение, ПутьКФайлу, АдресРазрешения);
		Если Рез.Успех Тогда
			КлючУникальности = ?(ВНовомОкне, Строка(Новый УникальныйИдентификатор), Неопределено);
			Если Рез.ЭтоОтчет Тогда
				ОткрытьФорму("ВнешнийОтчет." + Рез.ИмяОбъекта + ".Форма", , , КлючУникальности);
			Иначе
				ОткрытьФорму("ВнешняяОбработка." + Рез.ИмяОбъекта + ".Форма", , , КлючУникальности);
			КонецЕсли;
		Иначе
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Ошибка подключения: %1'"), Рез.Ошибка));
		КонецЕсли;
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Ошибка файла 1С: %1'"), ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Открывает стандартную навигационную ссылку панели в новом окне.
// Параметры:
//  СсылкаТекст - Строка - текст навигационной ссылки.
&НаКлиенте
Процедура ОткрытьСтандартнуюСсылкуВНовомОкне(Знач СсылкаТекст)
	Успех = Ложь;
	ПутьКФорме = "";
	Попытка
		Если СтрНайти(СсылкаТекст, "e1cib/list/") > 0 Тогда
			Остаток = Сред(СсылкаТекст, 12);
			ПозицияВопроса = СтрНайти(Остаток, "?");
			Если ПозицияВопроса > 0 Тогда
				Остаток = Лев(Остаток, ПозицияВопроса - 1);
			КонецЕсли;
			ПутьКФорме = Остаток + ".ФормаСписка";
		ИначеЕсли СтрНайти(СсылкаТекст, "e1cib/app/") > 0 Тогда
			Остаток = Сред(СсылкаТекст, 11);
			ПозицияВопроса = СтрНайти(Остаток, "?");
			Если ПозицияВопроса > 0 Тогда
				Остаток = Лев(Остаток, ПозицияВопроса - 1);
			КонецЕсли;
			ПутьКФорме = Остаток + ".Форма";
		КонецЕсли;
		Если ЗначениеЗаполнено(ПутьКФорме) Тогда
			ОткрытьФорму(ПутьКФорме, , , Строка(Новый УникальныйИдентификатор));
			Успех = Истина;
		КонецЕсли;
	Исключение
		// Если отдельная форма недоступна, ниже выполняется обычный переход по ссылке.
	КонецПопытки;
	Если Не Успех Тогда
		Попытка
			ПерейтиПоНавигационнойСсылке(СсылкаТекст);
		Исключение
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось открыть объект: %1'"),
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Выполняет стандартную системную команду приложения.
// Параметры:
//  ИмяКоманды - Произвольный - параметр процедуры или функции.
//  ВНовомОкне - Булево - признак открытия в отдельном окне.
&НаКлиенте
Процедура ОткрытьСистемнуюКомандуНаКлиенте(ИмяКоманды, Знач ВНовомОкне)
	Попытка
		Если Лев(ИмяКоманды, 8) = "v8res://" Тогда
			ИмяПодключения = ПодключитьСтандартнуюОбработкуНаСервере(ИмяКоманды);
			Если Не ПустаяСтрока(ИмяПодключения) Тогда
				КлючОкна = ?(ВНовомОкне, Строка(Новый УникальныйИдентификатор), ИмяКоманды);
				ОткрытьФорму("ВнешняяОбработка." + ИмяПодключения + ".Форма", , , КлючОкна);
			Иначе
				СообщитьПользователюПанелька(НСтр("ru = 'Не удалось извлечь системную обработку.'"));
			КонецЕсли;
		КонецЕсли;
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Ошибка: %1'"), ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Подключает и открывает дополнительный отчет или обработку по навигационной ссылке.
//
// Параметры:
//  НавигационнаяСсылка - Строка - навигационная ссылка дополнительной обработки.
//  ВНовомОкне - Булево - признак открытия в отдельном окне.
//  ИсходныйАдрес - Строка - исходная сохраненная ссылка для повторной проверки личной политики; пустая строка при отсутствии отдельного адреса.
&НаКлиенте
Процедура ЗапуститьДопОбработкуНапрямую(НавигационнаяСсылка, Знач ВНовомОкне = Ложь, ИсходныйАдрес = "")
	ОчиститьСообщения();
	Попытка
		Рез = ПодключитьДопОбработкуНаСервере(НавигационнаяСсылка, ИсходныйАдрес);
		Если Рез.Успех Тогда
			КлючУникальности = ?(ВНовомОкне, Строка(Новый УникальныйИдентификатор), НавигационнаяСсылка);
			ТипБлока = ?(Рез.ЭтоОтчет, "ВнешнийОтчет.", "ВнешняяОбработка.");
			ПутьКФорме = "";
			Если Не ПустаяСтрока(Рез.ПутьКФорме) Тогда
				Если СтрНайти(Рез.ПутьКФорме, ".") > 0 Тогда
					ПутьКФорме = Рез.ПутьКФорме;
				Иначе
					ПутьКФорме = ТипБлока + Рез.ИмяОбъекта + ".Форма." + Рез.ПутьКФорме;
				КонецЕсли;
			Иначе
				ПутьКФорме = ТипБлока + Рез.ИмяОбъекта + ".Форма";
			КонецЕсли;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Уникальность", НавигационнаяСсылка);
			Попытка
				ОткрытьФорму(ПутьКФорме, ПараметрыФормы, ЭтотОбъект, КлючУникальности);
			Исключение
				Если Не ПустаяСтрока(Рез.ПутьКФорме) И СтрНайти(ОписаниеОшибки(), "Неизвестное имя формы") > 0 Тогда
					ПутьКФормеРезерв = ТипБлока + Рез.ИмяОбъекта + ".Форма";
					ОткрытьФорму(ПутьКФормеРезерв, ПараметрыФормы, ЭтотОбъект, КлючУникальности);
				Иначе
					ВызватьИсключение;
				КонецЕсли;
			КонецПопытки;
		Иначе
			СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Не удалось запустить: %1'"), Рез.Ошибка));
		КонецЕсли;
	Исключение
		СообщитьПользователюПанелька(СтрШаблон(НСтр("ru = 'Ошибка: %1'"), ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Универсальное копирование текста в буфер обмена.
// Поддерживает современные платформы 8.3.24+, COM-объекты Windows и резервное диалоговое окно.
&НаКлиенте
Асинх Процедура СкопироватьТекстВБуферНадежно(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	УспешноСкопировано = Ложь;
	// УРОВЕНЬ 1: Попытка через современный асинхронный API (для платформ 8.3.24+)
	// Код оборачиваем в Выполнить(), чтобы старые платформы не ругались на неизвестные типы при компиляции
	Попытка
		СисИнфо = Новый СистемнаяИнформация;
		ЧастиВерсии = СтрРазделить(СисИнфо.ВерсияПриложения, ".");
		Если ЧастиВерсии.Количество() >= 3 Тогда
			НомерВерсии = Число(ЧастиВерсии[0]) * 10000 + Число(ЧастиВерсии[1]) * 100 + Число(ЧастиВерсии[2]);
			Если НомерВерсии >= 80324 Тогда
				ТекстКопирования = Текст;
				ПромисКопирования = Неопределено;
				// Внутри Выполнить() нельзя использовать Ждать, поэтому мы возвращаем Промис (Обещание) наружу
				ТекстДляВыполнения =
					"ФорматБуфера = СтандартныйФорматДанныхБуфераОбмена.Текст;" + Символы.ПС +
					"Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда" + Символы.ПС +
					"    ДанныеБуфера = Новый ЭлементБуфераОбмена(ФорматБуфера, ТекстКопирования);" + Символы.ПС +
					"    ПромисКопирования = СредстваБуфераОбмена.ПоместитьДанныеАсинх(ДанныеБуфера);" + Символы.ПС +
					"КонецЕсли;";
				Выполнить(ТекстДляВыполнения);
				Если ПромисКопирования <> Неопределено Тогда
					УспешноСкопировано = Ждать ПромисКопирования;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Игнорируем ошибки при выполнении нового API
	КонецПопытки;
	// УРОВЕНЬ 2: Использование COM-объекта (для старых платформ в среде Windows)
	// Копирует текст незаметно без открытия окон
	Если Не УспешноСкопировано Тогда
		Попытка
			ХТМЛ = Новый COMОбъект("htmlfile");
			УспешноСкопировано = ХТМЛ.ParentWindow.ClipboardData.SetData("Text", Текст);
		Исключение
			// COM может отсутствовать в ОС; ниже предлагается ручное копирование.
		КонецПопытки;
	КонецЕсли;
	// УРОВЕНЬ 3: Финал. Если скопировано успешно — показываем уведомление. Иначе fallback на ручной ввод.
	Если УспешноСкопировано Тогда
		ПоказатьОповещениеПользователя("Скопировано", , Текст, БиблиотекаКартинок.Успешно);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияОкнаСсылки", ЭтотОбъект);
		ПоказатьВводСтроки(Оповещение, Текст,НСтр("ru = 'Ваша ОС блокирует буфер. Скопируйте текст (Ctrl+C):'"));
	КонецЕсли;
КонецПроцедуры

// Обязательная пустая заглушка для fallback-копирования через окно ввода
//
// Параметры:
//  Результат - Неопределено, Строка - результат окна ввода; не используется.
//  Параметры - Неопределено - дополнительные параметры оповещения не передаются.
&НаКлиенте
Процедура ПослеЗакрытияОкнаСсылки(Результат, Параметры) Экспорт
	// Ничего не делаем, окно закрыто
КонецПроцедуры

#КонецОбласти

#Область ПодключениеВнешнихОбработок

// Определяет право интерактивного открытия локального инструмента по формату.
&НаСервереБезКонтекста
Функция СтатусПраваОткрытияЛокальногоФайлаПанелька(Знач Расширение)
	Расширение = НРег(Расширение);
	Если Расширение = ".epf" Тогда
		ИмяПрава = "ИнтерактивноеОткрытиеВнешнихОбработок";
	ИначеЕсли Расширение = ".erf" Тогда
		ИмяПрава = "ИнтерактивноеОткрытиеВнешнихОтчетов";
	Иначе
		Возврат "Некорректная";
	КонецЕсли;
	Возврат ?(ПравоДоступа(ИмяПрава, Метаданные), "ОК", "НетПрав");
КонецФункции

// Подключает локальный файл внешней обработки или отчета через временное хранилище.
//
// Параметры:
//  АдресВХ - Строка - адрес данных во временном хранилище.
//  Расширение - Строка - расширение подключаемого файла.
//  ПутьКФайлу - Строка - исходный локальный путь для проверки политики.
//  АдресРазрешения - Строка - адрес серверного контекста запуска; пустая строка использует контекст формы.
//
// Возвращаемое значение:
//  Структура - результат подключения файла:
//  * Успех - Булево - файл подключен.
//  * ИмяОбъекта - Строка - имя подключенного экземпляра.
//  * ЭтоОтчет - Булево - расширение файла ERF.
//  * Ошибка - Строка - пояснение отказа.
&НаСервере
Функция ПодключитьЛокальныйФайлНаСервере(АдресВХ, Расширение, ПутьКФайлу = "", АдресРазрешения = "")
	Рез = Новый Структура;
	Рез.Вставить("Успех", Ложь);
	Рез.Вставить("ИмяОбъекта", "");
	Рез.Вставить("ЭтоОтчет", Ложь);
	Рез.Вставить("Ошибка", "");
	Рез.ЭтоОтчет = (НРег(Расширение) = ".erf");
	СтатусПрава = СтатусПраваОткрытияЛокальногоФайлаПанелька(Расширение);
	Если СтатусПрава = "Некорректная" Или НРег(Прав(СокрЛП(ПутьКФайлу), 4)) <> НРег(Расширение) Тогда
		Рез.Ошибка = НСтр("ru = 'Поддерживаются только файлы EPF и ERF с соответствующим расширением.'");
		Возврат Рез;
	КонецЕсли;
	Если СтатусПрава = "НетПрав" Тогда
		Рез.Ошибка = НСтр("ru = 'Недостаточно прав для открытия этого внешнего отчёта или обработки.'");
		Возврат Рез;
	КонецЕсли;

	ПроверитьПравоПодключенияИнструментаПанелька("ext_file:" + ПутьКФайлу, АдресРазрешения);
	Попытка
		// Сохраняем режим подключения локальных инструментов; права пользователя не повышаем.
		Если Рез.ЭтоОтчет Тогда
			Рез.ИмяОбъекта = ВнешниеОтчеты.Подключить(АдресВХ, , Ложь);
		Иначе
			Рез.ИмяОбъекта = ВнешниеОбработки.Подключить(АдресВХ, , Ложь);
		КонецЕсли;
		Рез.Успех = Истина;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗаписатьОшибкуПанелька("ПодключениеЛокальногоФайла", Ошибка);
		Рез.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка);
	КонецПопытки;
	Возврат Рез;
КонецФункции

// Подключает стандартный инструмент из ресурса конфигурации.
// Параметры:
//  ПутьКФайлу_v8res - Строка - путь к ресурсу стандартной обработки.
// Возвращаемое значение:
//  Строка - результат выполнения функции.
&НаСервере
Функция ПодключитьСтандартнуюОбработкуНаСервере(Знач ПутьКФайлу_v8res)
	Если Лев(НРег(ПутьКФайлу_v8res), 8) <> "v8res://" Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный адрес стандартного инструмента.'");
	КонецЕсли;
	Если СтатусПраваОткрытияЛокальногоФайлаПанелька(".epf") = "НетПрав" Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для открытия стандартного инструмента.'");
	КонецЕсли;
	ПроверитьПравоПодключенияИнструментаПанелька(ПутьКФайлу_v8res);
	ИмяИзПути = СформироватьБезопасноеИмяЭлементаПанелька("", ПутьКФайлу_v8res);
	Если СтрДлина(ИмяИзПути) > 200 Тогда
		ИмяИзПути = Прав(ИмяИзПути, 200);
	КонецЕсли;
	УникальноеИмя = "SysTool_" + ИмяИзПути;
	Попытка
		ВнешниеОбработки.Создать(УникальноеИмя);
		Возврат УникальноеИмя;
	Исключение
		// Ресурс ещё не подключён в сеансе; выполняем первое подключение ниже.
	КонецПопытки;
	Попытка
		Возврат ВнешниеОбработки.Подключить(ПутьКФайлу_v8res, УникальноеИмя, Ложь);
	Исключение
		ЗаписатьОшибкуПанелька("ПодключениеСтандартногоИнструмента", ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;
КонецФункции

// Выбирает единственный механизм подключения. Отказ адаптера не включает резервный путь.
//
// Параметры:
//  НавигационнаяСсылка - Строка - ссылка дополнительного отчёта или обработки.
//  ИсходныйАдрес - Строка - исходная сохраненная ссылка для повторной проверки личной политики; пустая строка при отсутствии отдельного адреса.
//
// Возвращаемое значение:
//  Структура - результат подключения:
//  * Успех - Булево - инструмент подключен.
//  * ИмяОбъекта - Строка - имя подключенного экземпляра.
//  * ЭтоОтчет - Булево - инструмент является отчетом.
//  * Ошибка - Строка - пояснение отказа.
//  * ПутьКФорме - Строка - подготовленное имя формы, если его сообщил адаптер.
&НаСервере
Функция ПодключитьДопОбработкуНаСервере(Знач НавигационнаяСсылка, Знач ИсходныйАдрес = "")
	ПроверитьПравоПодключенияИнструментаПанелька(НавигационнаяСсылка, "", ИсходныйАдрес);
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ИмяОбъекта", "");
	Результат.Вставить("ЭтоОтчет", Ложь);
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("ПутьКФорме", "");
	Разбор = РазобратьСсылкуДопОбработкиПанелька(НавигационнаяСсылка);
	Если Не Разбор.Успех Тогда
		Результат.Ошибка = Разбор.Ошибка;
		Возврат Результат;
	КонецЕсли;
	ИмяСправочника = Разбор.ИмяСправочника;
	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		Результат.Ошибка = "В этой базе отсутствует справочник " + ИмяСправочника + ".";
		Возврат Результат;
	КонецЕсли;
	Попытка
		Если Не ПравоДоступа("Чтение", МетаданныеСправочника) Тогда
			Результат.Ошибка = "Недостаточно прав для чтения дополнительного отчёта или обработки.";
			Возврат Результат;
		КонецЕсли;
		СсылкаДоп = Справочники[ИмяСправочника].ПолучитьСсылку(Разбор.Идентификатор);
		// Имя таблицы получено из разрешённого списка и проверено по метаданным.
		Запрос = Новый Запрос("ВЫБРАТЬ
|   Доп.ПометкаУдаления КАК ПометкаУдаления
|ИЗ
|   Справочник." +
			ИмяСправочника + " КАК Доп
|ГДЕ
|   Доп.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", СсылкаДоп);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Результат.Ошибка = "Дополнительный отчёт или обработка не найдены.";
			Возврат Результат;
		КонецЕсли;
		Если Выборка.ПометкаУдаления Тогда
			Результат.Ошибка = "Дополнительный отчёт или обработка помечены на удаление.";
			Возврат Результат;
		КонецЕсли;
		Если МетаданныеСправочника.Иерархический Тогда
			Если СсылкаДоп.ЭтоГруппа Тогда
				Результат.Ошибка = "Выбрана группа справочника. Для запуска выберите отчёт или обработку.";
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		ИмяРеквизитаВида = ?(ИмяСправочника = "ВнешниеОбработки", "ТипОбработки", "Вид");
		Если МетаданныеСправочника.Реквизиты.Найти(ИмяРеквизитаВида) = Неопределено Тогда
			Результат.Ошибка = "Не поддерживается структура справочника " + ИмяСправочника + ".";
			Возврат Результат;
		КонецЕсли;
		ВидОбъекта = СтрЗаменить(НРег(Строка(СсылкаДоп[ИмяРеквизитаВида])), "ё", "е");
		Результат.ЭтоОтчет = СтрНайти(ВидОбъекта, "отчет") > 0;
		Если ИмяСправочника = "ДополнительныеОтчетыИОбработки"
			И Метаданные.ОбщиеМодули.Найти("ДополнительныеОтчетыИОбработки") <> Неопределено Тогда
			МодульБСП = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
			Результат.ИмяОбъекта = МодульБСП.ПодключитьВнешнююОбработку(СсылкаДоп);
		ИначеЕсли ИмяСправочника = "ВнешниеОбработки"
			И Метаданные.ОбщиеМодули.Найти("ОбщегоНазначенияЕАП") <> Неопределено Тогда
			МодульЕАП = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияЕАП");
			Подключение = МодульЕАП.ПодключитьОбработку(СсылкаДоп);
			Если ТипЗнч(Подключение) <> Тип("Структура") Тогда
				Результат.Ошибка = "Механизм WMS не вернул результат подключения.";
				Возврат Результат;
			КонецЕсли;
			ИмяМетаданных = "";
			ПринадлежностьФормы = "";
			Если Не Подключение.Свойство("ИмяМетаданных", ИмяМетаданных)
				Или Не Подключение.Свойство("ПринадлежностьФормы", ПринадлежностьФормы) Тогда
				Результат.Ошибка = "Не поддерживается формат результата подключения WMS.";
				Возврат Результат;
			КонецЕсли;
			Результат.ИмяОбъекта = Строка(ИмяМетаданных);
			Результат.ЭтоОтчет = Строка(ПринадлежностьФормы) = "ВнешнийОтчет";
		Иначе
			ПодключитьДопОбработкуБезАдаптераПанелька(СсылкаДоп, МетаданныеСправочника, Результат);
		КонецЕсли;
		Если ИмяСправочника = "ВнешниеОбработки"
			И МетаданныеСправочника.Реквизиты.Найти("ФормаГруппыВнешниеКоманды") <> Неопределено Тогда
			Результат.ПутьКФорме = Строка(СсылкаДоп.ФормаГруппыВнешниеКоманды);
		КонецЕсли;
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			Возврат Результат;
		КонецЕсли;
		Результат.Успех = ЗначениеЗаполнено(Результат.ИмяОбъекта);
		Если Не Результат.Успех Тогда
			Результат.Ошибка = "Механизм подключения не вернул имя отчёта или обработки.";
		КонецЕсли;
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗаписатьОшибкуПанелька("ПодключениеДополнительнойОбработки", Ошибка);
		Результат.Ошибка = "Не удалось подключить отчёт или обработку: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка);
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Подключает файл из записи только при отсутствии штатного адаптера БСП/WMS.
// Параметры:
//  СсылкаДоп - СправочникСсылка - проверенная ссылка записи.
//  МетаданныеСправочника - ОбъектМетаданных - метаданные поддерживаемого справочника.
//  Результат - Структура - заполняемые ИмяОбъекта и Ошибка; ЭтоОтчет уже определён.
&НаСервереБезКонтекста
Процедура ПодключитьДопОбработкуБезАдаптераПанелька(СсылкаДоп, МетаданныеСправочника, Результат)
	ИмяХранилища = ?(МетаданныеСправочника.Имя = "ВнешниеОбработки", "ДанныеОбработки", "ХранилищеОбработки");
	Если МетаданныеСправочника.Реквизиты.Найти(ИмяХранилища) = Неопределено Тогда
		Результат.Ошибка = "Не найден реквизит хранения файла " + ИмяХранилища + ".";
		Возврат;
	КонецЕсли;
	ДанныеФайла = СсылкаДоп[ИмяХранилища].Получить();
	Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
		Результат.Ошибка = "В записи отсутствует файл отчёта или обработки.";
		Возврат;
	КонецЕсли;
	// При отсутствии настройки не отключаем безопасный режим автоматически.
	БезопасныйРежимЗапуска = Истина;
	ИмяРеквизитаБезопасногоРежима = "БезопасныйРежим";
	Если МетаданныеСправочника.Реквизиты.Найти(ИмяРеквизитаБезопасногоРежима) <> Неопределено Тогда
		БезопасныйРежимЗапуска = СсылкаДоп[ИмяРеквизитаБезопасногоРежима];
	КонецЕсли;
	АдресДанных = ПоместитьВоВременноеХранилище(ДанныеФайла);
	Если Результат.ЭтоОтчет Тогда
		Результат.ИмяОбъекта = ВнешниеОтчеты.Подключить(АдресДанных, , БезопасныйРежимЗапуска);
	Иначе
		Результат.ИмяОбъекта = ВнешниеОбработки.Подключить(АдресДанных, , БезопасныйРежимЗапуска);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПроверкаИРаботаСФайлами

// Завершает проверку пути результатом, чтобы параллельная ошибка не осталась без обработчика.
// Параметры:
//  Путь - Строка - путь локального или сетевого файла.
// Возвращаемое значение:
//  Обещание - результат типа Структура с доступностью и информацией об ошибке.
&НаКлиенте
Асинх Функция ПолучитьРезультатПроверкиПутиПанелька(Знач Путь)
	Результат = Новый Структура("Доступен,Ошибка,Время", Ложь, Неопределено, 0);
	Начало = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	Попытка
		ФайлОбъект = Новый Файл(Путь);
		Результат.Доступен = Ждать ФайлОбъект.СуществуетАсинх();
	Исключение
		Результат.Ошибка = ИнформацияОбОшибке();
	КонецПопытки;
	Если Начало > 0 Тогда
		Результат.Время = Макс(0, ЧасыДиагностикиПанелька(Истина) - Начало);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Проверяет локальные файлы; недоступные ссылки отмечает ошибкой и отключает переход.
&НаКлиенте
Асинх Процедура ПроверитьДоступностьВнешнихФайловНаКлиенте()
	Если ОбновлениеЗапрошеноПанелька = Истина Или ФормаЗакрываетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	ВерсияПроверки = ВерсияЗапросовОбновленияПанелька;
	Если ПоколениеПроверкиФайловПанелька = ПоколениеЗагрузкиПанелька Тогда
		Возврат;
	КонецЕсли;
	ПоколениеПроверкиФайловПанелька = ПоколениеЗагрузкиПанелька;
	Поколение = ПоколениеЗагрузкиПанелька;
	Если РежимHTTP Тогда
		ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька,
			"Клиент: до получения html_loaded (включая сервер и обмен)", НачалоЗагрузкиПанелька);
	КонецЕсли;
	НачалоПроверки = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
	ДоступностьПутей = Новый Соответствие;
	ЕстьОшибкаТекущейПроверки = Ложь;
	ЧислоДоступныхПутей = 0;
	ЧислоНедоступныхПутей = 0;
	НужноОбновитьРазметку = Ложь;
	ПроверкиПутей = Новый Соответствие;
	СписокПутей = Новый Массив;
	Для Каждого Стр Из ТаблицаСоответствияОбъектов Цикл
		Если Лев(Стр.Ссылка, 9) = "ext_file:" Тогда
			Путь = Сред(Стр.Ссылка, 10);
			Если ПроверкиПутей[Путь] = Неопределено Тогда
				ПроверкиПутей.Вставить(Путь, Ложь);
				СписокПутей.Добавить(Путь);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СледующийПуть = 0;
	Для ИндексПути = 0 По Мин(3, СписокПутей.Количество() - 1) Цикл
		Путь = СписокПутей[СледующийПуть];
		ПроверкиПутей.Вставить(Путь, ПолучитьРезультатПроверкиПутиПанелька(Путь));
		СледующийПуть = СледующийПуть + 1;
	КонецЦикла;
	Для Каждого Стр Из ТаблицаСоответствияОбъектов Цикл
		Если Лев(Стр.Ссылка, 9) = "ext_file:" Тогда
			ПутьКФайлу = Сред(Стр.Ссылка, 10);
			ФайлДоступен = ДоступностьПутей[ПутьКФайлу];
			ПерваяПроверкаПути = (ФайлДоступен = Неопределено);
			Если ПерваяПроверкаПути Тогда
				РезультатПроверки = Ждать ПроверкиПутей[ПутьКФайлу];
				ФайлДоступен = РезультатПроверки.Доступен;
				Если РезультатПроверки.Ошибка <> Неопределено Тогда
					ЗаписатьДиагностикуКлиентаПанелька("Проверка внешнего файла", РезультатПроверки.Ошибка);
				КонецЕсли;
				Если Поколение <> ПоколениеЗагрузкиПанелька Или ВерсияПроверки <> ВерсияЗапросовОбновленияПанелька
					Или ФормаЗакрываетсяПанелька = Истина Тогда
					Возврат;
				КонецЕсли;
				ДоступностьПутей.Вставить(ПутьКФайлу, ФайлДоступен);
				Если СледующийПуть < СписокПутей.Количество() Тогда
					Путь = СписокПутей[СледующийПуть];
					ПроверкиПутей.Вставить(Путь, ПолучитьРезультатПроверкиПутиПанелька(Путь));
					СледующийПуть = СледующийПуть + 1;
				КонецЕсли;
				Если ФайлДоступен Тогда
					ЧислоДоступныхПутей = ЧислоДоступныхПутей + 1;
				Иначе
					ЧислоНедоступныхПутей = ЧислоНедоступныхПутей + 1;
				КонецЕсли;
				Если ДиагностикаПанелька Тогда
					ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Клиент: проверка пути №"
						+ Строка(ДоступностьПутей.Количество())
						+ ?(ФайлДоступен, " (доступен): ", " (недоступен или ошибка): ")
						+ Строка(РезультатПроверки.Время) + " мс" + Символы.ПС;
				КонецЕсли;
			КонецЕсли;
			Если Не ФайлДоступен Тогда
				ЕстьОшибкаТекущейПроверки = Истина;
				Если Не РежимHTTP Тогда
					// Сигнал ставится до изменения элемента и сохраняется при прерывании проверки.
					ЕстьОшибкиВнешнихФайловПанелька = Истина;
				КонецЕсли;
				ТекстОшибки = "[ФАЙЛ НЕДОСТУПЕН ИЛИ ОТСУТСТВУЕТ]" + Символы.ПС + ПутьКФайлу;
				Если РежимHTTP Тогда
					// HTML обновляет все размещения пути по индексу; разметку пересчитываем один раз.
					Если ПерваяПроверкаПути Тогда
						Попытка
							ОкноБраузера = ПолучитьОкноWebДашбордаПанелька();
							ОкноБраузера.markFileAsUnavailable(ПутьКФайлу, ТекстОшибки, Истина);
							НужноОбновитьРазметку = Истина;
						Исключение
							ЗаписатьДиагностикуКлиентаПанелька("Отображение недоступного файла", ИнформацияОбОшибке());
						КонецПопытки;
					КонецЕсли;
				Иначе
					Элемент = Элементы.Найти(Стр.ИмяЭлемента);
					Если Элемент <> Неопределено Тогда
						Элемент.ЦветТекста = WebЦвета.Красный;
						Элемент.Подсказка = ТекстОшибки;
						Если Элемент.ОтображениеПодсказки = ОтображениеПодсказки.Нет Тогда
							Элемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
						КонецЕсли;
						Элемент.Гиперссылка = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Поколение <> ПоколениеЗагрузкиПанелька Или ВерсияПроверки <> ВерсияЗапросовОбновленияПанелька
		Или ФормаЗакрываетсяПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Если Не РежимHTTP Тогда
		ЕстьОшибкиВнешнихФайловПанелька = ЕстьОшибкаТекущейПроверки;
	КонецЕсли;
	Если НужноОбновитьРазметку Тогда
		Попытка
			ОкноБраузера = ПолучитьОкноWebДашбордаПанелька();
			ОкноБраузера.applyDynamicSpans();
		Исключение
			ЗаписатьДиагностикуКлиентаПанелька("Разметка недоступных файлов", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
	ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетДиагностикиПанелька, "Клиент: проверка внешних файлов", НачалоПроверки);
	Если ДиагностикаПанелька Тогда
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "Уникальных путей файлов: " +
			Строка(ДоступностьПутей.Количество()) + "; доступно: " + Строка(ЧислоДоступныхПутей)
			+ "; недоступно/ошибка: " + Строка(ЧислоНедоступныхПутей) + Символы.ПС
			+ "До четырёх проверок одновременно; времена отдельных путей не суммировать." + Символы.ПС;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПоискНаГлавнойФорме

// Получает актуальный текст поиска из элемента формы и применяет его.
&НаКлиенте
Процедура ПрименитьПоискНаГлавной()
	ТекстДляПоиска = СтрокаПоиска;
	Если ТекущийЭлемент = Элементы.СтрокаПоиска Тогда
		ТекстДляПоиска = Элементы.СтрокаПоиска.ТекстРедактирования;
	КонецЕсли;
	Если СтрокаПоиска <> ТекстДляПоиска Тогда
		СтрокаПоиска = ТекстДляПоиска;
	КонецЕсли;
	ПрименитьПоискСЗаданнымТекстом(ТекстДляПоиска);
КонецПроцедуры

// Рекурсивно обновляет видимость элементов панели в соответствии с поиском.
// Параметры:
//  ТекстПоиска - Строка - текст поискового запроса.
&НаКлиенте
Процедура ПрименитьПоискСЗаданнымТекстом(Знач ТекстПоиска)
	СтрокаПоискаНрег = НРег(ТекстПоиска);
	Если РежимHTTP Тогда
		// Вызов функции внутри HTML документа
		Попытка
			ОкноДокумента = ПолучитьОкноWebДашбордаПанелька();
			ОкноДокумента.applySearchFrom1C(СтрокаПоискаНрег);
		Исключение
			ЗаписатьДиагностикуКлиентаПанелька("Поиск в Web-документе", ИнформацияОбОшибке());
		КонецПопытки;
	Иначе
		ЕстьПоиск = Не ПустаяСтрока(СтрокаПоискаНрег);
		ГруппаВкладки = Элементы.Найти("Вкладки");
		Если ГруппаВкладки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Вкладка Из ГруппаВкладки.ПодчиненныеЭлементы Цикл
			ОбновитьВидимостьЭлементовРекурсивно(Вкладка, СтрокаПоискаНрег, ЕстьПоиск, Ложь);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры


// Рекурсивно проверяет элементы группы и меняет их видимость по результатам поиска.
//
// Параметры:
//  Родитель - ГруппаФормы, ДекорацияФормы - текущий узел динамических элементов обычной панели.
//  СтрокаПоискаНрег - Строка - текст поиска в нижнем регистре.
//  ЕстьПоиск - Булево - признак активного поиска.
//  ПринудительнаяВидимость - Булево - признак принудительного отображения элемента.
//
// Возвращаемое значение:
//  Булево - элемент или его подчиненные удовлетворяют текущему фильтру.
&НаКлиенте
Функция ОбновитьВидимостьЭлементовРекурсивно(Родитель, СтрокаПоискаНрег, ЕстьПоиск, Знач ПринудительнаяВидимость)
	Если СтрНайти(Родитель.Имя, "_Пружина") > 0 ИЛИ СтрНайти(Родитель.Имя, "АвтоПружина_") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Родитель) <> Тип("ГруппаФормы") Тогда
		Если СтрНайти(Родитель.Имя, "_Текст") > 0 Или СтрНайти(Родитель.Имя, "_Иконка") > 0 Тогда
			Возврат Родитель.Видимость;
		КонецЕсли;
		Если Не ЕстьПоиск Тогда
			Если Не Родитель.Видимость Тогда
				Родитель.Видимость = Истина;
			КонецЕсли;
			Если ТипЗнч(Родитель.Заголовок) = Тип("ФорматированнаяСтрока") И Родитель.Гиперссылка Тогда
				Родитель.Заголовок = Строка(Родитель.Заголовок);
			КонецЕсли;
			Возврат Истина;
		КонецЕсли;
		ТекстСсылки = Строка(Родитель.Заголовок);
		ТекстСсылкиНрег = НРег(ТекстСсылки);
		Если ЕстьПоиск Тогда
			Позиция = СтрНайти(ТекстСсылкиНрег, СтрокаПоискаНрег);
			Если Позиция > 0 Тогда
				Если Родитель.Видимость <> (Истина) Тогда
					Родитель.Видимость = Истина;
				КонецЕсли;
				Если Родитель.Гиперссылка Тогда
					ЛевЧасть  = Лев(ТекстСсылки, Позиция - 1);
					СредЧасть = Сред(ТекстСсылки, Позиция, СтрДлина(СтрокаПоискаНрег));
					ПравЧасть = Сред(ТекстСсылки, Позиция + СтрДлина(СтрокаПоискаНрег));
					МассивФС = Новый Массив;
					ШрифтВыделения = Новый Шрифт(,,, Истина);
					Если Не ПустаяСтрока(ЛевЧасть) Тогда
						МассивФС.Добавить(ЛевЧасть);
					КонецЕсли;
					МассивФС.Добавить(Новый ФорматированнаяСтрока(СредЧасть, ШрифтВыделения, WebЦвета.Красный));
					Если Не ПустаяСтрока(ПравЧасть) Тогда
						МассивФС.Добавить(ПравЧасть);
					КонецЕсли;
					Родитель.Заголовок = Новый ФорматированнаяСтрока(МассивФС);
				КонецЕсли;
			ИначеЕсли ПринудительнаяВидимость Тогда
				Если Родитель.Видимость <> (Истина) Тогда
					Родитель.Видимость = Истина;
				КонецЕсли;
				Если ТипЗнч(Родитель.Заголовок) = Тип("ФорматированнаяСтрока") И Родитель.Гиперссылка Тогда
					Родитель.Заголовок = ТекстСсылки;
				КонецЕсли;
			Иначе
				Если Родитель.Видимость <> (Ложь) Тогда
					Родитель.Видимость = Ложь;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Родитель.Видимость <> (Истина) Тогда
				Родитель.Видимость = Истина;
			КонецЕсли;
			Если ТипЗнч(Родитель.Заголовок) = Тип("ФорматированнаяСтрока") И Родитель.Гиперссылка Тогда
				Родитель.Заголовок = ТекстСсылки;
			КонецЕсли;
		КонецЕсли;
		Возврат Родитель.Видимость;
	КонецЕсли;
	ЕстьВидимыеПодчиненные = Ложь;
	ТекущаяГруппаПодходит = ПринудительнаяВидимость;
	СовпадениеВЗаголовке = Ложь;
	Если ЕстьПоиск И СтрНайти(НРег(Строка(Родитель.Заголовок)), СтрокаПоискаНрег) > 0 Тогда
		ТекущаяГруппаПодходит = Истина;
		СовпадениеВЗаголовке = Истина;
	КонецЕсли;
	ШапкаГруппы = Неопределено;
	Для Каждого ПодчиненныйЭлемент Из Родитель.ПодчиненныеЭлементы Цикл
		Если СтрНайти(ПодчиненныйЭлемент.Имя, "_Шапка") > 0 Тогда
			ШапкаГруппы = ПодчиненныйЭлемент;
			Продолжить;
		КонецЕсли;
		ВидимостьПодчиненного = ОбновитьВидимостьЭлементовРекурсивно(ПодчиненныйЭлемент, СтрокаПоискаНрег,
			ЕстьПоиск, ТекущаяГруппаПодходит);
		Если ВидимостьПодчиненного Тогда
			ЕстьВидимыеПодчиненные = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ШапкаГруппы <> Неопределено Тогда
		Если ШапкаГруппы.Видимость <> (ЕстьВидимыеПодчиненные Или (Не ЕстьПоиск) Или ТекущаяГруппаПодходит) Тогда
			ШапкаГруппы.Видимость = ЕстьВидимыеПодчиненные Или (Не ЕстьПоиск) Или ТекущаяГруппаПодходит;
		КонецЕсли;
		ТекстТипа = Элементы.Найти(Родитель.Имя + "_ТекстЗаголовка");
		Если ТекстТипа <> Неопределено Тогда
			Если СовпадениеВЗаголовке Тогда
				ТекстТипа.ЦветТекста = WebЦвета.Красный;
			Иначе
				ТекстТипа.ЦветТекста = ЦветГруппировки;
			КонецЕсли;
		КонецЕсли;
		ТекстКолонки = Элементы.Найти(Родитель.Имя + "_Текст");
		Если ТекстКолонки <> Неопределено Тогда
			Если СовпадениеВЗаголовке Тогда
				ТекстКолонки.ЦветТекста = WebЦвета.Красный;
			Иначе
				ТекстКолонки.ЦветТекста = ЦветКолонки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ШапкаГруппы = Неопределено И СтрНайти(Родитель.Имя, "ГруппаКолонка_") > 0 Тогда
		Если СовпадениеВЗаголовке Тогда
			Родитель.ЦветТекстаЗаголовка = WebЦвета.Красный;
		Иначе
			Родитель.ЦветТекстаЗаголовка = ЦветКолонки;
		КонецЕсли;
	КонецЕсли;
	Если Родитель.Видимость <> (ЕстьВидимыеПодчиненные ИЛИ (Не ЕстьПоиск) ИЛИ ТекущаяГруппаПодходит) Тогда
		Родитель.Видимость = ЕстьВидимыеПодчиненные ИЛИ (Не ЕстьПоиск) ИЛИ ТекущаяГруппаПодходит;
	КонецЕсли;
	Возврат Родитель.Видимость;
КонецФункции

#КонецОбласти

#Область ДанныеWebИнтерфейса

// Получает текст HTML-макета дашборда из обработки.
// Возвращаемое значение:
//  Строка - Исходный код HTML-макета.
&НаСервере
Функция ПолучитьМакетHTMLНаСервере()
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("МакетДашбордаHTML");
	Возврат Макет.ПолучитьТекст();
КонецФункции

// Возвращает идентификатор страницы текущей модели или обязательной системной страницы.
&НаСервереБезКонтекста
Функция ИдентификаторСтраницыHTMLПанелька(Контекст, ИмяСтраницы)
	Если ТипЗнч(Контекст.ДанныеСтраниц) = Тип("ТаблицаЗначений") Тогда
		Страница = Контекст.ДанныеСтраниц.Найти(ИмяСтраницы, "ИмяСтраницы");
		Если Страница <> Неопределено Тогда
			Возврат Страница.ИД;
		КонецЕсли;
	КонецЕсли;
	Если ИмяСтраницы = "Главная" Тогда
		Возврат "page-main";
	ИначеЕсли ИмяСтраницы = "Не распределено" Тогда
		Возврат "page-unassigned";
	ИначеЕсли ИмяСтраницы = "Стандартные инструменты" Тогда
		Возврат "page-standard";
	КонецЕсли;
	ВызватьИсключение НСтр("ru = 'Не найдена страница текущей модели панели.'");
КонецФункции

// Разделяет состояние браузера по пользователю базы и общей/личной панели.
// Сохраняется случайный идентификатор; параметры подключения в HTML не передаются.
&НаСервере
Функция ПространствоСостоянияHTMLПанелька()
	Пространство = "";
	Попытка
		Пространство = ПолучитьПользовательскуюНастройкуПанелька("ПространствоСостоянияHTML", "");
		Если ТипЗнч(Пространство) <> Тип("Строка") Тогда
			Пространство = "";
		КонецЕсли;
		Если ПустаяСтрока(Пространство) Тогда
			Пространство = Строка(Новый УникальныйИдентификатор);
			СохранитьПользовательскуюНастройкуПанелька("ПространствоСостоянияHTML", Пространство);
		КонецЕсли;
	Исключение
		// При отказе сохранения предпочтений используем состояние только текущего документа.
		ЗаписатьОшибкуПанелька("ПространствоСостоянияHTML", ИнформацияОбОшибке());
		Пространство = Строка(Новый УникальныйИдентификатор);
	КонецПопытки;
	Возврат Пространство + ?(ИспользуетсяЛичнаяПанельПанелька, ":personal", ":common");
КонецФункции

// Собирает данные, сериализует их в JSON и подготавливает HTML.
// Параметры:
//  КонтекстОтрисовки - Структура - Содержит все необходимые данные для построения дашборда.
&НаСервере
Процедура СформироватьHTMLДашборда(КонтекстОтрисовки)
	Данные = КонтекстОтрисовки.Данные;
	КэшКартинокПанелька = Новый Соответствие;
	ДеревоJSON = Новый Структура("Settings, Pages", Новый Структура, Новый Массив);
	ДеревоJSON.Settings.Вставить("GroupByType", КонтекстОтрисовки.ГруппироватьПоТипу);
	ДеревоJSON.Settings.Вставить("IsAdmin", КонтекстОтрисовки.ПользовательАдминистратор);
	ДеревоJSON.Settings.Вставить("Personal", ИспользуетсяЛичнаяПанельПанелька);
	ДеревоJSON.Settings.Вставить("HasPersonal", ЕстьЛичнаяПанельВКонтекстеПанелька = Истина);
	ДеревоJSON.Settings.Вставить("StateNamespace", ПространствоСостоянияHTMLПанелька());
	ДеревоJSON.Settings.Вставить("CanPersonal", ПерсональнаяПанельРазрешенаПанелька И
		ПравоДоступа("СохранениеДанныхПользователя", Метаданные));
	ДеревоJSON.Settings.Вставить("SavedTab", ПолучитьПользовательскуюНастройкуПанелька("Вкладка", ""));
	ДеревоJSON.Settings.Вставить("SavedTheme", ПолучитьПользовательскуюНастройкуПанелька("Тема", Ложь));
	СтрокаПодсказок = Строка(КонтекстОтрисовки.РежимПодсказок);
	Если СтрНайти(НРег(СтрокаПодсказок), "снизу") > 0 Тогда
		РежимП = "Снизу";
	ИначеЕсли СтрНайти(НРег(СтрокаПодсказок), "всплывающая") > 0 Тогда
		РежимП = "Всплывающая";
	ИначеЕсли СтрНайти(НРег(СтрокаПодсказок), "кнопка") > 0 Тогда
		РежимП = "Кнопка";
	Иначе
		РежимП = "Нет";
	КонецЕсли;
	ДеревоJSON.Settings.Вставить("TooltipMode", РежимП);
	КэшСтраниц = Новый Соответствие;
	КэшКолонок = Новый Соответствие;
	КэшТипов = Новый Соответствие;
	Для Каждого ИмяСтраницы Из КонтекстОтрисовки.МассивСтраниц Цикл
		СтрИмяСтраницы = СокрЛП(Строка(ИмяСтраницы));
		СтраницаJSON = Новый Структура;
		СтраницаJSON.Вставить("Id", ИдентификаторСтраницыHTMLПанелька(КонтекстОтрисовки, СтрИмяСтраницы));
		СтраницаJSON.Вставить("Name", СтрИмяСтраницы);
		СтраницаJSON.Вставить("IconBase64",
			КартинкаИзКэшаДашбордаПанелька(КонтекстОтрисовки.ИконкиСтраниц[ИмяСтраницы], КэшКартинокПанелька));
		СтраницаJSON.Вставить("Columns", Новый Массив);
		ДеревоJSON.Pages.Добавить(СтраницаJSON);
		КэшСтраниц.Вставить(СтрИмяСтраницы, СтраницаJSON);
	КонецЦикла;
	Для Каждого ИмяКолонки Из КонтекстОтрисовки.МассивКолонок Цикл
		СтрИмяКолонки = СокрЛП(Строка(ИмяКолонки));
		ИмяСтраницы = КонтекстОтрисовки.НастройкиКолонокСтраница[ИмяКолонки];
		СтрИмяСтраницы = ?(ЗначениеЗаполнено(ИмяСтраницы), СокрЛП(Строка(ИмяСтраницы)), "Главная");
		СтраницаJSON = КэшСтраниц[СтрИмяСтраницы];
		Если СтраницаJSON <> Неопределено Тогда
			КлючКолонки = СтрИмяСтраницы + "|" + СтрИмяКолонки;
			Если КэшКолонок[КлючКолонки] = Неопределено Тогда
				КолонкаJSON = Новый Структура;
				КолонкаJSON.Вставить("Id", СтрИмяКолонки);
				КолонкаJSON.Вставить("Name", ЗаголовокКолонкиПанелька(КонтекстОтрисовки, СтрИмяКолонки));
				КолонкаJSON.Вставить("Color", СформироватьЦветHEX(КонтекстОтрисовки.ЦветКолонки));
				КолонкаJSON.Вставить("IconBase64",
					КартинкаИзКэшаДашбордаПанелька(КонтекстОтрисовки.ИконкиКолонок[ИмяКолонки], КэшКартинокПанелька));
				КолонкаJSON.Вставить("Types", Новый Массив);
				СтраницаJSON.Columns.Добавить(КолонкаJSON);
				КэшКолонок.Вставить(КлючКолонки, КолонкаJSON);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Данные Цикл
		Если Не ЗначениеЗаполнено(Стр.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		// Таблица соответствий используется клиентской проверкой доступности файлов.
		НоваяСтрСоответствия = ТаблицаСоответствияОбъектов.Добавить();
		НоваяСтрСоответствия.Ссылка = Стр.Ссылка;
		НоваяСтрСоответствия.ИмяЭлемента = "HTTP_Элемент";
		Вкладка = СокрЛП(Строка(Стр.Вкладка));
		Колонка = СокрЛП(Строка(Стр.Колонка));
		ТипОбъекта = СокрЛП(Строка(Стр.ТипОбъекта));
		СтраницаJSON = КэшСтраниц[Вкладка];
		Если СтраницаJSON = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КлючКолонки = Вкладка + "|" + Колонка;
		КолонкаJSON = КэшКолонок[КлючКолонки];
		Если КолонкаJSON = Неопределено Тогда
			КолонкаJSON = Новый Структура;
			КолонкаJSON.Вставить("Id", Колонка);
			КолонкаJSON.Вставить("Name", ЗаголовокКолонкиПанелька(КонтекстОтрисовки, Колонка));
			КолонкаJSON.Вставить("Color", СформироватьЦветHEX(КонтекстОтрисовки.ЦветКолонки));
			КолонкаJSON.Вставить("IconBase64",
				КартинкаИзКэшаДашбордаПанелька(КонтекстОтрисовки.ИконкиКолонок[Колонка], КэшКартинокПанелька));
			КолонкаJSON.Вставить("Types", Новый Массив);
			СтраницаJSON.Columns.Добавить(КолонкаJSON);
			КэшКолонок.Вставить(КлючКолонки, КолонкаJSON);
		КонецЕсли;
		// Без группировки один массив сохраняет порядок строк внутри колонки.
		ИмяГруппыТипа = ?(КонтекстОтрисовки.ГруппироватьПоТипу, ТипОбъекта, "Прочее");
		КлючТипа = КлючКолонки + "|" + ИмяГруппыТипа;
		ТипJSON = КэшТипов[КлючТипа];
		Если ТипJSON = Неопределено Тогда
			ТипJSON = Новый Структура("Name, IconBase64, Links", ИмяГруппыТипа,
				КартинкаИзКэшаДашбордаПанелька(ПолучитьКартинкуДляТипаПанелька(Стр.ТипОбъекта), КэшКартинокПанелька, "type:" +
				Стр.ТипОбъекта), Новый Массив);
			КолонкаJSON.Types.Добавить(ТипJSON);
			КэшТипов.Вставить(КлючТипа, ТипJSON);
		КонецЕсли;
		МассивСсылок = ТипJSON.Links;
		ЭтоСистемнаяКоманда = (Лев(Стр.Ссылка, 8) = "sys_cmd:");
		ЭтоВнешнийФайл = (Лев(Стр.Ссылка, 9) = "ext_file:");
		ЭтоВебСсылка = (Лев(Стр.Ссылка, 9) = "web_link:");
		ЭтоДопОбработка = (СтрНайти(Стр.Ссылка,
			"e1cib/data/Справочник.ДополнительныеОтчетыИОбработки") > 0) ИЛИ (СтрНайти(Стр.Ссылка,
			"e1cib/data/Справочник.ВнешниеОбработки") > 0);
		ЭтоСсылкаНаДанные = (СтрНайти(Стр.Ссылка, "e1cib/data/") > 0);
		КорректнаяСсылка = ЭтоСистемнаяКоманда Или ЭтоВнешнийФайл Или ЭтоВебСсылка Или ЭтоДопОбработка Или
			(СтрНайти(Стр.Ссылка, "e1cib/") > 0 Или СтрНайти(Стр.Ссылка, "e1c://") > 0);
		СтатусСсылки = "ОК";
		Если ЭтоВнешнийФайл Тогда
			СтатусСсылки = СтатусПраваОткрытияЛокальногоФайлаПанелька(Прав(СокрЛП(Стр.Ссылка), 4));
		ИначеЕсли ЭтоСистемнаяКоманда Тогда
			СтатусСсылки = СтатусПраваОткрытияЛокальногоФайлаПанелька(".epf");
		ИначеЕсли КорректнаяСсылка И Не ЭтоВебСсылка Тогда
			Если ЭтоДопОбработка Тогда
				Попытка
					СтатусСсылки = ПроверитьСтатусДопОбработки(Стр.Ссылка, КонтекстОтрисовки.КэшСтатусовМД);
				Исключение
					СтатусСсылки = "Ошибка";
				КонецПопытки;
			Иначе
				Попытка
					СтатусСсылки = ПроверитьСтатусСсылки1С(Стр.Ссылка, КонтекстОтрисовки.КэшСтатусовМД);
				Исключение
					СтатусСсылки = "Ошибка";
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли Не КорректнаяСсылка Тогда
			СтатусСсылки = "Ошибка";
		КонецЕсли;
		СсылкаJSON = Новый Структура;
		СсылкаJSON.Вставить("Name", ?(ЗначениеЗаполнено(Стр.Наименование), Стр.Наименование, Стр.Ссылка));
		СсылкаJSON.Вставить("Url", Стр.Ссылка);
		СсылкаJSON.Вставить("Tooltip", Стр.Подсказка);
		СсылкаJSON.Вставить("Status", СтатусСсылки);
		СсылкаJSON.Вставить("IsFavorite", КонтекстОтрисовки.СсылкиИзбранного[НРег(СокрЛП(Стр.Ссылка))] <> Неопределено);
		СсылкаJSON.Вставить("IsSysCmd", ЭтоСистемнаяКоманда);
		СсылкаJSON.Вставить("IsExtFile", ЭтоВнешнийФайл);
		СсылкаJSON.Вставить("IsWebLink", ЭтоВебСсылка);
		СсылкаJSON.Вставить("IsAddProc", ЭтоДопОбработка);
		СсылкаJSON.Вставить("IsDataLink", ЭтоСсылкаНаДанные);
		СсылкаJSON.Вставить("IsStandard", КорректнаяСсылка И Не ЭтоСистемнаяКоманда И Не ЭтоВнешнийФайл И
			Не ЭтоВебСсылка И Не ЭтоДопОбработка);
		СсылкаJSON.Вставить("HasTooltip", ЗначениеЗаполнено(Стр.Подсказка));
		МассивСсылок.Добавить(СсылкаJSON);
	КонецЦикла;
	Для Каждого Страница Из ДеревоJSON.Pages Цикл
		ИнвертИндекс = Страница.Columns.Количество() - 1;
		Пока ИнвертИндекс >= 0 Цикл
			Если Страница.Columns[ИнвертИндекс].Types.Количество() = 0 Тогда
				Страница.Columns.Удалить(ИнвертИндекс);
			КонецЕсли;
			ИнвертИндекс = ИнвертИндекс - 1;
		КонецЦикла;
	КонецЦикла;
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДеревоJSON);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	// Экранируем слеши для безопасного парсинга в JS
	СтрокаJSON = СтрЗаменить(СтрокаJSON, "</", "<\/");
	ТекстМакета = ПолучитьМакетHTMLНаСервере();
	Если ПустаяСтрока(ТекстМакета) Тогда
		ВызватьИсключение НСтр("ru = 'ОШИБКА: Макет HTML пуст!'");
	КонецЕсли;
	// Готовый документ передаётся в реквизит формы.
	HTMLДашборд = СтрЗаменить(ТекстМакета, "/*JSON_DATA_PLACEHOLDER*/{}", СтрокаJSON);
	Если ДиагностикаПанелька Тогда
		ВремяКартинок = КэшКартинокПанелька["diag:ms"];
		КоличествоКартинок = КэшКартинокПанелька["diag:count"];
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + "В составе Web-подготовки: преобразование картинок: "
			+ Строка(?(ВремяКартинок = Неопределено, 0, ВремяКартинок)) + " мс; уникальных ключей: "
			+ Строка(?(КоличествоКартинок = Неопределено, 0, КоличествоКартинок)) + Символы.ПС;
	КонецЕсли;
КонецПроцедуры

// Разбирает сообщение Web-документа до выполнения действия.
// Параметры:
//  URL - Строка - адрес протокола panelka://.
// Возвращаемое значение:
//  Структура - Успех (Булево), Действие, Ссылка, Представление, Ошибка (Строка).
&НаКлиенте
Функция РазобратьКомандуWebПанелька(Знач URL)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Действие", "");
	Результат.Вставить("Ссылка", "");
	Результат.Вставить("Представление", "");
	Результат.Вставить("Ошибка", "Некорректная команда Web-интерфейса.");
	Если ТипЗнч(URL) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;
	Если Лев(URL, СтрДлина("panelka://")) <> "panelka://" Тогда
		Возврат Результат;
	КонецЕсли;
	Остаток = Сред(URL, СтрДлина("panelka://") + 1);
	ПозицияВопроса = СтрНайти(Остаток, "?");
	ПараметрыСтрокой = "";
	Если ПозицияВопроса > 0 Тогда
		Действие = Лев(Остаток, ПозицияВопроса - 1);
		ПараметрыСтрокой = Сред(Остаток, ПозицияВопроса + 1);
	Иначе
		Действие = Остаток;
	КонецЕсли;
	// Браузер может дописать завершающий слеш к адресу собственного протокола.
	Если Прав(Действие, 1) = "/" Тогда
		Действие = Лев(Действие, СтрДлина(Действие) - 1);
	КонецЕсли;
	Если Прав(ПараметрыСтрокой, 1) = "/" Тогда
		ПараметрыСтрокой = Лев(ПараметрыСтрокой, СтрДлина(ПараметрыСтрокой) - 1);
	КонецЕсли;
	Действия = СтрРазделить("html_loaded,save_tab,save_theme,switch_mode,open_settings,personal_settings,personal_create_common,personal_create_empty,personal_switch,open,open_new,open_card,copy_name,copy_text,copy_url,copy_ext_url,copy_file,copy_dir,add_fav,remove_fav", ",");
	Если Действия.Найти(Действие) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ПараметрыКомандыWeb = Новый Соответствие;
	Для Каждого ПараметрСтрокой Из СтрРазделить(ПараметрыСтрокой, "&", Ложь) Цикл
		ИмяПараметраКоманды = Лев(ПараметрСтрокой, 2);
		Если ИмяПараметраКоманды <> "u=" И ИмяПараметраКоманды <> "n=" Тогда
			Возврат Результат;
		КонецЕсли;
		Если ПараметрыКомандыWeb[ИмяПараметраКоманды] <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		ЗначениеПараметра = ДекодироватьСтрокуИзBase64(Сред(ПараметрСтрокой, 3));
		Если ЗначениеПараметра = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
		ПараметрыКомандыWeb.Вставить(ИмяПараметраКоманды, ЗначениеПараметра);
	КонецЦикла;
	Ссылка = ПараметрыКомандыWeb["u="];
	Представление = ПараметрыКомандыWeb["n="];
	Если Ссылка = Неопределено Тогда
		Ссылка = "";
	КонецЕсли;
	Если Представление = Неопределено Тогда
		Представление = "";
	КонецЕсли;
	Ссылка = СокрЛП(Ссылка);
	БезСсылки = СтрРазделить("html_loaded,switch_mode,open_settings,personal_settings,personal_create_common,personal_create_empty,personal_switch,copy_name,copy_text", ",");
	Если БезСсылки.Найти(Действие) = Неопределено И ПустаяСтрока(Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Действие = "save_theme" И Ссылка <> "true" И Ссылка <> "false" Тогда
		Возврат Результат;
	КонецЕсли;
	Если Действие = "copy_file" Или Действие = "copy_dir" Тогда
		Если Лев(Ссылка, 9) <> "ext_file:" Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Результат.Успех = Истина;
	Результат.Действие = Действие;
	Результат.Ссылка = Ссылка;
	Результат.Представление = Представление;
	Результат.Ошибка = "";
	Возврат Результат;
КонецФункции

// Декодирует URL-вариант Base64, используемый макетом, с проверкой целостности.
// Параметры:
//  ИсходнаяСтрока - Строка - Base64 с заменой + / = на - _ .
// Возвращаемое значение:
//  Строка, Неопределено - декодированный текст либо признак ошибки формата.
&НаКлиенте
Функция ДекодироватьСтрокуИзBase64(Знач ИсходнаяСтрока)
	Если ПустаяСтрока(ИсходнаяСтрока) Тогда
		Возврат "";
	КонецЕсли;
	ИсходнаяСтрока = СтрЗаменить(СтрЗаменить(СтрЗаменить(ИсходнаяСтрока, "-", "+"), "_", "/"), ".", "=");
	Попытка
		Данные = Base64Значение(ИсходнаяСтрока);
		ПроверочнаяСтрока = СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ВК, ""), Символы.ПС, "");
		Если ПроверочнаяСтрока <> ИсходнаяСтрока Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Исключение
		// Повреждённые параметры не передаются обработчику действия как обычный текст.
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Возвращает окно встроенного браузера с учётом различий платформ.
// Возвращаемое значение:
//  Произвольный - DOM-окно Web-документа; исключение обрабатывает вызывающая операция.
&НаКлиенте
Функция ПолучитьОкноWebДашбордаПанелька()
	ОкноДокумента = Неопределено;
	Попытка
		ОкноДокумента = Элементы.ПолеHTMLДашборда.Документ.defaultView;
	Исключение
		// Старый движок предоставляет parentWindow вместо defaultView.
	КонецПопытки;
	Если ОкноДокумента = Неопределено Тогда
		ОкноДокумента = Элементы.ПолеHTMLДашборда.Документ.parentWindow;
	КонецЕсли;
	Возврат ОкноДокумента;
КонецФункции

// Конвертирует системную картинку 1С в строку DataURI (Base64) для HTML.
//
// Параметры:
//  ИмяИконкиИлиКартинка - Строка, Картинка - имя картинки библиотеки либо готовая картинка.
//
// Возвращаемое значение:
//  Строка - Data URI картинки; пустая строка при отсутствии изображения.
&НаСервереБезКонтекста
Функция ПолучитьBase64СистемнойИконки(Знач ИмяИконкиИлиКартинка)
	Картинка = Неопределено;
	Если ТипЗнч(ИмяИконкиИлиКартинка) = Тип("Картинка") Тогда
		Картинка = ИмяИконкиИлиКартинка;
	ИначеЕсли ТипЗнч(ИмяИконкиИлиКартинка) = Тип("Строка") И ЗначениеЗаполнено(ИмяИконкиИлиКартинка) Тогда
		Попытка
			Картинка = БиблиотекаКартинок[ИмяИконкиИлиКартинка];
		Исключение
			Возврат "";
		КонецПопытки;
	Иначе
		Возврат "";
	КонецЕсли;
	Если Картинка = Неопределено Или Картинка.Вид = ВидКартинки.Пустая Тогда
		Возврат "";
	КонецЕсли;
	ДвоичныеДанные = Неопределено;
	ТипСодержимого = "image/png";
	Попытка
		КартинкаPNG = Картинка.Преобразовать(ФорматКартинки.PNG);
		ДвоичныеДанные = КартинкаPNG.ПолучитьДвоичныеДанные();
	Исключение
		// В режиме совместимости преобразование может быть недоступно.
	КонецПопытки;
	Если ДвоичныеДанные = Неопределено Тогда
		Попытка
			ДвоичныеДанные = Картинка.ПолучитьДвоичныеДанные();
			Если ДвоичныеДанные <> Неопределено Тогда
				ТипСодержимого = ТипСодержимогоКартинкиHTMLПанелька(ДвоичныеДанные);
			КонецЕсли;
		Исключение
			// При недоступных данных строим элемент без картинки.
			Возврат "";
		КонецПопытки;
	КонецЕсли;
	Если ДвоичныеДанные <> Неопределено И Не ПустаяСтрока(ТипСодержимого) Тогда
		Возврат "data:" + ТипСодержимого + ";base64," + Base64Строка(ДвоичныеДанные);
	КонецЕсли;
	Возврат "";
КонецФункции

// Определяет MIME-тип выбранного варианта картинки по его двоичным данным.
//
// Параметры:
//  ДвоичныеДанныеКартинки - ДвоичныеДанные - данные одного варианта картинки.
//
// Возвращаемое значение:
//  Строка - MIME-тип для HTML; пустая строка для неизвестного или неподдерживаемого формата.
&НаСервереБезКонтекста
Функция ТипСодержимогоКартинкиHTMLПанелька(ДвоичныеДанныеКартинки)
	Попытка
		КартинкаВарианта = Новый Картинка(ДвоичныеДанныеКартинки);
		ФорматИзображения = КартинкаВарианта.Формат();
	Исключение
		// Неизвестные или поврежденные данные не передаем в HTML.
		Возврат "";
	КонецПопытки;
	Если ФорматИзображения = ФорматКартинки.PNG Тогда
		Возврат "image/png";
	ИначеЕсли ФорматИзображения = ФорматКартинки.JPEG Тогда
		Возврат "image/jpeg";
	ИначеЕсли ФорматИзображения = ФорматКартинки.GIF Тогда
		Возврат "image/gif";
	ИначеЕсли ФорматИзображения = ФорматКартинки.BMP Тогда
		Возврат "image/bmp";
	ИначеЕсли ФорматИзображения = ФорматКартинки.SVG Тогда
		Возврат "image/svg+xml";
	ИначеЕсли ФорматИзображения = ФорматКартинки.Icon Тогда
		Возврат "image/x-icon";
	КонецЕсли;
	Возврат "";
КонецФункции

// Заглушка. Возвращает цвет по умолчанию для веб-интерфейса.
// Параметры:
//  Цвет1С - Цвет - Цвет платформы 1С.
// Возвращаемое значение:
//  Строка - Строковое представление цвета.
&НаСервереБезКонтекста
Функция СформироватьЦветHEX(Цвет1С)
	// В текущей реализации используется наследование цвета из CSS тем
	Возврат "inherit";
КонецФункции

// Кэш существует только в пределах формирования одного Web-документа.
&НаСервере
Функция КартинкаИзКэшаДашбордаПанелька(Картинка, Кэш, Ключ = Неопределено)
	Если Ключ = Неопределено Тогда
		Если ТипЗнч(Картинка) <> Тип("Строка") Тогда
			Возврат ПолучитьBase64СистемнойИконки(Картинка);
		КонецЕсли;
		Ключ = "name:" + Картинка;
	КонецЕсли;
	Результат = Кэш[Ключ];
	Если Результат = Неопределено Тогда
		НачалоКартинки = ЧасыДиагностикиПанелька(ДиагностикаПанелька);
		Результат = ПолучитьBase64СистемнойИконки(Картинка);
		Кэш.Вставить(Ключ, Результат);
		Если ДиагностикаПанелька Тогда
			ВремяКартинок = Кэш["diag:ms"];
			КоличествоКартинок = Кэш["diag:count"];
			Кэш.Вставить("diag:ms", ?(ВремяКартинок = Неопределено, 0, ВремяКартинок)
				+ Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоКартинки));
			Кэш.Вставить("diag:count", ?(КоличествоКартинок = Неопределено, 0, КоличествоКартинок) + 1);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеФункцииПредставления

// Формирует безопасное имя элемента формы без обращения к модулю объекта обработки.
// Параметры:
//  Префикс - Строка - префикс результирующего имени.
//  ИмяТекст - Строка - исходный текст для формирования имени.
// Возвращаемое значение:
//  Строка - строка, содержащая только допустимые символы имени элемента формы.
&НаСервере
Функция СформироватьБезопасноеИмяЭлементаПанелька(Знач Префикс, Знач ИмяТекст)
	ДопустимыеСимволы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
	ЧастиИмени = Новый Массив;
	Для Индекс = 1 По СтрДлина(ИмяТекст) Цикл
		СимволИмени = Сред(ИмяТекст, Индекс, 1);
		Если СтрНайти(ДопустимыеСимволы, СимволИмени) > 0 Тогда
			ЧастиИмени.Добавить(СимволИмени);
		Иначе
			ЧастиИмени.Добавить("_");
		КонецЕсли;
	КонецЦикла;
	Возврат Префикс + СтрСоединить(ЧастиИмени, "");
КонецФункции

// Возвращает системную картинку 1С для заданного типа объекта без обращения к модулю объекта обработки.
// Параметры:
//  ТипОбъекта - Строка - тип объекта.
// Возвращаемое значение:
//  Картинка - системная картинка для типа объекта.
&НаСервере
Функция ПолучитьКартинкуДляТипаПанелька(Знач ТипОбъекта)
	Если ТипОбъекта = "Справочники" Тогда
		Возврат БиблиотекаКартинок.Справочник;
	ИначеЕсли ТипОбъекта = "Документы" Тогда
		Возврат БиблиотекаКартинок.Документ;
	ИначеЕсли ТипОбъекта = "Журналы документов" Тогда
		Возврат БиблиотекаКартинок.ЖурналДокументов;
	ИначеЕсли ТипОбъекта = "Отчеты" ИЛИ СтрНайти(ТипОбъекта, "Внешние отчеты") > 0 Тогда
		Возврат БиблиотекаКартинок.Отчет;
	ИначеЕсли ТипОбъекта = "Обработки" ИЛИ СтрНайти(ТипОбъекта, "Внешние обработки") > 0 Тогда
		Возврат БиблиотекаКартинок.Обработка;
	ИначеЕсли ТипОбъекта = "Регистры сведений" Тогда
		Возврат БиблиотекаКартинок.РегистрСведений;
	ИначеЕсли ТипОбъекта = "Регистры накопления" Тогда
		Возврат БиблиотекаКартинок.РегистрНакопления;
	ИначеЕсли ТипОбъекта = "Бизнес-процессы" Тогда
		Возврат БиблиотекаКартинок.БизнесПроцесс;
	ИначеЕсли ТипОбъекта = "Задачи" Тогда
		Возврат БиблиотекаКартинок.Задача;
	ИначеЕсли ТипОбъекта = "Общие формы" Тогда
		Возврат БиблиотекаКартинок.Форма;
	ИначеЕсли ТипОбъекта = "Константы" Тогда
		Возврат БиблиотекаКартинок.Константа;
	ИначеЕсли ТипОбъекта = "Планы видов характеристик" Тогда
		Возврат БиблиотекаКартинок.ПланВидовХарактеристик;
	ИначеЕсли ТипОбъекта = "Планы счетов" Тогда
		Возврат БиблиотекаКартинок.ПланСчетов;
	ИначеЕсли ТипОбъекта = "Планы видов расчета" Тогда
		Возврат БиблиотекаКартинок.ПланВидовРасчета;
	ИначеЕсли ТипОбъекта = "Планы обмена" Тогда
		Возврат БиблиотекаКартинок.ПланОбмена;
	ИначеЕсли ТипОбъекта = "Стандартные инструменты" Тогда
		Возврат БиблиотекаКартинок.Настройка;
	Иначе
		Возврат БиблиотекаКартинок.Папка;
	КонецЕсли;
КонецФункции

// Ищет навигационную ссылку объекта в таблице соответствий динамических элементов.
// Параметры:
//  ИмяЭлемента - Строка - имя элемента панели.
// Возвращаемое значение:
//  Строка - результат выполнения функции.
&НаСервере
Функция НайтиСсылкуОбъектаПоИмени(ИмяЭлемента)
	Для Каждого Стр Из ТаблицаСоответствияОбъектов Цикл
		Если Стр.ИмяЭлемента = ИмяЭлемента Тогда
			Возврат Стр.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Определяет отображаемый тип объекта по его навигационной ссылке.
// Параметры:
//  СсылкаТекст - Строка - текст навигационной ссылки.
// Возвращаемое значение:
//  Строка - результат выполнения функции.
&НаСервереБезКонтекста
Функция ПолучитьТипОбъектаИзСсылки(СсылкаТекст)
	Если Лев(СсылкаТекст, 8) = "sys_cmd:" Тогда
		Возврат "Стандартные инструменты";
	КонецЕсли;
	Если Лев(СсылкаТекст, 9) = "ext_file:" Тогда
		Если Прав(НРег(СсылкаТекст), 4) = ".erf" Тогда
			Возврат "Внешние отчеты (Локально)";
		Иначе
			Возврат "Внешние обработки (Локально)";
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(СсылкаТекст, "e1cib/") = 0 И СтрНайти(СсылкаТекст, "e1c://") = 0 Тогда
		Возврат "Некорректные ссылки";
	КонецЕсли;
	ПозицияТочки = СтрНайти(СсылкаТекст, ".");
	Если ПозицияТочки > 0 Тогда
		ПодстрокаДоТочки = Лев(СсылкаТекст, ПозицияТочки - 1);
		Слеши = СтрРазделить(ПодстрокаДоТочки, "/");
		Если Слеши.Количество() > 0 Тогда
			Возврат ПредставлениеТипаМножественное(Слеши[Слеши.Количество() - 1]);
		КонецЕсли;
	КонецЕсли;
	Возврат "Прочее";
КонецФункции

// Преобразует технический идентификатор типа объекта в пользовательское представление.
// Параметры:
//  ТехническийТип - Строка - технический идентификатор типа.
// Возвращаемое значение:
//  Строка - результат выполнения функции.
&НаСервереБезКонтекста
Функция ПредставлениеТипаМножественное(ТехническийТип)
	Если ТехническийТип = "Документ" Тогда
		Возврат "Документы";
	КонецЕсли;
	Если ТехническийТип = "Справочник" Тогда
		Возврат "Справочники";
	КонецЕсли;
	Если ТехническийТип = "РегистрСведений" Тогда
		Возврат "Регистры сведений";
	КонецЕсли;
	Если ТехническийТип = "РегистрНакопления" Тогда
		Возврат "Регистры накопления";
	КонецЕсли;
	Если ТехническийТип = "РегистрБухгалтерии" Тогда
		Возврат "Регистры бухгалтерии";
	КонецЕсли;
	Если ТехническийТип = "РегистрРасчета" Тогда
		Возврат "Регистры расчета";
	КонецЕсли;
	Если ТехническийТип = "Отчет" Тогда
		Возврат "Отчеты";
	КонецЕсли;
	Если ТехническийТип = "Обработка" Тогда
		Возврат "Обработки";
	КонецЕсли;
	Если ТехническийТип = "ЖурналДокументов" Тогда
		Возврат "Журналы документов";
	КонецЕсли;
	Если ТехническийТип = "БизнесПроцесс" Тогда
		Возврат "Бизнес-процессы";
	КонецЕсли;
	Если ТехническийТип = "Задача" Тогда
		Возврат "Задачи";
	КонецЕсли;
	Если ТехническийТип = "ОбщаяФорма" Тогда
		Возврат "Общие формы";
	КонецЕсли;
	Если ТехническийТип = "Константа" Тогда
		Возврат "Константы";
	КонецЕсли;
	Если ТехническийТип = "ПланВидовХарактеристик" Тогда
		Возврат "Планы видов характеристик";
	КонецЕсли;
	Если ТехническийТип = "ПланСчетов" Тогда
		Возврат "Планы счетов";
	КонецЕсли;
	Если ТехническийТип = "ПланВидовРасчета" Тогда
		Возврат "Планы видов расчета";
	КонецЕсли;
	Если ТехническийТип = "ПланОбмена" Тогда
		Возврат "Планы обмена";
	КонецЕсли;
	Возврат ТехническийТип;
КонецФункции

#КонецОбласти

#Область ДиагностикаПроизводительностиПанелька

// В выключенном режиме не обращается к часам и не собирает строки отчёта.
&НаКлиентеНаСервереБезКонтекста
Функция ЧасыДиагностикиПанелька(Включена)
	Если Не Включена Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах();
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьЭтапДиагностикиПанелькаЗначение(Отчет, Название, Начало)
	Если Начало = 0 Или Начало = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отчет = Отчет + Название + ": " + Строка(Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало)) + " мс" +
		Символы.ПС;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДиагностикиПанелька(Выбор, Параметры) Экспорт
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Выбор.Значение = "toggle" Тогда
		ДиагностикаПанелька = Не ДиагностикаПанелька;
		Если ДиагностикаПанелька Тогда
			ОбновитьИнтерфейсДашборда();
		КонецЕсли;
	ИначеЕсли Выбор.Значение = "refresh" Тогда
		ДиагностикаПанелька = Истина;
		ОбновитьИнтерфейсДашборда();
	ИначеЕсли Выбор.Значение = "full" Тогда
		ДиагностикаПанелька = Истина;
		ОбновитьИнтерфейсДашборда(Истина);
	ИначеЕсли Выбор.Значение = "exchange" Тогда
		ЗамеритьОбменПанелька();
	Иначе
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(?(ПустаяСтрока(ОтчетДиагностикиПанелька),
			"Включите диагностику и дождитесь загрузки панели.", ОтчетДиагностикиПанелька));
		Документ.Показать("Замер загрузки Панелька");
	КонецЕсли;
КонецПроцедуры

// По отдельной команде сравнивает пустые серверные вызовы без перестроения.
// Не изменяет последний отчёт загрузки и не вызывается при обычном открытии панели.
&НаКлиенте
Процедура ЗамеритьОбменПанелька()
	ОтчетОбмена = "Панелька: обмен без перестроения; native-queue-9" + Символы.ПС
		+ "Режим: " + ?(РежимHTTP, "Web-интерфейс", "Обычный интерфейс") + Символы.ПС
		+ "Три пары вызовов. Порядок чередуется. Все интервалы измерены на клиенте." + Символы.ПС
		+ "Это обмен уже открытой формы без изменений, а не передача заново построенного интерфейса." + Символы.ПС;
	Для НомерПары = 1 По 3 Цикл
		Для Позиция = 1 По 2 Цикл
			БезКонтекста = ?(НомерПары = 2, Позиция = 2, Позиция = 1);
			Начало = ЧасыДиагностикиПанелька(Истина);
			Если БезКонтекста Тогда
				Ответ = ДиагностическийВызовБезКонтекстаПанелька();
			Иначе
				Ответ = ДиагностическийВызовСКонтекстомПанелька();
			КонецЕсли;
			ДобавитьЭтапДиагностикиПанелькаЗначение(ОтчетОбмена,
				"Пара " + Строка(НомерПары) + ?(БезКонтекста, ": без контекста формы", ": с контекстом формы"), Начало);
			Если Ответ <> Истина Тогда
				ОтчетОбмена = ОтчетОбмена + "Неожиданный ответ диагностического вызова." + Символы.ПС;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ОтчетОбмена = ОтчетОбмена +
		"Времена включают обмен, ожидание сервера и обработку вызова. Разница не является точным размером или временем сериализации контекста.";
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(ОтчетОбмена);
	Документ.Показать("Замер обмена Панелька");
КонецПроцедуры

// Контрольный вызов без обращения к форме, базе и файлам.
// Возвращаемое значение:
//  Булево - Истина.
&НаСервереБезКонтекста
Функция ДиагностическийВызовБезКонтекстаПанелька()
	Возврат Истина;
КонецФункции

// Контрольный вызов с контекстом формы, без изменения данных и элементов.
// Возвращаемое значение:
//  Булево - Истина.
&НаСервере
Функция ДиагностическийВызовСКонтекстомПанелька()
	Возврат Истина;
КонецФункции

// Формирует детализацию из накопленных серверных замеров ссылок.
// Параметры:
//  Замеры - Структура - длительности этапов и число созданных элементов/команд.
// Возвращаемое значение:
//  Строка - строки для включения в общий отчёт загрузки.
&НаСервереБезКонтекста
Функция ПредставлениеЗамеровСсылокПанелька(Знач Замеры)
	Результат = "Внутри этапа ссылок (не суммировать с общим этапом):" + Символы.ПС;
	Для Каждого Часть Из Замеры Цикл
		Результат = Результат + "  " + Часть.Ключ + ": " + Строка(Часть.Значение)
			+ ?(Лев(Часть.Ключ, 5) = "Число", " шт.", " мс") + Символы.ПС;
	КонецЦикла;
	Возврат Результат +
		"ДобавлениеЭлементовМеню, ПривязкаКомандМеню, ЗаголовкиМеню и КартинкиМеню — части Меню. ПолучениеКартинокМеню и ПрисваиваниеКартинокМеню входят в КартинкиМеню. Избранное пересекается с этими частями. ЧислоЭлементов — явные элементы этапа; ЧислоКоманд — новые команды внутри этапа ссылок." + Символы.ПС;
КонецФункции

// Накапливает длительности без формирования строки на каждой ссылке.
&НаСервереБезКонтекста
Процедура НакопитьЗамерОтрисовкиПанелька(Диаг, Часть, Начало)
	Если Начало = 0 Тогда
		Возврат;
	КонецЕсли;
	Диаг[Часть] = Диаг[Часть] + Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
КонецПроцедуры

#КонецОбласти

#Область ОбработкаОшибок

// Добавляет непредвиденную клиентскую ошибку к включённой диагностике, без серверного вызова.
// Параметры:
//  Операция - Строка - описание действия.
//  Ошибка - ИнформацияОбОшибке - исходное исключение.
&НаКлиенте
Процедура ЗаписатьДиагностикуКлиентаПанелька(Знач Операция, Ошибка)
	Если ДиагностикаПанелька Тогда
		ОтчетДиагностикиПанелька = ОтчетДиагностикиПанелька + Операция + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(Ошибка) + Символы.ПС;
	КонецЕсли;
КонецПроцедуры

// Записывает техническую причину ошибки без зависимости от версии БСП.
// Параметры:
//  Операция - Строка - имя операции для события журнала.
//  Ошибка - ИнформацияОбОшибке - исходное исключение.
&НаСервереБезКонтекста
Процедура ЗаписатьОшибкуПанелька(Знач Операция, Ошибка)
	Попытка
		ЗаписьЖурналаРегистрации("Панелька." + Операция, УровеньЖурналаРегистрации.Ошибка, , ,
			Лев(ОбработкаОшибок.ПодробноеПредставлениеОшибки(Ошибка), 10000));
	Исключение
		// Отказ журнала не должен подменять исходную ошибку, возвращаемую вызывающему коду.
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область УправлениеНастройкамиПанели

// Сохраняет имя подключения внешней обработки, заданное каталогом или WMS.
// Имя объекта в исходниках может отличаться от имени его регистрации в сеансе.
&НаКлиенте
Функция ИмяСоседнейФормыПанелька(Знач ИмяСоседнейФормы)
	ПолноеИмяФормы = ИмяФормы;
	Разделитель = ".Форма.";
	Позиция = СтрНайти(ПолноеИмяФормы, Разделитель);
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не удалось определить имя подключения Панелька по имени открытой формы: %1'"), ПолноеИмяФормы);
	КонецЕсли;
	Возврат Лев(ПолноеИмяФормы, Позиция + СтрДлина(Разделитель) - 1) + ИмяСоседнейФормы;
КонецФункции

// Открывает общий редактор настроек, сохраняя владельца и имя подключения Панелька.
&НаКлиенте
Процедура ОткрытьОбщиеНастройкиПанелиПанелька()
	ОткрытьФорму(ИмяСоседнейФормыПанелька("НастройкиПанелька"), , ЭтотОбъект);
КонецПроцедуры

// Открывает личный редактор либо предлагает основу для новой персональной панели.
&НаКлиенте
Процедура ОткрытьНастройкиЛичнойПанелиПанелька()
	Если ЕстьПерсональнаяПанельПанелька() Тогда
		ОткрытьПерсональныйРедакторПанелька(Ложь);
		Возврат;
	КонецЕсли;
	Варианты = Новый СписокЗначений;
	Варианты.Добавить("common",НСтр("ru = 'На основе общей панели'"));
	Варианты.Добавить("empty",НСтр("ru = 'С пустой панели'"));
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораОсновыЛичнойПанелиПанелька", ЭтотОбъект), Варианты,
		Элементы.ПерсональнаяНастройкаПанелиПанелька);
КонецПроцедуры

// Переключает сохраненный профиль и запрашивает обновление через общую очередь.
&НаКлиенте
Процедура ПереключитьАктивнуюПанельПанелька()
	Если Не ЕстьПерсональнаяПанельПанелька() Тогда
		ОткрытьНастройкиЛичнойПанелиПанелька();
		Возврат;
	КонецЕсли;
	ПереключитьЛичныйПрофильПанелька();
	ОбновитьИнтерфейсДашборда();
КонецПроцедуры

// Открывает вариант настроек, выбранный из меню или переданный единственным пунктом.
// Параметры:
//  ВидНастройки - Строка - common для общей панели, иначе персональная настройка.
&НаКлиенте
Процедура ОткрытьВыбранныеНастройкиПанелька(ВидНастройки)
	Если ВидНастройки = "common" Тогда
		ОткрытьОбщиеНастройкиПанелиПанелька();
	Иначе
		ОткрытьНастройкиЛичнойПанелиПанелька();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Отделяет подпись колонки от технического ключа размещения.
&НаСервереБезКонтекста
Функция ЗаголовокКолонкиПанелька(Контекст, Ключ)
	Заголовок = Контекст.ЗаголовкиКолонок[Ключ];
	Возврат ?(Заголовок = Неопределено, Ключ, Заголовок);
КонецФункции

#Область ВыборПерсональнойПанели

// Проверяет актуальную политику непосредственно перед подключением внешнего кода.
//
// Параметры:
//  Адрес - Строка - фактический адрес подключаемого инструмента.
//  АдресРазрешения - Строка - адрес серверного контекста построения, захваченный до ожидания.
//  ИсходныйАдрес - Строка - исходная сохраненная ссылка для повторной проверки личной политики; пустая строка при отсутствии отдельного адреса.
&НаСервере
Процедура ПроверитьПравоПодключенияИнструментаПанелька(Знач Адрес, Знач АдресРазрешения = "", Знач ИсходныйАдрес = "")
	Если ПустаяСтрока(АдресРазрешения) Тогда
		АдресРазрешения = АдресКонтекстаЗапускаПанелька;
	КонецЕсли;
	Контекст = ПрочитатьКонтекстЗапускаПанелька(АдресРазрешения);
	Если Не Контекст.Личная Тогда
		Возврат;
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Если Не Обработка.ПанелькаРазрешенаПерсональнаяПанель() Тогда
		ВызватьИсключение НСтр("ru = 'Персональные панели отключены. Обновите Панелька перед запуском инструмента.'");
	КонецЕсли;
	Профиль = Обработка.ПанелькаПрочитатьЛичныйПрофиль();
	Если Не Профиль.Активна Или Профиль.Данные = Неопределено
		Или Профиль.Ревизия <> Контекст.Ревизия Тогда
		ВызватьИсключение НСтр("ru = 'Персональная панель изменена или удалена. Обновите Панелька перед запуском инструмента.'");
	КонецЕсли;
	КонтекстДоступа = Обработка.ПанелькаКонтекстДоступаЛичнойПанели();
	КлючПодключения = Обработка.ПанелькаКлючДополнительнойСсылки(Адрес);
	Если Не ПустаяСтрока(КлючПодключения) Тогда
		Если Не ПустаяСтрока(ИсходныйАдрес)
			И Обработка.ПанелькаКлючДополнительнойСсылки(ИсходныйАдрес) <> КлючПодключения Тогда
			ВызватьИсключение НСтр("ru = 'Исходная ссылка не соответствует подключаемому инструменту.'");
		КонецЕсли;
		Найдена = Ложь;
		Для Каждого СсылкаПрофиля Из Профиль.Данные.КаталогСсылок Цикл
			АдресСтроки = АдресСсылкиДашбордаПанелька(СсылкаПрофиля.Ссылка, СсылкаПрофиля.Источник);
			Если Не ПустаяСтрока(ИсходныйАдрес) И АдресСтроки <> ИсходныйАдрес Тогда
				Продолжить;
			КонецЕсли;
			Если Обработка.ПанелькаКлючДополнительнойСсылки(СсылкаПрофиля.Ссылка) <> КлючПодключения Тогда
				Продолжить;
			КонецЕсли;
			Найдена = Истина;
			Если Не Обработка.ПанелькаСсылкаДоступнаЛично(СсылкаПрофиля.Ссылка, СсылкаПрофиля.Источник,
				Неопределено, Неопределено, КонтекстДоступа) Тогда
				ВызватьИсключение НСтр("ru = 'Источник сохраненной ссылки больше недоступен. Обновите Панелька.'");
			КонецЕсли;
		КонецЦикла;
		Если Не Найдена Тогда
			ВызватьИсключение НСтр("ru = 'Ссылка удалена из персональной панели. Обновите Панелька.'");
		КонецЕсли;
	ИначеЕсли Не Обработка.ПанелькаСсылкаДоступнаЛично(Адрес, "", Неопределено, Неопределено, КонтекстДоступа) Тогда
		ВызватьИсключение НСтр("ru = 'Инструмент недоступен по текущим правам или настройкам персональной панели. Обновите Панелька.'");
	КонецЕсли;
КонецПроцедуры

// Читает серверный снимок режима; клиентское изменение реквизитов формы не разрешает запуск.
&НаСервере
Функция ПрочитатьКонтекстЗапускаПанелька(Знач АдресРазрешения)
	Если ПустаяСтрока(АдресРазрешения) Или АдресРазрешения <> АдресКонтекстаЗапускаПанелька Тогда
		ВызватьИсключение НСтр("ru = 'Контекст запуска устарел. Обновите Панелька и повторите команду.'");
	КонецЕсли;
	ХранилищеКонтекста = ПолучитьИзВременногоХранилища(АдресРазрешения);
	Если ТипЗнч(ХранилищеКонтекста) <> Тип("ХранилищеЗначения") Тогда
		ВызватьИсключение НСтр("ru = 'Не найден серверный контекст запуска. Обновите Панелька.'");
	КонецЕсли;
	Контекст = ХранилищеКонтекста.Получить();
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректный серверный контекст запуска. Обновите Панелька.'");
	КонецЕсли;
	Если Не Контекст.Свойство("Версия") Или Не Контекст.Свойство("Форма")
		Или Не Контекст.Свойство("Личная") Или Не Контекст.Свойство("Ревизия") Тогда
		ВызватьИсключение НСтр("ru = 'Неполный серверный контекст запуска. Обновите Панелька.'");
	КонецЕсли;
	Если Контекст.Версия <> 1 Или Контекст.Форма <> Строка(УникальныйИдентификатор)
		Или ТипЗнч(Контекст.Личная) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'Контекст запуска не относится к этой форме. Обновите Панелька.'");
	КонецЕсли;
	Возврат Контекст;
КонецФункции

// Перечитываем общую политику перед запуском из уже открытой личной панели.
&НаСервере
Функция РазрешенЗапускЛичнойСсылкиПанелька(Адрес)
	Если Не ИспользуетсяЛичнаяПанельПанелька Тогда
		Возврат Истина;
	КонецЕсли;
	Обработка = РеквизитФормыВЗначение("Объект");
	Если Не Обработка.ПанелькаРазрешенаПерсональнаяПанель() Тогда
		Возврат Ложь;
	КонецЕсли;
	Профиль = Обработка.ПанелькаПрочитатьЛичныйПрофиль();
	Если Профиль.Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Источник = "";
	Для Каждого Ссылка Из Профиль.Данные.КаталогСсылок Цикл
		Если Ссылка.Ссылка = Адрес Тогда
			Источник = Ссылка.Источник;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Обработка.ПанелькаСсылкаДоступнаЛично(Адрес, Источник);
КонецФункции

&НаКлиенте
Процедура ПослеВыбораОсновыЛичнойПанелиПанелька(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьПерсональныйРедакторПанелька(Результат.Значение = "empty");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПерсональныйРедакторПанелька(СНуля)
	ПараметрыРедактора = Новый Структура("ПерсональнаяНастройкаПанелька,НачатьСПустой", Истина, СНуля);
	ОткрытьФорму(ИмяСоседнейФормыПанелька("НастройкиПанелька"), ПараметрыРедактора, ЭтотОбъект, "ПерсональнаяПанель");
КонецПроцедуры

&НаСервере
Функция ЕстьПерсональнаяПанельПанелька()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПанелькаПроверитьПравоЛичнойПанели();
	Возврат Обработка.ПанелькаПрочитатьЛичныйПрофиль().Данные <> Неопределено;
КонецФункции

&НаСервере
Процедура ПереключитьЛичныйПрофильПанелька()
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПанелькаПереключитьЛичныйРежим();
	// Режим является частью представления даже при одинаковом содержимом панелей.
	СброситьСнимокОбычнойПанелиПанелька();
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ВариантыНастройкиПанелька()
	Варианты = Новый СписокЗначений;
	Если РеквизитФормыВЗначение("Объект").ПанелькаРазрешенаПерсональнаяПанель() И
		ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		Варианты.Добавить("personal",НСтр("ru = 'Моя панель — только для меня'"));
	КонецЕсли;
	Если ПользовательИмеетПраваАдмина() Тогда
		Варианты.Добавить("common",НСтр("ru = 'Общая панель — для пользователей'"));
	КонецЕсли;
	Возврат Варианты;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораНастройкиПанелька(Результат, Контекст) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьВыбранныеНастройкиПанелька(Результат.Значение);
КонецПроцедуры

#КонецОбласти
