#Область ОписаниеПеременных

&НаКлиенте
Перем МожноЗакрытьОкноЗагрузкиПанелька;
&НаКлиенте
Перем ПродолжениеЗапланированоПанелька;
&НаКлиенте
Перем ОповещениеПродолженияПанелька;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("МакетЗагрузкиПанелькаHTML");
	HTMLЗагрузки = Макет.ПолучитьТекст();
	ПроцентЗагрузкиПанелька = 0;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Даём платформе показать окно до первого шага построения владельца.
	ЗапланироватьПродолжение();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	МожноЗакрытьОкноЗагрузкиПанелька = Истина;
	Если ПродолжениеЗапланированоПанелька = Истина Тогда
		ОтключитьОбработчикОжидания("ПродолжитьЗагрузку");
		ПродолжениеЗапланированоПанелька = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	// Esc и закрытие окна не оставляют частично построенную панель доступной.
	Если Не ЗавершениеРаботы И МожноЗакрытьОкноЗагрузкиПанелька <> Истина Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обновляет только собственные элементы формы, без сервера и перезагрузки GIF.
// Параметры:
//  Готово - Число - число завершённых этапов.
//  Всего - Число - общее число этапов; ноль во время подготовки.
//  Этап - Строка - текущий этап загрузки.
&НаКлиенте
Процедура ОбновитьПрогресс(Знач Готово, Знач Всего, Знач Этап) Экспорт
	Готово = Макс(0, Цел(Готово));
	Всего = Макс(0, Цел(Всего));
	Если Всего > 0 Тогда
		Готово = Мин(Готово, Всего);
		ПроцентЗагрузкиПанелька = Цел(100 * Готово / Всего);
		Элементы.ПрогрессЗагрузкиПанелька.Заголовок = "Выполнено: " + Формат(Готово, "ЧГ=0;ЧДЦ=0")
			+ " из " + Формат(Всего, "ЧГ=0;ЧДЦ=0");
	Иначе
		ПроцентЗагрузкиПанелька = 0;
		Элементы.ПрогрессЗагрузкиПанелька.Заголовок = "Подготовка панели…";
	КонецЕсли;
	Элементы.ЭтапЗагрузкиПанелька.Заголовок = Этап;
КонецПроцедуры

// Клиентская обратная связь назначается сразу после открытия окна.
// Параметры:
//  Оповещение - ОписаниеОповещения - продолжение построения панели на клиенте.
&НаКлиенте
Процедура УстановитьПродолжение(Знач Оповещение) Экспорт
	ОповещениеПродолженияПанелька = Оповещение;
КонецПроцедуры

// Планирует только следующий фактический шаг. Фонового опроса сервера нет.
&НаКлиенте
Процедура ЗапланироватьПродолжение() Экспорт
	Если МожноЗакрытьОкноЗагрузкиПанелька = Истина Или ПродолжениеЗапланированоПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПродолжитьЗагрузку", 0.05, Истина);
	ПродолжениеЗапланированоПанелька = Истина;
КонецПроцедуры

// Продолжение хранится только на клиенте; связь форм не участвует в серверном обмене.
&НаКлиенте
Процедура ПродолжитьЗагрузку() Экспорт
	ПродолжениеЗапланированоПанелька = Ложь;
	Если МожноЗакрытьОкноЗагрузкиПанелька = Истина Тогда
		Возврат;
	КонецЕсли;
	Если ОповещениеПродолженияПанелька <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеПродолженияПанелька, Неопределено);
	КонецЕсли;
КонецПроцедуры

// Вызывается владельцем и после успеха, и после ошибки построения.
&НаКлиенте
Процедура Завершить() Экспорт
	Если ПродолжениеЗапланированоПанелька = Истина Тогда
		ОтключитьОбработчикОжидания("ПродолжитьЗагрузку");
		ПродолжениеЗапланированоПанелька = Ложь;
	КонецЕсли;
	МожноЗакрытьОкноЗагрузкиПанелька = Истина;
	ОповещениеПродолженияПанелька = Неопределено;
	Закрыть();
КонецПроцедуры


#КонецОбласти
